 2436  .PARAM CGXM0   = 1.7E-17 
 2437  .PARAM CGXMW   = 1.59228E-17 
 2438  .PARAM CGXMW2  = 6.81673E-11
 2439  .PARAM CDSM1   = 7.5E-25 
 2440  .PARAM CDSM1W  = 1.29E-17
 2441  .PARAM CFL     = 2.60749E-11
 2442  .PARAM LMAXCF  = 1.57E-06
 2443  .PARAM CFW     = 1.49E-18
 2444  
 2445  
 2446  * Layout and electrical dimensions:
 2447  *----------------------------------
 2448  .PARAM WM='W*TOMETER'
 2449  .PARAM LM='L*TOMETER'
 2450  .PARAM WFING='WM/NFING+XW'
 2451  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
 2452  .PARAM FS='2-FD'
 2453  .PARAM ADP ='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FD*(CONW/2.0+COEACT2)+XW/2)'
 2454  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
 2455  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
 2456  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
 2457  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 2458  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 2459  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 2460  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 2461  
 2462  
 2463  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
 2464  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 2465  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 2466  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
 2467  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
 2468  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
 2469  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
 2470  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 2471  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
 2472  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
 2473  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
 2474  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
 2475  
 2476  * DC Effective length and width:
 2477  *---------------------------
 2478  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 2479  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 2480  * AC Effective length and width:
 2481  *------------------------------
 2482  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 2483  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(2.2556E-16/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 2484  *  Effective Source/Drain Junction width:
 2485  *---------------------------------------
 2486  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 2487  
 2488  
 2489  * Model improvement equations :
 2490  *------------------------------
 2491  
 2492   
 2493      * Continuous Model for mismatch deviations 
 2494  *----------------------------------------
 2495  .PARAM X_DEV        = 0.0 DEVX/GAUSS = {1.0}
 2496  .PARAM Y_DEV        = 0.0 DEVX/GAUSS = {1.0}
 2497  .PARAM Z_DEV        = 0.0 DEVX/GAUSS = {1.0}
 2498  .PARAM DVTH_AVT        = '4.5E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 2499  .PARAM DBETA_ABETA     = '0.81E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 2500  
 2501  
 2502  .PARAM PVT          = 4.9E-06      
 2503  .PARAM TPVT         = -0.014E-06     
 2504  .PARAM ZETAVT       = 0.37E+12
 2505  .PARAM DVTH_PVT    = '(PVT+TPVT*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETAVT*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 2506  .PARAM DVTH0_SIG = 'SQRT(DVTH_PVT*DVTH_PVT+DVTH_AVT*DVTH_AVT)'
 2507  .PARAM DVTH0_DEV = '(DVTH_AVT*X_DEV+DVTH_PVT*Y_DEV)*SVTLP_DEV*MISMATCH'
 2508  
 2509  
 2510  .PARAM PBETA        = 0.77E-05    
 2511  .PARAM TPBETA       = -0.0062E-05   
 2512  .PARAM ZETABETA     = 9.4E+10
 2513  .PARAM DBETA_PBETA = '(PBETA+TPBETA*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETABETA*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 2514  .PARAM DBETA_SIG = 'SQRT(DBETA_PBETA*DBETA_PBETA+DBETA_ABETA*DBETA_ABETA)'
 2515  .PARAM DBETA_DEV = '(DBETA_ABETA*Z_DEV+DBETA_PBETA*Y_DEV)*SVTLP_DEV*MISMATCH'
 2516  
 2517  .PARAM PROCESSSTATFLAGS = '1.0'
 2518  .PARAM DVTHTOT   = 'NSVTLP_DVTH0_CMOS065/(VALIF((NSVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 2519  .PARAM VTH     = '0.42333+NSVTLP_DVTH0_CMOS065'
 2520  
 2521  
 2522  * Equation for  AGIDL:
 2523  * --------------------
 2524  .PARAM AGIDL   = '(4.1681E-05)*10^DAGIDL'
 2525  
 2526  
 2527  * Equations for mobility :
 2528  *-------------------------
 2529  .PARAM EPSILON2 = 1E-18
 2530  .PARAM LLIMIT = '7.96E-07-XL' 
 2531  .PARAM WLIMIT = '3.75096E-07-XW' 
 2532  .PARAM DWU = 'DWU0+(-0.5)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
 2533  .PARAM MOBILITY = '2.0/(0.004525008559+(LLIMIT+XL
 2534  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.0002557917469/LE)
 2535  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 2536  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 2537  
 2538  
 2539  
 2540  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 2541  
 2542  
 2543  * Channel doping nch and body factor k1 worst case :
 2544  *---------------------------------------------------
 2545  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 2546  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 2547  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(7.863E+17/NI)+0.25043+0.4'
 2548  .PARAM  K2        =  '(-0.016255+-6.219E-09/LE)*(TOX/2.3926E-09)'
 2549  .PARAM  K1        =  '(0.35383)-MOSTYPE*(0.42333-VTH)/SQRT(PHIS_TYP)'
 2550  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 2551  .PARAM  NCH       =  '7.863E+17*(K1*K1)/((0.35383)*(0.35383))'
 2552  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
 2553  * Series resistance worst case :
 2554  *-------------------------------
 2555  .PARAM RDSW      =  '(195.87)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 2556  .PARAM PRWB      =  0
 2557  
 2558  
 2559  
 2560  
 2561  
 2562  
 2563  .PARAM VSATEFF = '(1.7862E+05)'
 2564  
 2565  * Equations for stress :
 2566  *-----------------------
 2567  
 2568  .PARAM C_1	= 'CONW+COEACT2+CONPO'
 2569  .PARAM C_2 	= C_1
 2570  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
 2571  .PARAM B_2	= B_1 
 2572  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 2573  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 2574  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 2575  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 2576  * Stress effect on threshold voltage :
 2577  *-------------------------------------
 2578  
 2579  
 2580  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((-5.6224E-16*NFING/WM+2.2724E-09)/2)*(ABS(1/LM-(0*NFING/WM+7E+06))+(1/LM -(0*NFING/WM+7E+06)))+3.5294E-10*NFING/WM+-0.0040207'
 2581  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2582  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NSVTLP_DVTH0_CMOS065+DVTHTOT'
 2583  * Stress effect on mobility :
 2584  *----------------------------
 2585  
 2586  
 2587  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-2.1056E-08)/2)*(ABS(1/LM-(-0.08785*NFING/WM+3.8298E+06))-(1/LM -(-0.08785*NFING/WM+3.8298E+06)))+((-5.9944E-15*NFING/WM+2.1544E-08)/2)*(ABS(1/LM-(0.1532*NFING/WM +9E+06))+(1/LM -(0.1532*NFING/WM+9E+06)))+-3E-09*NFING/WM+0.07397'
 2588  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2589  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 2590  * Stress effect on body factor K1 :
 2591  *----------------------------------
 2592  .PARAM VARMAXK1         = '-0.04+0/LM+1E-08*NFING/WM'
 2593  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2594  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 2595  * Stress effect on DVT0 :
 2596  *------------------------
 2597  .PARAM DVT0_STRESS        = -0.065
 2598  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 2599  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2600  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 2601  * Stress effect on access resistance :
 2602  *-------------------------------------
 2603  .PARAM VARMAXRDSW       = '0.15+-5.67E-08*NFING/WM'
 2604  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2605  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 2606  
 2607  
 2608  .PARAM NFACTOR = '(1.183+1.3488E-07/LE)*SQRT(PHIS*7.863E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
 2609  
 2610  
 2611  
 2612  * Equations for VT :
 2613  *-------------------
 2614  .PARAM W0       = '2.2957E-08+(0-XW)'
 2615  .PARAM K3B      = '(3+-1.7E-07/LE)*(2.3926E-09/TOX)'
 2616  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 2617  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*7.863E+17*1E6))'
 2618  .PARAM DVTP0    = 0
 2619  
 2620  
 2621  .PARAM N_SUBVT  = '1.0+(1.183+1.3488E-07/LE)*7.177800693E-09/XDEP0'
 2622  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.4293E-06))'
 2623  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
 2624  .PARAM K3       = '(-5.8321)*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
 2625  
 2626  
 2627  
 2628  * Equation for moin :
 2629  *-------------------
 2630  .PARAM MOIN = 'VALIF((5.8569*((0.35383)/K1EFF)^2 > 5), (5.8569*((0.35383)/K1EFF)^2), (5))'
 2631  
 2632  
 2633  * Equations for LKETA :
 2634  *---------------------
 2635  
 2636  
 2637  .PARAM LKETA    = 0.001 
 2638  
 2639  
 2640  *Worst case methodology improvement: Short Channel effect
 2641  *--------------------------------------------------------
 2642  .PARAM LPE0  = '((((0.35383)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(3E-13+1.16E-14/LE)/(LMIN+5E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 2643  .PARAM LPEB  = '(1.2424E-07)/(LMIN+5E-09-2*LINT)*(LMIN+XL-2*LINT)'
 2644  .PARAM DVT1  = '0.032*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 2645  .PARAM DVT1W = '8.4182E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2646  .PARAM DSUB = '(0.024314)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2647  
 2648  
 2649  
 2650  * Equations for Extrinsic Capacitances:
 2651  * ------------------------------------
 2652  
 2653  .PARAM CF = '(0)*(1 + DCFRING)'
 2654  .PARAM CGBO = '5.00E-10*(1 + DCFRING)'
 2655  
 2656  
 2657  .PARAM CGSL = '((2.5E-11) + 0/LM  + 0/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
 2658  .PARAM CGDL = '((2.5E-11) + 0/LM  + 0/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
 2659  .PARAM CGSO       =  '2.6411E-10*(2.3926E-09/TOX)'
 2660  .PARAM CGDO       =  '2.6411E-10*(2.3926E-09/TOX)'
 2661  
 2662  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2663  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2664  
 2665  
 2666  
 2667  * Equations for extrinsic S/D resistances:
 2668  * ---------------------------------------
 2669  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
 2670  
 2671  
 2672  
 2673  * Salicided poly gate resistance:
 2674  * ------------------------------
 2675  
 2676  .PARAM RGATEMOD = 0
 2677  .PARAM RSHG0    = 15.014
 2678  
 2679  * Salicided Source/Drain diffusion access resistances:
 2680  * ---------------------------------------------------
 2681  .PARAM NRSEFF    = 'NRS'
 2682  .PARAM NRDEFF    = 'NRD'
 2683  
 2684  
 2685  
 2686  * Equations for poly gate resistance:
 2687  * -----------------------------------
 2688  .PARAM XGW        = 1.0E-07
 2689  .PARAM XGL        = -2.674E-08
 2690  .PARAM TC1G       = 2.3E-03
 2691  .PARAM TC2G       = 0
 2692  .PARAM TC1GV      = 0
 2693  .PARAM TC2GV      = 0
 2694  .PARAM LHEAD      = 'MAX(NFING*CONW+(NFING-1)*CONS+2*COEPO,NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS)))'
 2695  .PARAM NCHEAD     = 'NCRG*(1+TRUNC(((LHEAD-CONW-2*COEPO)/(CONW+CONS))+1E-12))'
 2696  .PARAM RGCON      = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 2697  .PARAM RSHGT      = 'MAX(1E-6,RSHG*(1+(TC1G+TC2G*(EFFTEMP-25))*(EFFTEMP-25)))'
 2698  .PARAM RSHGVT     = 'MAX(1E-6,RSHGV*(1+(TC1GV+TC2GV*(EFFTEMP-25))*(EFFTEMP-25)))'
 2699  .PARAM RGELTD     = 'RSHGT*(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*NFING)+RSHGVT*1E-12/((LM+XL)*(WM/NFING+XW)*NFING)'
 2700  .PARAM RGBSIM4    = '(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*1)'
 2701  .PARAM RSHGEFF    = '(RGELTD+RGCON)/RGBSIM4*NFING'
 2702  
 2703  * Equations for bulk resistance:
 2704  * ------------------------------
 2705  .PARAM RSTI       = '(RSTIR+RSTIL*WM/(12*NFING*(LM+XBL)))/NFING'
 2706  .PARAM RBSD       = '(RBSDR*1E-6)/(WM)'
 2707  .PARAM RBODYMOD   = 1
 2708  .PARAM RBPB       = 'RBGBL*1E-6/LM'
 2709  .PARAM RBPD       = 1E+09
 2710  .PARAM RBPS       = 1E+09
 2711  .PARAM RBDB       = 'RBSD*NFING/2'
 2712  .PARAM RBSB       = 'RBSD*NFING/2'
 2713  
 2714  * Equations for parasitic capacitances:
 2715  * -------------------------------------
 2716  .PARAM CGD_PLS    = '((NFING+FD)/2*CGXM0 + (NFING+FD)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FD*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 2717  .PARAM CGS_PLS    = '((NFING+FS)/2*CGXM0 + (NFING+FS)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FS*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 2718  .PARAM CDS_PLS    = '(CDSM1+CDSM1W*WFING)*NFING/(LM+2*CONPO)'
 2719  .PARAM CGDM	  = '(1-LPEC)*CGD_PLS*WEC*NFING '
 2720  .PARAM CGSM	  = '(1-LPEC)*CGS_PLS*WEC*NFING '
 2721  .PARAM CFLM       = 'CFL*LOG((1+0.5*(MIN(LM+XL,LMAXCF))/(CONPO-XL/2))/(1+0.5*(LMIN+XL)/(CONPO-XL/2)))'
 2722  .PARAM CFWM       = 'CFW*NGCON/WEC'
 2723  .PARAM CDSM       = 'CDSM0*(LMIN+2.0*CDSML)/(LM+2.0*CDSML)*(WM/NFING)*NFING+(1-LPEC)*CDS_PLS'
 2724  .PARAM CBDM       = 'CBXM0*(WM/NFING)*FD'
 2725  .PARAM CBSM       = 'CBXM0*(WM/NFING)*FS'
 2726  
 2727  
