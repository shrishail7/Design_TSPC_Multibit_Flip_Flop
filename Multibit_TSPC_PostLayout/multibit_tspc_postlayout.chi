 1992  * Equations for mobility :
 1993  *-------------------------
 1994  .PARAM EPSILON2 = 1E-18
 1995  .PARAM LLIMIT = '3.660474E-08-XL' 
 1996  .PARAM WLIMIT = '2.62296E-07-XW' 
 1997  .PARAM DWU = 'DWU0+(3.2242)*0.5E6*(ABS(LE-1E-07)-(LE-1E-07))' 
 1998  .PARAM MOBILITY = '2.0/(0.02212584965+(LLIMIT+XL
 1999  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.006851678275/LE)
 2000  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 2001  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 2002  
 2003  
 2004  
 2005  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PSRAMSPSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 2006  
 2007  
 2008  * Channel doping nch and body factor k1 worst case :
 2009  *---------------------------------------------------
 2010  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 2011  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 2012  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(3.8723E+17/NI)+0.18679+0.4'
 2013  .PARAM  K2        =  '(0+7.4711E-11/LE)*(TOX/2.4239E-09)'
 2014  .PARAM  K1        =  '(0.25156)-MOSTYPE*(-0.48961-VTH)/SQRT(PHIS_TYP)'
 2015  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 2016  .PARAM  NCH       =  '3.8723E+17*(K1*K1)/((0.25156)*(0.25156))'
 2017  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18679+0.4'
 2018  * Series resistance worst case :
 2019  *-------------------------------
 2020  .PARAM RDSW      =  '(406.95+2.097E-05/WE)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PSRAMSPSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 2021  .PARAM PRWB      =  0.26884
 2022  
 2023  
 2024  
 2025  
 2026  
 2027  .PARAM  VTH0EFF   =  'VTH0-PSRAMSPSVTLP_DVTH0_CMOS065+DVTHTOT'
 2028  .PARAM U0EFF            = U0
 2029  .PARAM K1EFF		= K1
 2030  .PARAM DVT0EFF		= 1.4588
 2031  .PARAM RDSWEFF0          = RDSW 
 2032  .PARAM VSATEFF = '(3.1774E+05)'
 2033  
 2034  
 2035  .PARAM NFACTOR = '(1.2065)*SQRT(PHIS*3.8723E+17/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 2036  
 2037  
 2038  
 2039  * Equations for VT :
 2040  *-------------------
 2041  .PARAM W0       = '4.6522E-07+(0-XW)'
 2042  .PARAM K3B      = '(7.0432)*(2.4239E-09/TOX)'
 2043  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 2044  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*3.8723E+17*1E6))'
 2045  .PARAM DVTP0    = 0
 2046  
 2047  
 2048  .PARAM N_SUBVT  = '1.0+(1.2065)*7.271700702E-09/XDEP0'
 2049  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+9.7209E-07))'
 2050  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 2051  .PARAM K3       = '(-13.36+3E-07/(LE*(LMIN+0-2*LINT)/(LMIN+XL-2*LINT)))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 2052  
 2053  
 2054  
 2055  * Equation for moin :
 2056  *-------------------
 2057  .PARAM MOIN = 'VALIF((10*((0.25156)/K1EFF)^2 > 5), (10*((0.25156)/K1EFF)^2), (5))'
 2058  
 2059  
 2060  * Equations for LKETA :
 2061  *---------------------
 2062  
 2063  .PARAM LKETAEXP = 'VALIF(((2.646973186E-07/LE-3.020555489) > 34), (34), (2.646973186E-07/LE-3.020555489))'
 2064  
 2065  .PARAM LKETA    = '-0.019729/(1.0+EXP(LKETAEXP))'
 2066  
 2067  
 2068  *Worst case methodology improvement: Short Channel effect
 2069  *--------------------------------------------------------
 2070  .PARAM LPE0  = '((((0.25156)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4.5877E-08)/(LMIN+0-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 2071  .PARAM LPEB  = '(-5.9281E-10)/(LMIN+0-2*LINT)*(LMIN+XL-2*LINT)'
 2072  .PARAM DVT1  = '0.077454*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 2073  .PARAM DVT1W = '2.0191E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2074  .PARAM DSUB = '(0.065407)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2075  
 2076  
 2077  
 2078  * Equations for Extrinsic Capacitances:
 2079  * ------------------------------------
 2080  
 2081  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 2082  
 2083  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 2084  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 2085  
 2086  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 2087  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 2088  
 2089  
 2090  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 2091  
 2092  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 2093  
 2094  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
 2095  
 2096  .PARAM CGSL = '(6.7972E-11)*(2.4239E-09/TOX)'
 2097  .PARAM CGDL = '(6.7972E-11)*(2.4239E-09/TOX)'
 2098  .PARAM CGSO       =  '7.948E-11*(2.4239E-09/TOX)'
 2099  .PARAM CGDO       =  '7.948E-11*(2.4239E-09/TOX)'
 2100  
 2101  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2102  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2103  
