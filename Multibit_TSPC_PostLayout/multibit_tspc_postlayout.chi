 1076  .PARAM PROCESSSTATFLAGS = '1.0'
 1077  .PARAM DVTHTOT   = 'NHVTLPPGSP_DVTH0_CMOS065/(VALIF((NHVTLPPGSP_DVTH0_CMOS065==0),(1),(0))+SQRT((NHVTLPPGSP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMSPHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NHVTLPPGSP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1078  .PARAM VTH     = '0.67476+NHVTLPPGSP_DVTH0_CMOS065'
 1079  
