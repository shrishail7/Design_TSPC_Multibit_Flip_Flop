  604  
  605  * Model improvement equations :
  606  *------------------------------
  607  
  608  * Equations for mismatch deviations:
  609  *-----------------------------------
  610  .PARAM DVTH0_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(5.0E-9),(6.6E-9))
  611  .PARAM DVTH0_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  612  .PARAM DVTH0_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
  613  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
  614  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMDPHVTLP_DEV*MISMATCH}
  615  .PARAM DBETA_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.87E-8),(0.62E-8))
  616  .PARAM DBETA_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  617  .PARAM DBETA_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.153))
  618  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
  619  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMDPHVTLP_DEV*MISMATCH}
  620  
  621  
  622  .PARAM PROCESSSTATFLAGS = '1.0'
  623  .PARAM DVTHTOT   = 'NHVTLPPGDP_DVTH0_CMOS065/(VALIF((NHVTLPPGDP_DVTH0_CMOS065==0),(1),(0))+SQRT((NHVTLPPGDP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMDPHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NHVTLPPGDP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  624  .PARAM VTH     = '0.67476+NHVTLPPGDP_DVTH0_CMOS065'
  625  
