 1744  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 1745  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
