 4203  + WMIN=1.2E-07          WMAX=1E-05            LMIN=6E-08            
 4204  + LMAX=1E-05
 4205  + TR=25                 SWIGATE=1             SWIMPACT=1            
 4206  + SWGIDL=1              SWJUNCAP=1            QMC=1                 
 4207  + LVARO=XL              LVARL=0               LVARW=0               
 4208  + LAP=-3E-09            WVARO=XW              WVARL=0               
 4209  + WVARW=0               WOT=-2E-08            DLQ=-3.4E-08          
 4210  + DWQ=-1.6E-08          VFBO=VFBO             VFBL=-0.0243527       
 4211  + VFBW=0                VFBLW=0.001           STVFBO=0.000538249    
 4212  + STVFBL=0.0051834      STVFBW=-0.00857997    STVFBLW=-0.00381712   
 4213  + TOXO=TOX              NSUBO=NSUBO           NSUBW=0               
 4214  + WSEG=8.98534E-10      NPCK=NPCK             NPCKW=0               
 4215  + WSEGP=9.97308E-07     LPCK=LPCK             LPCKW=0               
 4216  + FOL1=0.10395          FOL2=-0.00270864      VNSUBO=0              
 4217  + NSLPO=0.05            DNSUBO=0              DPHIBO=0              
 4218  + DPHIBL=0              DPHIBLEXP=1           DPHIBW=0              
 4219  + DPHIBLW=0             NPO=4.04063E+26       NPL=0                 
 4220  + CTO='0.0234441'       CTL='0.0252877'       CTLEXP=0.841348       
 4221  + CTW='0.146856'        CTLW='-0.00391158'    TOXOVO=TOX            
 4222  + LOV=LOV               NOVO=1.508E+24        CFL=5.19654E-05       
 4223  + CFLEXP=2.83225        CFW=-0.0623829        CFBO=0                
 4224  + UO=U0                 FBET1=0.528925        FBET1W=-0.192782      
 4225  + LP1=4.71614E-08       LP1W=0.129499         FBET2=1.21764         
 4226  + LP2=1.24064E-08       BETW1=-0.00509013     BETW2=-0.103962       
 4227  + WBET=4.9599E-07       STBETO=1.35303        STBETL=-0.0116032     
 4228  + STBETW=0.00224968     STBETLW=0.00232922    MUEO=0.869816         
 4229  + MUEW=0.00312469       STMUEO=-4.4409E-10    THEMUO=1.81854        
 4230  + STTHEMUO=0.224244     CSO=0.717381          CSL=0.00433959        
 4231  + CSLEXP=2.47946        CSW=0.107359          CSLW=0.0112374        
 4232  + STCSO=-3.89037        XCORO=0.0697307       XCORL=1E-06           
 4233  + XCORW=-0.539971       XCORLW=1E-15          STXCORO=1.6278        
 4234  + FETAO=1               RSW1=RSW1EFF          RSW2=0.213571         
 4235  + STRSO=0.693125        RSBO=0                RSGO=0                
 4236  + THESATO='0.716503*U0/0.0448269' THESATL='0.410137*U0/0.0448269' 
 4237  + THESATLEXP=1.05347    THESATW=-0.0112957    THESATLW=-2.14457E-05 
 4238  + STTHESATO=0.708735    STTHESATL=-0.0157628  STTHESATW=-0.0236558  
 4239  + STTHESATLW=0.00940702 THESATBO=0            THESATGO=0.180434     
 4240  + AXO=4.77579           AXL=0.248451          ALPL=0.124376         
 4241  + ALPLEXP=0.49843       ALPW=-0.107751        ALP1L1=0.00357711     
 4242  + ALP1LEXP=0.366122     ALP1L2=0.628315       ALP1W=0.57008         
