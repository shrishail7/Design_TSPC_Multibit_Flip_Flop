 1742  
 1743  *------------------------------------------------------------------------------
 1744  * flag used to switch on/off device access modeling (for post layout simulation)
 1745  *------------------------------------------------------------------------------
 1746  *   lpe     Body      Access_R  Access_C   Extraction_mode
 1747  *    0       yes        yes       yes           --
 1748  *    1       yes        yes       no             C
 1749  *    2       yes        no        yes            R
 1750  *    3       yes        no        no             RC
 1751  *
 1752  .PARAM LPER = 'VALIF(((LPE==2) || (LPE==3)),(1),(0))'
 1753  .PARAM LPEC = 'VALIF(((LPE==1) || (LPE==3) || (LPE==97)),(1),(0))'
 1754  .PARAM ALIGNMENT_PRELAYOUT  = 'VALIF(((LPE==99) || (LPE==98)),(1),(0))'
 1755  .PARAM ALIGNMENT_POSTLAYOUT = 'VALIF((LPE==98),(1),(0))'
 1756  .PARAM LPEC2 = 'VALIF(((LPE==1) || (LPE==3)),(1),(0))'
 1757  
 1758  
 1759  *-----------------------------------------------------------------------------------------------------
 1760  * flag used to switch on/off Source and Drain diffusion access resistances (for post layout simulation) 
 1761  *-----------------------------------------------------------------------------------------------------
 1762  .PARAM NRSD_FLAG = 'VALIF(((NRS==0) && (NRD==0)),(0),(1))'
 1763  
 1764  
 1765  
 1766  *--------------------------------------------------------
 1767  * flag used to switch on/off mismatch into process corners
 1768  *--------------------------------------------------------
 1769  * svtlp_dev  no_mm  mc_mm  mm_in_corners  param_mm
 1770  *       0       yes    no     no             no
 1771  *       1       no     yes    no             no
 1772  *       2       no     no     yes            no
 1773  *       3       no     no     no             yes
 1774  *
 1775  .PARAM MFLAG_NO        = 'VALIF((SVTLP_DEV==0),(1),(0))'
 1776  .PARAM MFLAG_MC        = 'VALIF((SVTLP_DEV==1),(1),(0))'
 1777  .PARAM MFLAG_CORNER    = 'VALIF((SVTLP_DEV==2),(1),(0))'
 1778  .PARAM MFLAG_PARAM     = 'VALIF((SVTLP_DEV==3),(1),(0))'
 1779  
