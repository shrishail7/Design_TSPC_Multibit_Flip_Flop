 1517  .PARAM RDW = 0
 1518  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 0.0002*(TEMPK/(25+273.15) -1)), (0))'
 1519  .PARAM RDSWEFF2 = '(RDSWEFF + 0.0002*(TEMPK/(25+273.15) -1))'
 1520  .PARAM PRT = 0
 1521  
 1522  
 1523  * Equations for thermal noise scaling
 1524  * ------------------------------------
 1525  .PARAM NTNOI = '1*LE/LEC'
 1526  
 1527  
 1528  
 1529  
 1530  
 1531   
 1532  .PARAM WPEMOD   = 1
 1533  .PARAM KVTH0WE  = (-5.486849E-3+9.596948E-11/LE+1E-13/WE)
 1534  .PARAM K2WE     = (3.559716E-3+-5.383133E-11/LE+1.125498E-13/WE)
 1535  .PARAM SCREF    = 1E-6
 1536  .PARAM KU0WE    = (-8.277252E-4+-6.093262E-10/LE+9.372638E-10/WE)
 1537  .PARAM WEB      = -450
 1538  .PARAM WEC2      = -3000
