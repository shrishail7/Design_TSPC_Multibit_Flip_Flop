 1783  * Device temperature:
 1784  *--------------------
 1785  .PARAM TEMPK   = 'TEMPER+273.15'
 1786  
 1787  
 1788  * invariant parameters:
 1789  *----------------------
 1790  .PARAM MOSTYPE = -1 
 1791  
 1792  .PARAM CONW    = '0.09E-6'
 1793  .PARAM CONS    = '0.11E-6'
 1794  .PARAM COEACT1  = '0.015E-6'
 1795  .PARAM COEACT2  = '0.03E-6'
 1796  .PARAM CONPO   = '0.055E-6'
 1797  .PARAM PO2DB   = '0.100E-6'
 1798  .PARAM LINT    = -1.5E-09
 1799  .PARAM DLC     = 1.25E-08
 1800  .PARAM LMIN    = 6E-8
 1801  .PARAM DWU0    = 0.02074
 1802  .PARAM WINT    = -2.5871E-08
 1803  .PARAM DWC     = -9E-09
 1804  .PARAM DWJ     = -1E-08
 1805  .PARAM COEPO   = '0.01E-6'
 1806  
 1807  .PARAM CONACT  = '0.070E-6'
 1808  .PARAM NCRG    = 1
 1809  .PARAM CONRPO  = '0.22E-6'
 1810  .PARAM RPOEXTPOFLD = '0.22E-6' 
 1811  .PARAM DIODEMOD = 1
 1812  
 1813  
 1814  
 1815  * variant parameters:
 1816  *--------------------
 1817  .PARAM XL      = '8E-09 + PSVTLP_DXL_CMOS065'
 1818  .PARAM XW      = '0 + PSVTLP_DXW_CMOS065'
 1819  .PARAM TOX     = '2.4239E-09 + PSVTLP_DTOXE_CMOS065'
 1820  .PARAM DMU     = PSVTLP_DMU_CMOS065
 1821   
 1822  
 1823  .PARAM  CJS     = '0.0012557*(1 + PSVTLP_DCJB_CMOS065)'
 1824  .PARAM  CJSWS   = '3.1862E-11*(1 + PSVTLP_DCJSW_CMOS065)'
 1825  .PARAM  CJSWGS  = '1.6208E-10*(1 + PSVTLP_DCJGATE_CMOS065)'
 1826  .PARAM  CJD     = '0.0012557*(1 + PSVTLP_DCJB_CMOS065)'
 1827  .PARAM  CJSWD   = '3.1862E-11*(1 + PSVTLP_DCJSW_CMOS065)'
 1828  .PARAM  CJSWGD  = '1.6208E-10*(1 + PSVTLP_DCJGATE_CMOS065)'
 1829  .PARAM  JSS     = '9.9977E-15*10^PSVTLP_DIDIODE_CMOS065'
 1830  .PARAM  JSWS    = '1.7696E-14*10^PSVTLP_DIDIODE_CMOS065'
 1831  .PARAM  JSWGS   = '5.6824E-14*10^PSVTLP_DIDIODE_CMOS065'
 1832  .PARAM  JTSS    = '1.0398E-05*10^PSVTLP_DIDIODE_CMOS065'
 1833  .PARAM  JTSSWS  = '2.9147E-10*10^PSVTLP_DIDIODE_CMOS065'
 1834  .PARAM  JTSSWGS = '7.3874E-11*10^PSVTLP_DIDIODE_CMOS065'
 1835  .PARAM  JSD     = '9.9977E-15*10^PSVTLP_DIDIODE_CMOS065'
 1836  .PARAM  JSWD    = '1.7696E-14*10^PSVTLP_DIDIODE_CMOS065'
 1837  .PARAM  JSWGD   = '5.6824E-14*10^PSVTLP_DIDIODE_CMOS065'
 1838  .PARAM  JTSD    = '1.0398E-05*10^PSVTLP_DIDIODE_CMOS065'
 1839  .PARAM  JTSSWD  = '2.9147E-10*10^PSVTLP_DIDIODE_CMOS065'
 1840  .PARAM  JTSSWGD = '7.3874E-11*10^PSVTLP_DIDIODE_CMOS065'
 1841  .PARAM DAGIDL  = PSVTLP_DAGIDL_CMOS065
 1842  .PARAM DCFRING = PSVTLP_DCFRING_CMOS065
 1843  .PARAM DRDSW   = PSVTLP_DRDSW_CMOS065
 1844  
 1845  .PARAM RSH      = '15 + PSVTLP_DRSH_CMOS065'
 1846  .PARAM RCONSD  = '37.5+PSVTLP_DRCONSD_CMOS065'
 1847  .PARAM RSHG     = '15 + PSVTLP_DRSHG_CMOS065'
 1848  .PARAM RSHGUM   = '468 + PSVTLP_DRSHGU_CMOS065'
 1849  .PARAM RSHGU    = '710 + PSVTLP_DRSHGU_CMOS065'
 1850  
 1851  .PARAM RCONPO	= '37.5 + PSVTLP_DRCONPO_CMOS065'
 1852  .PARAM RHIG	= '0 + PSVTLP_DRHIG_CMOS065'
 1853  .PARAM RSD_RPO  = '265 + PSVTLP_DRSD_RPO_CMOS065'
 1854  
 1855  
 1856  * Layout and electrical dimensions:
 1857  *----------------------------------
 1858  .PARAM WM='W*TOMETER'
 1859  .PARAM LM='L*TOMETER'
 1860  .PARAM WFING='WM/NFING+XW'
 1861  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
 1862  .PARAM FS='2-FD'
 1863  .PARAM EDUM='EDU*TOMETER'
 1864  .PARAM ESUM='ESU*TOMETER'
 1865  .PARAM ADP='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(CONW/2.0+COEACT2+XW/2))'
 1866  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
 1867  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
 1868  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
 1869  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 1870  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 1871  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 1872  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 1873  .PARAM POCOSM	= 'POCOS*TOMETER'
 1874  .PARAM POCODM	= 'POCOD*TOMETER'
 1875  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
 1876  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 1877  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 1878  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
 1879  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
 1880  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
 1881  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
 1882  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 1883  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
 1884  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
 1885  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
 1886  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
 1887  
 1888  * DC Effective length and width:
 1889  *---------------------------
 1890  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1891  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1892  * AC Effective length and width:
 1893  *------------------------------
 1894  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1895  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(5E-17/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1896  *  Effective Source/Drain Junction width:
 1897  *---------------------------------------
 1898  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 1899  
 1900  
 1901  * Model improvement equations :
 1902  *------------------------------
 1903  
 1904   
 1905      * Continuous Model for mismatch deviations 
 1906  *----------------------------------------
 1907  .PARAM X_DEV        = 0.0 DEVX/GAUSS = {1.0}
 1908  .PARAM Y_DEV        = 0.0 DEVX/GAUSS = {1.0}
 1909  .PARAM Z_DEV        = 0.0 DEVX/GAUSS = {1.0}
 1910  .PARAM DVTH_AVT        = '3E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 1911  .PARAM DBETA_ABETA     = '0.53E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 1912  
 1913  
 1914  .PARAM PVT          = 4.9E-06      
 1915  .PARAM TPVT         = -0.025E-06     
 1916  .PARAM ZETAVT       = 0.94E+12
 1917  .PARAM DVTH_PVT    = '(PVT+TPVT*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETAVT*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 1918  .PARAM DVTH0_SIG = 'SQRT(DVTH_PVT*DVTH_PVT+DVTH_AVT*DVTH_AVT)'
 1919  .PARAM DVTH0_DEV = '(DVTH_AVT*X_DEV+DVTH_PVT*Y_DEV)*SVTLP_DEV*MISMATCH'
 1920  
 1921  
 1922  .PARAM PBETA        = 0.81E-05    
 1923  .PARAM TPBETA       = -0.0078E-05   
 1924  .PARAM ZETABETA     = 0.015E+12
 1925  .PARAM DBETA_PBETA = '(PBETA+TPBETA*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETABETA*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 1926  .PARAM DBETA_SIG = 'SQRT(DBETA_PBETA*DBETA_PBETA+DBETA_ABETA*DBETA_ABETA)'
 1927  .PARAM DBETA_DEV = '(DBETA_ABETA*Z_DEV+DBETA_PBETA*Y_DEV)*SVTLP_DEV*MISMATCH'
 1928  
 1929  .PARAM PROCESSSTATFLAGS = '1.0'
 1930  .PARAM DVTHTOT   = 'PSVTLP_DVTH0_CMOS065/(VALIF((PSVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((PSVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PSVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1931  .PARAM VTH     = '-0.43+PSVTLP_DVTH0_CMOS065'
 1932  
 1933  
 1934  * Equation for  AGIDL:
 1935  * --------------------
 1936  .PARAM AGIDL   = '(2.3222E-07)*10^DAGIDL'
 1937  
 1938  
 1939  * Equations for mobility :
 1940  *-------------------------
 1941  .PARAM EPSILON2 = 1E-18
 1942  .PARAM LLIMIT = '3.4199E-08-XL' 
 1943  .PARAM WLIMIT = '2.48258E-07-XW' 
 1944  .PARAM DWU = 'DWU0+(-0.3)*0.5E6*(ABS(LE-1E-07)-(LE-1E-07))' 
 1945  .PARAM MOBILITY = '2.0/(0.01486383245+(LLIMIT+XL
 1946  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.001529610171/LE)
 1947  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1948  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1949  
 1950  
 1951  
 1952  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1953  
 1954  
 1955  * Channel doping nch and body factor k1 worst case :
 1956  *---------------------------------------------------
 1957  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1958  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1959  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(3.8723E+17/NI)+0.18679+0.4'
 1960  .PARAM  K2        =  '(0.012139+-6.6409E-09/LE)*(TOX/2.4239E-09)'
 1961  .PARAM  K1        =  '(0.25156)-MOSTYPE*(-0.43-VTH)/SQRT(PHIS_TYP)'
 1962  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1963  .PARAM  NCH       =  '3.8723E+17*(K1*K1)/((0.25156)*(0.25156))'
 1964  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18679+0.4'
 1965  * Series resistance worst case :
 1966  *-------------------------------
 1967  .PARAM RDSW      =  '(312+3E-05/WE)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1968  .PARAM PRWB      =  -0.26884
 1969  
 1970  
 1971  
 1972  
 1973  
 1974  
 1975  .PARAM VSATEFF = '(1.4573E+05)'
 1976  
 1977  * Equations for stress :
 1978  *-----------------------
 1979  
 1980  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
 1981  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
 1982  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
 1983  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
 1984  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
 1985  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 1986  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 1987  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 1988  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 1989  * Stress effect on threshold voltage :
 1990  *-------------------------------------
 1991  
 1992  
 1993  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1E+12))+(1/LM -(0*NFING/WM+1E+12)))+1.3708E-09*NFING/WM+-0.0024556'
 1994  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1995  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PSVTLP_DVTH0_CMOS065+DVTHTOT'
 1996  * Stress effect on mobility :
 1997  *----------------------------
 1998  
 1999  
 2000  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-9.7441E-09)/2)*(ABS(1/LM-(-0.088*NFING/WM+3.1087E+06))-(1/LM -(-0.088*NFING/WM+3.1087E+06)))+((-6.439E-16*NFING/WM+2.9816E-09)/2)*(ABS(1/LM-(0.1532*NFING/WM +4.1101E+06))+(1/LM -(0.1532*NFING/WM+4.1101E+06)))+4.41E-10*NFING/WM+0.018161'
 2001  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2002  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 2003  * Stress effect on body factor K1 :
 2004  *----------------------------------
 2005  .PARAM VARMAXK1         = '0.00273+5.49E-10/LM+-7E-09*NFING/WM'
 2006  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2007  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 2008  * Stress effect on DVT0 :
 2009  *------------------------
 2010  .PARAM DVT0_STRESS        = 6
 2011  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 2012  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2013  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 2014  * Stress effect on access resistance :
 2015  *-------------------------------------
 2016  .PARAM VARMAXRDSW       = '0.103+-8.11E-09*NFING/WM'
 2017  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2018  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 2019  
 2020  
 2021  .PARAM NFACTOR = '(1.2065+1.2E-07/LE)*SQRT(PHIS*3.8723E+17/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 2022  
 2023  
 2024  
 2025  * Equations for VT :
 2026  *-------------------
 2027  .PARAM W0       = '4.6522E-07+(0-XW)'
 2028  .PARAM K3B      = '(7.0432)*(2.4239E-09/TOX)'
 2029  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 2030  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*3.8723E+17*1E6))'
 2031  .PARAM DVTP0    = 0
 2032  
 2033  
 2034  .PARAM N_SUBVT  = '1.0+(1.2065+1.2E-07/LE)*7.271700702E-09/XDEP0'
 2035  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+7E-07))'
 2036  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 2037  .PARAM K3       = '(-13.36+3E-07/(LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 2038  
 2039  
 2040  
 2041  * Equation for moin :
 2042  *-------------------
 2043  .PARAM MOIN = 'VALIF((10*((0.25156)/K1EFF)^2 > 5), (10*((0.25156)/K1EFF)^2), (5))'
 2044  
 2045  
 2046  * Equations for LKETA :
 2047  *---------------------
 2048  
 2049  .PARAM LKETAEXP = 'VALIF(((5.204538357E-07/LE-6311.66805) > 34), (34), (5.204538357E-07/LE-6311.66805))'
 2050  
 2051  .PARAM LKETA    = '0.00059794/(1.0+EXP(LKETAEXP))'
 2052  
 2053  
 2054  *Worst case methodology improvement: Short Channel effect
 2055  *--------------------------------------------------------
 2056  .PARAM LPE0  = '((((0.25156)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.72E-08)/(LMIN+8E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 2057  .PARAM LPEB  = '(5.9281E-08)/(LMIN+8E-09-2*LINT)*(LMIN+XL-2*LINT)'
 2058  .PARAM DVT1  = '0.077454*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 2059  .PARAM DVT1W = '1.6265E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2060  .PARAM DSUB = '(0.050016)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2061  
 2062  
 2063  
 2064  * Equations for Extrinsic Capacitances:
 2065  * ------------------------------------
 2066  
 2067  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 2068  
 2069  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 2070  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 2071  
 2072  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 2073  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 2074  
 2075  
 2076  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 2077  
 2078  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 2079  
 2080  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
 2081  
 2082  .PARAM CGSL = '((5E-11) + 1.5E-18/LM  + -1E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 2083  .PARAM CGDL = '((5E-11) + 1.5E-18/LM  + -1E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 2084  .PARAM CGSO       =  'VALIF((POCOSM>0),(6.9E-11*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),6.9E-11*(2.4239E-09/TOX))'
 2085  .PARAM CGDO       =  'VALIF((POCOSM>0),(6.9E-11*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),6.9E-11*(2.4239E-09/TOX))'
 2086  
 2087  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2088  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2089  
 2090  
 2091  
 2092  * Equations for extrinsic S/D resistances:
 2093  * ---------------------------------------
 2094  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 2095   
 2096  * Unsilicided poly gate resistance:
 2097  * --------------------------------
 2098  .PARAM RSHGUMMID = '(605+RSHGUM)/2 + (605-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
 2099  .PARAM RSHGUMEFF = 'RSHGUMMID*605*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*605)'
 2100  
 2101  
 2102  .PARAM RGATEMOD = 1
 2103  .PARAM XGWS    = 'CONRPO-COEPO'
 2104  .PARAM XGWU    = 'RPOEXTPOFLD'
 2105  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
 2106  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
 2107  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
 2108  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
 2109  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
 2110  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 2111  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
 2112  
 2113  * Unsilicided Source/Drain diffusion access resistances:
 2114  * -----------------------------------------------------
 2115  .PARAM NRSEFF    = 'NRS + (RSD_RPO*ESUM/(RSH*WE)/NFING)'
 2116  .PARAM NRDEFF    = 'NRD + (RSD_RPO*EDUM/(RSH*WE)/NFING)'
