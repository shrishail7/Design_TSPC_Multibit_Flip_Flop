 1187  
 1188  * Model improvement equations :
 1189  *------------------------------
 1190  
 1191   
 1192      * Continuous Model for mismatch deviations 
 1193  *----------------------------------------
 1194  .PARAM X_DEV        = 0.0 DEVX/GAUSS = {1.0}
 1195  .PARAM Y_DEV        = 0.0 DEVX/GAUSS = {1.0}
 1196  .PARAM Z_DEV        = 0.0 DEVX/GAUSS = {1.0}
 1197  .PARAM DVTH_AVT        = '4E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 1198  .PARAM DBETA_ABETA     = '0.46E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 1199  
 1200  
 1201  .PARAM PVT          = 8.2E-06      
 1202  .PARAM TPVT         = -0.025E-06     
 1203  .PARAM ZETAVT       = 0.018E+12
 1204  .PARAM DVTH_PVT    = '(PVT+TPVT*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETAVT*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 1205  .PARAM DVTH0_SIG = 'SQRT(DVTH_PVT*DVTH_PVT+DVTH_AVT*DVTH_AVT)'
 1206  .PARAM DVTH0_DEV = '(DVTH_AVT*X_DEV+DVTH_PVT*Y_DEV)*LVTLP_DEV*MISMATCH'
 1207  
 1208  
 1209  .PARAM PBETA        = 2.2E-05    
 1210  .PARAM TPBETA       = -0.011E-05   
 1211  .PARAM ZETABETA     = 7.9E+09
 1212  .PARAM DBETA_PBETA = '(PBETA+TPBETA*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETABETA*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 1213  .PARAM DBETA_SIG = 'SQRT(DBETA_PBETA*DBETA_PBETA+DBETA_ABETA*DBETA_ABETA)'
 1214  .PARAM DBETA_DEV = '(DBETA_ABETA*Z_DEV+DBETA_PBETA*Y_DEV)*LVTLP_DEV*MISMATCH'
 1215  
 1216  .PARAM PROCESSSTATFLAGS = '1.0'
 1217  .PARAM DVTHTOT   = 'NLVTLP_DVTH0_CMOS065/(VALIF((NLVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((NLVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NLVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NLVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1218  .PARAM VTH     = '0.243+NLVTLP_DVTH0_CMOS065'
 1219  
 1220  
 1221  * Equation for  AGIDL:
 1222  * --------------------
 1223  .PARAM AGIDL   = '(4.1681E-05)*10^DAGIDL'
 1224  
 1225  
 1226  * Equations for mobility :
 1227  *-------------------------
 1228  .PARAM EPSILON2 = 1E-18
 1229  .PARAM LLIMIT = '1.14E-07-XL' 
 1230  .PARAM WLIMIT = '4.6E-07-XW' 
 1231  .PARAM DWU = 'DWU0+(-0.45)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
 1232  .PARAM MOBILITY = '2.0/(0.00448019802+(LLIMIT+XL
 1233  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.0005198019802/LE)
 1234  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1235  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1236  
 1237  
 1238  
 1239  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NLVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1240  
 1241  
 1242  * Channel doping nch and body factor k1 worst case :
 1243  *---------------------------------------------------
 1244  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1245  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1246  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(5.2772E+17/NI)+0.25043+0.4'
 1247  .PARAM  K2        =  '(-0.027099+9.9092E-09/LE)*(TOX/2.3926E-09)'
 1248  .PARAM  K1        =  '(0.29)-MOSTYPE*(0.243-VTH)/SQRT(PHIS_TYP)'
 1249  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1250  .PARAM  NCH       =  '5.2772E+17*(K1*K1)/((0.29)*(0.29))'
 1251  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
 1252  * Series resistance worst case :
 1253  *-------------------------------
 1254  .PARAM RDSW      =  '(75)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NLVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1255  .PARAM PRWB      =  -0.5
 1256  
 1257  
 1258  
 1259  
 1260  
 1261  
 1262  * Equations for Poly spacing effect:
 1263  *-----------------------------------
 1264  .PARAM SPODEFM  = '0.2E-6'
 1265  .PARAM SPOAM    = 'VALIF((SPOA > 0),(SPOA*TOMETER),(SPODEFM))'
 1266  .PARAM SPOBM    = 'VALIF((SPOB > 0),(SPOB*TOMETER),(SPODEFM))'
 1267  .PARAM SPOM     = '2/(1/(MIN(SPOAM,SPOBM)-5E-09)+1/(MIN(SPOAM,SPOBM)-5E-09))'
 1268  .PARAM DVT_SPO_LR = '1.000*((5.361E-8/(SPOM))**4.8125-(5.361E-8/(0.2E-6-5E-09))**4.8125)'
 1269  .PARAM DVT_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DVT_SPO_LR/0.243*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DVT_SPO_LR'
 1270  .PARAM DU0_SPO_LR = '-1.000*((2.9899E-8/(SPOM))**1.859-(2.9899E-8/(0.2E-6-5E-09))**1.859)'
 1271  .PARAM DU0_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DU0_SPO_LR*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DU0_SPO_LR'
 1272  .PARAM VSATEFF = '(7.34E+05+0.00043638/LE)*(1+DU0_SPO)'
 1273  
 1274  
 1275  * Equations for stress :
 1276  *-----------------------
 1277  
 1278  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
 1279  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
 1280  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
 1281  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
 1282  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
 1283  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 1284  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 1285  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 1286  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 1287  * Stress effect on threshold voltage :
 1288  *-------------------------------------
 1289  
 1290  
 1291  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((-3.265E-16*NFING/WM+1.3814E-09)/2)*(ABS(1/LM-(0*NFING/WM+5E+06))+(1/LM -(0*NFING/WM+5E+06)))+3.5294E-10*NFING/WM+-0.0040207'
 1292  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1293  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NLVTLP_DVTH0_CMOS065+DVTHTOT+DVT_SPO'
 1294  * Stress effect on mobility :
 1295  *----------------------------
 1296  
 1297  
 1298  .PARAM VARMAXU0 	= '((4.5544E-16*NFING/WM+-1.1961E-08)/2)*(ABS(1/LM-(-0.08785*NFING/WM+5.8298E+06))-(1/LM -(-0.08785*NFING/WM+5.8298E+06)))+((1.2264E-15*NFING/WM+-1.5993E-09)/2)*(ABS(1/LM-(0.1532*NFING/WM +9.8E+06))+(1/LM -(0.1532*NFING/WM+9.8E+06)))+-3E-09*NFING/WM+0.07397'
 1299  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1300  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)*(1+DU0_SPO)'
 1301  * Stress effect on body factor K1 :
 1302  *----------------------------------
 1303  .PARAM VARMAXK1         = '-0.04+0/LM+1E-08*NFING/WM'
 1304  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1305  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 1306  * Stress effect on DVT0 :
 1307  *------------------------
 1308  .PARAM DVT0_STRESS        = -0.08067
 1309  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 1310  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1311  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 1312  * Stress effect on access resistance :
 1313  *-------------------------------------
 1314  .PARAM VARMAXRDSW       = '0.15+-5.67E-08*NFING/WM'
 1315  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1316  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 1317  
 1318  
 1319  .PARAM NFACTOR = '(0.90222+1.5331E-07/LE)*SQRT(PHIS*5.2772E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
 1320  
 1321  
 1322  
 1323  * Equations for VT :
 1324  *-------------------
 1325  .PARAM W0       = '2.2957E-08+(0-XW)'
 1326  .PARAM K3B      = '(1.5+-1.6E-07/LE)*(2.3926E-09/TOX)'
 1327  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1328  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*5.2772E+17*1E6))'
 1329  .PARAM DVTP0    = 0
 1330  
 1331  
 1332  .PARAM N_SUBVT  = '1.0+(0.90222+1.5331E-07/LE)*7.177800693E-09/XDEP0'
 1333  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+3E-06))'
 1334  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
 1335  .PARAM K3       = '(-3.5+2.5E-07/(LE*(LMIN+5E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
 1336  
 1337  
 1338  
 1339  * Equation for moin :
 1340  *-------------------
 1341  .PARAM MOIN = 'VALIF((5.8569*((0.29)/K1EFF)^2 > 5), (5.8569*((0.29)/K1EFF)^2), (5))'
 1342  
 1343  
 1344  * Equations for LKETA :
 1345  *---------------------
 1346  
 1347  
 1348  .PARAM LKETA    = 0 
 1349  
 1350  
 1351  *Worst case methodology improvement: Short Channel effect
 1352  *--------------------------------------------------------
 1353  .PARAM LPE0  = '((((0.29)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4E-12+2.1E-14/LE)/(LMIN+5E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1354  .PARAM LPEB  = '(-2.038E-07+1.5546E-14/LE)/(LMIN+5E-09-2*LINT)*(LMIN+XL-2*LINT)'
 1355  .PARAM DVT1  = '0.0233*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1356  .PARAM DVT1W = '7E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1357  .PARAM DSUB = '(0.62286)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1358  
 1359  
 1360  
 1361  * Equations for Extrinsic Capacitances:
 1362  * ------------------------------------
 1363  
 1364  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 1365  
 1366  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 1367  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 1368  
 1369  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 1370  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 1371  
 1372  
 1373  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 1374  
 1375  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 1376  
 1377  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
 1378  
 1379  .PARAM CGSL = '((6.9E-11) + 6.8943E-18/LM  + -3.2394E-25/LM^2 + -8.23E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
 1380  .PARAM CGDL = '((6.9E-11) + 6.8943E-18/LM  + -3.2394E-25/LM^2 + -8.23E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
 1381  .PARAM CGSO       =  'VALIF((POCOSM>0),(2.1E-11*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),2.1E-11*(2.3926E-09/TOX))'
 1382  .PARAM CGDO       =  'VALIF((POCOSM>0),(2.1E-11*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),2.1E-11*(2.3926E-09/TOX))'
 1383  
 1384  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1385  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1386  
 1387  
 1388  
 1389  * Equations for extrinsic S/D resistances:
 1390  * ---------------------------------------
 1391  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
 1392   
 1393  * Unsilicided poly gate resistance:
 1394  * --------------------------------
 1395  .PARAM RSHGUMMID = '(585+RSHGUM)/2 + (585-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
 1396  .PARAM RSHGUMEFF = 'RSHGUMMID*585*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*585)'
 1397  
 1398  
 1399  .PARAM RGATEMOD = 1
 1400  .PARAM XGWS    = 'CONRPO-COEPO'
 1401  .PARAM XGWU    = 'RPOEXTPOFLD'
 1402  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
 1403  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
 1404  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
 1405  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
 1406  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
 1407  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 1408  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
 1409  
 1410  * Unsilicided Source/Drain diffusion access resistances:
 1411  * -----------------------------------------------------
 1412  .PARAM NRSEFF    = 'NRS + (RSD_RPO*ESUM/(RSH*WE)/NFING)'
 1413  .PARAM NRDEFF    = 'NRD + (RSD_RPO*EDUM/(RSH*WE)/NFING)'
 1414  
 1415  
 1416  
 1417  * Equations for VOFF:
 1418  * ------------------
 1419  
 1420  .PARAM VOFF = '-0.14445 + -0.14555*(TEMPK/(25+273.15) -1)' 
 1421  
 1422  
 1423  
 1424  * Equations for temperature dependance of BGIDL:
 1425  * --------------------------------------------
 1426  .PARAM BGIDL = '4.927E+09 + -1.198E+09*(TEMPK/(25+273.15) -1)'
 1427  
 1428  
 1429  * Equations for temperature dependence of series resistances:
 1430  * -----------------------------------------------------------
 1431  .PARAM RDWMIN = 0
 1432  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 1433  .PARAM RSWMIN = 0
 1434  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 1435  .PARAM RDSWMIN = 0
 1436  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 1437  .PARAM RSW = 0
 1438  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 0*(TEMPK/(25+273.15) -1)), (0))'
 1439  .PARAM RDW = 0
 1440  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 0*(TEMPK/(25+273.15) -1)), (0))'
 1441  .PARAM RDSWEFF2 = '(RDSWEFF + 0*(TEMPK/(25+273.15) -1))'
 1442  .PARAM PRT = 0
