  551  .SETSOA LABEL="N1 ==> Isolation safe voltage ranges violation" E V(G,D)=(-1.32,1.32) 
  552  .SETSOA LABEL="N2 ==> Isolation safe voltage ranges violation" E V(G,S)=(-1.32,1.32) 
  553  .SETSOA LABEL="N3 ==> Isolation safe voltage ranges violation : Gate oxide limitation with and without channel presence" E IF (V(G,B)-VT(M1)<0) THEN V(G,B)=(-1.32,1.32) ELSE V(G,B)=(-2.64,2.64) ENDIF 
  554  .SETSOA LABEL="N4 ==> Isolation safe voltage ranges violation" E V(D,S)=(-1.32,1.32) 
  555  .SETSOA LABEL="N5a ==> Isolation safe voltage ranges violation : D/B diode limitation in reverse bias" E V(B,D)=(-2.64,*) 
  556  .SETSOA LABEL="N5b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when D/B diode in forward bias" E V(B,D)=(*,0.33) 
  557  .SETSOA LABEL="N6a ==> Isolation safe voltage ranges violation : S/B diode limitation in reverse bias" E V(B,S)=(-2.64,*) 
  558  .SETSOA LABEL="N6b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when S/B diode in forward bias" E V(B,S)=(*,0.33) 
  559  .SETSOA LABEL="N7 ==> Isolation safe voltage ranges violation : MOS HCI limitation on D side" E IF (V(G,S)-VT(M1)>0) && (V(D,S)>0.2) THEN V(B,D)=(-1.4,0.2) ENDIF 
  560  .SETSOA LABEL="N8 ==> Isolation safe voltage ranges violation : MOS HCI limitation on S side" E IF (V(G,D)-VT(M1)>0) && (V(D,S)<-0.2) THEN V(B,S)=(-1.4,0.2) ENDIF 
