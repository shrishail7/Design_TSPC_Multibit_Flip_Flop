 2162  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.2E-01*1.2E-01+1.3E-07*1.3E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 2163  .PARAM NOIC    = '(5E+09)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.2E-01*1.2E-01+1.3E-07*1.3E-07/(WM*LM*MULT))*DNOISE_MDEV)'
