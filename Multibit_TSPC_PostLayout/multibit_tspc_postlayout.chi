  606  
  607  * Equations for mismatch deviations:
  608  *-----------------------------------
  609  .PARAM DVTH0_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(4.5E-9),(5.8E-9))
  610  .PARAM DVTH0_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  611  .PARAM DVTH0_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
  612  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
  613  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMDPSVTLP_DEV*MISMATCH}
  614  .PARAM DBETA_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.69E-8),(0.52E-8))
  615  .PARAM DBETA_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  616  .PARAM DBETA_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.153))
  617  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
  618  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMDPSVTLP_DEV*MISMATCH}
  619  
  620  
  621  .PARAM PROCESSSTATFLAGS = '1.0'
  622  .PARAM DVTHTOT   = 'NSVTLPPGDP_DVTH0_CMOS065/(VALIF((NSVTLPPGDP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTLPPGDP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMDPSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTLPPGDP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  623  .PARAM VTH     = '0.45039+NSVTLPPGDP_DVTH0_CMOS065'
  624  
  625  
  626  * Equation for  AGIDL:
  627  * --------------------
  628  .PARAM AGIDL   = '(0.00014407)*10^DAGIDL'
  629  
  630  
  631  * Equations for mobility :
  632  *-------------------------
  633  .PARAM EPSILON2 = 1E-18
  634  .PARAM LLIMIT = '7.6175E-08-XL' 
  635  .PARAM WLIMIT = '2.38336E-07-XW' 
  636  .PARAM DWU = 'DWU0+(7.7762)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
  637  .PARAM MOBILITY = '2.0/(0.007130730051+(LLIMIT+XL
  638  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.003621958121/LE)
  639  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  640  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  641  
  642  
  643  
  644  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSRAMDPSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  645  
  646  
  647  * Channel doping nch and body factor k1 worst case :
  648  *---------------------------------------------------
  649  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  650  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  651  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(7.863E+17/NI)+0.25043+0.4'
  652  .PARAM  K2        =  '(0.024422+-5.2602E-09/LE)*(TOX/2.3926E-09)'
  653  .PARAM  K1        =  '(0.35383)-MOSTYPE*(0.45039-VTH)/SQRT(PHIS_TYP)'
  654  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  655  .PARAM  NCH       =  '7.863E+17*(K1*K1)/((0.35383)*(0.35383))'
  656  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  657  * Series resistance worst case :
  658  *-------------------------------
  659  .PARAM RDSW      =  '(707.87+-4.2669E-05/LE+-0.00010948/WE+9.5E-12/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSRAMDPSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  660  .PARAM PRWB      =  0.057545
  661  
  662  
  663  
  664  
  665  
  666  .PARAM  VTH0EFF   =  'VTH0-NSVTLPPGDP_DVTH0_CMOS065+DVTHTOT'
  667  .PARAM U0EFF            = U0
  668  .PARAM K1EFF		= K1
  669  .PARAM DVT0EFF		= -0.03
  670  .PARAM RDSWEFF0          = RDSW 
  671  .PARAM VSATEFF = '(1.22E+05)'
  672  
  673  
  674  .PARAM NFACTOR = '(1.3251)*SQRT(PHIS*7.863E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
  675  
  676  
  677  
  678  * Equations for VT :
  679  *-------------------
  680  .PARAM W0       = '2.2957E-08+(0-XW)'
  681  .PARAM K3B      = '(3+-1.7E-07/LE)*(2.3926E-09/TOX)'
  682  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  683  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*7.863E+17*1E6))'
  684  .PARAM DVTP0    = 0
  685  
  686  
  687  .PARAM N_SUBVT  = '1.0+(1.3251)*7.177800693E-09/XDEP0'
  688  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.3E-06))'
  689  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
  690  .PARAM K3       = '(-5.8321)*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
  691  
  692  
  693  
  694  * Equation for moin :
  695  *-------------------
  696  .PARAM MOIN = 'VALIF((5.8569*((0.35383)/K1EFF)^2 > 5), (5.8569*((0.35383)/K1EFF)^2), (5))'
  697  
  698  
  699  * Equations for LKETA :
  700  *---------------------
  701  
  702  
  703  .PARAM LKETA    = '0.0087889 + -0.01*(TEMPK/(25+273.15) -1)'
  704  
  705  
  706  *Worst case methodology improvement: Short Channel effect
  707  *--------------------------------------------------------
  708  .PARAM LPE0  = '((((0.35383)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(3E-08+6E-15/LE)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  709  .PARAM LPEB  = '(0)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
  710  .PARAM DVT1  = '0.032462*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  711  .PARAM DVT1W = '8.598E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  712  .PARAM DSUB = '(0.73367)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  713  
  714  
  715  
  716  * Equations for Extrinsic Capacitances:
  717  * ------------------------------------
  718  
  719  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  720  
  721  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  722  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  723  
  724  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  725  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  726  
  727  
  728  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  729  
  730  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  731  
  732  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
  733  
  734  .PARAM CGSL = '(7.3597E-11)*(2.3926E-09/TOX)'
  735  .PARAM CGDL = '(7.3597E-11)*(2.3926E-09/TOX)'
  736  .PARAM CGSO       =  '1E-10*(2.3926E-09/TOX)'
  737  .PARAM CGDO       =  '1E-10*(2.3926E-09/TOX)'
  738  
  739  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  740  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  741  
  742  
  743  
  744  * Equations for extrinsic S/D resistances:
  745  * ---------------------------------------
  746  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*70*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(0*CONPO*NFING/WM)'
  747  
  748  
  749  
  750  * Salicided poly gate resistance:
  751  * ------------------------------
  752  
  753  .PARAM RGATEMOD = 0
  754  .PARAM RSHG0    = 0
  755  
  756  * Salicided Source/Drain diffusion access resistances:
  757  * ---------------------------------------------------
  758  .PARAM NRSEFF    = 'NRS'
  759  .PARAM NRDEFF    = 'NRD'
  760  
  761  
  762  
  763  * Equations for VOFF:
  764  * ------------------
  765  
  766  .PARAM VOFF = '-0.059216 + -0.14555*(TEMPK/(25+273.15) -1)' 
  767  
  768  
  769  
  770  * Equations for temperature dependance of BGIDL:
  771  * --------------------------------------------
  772  .PARAM BGIDL = '7.8683E+09 + -1.198E+09*(TEMPK/(25+273.15) -1)'
  773  
  774  
  775  * Equations for temperature dependence of series resistances:
  776  * -----------------------------------------------------------
  777  .PARAM RDWMIN = 0
  778  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 450*(TEMPK/(25+273.15) -1)), (0))'
  779  .PARAM RSWMIN = 0
  780  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 450*(TEMPK/(25+273.15) -1)), (0))'
  781  .PARAM RDSWMIN = 0
  782  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 450*(TEMPK/(25+273.15) -1)), (0))'
  783  .PARAM RSW = 0
  784  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 450*(TEMPK/(25+273.15) -1)), (0))'
  785  .PARAM RDW = 0
  786  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 450*(TEMPK/(25+273.15) -1)), (0))'
  787  .PARAM RDSWEFF2 = '(RDSWEFF + 450*(TEMPK/(25+273.15) -1))'
  788  .PARAM PRT = 0
  789  
  790  
  791  * Equations for thermal noise scaling
  792  * ------------------------------------
  793  .PARAM NTNOI = '1*LE/LEC'
  794  
