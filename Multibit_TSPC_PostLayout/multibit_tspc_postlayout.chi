  330  .PARAM RDSWMIN = 0
  331  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 450*(TEMPK/(25+273.15) -1)), (0))'
  332  .PARAM RSW = 0
  333  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 450*(TEMPK/(25+273.15) -1)), (0))'
  334  .PARAM RDW = 0
  335  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 450*(TEMPK/(25+273.15) -1)), (0))'
  336  .PARAM RDSWEFF2 = '(RDSWEFF + 450*(TEMPK/(25+273.15) -1))'
  337  .PARAM PRT = 0
