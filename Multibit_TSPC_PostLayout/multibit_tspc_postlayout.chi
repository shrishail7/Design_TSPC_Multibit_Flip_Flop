 3979  .PARAM WGCV    = 'WM/NFING+XW+-1.6E-08-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3980  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3981  .PARAM LGCV    = 'LM+XL+-3.4E-08-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3982  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3983  *  Effective Source/Drain Junction width:
 3984  *---------------------------------------
 3985  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 3986  
 3987  
 3988  * Model improvement equations :
 3989  *------------------------------
 3990  
 3991   
 3992  * Continuous Model for mismatch deviations:
 3993  *----------------------------------------
 3994  .PARAM DVTH0_SIG = '(4E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT(WM*(LM+XL)))/SQRT(2.0*MULT)'
 3995  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*LVTLP_DEV*MISMATCH}
 3996  .PARAM DBETA_SIG = '(0.46E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT(WM*(LM+XL)))/SQRT(2.0*MULT)'
 3997  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*LVTLP_DEV*MISMATCH}
 3998  .PARAM PROCESSSTATFLAGS = '1.0'
 3999  .PARAM DVTHTOT   = 'MOSTYPE*DVTHFACT*NLVTLP_DVTH0_CMOS065/(VALIF((NLVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((DVTHFACT*NLVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NLVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(DVTHFACT*NLVTLP_DVTH0_CMOS065)^2)+DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS+DVTH0_DEV*MFLAG_MC'
 4000  .PARAM DVTH    = 'MOSTYPE*DVTHFACT*NLVTLP_DVTH0_CMOS065'
 4001  
 4002  
 4003  
 4004  * Selection of the WPE model parameter values depending on the netlist extraction:
 4005  * -------------------------------------------------------------------------------
 4006  .PARAM WPEMOD    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1),(1))'
 4007  .PARAM KVTH0WE   = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0.008439+-3.265E-10/LE+-4.246E-09/WE+2.287E-16/(LE*WE))),((7.943001E-3+-2.437907E-10/LE+5.294195E-11/WE)))'
 4008  .PARAM K2WE      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0+0.0/LE+0.0/WE+0.0/(LE*WE))),((5.10249E-3+-4.810027E-11/LE+5.294195E-11/WE)))'
 4009  .PARAM SCREF     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1E-06),(1E-06))'
 4010  .PARAM KU0WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((5.126E-05+1.668E-11/LE+-5.689E-10/WE+5.348E-17/(LE*WE))),((-3.259336E-3+3.23339E-10/LE+-4.397753E-10/WE)))'
 4011  .PARAM WEB       = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
 4012  .PARAM WEC2      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
 4013  .PARAM DVTH0_WPE = 'MOSTYPE*WPEMOD*KVTH0WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
 4014  .PARAM DK2_WPE   = 'WPEMOD*K2WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
 4015  .PARAM DU0_WPE   = 'WPEMOD*KU0WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
 4016  
 4017  
 4018  
 4019  * Equations for stress :
 4020  *-----------------------
 4021  
 4022  .PARAM C_1       = 'CONW+COEACT2+CONPO'
 4023  .PARAM C_2       = C_1
 4024  .PARAM B_1       = '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
 4025  .PARAM B_2       = B_1 
 4026  .PARAM CEFF      = '2/(1/C_1+1/C_2)'
 4027  .PARAM BEFF      = '2/(1/B_1+1/B_2)'
 4028  .PARAM PO2ACTEFFM = 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 4029  .PARAM PO2ACTCALM = 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 4030  * Stress effect on threshold voltage :
 4031  *-------------------------------------
 4032  
 4033  
 4034  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((-3.265E-16*NFING/WM+1.3814E-09)/2)*(ABS(1/LM-(0*NFING/WM+5E+06))+(1/LM -(0*NFING/WM+5E+06)))+3.5294E-10*NFING/WM+-0.0040207'
 4035  .PARAM DVTH0_MECHSTRESS = 'MOSTYPE*VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)-MOSTYPE*DVTHFACT*NLVTLP_DVTH0_CMOS065+DVTHTOT'
 4036  * Stress effect on mobility :
 4037  *----------------------------
 4038  
 4039  
 4040  .PARAM VARMAXU0 	= '((4.5544E-16*NFING/WM+-1.1961E-08)/2)*(ABS(1/LM-(-0.08785*NFING/WM+5.8298E+06))-(1/LM -(-0.08785*NFING/WM+5.8298E+06)))+((1.2264E-15*NFING/WM+-1.5993E-09)/2)*(ABS(1/LM-(0.1532*NFING/WM +9.8E+06))+(1/LM -(0.1532*NFING/WM+9.8E+06)))+-3E-09*NFING/WM+0.07397'
 4041  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 4042  * Stress effect on body factor K1 :
 4043  *----------------------------------
 4044  .PARAM VARMAXK1         = '-0.04+0/LM+1E-08*NFING/WM'
 4045  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 4046  * Stress effect on DVT0 :
 4047  *------------------------
 4048  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 4049  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 4050  * Stress effect on access resistance :
 4051  *-------------------------------------
 4052  .PARAM VARMAXRDSW       = '0.15+-5.67E-08*NFING/WM'
 4053  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)' 
 4054  
 4055  
 4056  * Equations for mobility :
 4057  *-------------------------
 4058  .PARAM MOBILITY = '0.0448269*(1+DU0_WPE)*(1+DU0_MECHSTRESS)'
 4059  
 4060  
 4061  
 4062  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NLVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 4063  
 4064  
 4065  * Channel doping nch and body factor k1 worst case :
 4066  *---------------------------------------------------
 4067  .PARAM LE_TYP   = 'LE'
 4068  .PARAM WE_TYP   = 'WE'
 4069  .PARAM SCE_TERM = '1-0.10395*(1E-6/LE_TYP)--0.00270864*(1E-6/LE_TYP)**2'
 4070  .PARAM NSUBOTYP = '1.03781E+23*MAX((1+-0.0139217*1E-6/WE_TYP*LOG(1+WE_TYP/8.98534E-10)),1E-3)'
 4071  .PARAM NSUBOEFF = '1.03781E+23*MAX((1+-0.0139217*1E-6/WE*LOG(1+WE/8.98534E-10)),1E-3)'
 4072  .PARAM NPCKTYP  = '6.34706E+23*MAX((1+0*1E-6/WE_TYP*LOG(1+WE_TYP/9.97308E-07)),1E-3)'
 4073  .PARAM NPCKEFF  = '6.34706E+23*MAX((1+0*1E-6/WE*LOG(1+WE/9.97308E-07)),1E-3)'
 4074  .PARAM LPCKTYP  = '5.18669E-09*MAX((1+0*1E-6/WE_TYP*LOG(1+WE_TYP/9.97308E-07)),1E-3)'
 4075  .PARAM LPCKEFF  = '5.18669E-09*MAX((1+0*1E-6/WE*LOG(1+WE/9.97308E-07)),1E-3)'
 4076  .PARAM BOVA_TYP = '(SQRT(NSUBOTYP+0.5*NPCKTYP)-SQRT(NSUBOTYP))/7.5E10'
 4077  .PARAM BOVA     = '(SQRT(NSUBOEFF+0.5*NPCKEFF)-SQRT(NSUBOEFF))/7.5E10'
 4078  .PARAM NEFF_TYP = 'SCE_TERM*VALIF( LE_TYP<LPCKTYP, NSUBOTYP+NPCKTYP*(2-LE_TYP/LPCKTYP), (VALIF( LE_TYP<(2*LPCKTYP), NSUBOTYP+NPCKTYP*LPCKTYP/LE_TYP, (SQRT(NSUBOTYP)+7.5E10*LOG(1+2*LPCKTYP/LE_TYP*(EXP(BOVA_TYP)-1)))**2 )) )'
 4079  .PARAM NSUB     = 'VALIF( LE<LPCKEFF, NSUBOEFF+NPCKEFF*(2-LE/LPCKEFF), (VALIF( LE<(2*LPCKEFF), NSUBOEFF+NPCKEFF*LPCKEFF/LE, (SQRT(NSUBOEFF)+7.5E10*LOG(1+2*LPCKEFF/LE*(EXP(BOVA)-1)))**2 )) )'
 4080  .PARAM EGOVQ    = '1.179-9.025E-5*TEMPK-3.05E-7*TEMPK^2'
 4081  .PARAM PHIBFACT = '(1.045+4.5E-4*TEMPK)*(0.523+1.4E-3*TEMPK-1.48E-6*TEMPK^2)*(TEMPK/300)^2'
 4082  .PARAM PHIT_CL  = '1.3806505E-23*TEMPK/1.6021918E-19'
 4083  .PARAM PHIS0_CL = 'EGOVQ + 2*PHIT_CL*LOG(NEFF_TYP/(2.5E25*PHIBFACT^0.75))'
 4084  .PARAM GAMMA0_CL= 'SQRT(2*1.6021918E-19*1.045E-10*NEFF_TYP)/(3.453E-11/2.19039E-09)'
 4085  
 4086  .PARAM DPHIB    = '(0+0*(1E-6/LE_TYP)**1)*(1+0*(1E-6/WE_TYP))*(1+0*(1E-12/LE_TYP/WE_TYP))'
 4087  .PARAM DELTAQ   = '0.4*1*5.951993*(GAMMA0_CL*SQRT(PHIS0_CL+DPHIB)*3.453E-11/2.19039E-09)**(2.0/3.0)'
 4088  .PARAM PHIT     = 'PHIT_CL*(1+(0.75*DELTAQ+DPHIB)/PHIS0_CL)'
 4089  .PARAM PHIS0    = 'EGOVQ + 2*PHIT*LOG(NEFF_TYP/(2.5E25*PHIBFACT^0.75))'
 4090  .PARAM GAMMA0   = 'GAMMA0_CL*(1+DELTAQ/(GAMMA0_CL*SQRT(PHIS0_CL+DPHIB)))'
 4091  .PARAM A        = '2.0*PHIT*GAMMA0/SQRT(PHIS0) - 2.0*PHIT'
 4092  .PARAM C        = 'GAMMA0*SQRT(PHIS0) + 6.0*PHIT'
 4093  .PARAM NSUBO    = 'NSUB*( ((A-C)+SQRT((A+C)^2+4.0*A*(DVTH+0.29*DK1_MECHSTRESS*(SQRT(1+(4E-12+2.1E-14/LE)/LE)-1)*SQRT(PHIS0))))/2.0/A )^2'
 4094  .PARAM NPCK     = '0'
 4095  .PARAM LPCK     = '5.18669E-09'
 4096  
 4097  .PARAM DVFB     = '(1+-0.0243527*1E-6/LE)*(1+0*1E-6/WE)*(1+0.001*1E-12/(WE*LE))'
 4098  .PARAM VFBO     = '-0.921516+(DVTH0_WPE+DVTH0_MECHSTRESS)/DVFB'
 4099  .PARAM FTOX     = 'TOX/2.19039E-09'
 4100  * Series resistance worst case :
 4101  *-------------------------------
 4102  .PARAM RSW1      =  '39.3088*(1+DRDSW_MECHSTRESS)'
 4103  .PARAM RSW1EFF0  =  'RSW1*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NLVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 4104  
 4105  
 4106  * Equations for Extrinsic Capacitances:
 4107  * ------------------------------------
 4108  
 4109  .PARAM CFRW = '2.7435E-16/FTOX'
 4110  
 4111  
 4112  .PARAM LOV = '1.87E-09'
 4113  
 4114  
 4115  
 4116  * Equations for extrinsic S/D resistances:
 4117  * ---------------------------------------
 4118  .PARAM RSW1EFF    = 'RSW1EFF0 - LPER*RCONSD*WE*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12))'
 4119  
 4120  
 4121  
 4122  * Salicided poly gate resistance:
 4123  * ------------------------------
 4124  
 4125  .PARAM RGATEMOD = 0
 4126  .PARAM RSHG0    = 15.014
 4127  
 4128  * Salicided Source/Drain diffusion access resistances:
 4129  * ---------------------------------------------------
 4130  .PARAM NRSEFF    = 'NRS'
 4131  .PARAM NRDEFF    = 'NRD'
 4132  
 4133  
 4134  
 4135  * Equations for poly gate resistance:
 4136  * -----------------------------------
 4137  .PARAM XGW        = 1.0E-07
 4138  .PARAM XGL        = -2.674E-08
 4139  .PARAM TC1G       = 2.3E-03
 4140  .PARAM TC2G       = 0
 4141  .PARAM TC1GV      = 0
 4142  .PARAM TC2GV      = 0
 4143  .PARAM LHEAD      = 'MAX(NFING*CONW+(NFING-1)*CONS+2*COEPO,NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS)))'
 4144  .PARAM NCHEAD     = 'NCRG*(1+TRUNC(((LHEAD-CONW-2*COEPO)/(CONW+CONS))+1E-12))'
 4145  .PARAM RGCON      = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 4146  .PARAM RSHGT      = 'MAX(1E-6,RSHG*(1+(TC1G+TC2G*(EFFTEMP-25))*(EFFTEMP-25)))'
 4147  .PARAM RSHGVT     = 'MAX(1E-6,RSHGV*(1+(TC1GV+TC2GV*(EFFTEMP-25))*(EFFTEMP-25)))'
 4148  .PARAM RGELTD     = 'RSHGT*(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*NFING)+RSHGVT*1E-12/((LM+XL)*(WM/NFING+XW)*NFING)'
 4149  .PARAM RG         = '(RGELTD+RGCON)'
 4150  
 4151  * Equations for bulk resistance:
 4152  * ------------------------------
 4153  .PARAM RSTI       = '(RSTIR+RSTIL*WM/(12*NFING*(LM+XBL)))/NFING'
 4154  .PARAM RBSD       = '(RBSDR*1E-6)/(WM)'
 4155  .PARAM RBULKO     = 'RBGBL*1E-6/LM'
 4156  .PARAM RWELLO     = 'RSTI*NFING'
 4157  .PARAM RJUNSO     = 'RBSD*NFING/2'
 4158  .PARAM RJUNDO     = 'RBSD*NFING/2'
 4159  
 4160  * Equations for parasitic capacitances:
 4161  * -------------------------------------
 4162  .PARAM CGD_PLS    = '((NFING+FD)/2*CGXM0 + (NFING+FD)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FD*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 4163  .PARAM CGS_PLS    = '((NFING+FS)/2*CGXM0 + (NFING+FS)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FS*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 4164  .PARAM CDS_PLS    = '(CDSM1+CDSM1W*WFING)*NFING/(LM+2*CONPO)'
 4165  .PARAM CGDM	  = '(1-LPEC)*CGD_PLS*WEC*NFING '
 4166  .PARAM CGSM	  = '(1-LPEC)*CGS_PLS*WEC*NFING '
 4167  .PARAM CFLM       = 'CFLM0*LOG((1+0.5*(MIN(LM+XL,LMAXCF))/(CONPO-XL/2))/(1+0.5*(LMIN+XL)/(CONPO-XL/2)))'
 4168  .PARAM CFWM       = 'CFWM0*NGCON/WEC'
 4169  .PARAM CDSM       = 'CDSM0*(LMIN+2.0*CDSML)/(LM+2.0*CDSML)*(WM/NFING)*NFING+(1-LPEC)*CDS_PLS'
 4170  .PARAM CBDM       = 'CBXM0*(WM/NFING)*FD'
 4171  .PARAM CBSM       = 'CBXM0*(WM/NFING)*FS'
 4172  
 4173  
 4174  
 4175  * Equations for Flicker Noise Local Variations
 4176  * --------------------------------------------
 4177  
 4178  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
 4179  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
 4180  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
 4181  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
 4182  .PARAM NOIA    = '((TANH((LE-1E-07)*1.1E+06))*(2.8836E+26)/2+4.806E+25)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 4183  .PARAM NOIB    = '0*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 4184  .PARAM NOIC    = '0*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 4185  
 4186  
 4187  
 4188  * Netlist:
 4189  *---------
 4190  
 4191  M1 D  G  S  B  NLVTLP W='WM/NFING' L=LM ABSOURCE='ASM/NFING' ABDRAIN='ADM/NFING' LSSOURCE='PSM/NFING' LSDRAIN='PDM/NFING'
 4192  +              LGSOURCE='WE' LGDRAIN='WE' M='MULT*NFING' T=EFFTEMP
 4193  
 4194  
 4195  CDSMET  D  S   '1E-30+CDSM*MULT'
 4196  CBDMET  B  D   '1E-30+CBDM*MULT'
 4197  CBSMET  B  S   '1E-30+CBSM*MULT'
 4198  CGDMET  G  D   '1E-30+CGDM*MULT'
 4199  CGSMET  G  S   '1E-30+CGSM*MULT'
 4200  
 4201  
