 1415  .PARAM LPE0  = '((((0.44634)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(2.6165E-08)/(LMIN+-4E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1416  .PARAM LPEB  = '(0)/(LMIN+-4E-09-2*LINT)*(LMIN+XL-2*LINT)'
