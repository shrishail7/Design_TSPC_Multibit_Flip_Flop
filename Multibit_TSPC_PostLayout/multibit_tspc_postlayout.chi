 4576  
 4577  
 4578  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1E+12))+(1/LM -(0*NFING/WM+1E+12)))+1.2173E-09*NFING/WM+-0.0010491'
 4579  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 4580  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PLVTLP_DVTH0_CMOS065+DVTHTOT'
 4581  * Stress effect on mobility :
 4582  *----------------------------
 4583  
 4584  
 4585  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-9.7441E-09)/2)*(ABS(1/LM-(-0.088*NFING/WM+3.1087E+06))-(1/LM -(-0.088*NFING/WM+3.1087E+06)))+((-2.2734E-16*NFING/WM+1.4902E-10)/2)*(ABS(1/LM-(0.1532*NFING/WM +4.1101E+06))+(1/LM -(0.1532*NFING/WM+4.1101E+06)))+4.41E-10*NFING/WM+0.018161'
 4586  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 4587  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 4588  * Stress effect on body factor K1 :
 4589  *----------------------------------
 4590  .PARAM VARMAXK1         = '0.00273+5.49E-10/LM+-7E-09*NFING/WM'
 4591  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 4592  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 4593  * Stress effect on DVT0 :
 4594  *------------------------
 4595  .PARAM DVT0_STRESS        = 26.9
 4596  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 4597  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 4598  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 4599  * Stress effect on access resistance :
 4600  *-------------------------------------
 4601  .PARAM VARMAXRDSW       = '0.103+-8.11E-09*NFING/WM'
 4602  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 4603  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 4604  
 4605  
 4606  .PARAM NFACTOR = '(0.95946+1.6338E-07/LE+-1.6E-14/(LE*WE))*SQRT(PHIS*2.6962E+17/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 4607  
 4608  
 4609  
 4610  * Equations for VT :
 4611  *-------------------
 4612  .PARAM W0       = '4.6522E-07+(0-XW)'
 4613  .PARAM K3B      = '(3)*(2.4239E-09/TOX)'
 4614  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 4615  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*2.6962E+17*1E6))'
 4616  .PARAM DVTP0    = 0
 4617  
 4618  
 4619  .PARAM N_SUBVT  = '1.0+(0.95946+1.6338E-07/LE+-1.6E-14/(LE*WE))*7.271700702E-09/XDEP0'
 4620  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.9752E-06))'
 4621  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 4622  .PARAM K3       = '(-8+1E-07/(LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT))+2E-13/((LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT))*WE))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 4623  
 4624  
 4625  
 4626  * Equation for moin :
 4627  *-------------------
 4628  .PARAM MOIN = 'VALIF((10*((0.21)/K1EFF)^2 > 5), (10*((0.21)/K1EFF)^2), (5))'
 4629  
 4630  
 4631  * Equations for LKETA :
 4632  *---------------------
 4633  
 4634  
 4635  .PARAM LKETA    = 0.002 
 4636  
 4637  
 4638  *Worst case methodology improvement: Short Channel effect
 4639  *--------------------------------------------------------
 4640  .PARAM LPE0  = '((((0.21)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1E-12+3.1E-15/LE)/(LMIN+8E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 4641  .PARAM LPEB  = '(1.0013E-07+1.8804E-14/LE)/(LMIN+8E-09-2*LINT)*(LMIN+XL-2*LINT)'
 4642  .PARAM DVT1  = '1.3*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 4643  .PARAM DVT1W = '3E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 4644  .PARAM DSUB = '(0.019282)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 4645  
 4646  
 4647  
 4648  * Equations for Extrinsic Capacitances:
 4649  * ------------------------------------
 4650  
 4651  .PARAM CF = '(0)*(1 + DCFRING)'
 4652  .PARAM CGBO = '5.00E-10*(1 + DCFRING)'
 4653  
 4654  
 4655  .PARAM CGSL = '((1.40402E-10) + 0/LM  + 0/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 4656  .PARAM CGDL = '((1.40402E-10) + 0/LM  + 0/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 4657  .PARAM CGSO       =  '1.5623E-10*(2.4239E-09/TOX)'
 4658  .PARAM CGDO       =  '1.5623E-10*(2.4239E-09/TOX)'
 4659  
 4660  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 4661  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 4662  
 4663  
 4664  
 4665  * Equations for extrinsic S/D resistances:
 4666  * ---------------------------------------
 4667  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 4668  
 4669  
 4670  
 4671  * Salicided poly gate resistance:
 4672  * ------------------------------
 4673  
 4674  .PARAM RGATEMOD = 0
 4675  .PARAM RSHG0    = 16.043
 4676  
 4677  * Salicided Source/Drain diffusion access resistances:
 4678  * ---------------------------------------------------
 4679  .PARAM NRSEFF    = 'NRS'
 4680  .PARAM NRDEFF    = 'NRD'
 4681  
 4682  
 4683  
 4684  * Equations for poly gate resistance:
 4685  * -----------------------------------
 4686  .PARAM XGW        = 1.0E-07
 4687  .PARAM XGL        = -3.376E-08
 4688  .PARAM TC1G       = 2.3E-03
 4689  .PARAM TC2G       = 0
 4690  .PARAM TC1GV      = 0
 4691  .PARAM TC2GV      = 0
 4692  .PARAM LHEAD      = 'MAX(NFING*CONW+(NFING-1)*CONS+2*COEPO,NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS)))'
 4693  .PARAM NCHEAD     = 'NCRG*(1+TRUNC(((LHEAD-CONW-2*COEPO)/(CONW+CONS))+1E-12))'
 4694  .PARAM RGCON      = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 4695  .PARAM RSHGT      = 'MAX(1E-6,RSHG*(1+(TC1G+TC2G*(EFFTEMP-25))*(EFFTEMP-25)))'
 4696  .PARAM RSHGVT     = 'MAX(1E-6,RSHGV*(1+(TC1GV+TC2GV*(EFFTEMP-25))*(EFFTEMP-25)))'
 4697  .PARAM RGELTD     = 'RSHGT*(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*NFING)+RSHGVT*1E-12/((LM+XL)*(WM/NFING+XW)*NFING)'
 4698  .PARAM RGBSIM4    = '(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*1)'
 4699  .PARAM RSHGEFF    = '(RGELTD+RGCON)/RGBSIM4*NFING'
 4700  
 4701  * Equations for bulk resistance:
 4702  * ------------------------------
 4703  .PARAM RSTI       = '(RSTIR+RSTIL*WM/(12*NFING*(LM+XBL)))/NFING'
 4704  .PARAM RBSD       = '(RBSDR*1E-6)/(WM)'
 4705  .PARAM RBODYMOD   = 1
 4706  .PARAM RBPB       = 'RBGBL*1E-6/LM'
 4707  .PARAM RBPD       = 1E+09
 4708  .PARAM RBPS       = 1E+09
 4709  .PARAM RBDB       = 'RBSD*NFING/2'
 4710  .PARAM RBSB       = 'RBSD*NFING/2'
 4711  
 4712  * Equations for parasitic capacitances:
 4713  * -------------------------------------
 4714  .PARAM CGD_PLS    = '((NFING+FD)/2*CGXM0 + (NFING+FD)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FD*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 4715  .PARAM CGS_PLS    = '((NFING+FS)/2*CGXM0 + (NFING+FS)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FS*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 4716  .PARAM CDS_PLS    = '(CDSM1+CDSM1W*WFING)*NFING/(LM+2*CONPO)'
 4717  .PARAM CGDM	  = '(1-LPEC)*CGD_PLS*WEC*NFING '
 4718  .PARAM CGSM	  = '(1-LPEC)*CGS_PLS*WEC*NFING '
 4719  .PARAM CFLM       = 'CFL*LOG((1+0.5*(MIN(LM+XL,LMAXCF))/(CONPO-XL/2))/(1+0.5*(LMIN+XL)/(CONPO-XL/2)))'
 4720  .PARAM CFWM       = 'CFW*NGCON/WEC'
 4721  .PARAM CDSM       = 'CDSM0*(LMIN+2.0*CDSML)/(LM+2.0*CDSML)*(WM/NFING)*NFING+(1-LPEC)*CDS_PLS'
 4722  .PARAM CBDM       = 'CBXM0*(WM/NFING)*FD'
 4723  .PARAM CBSM       = 'CBXM0*(WM/NFING)*FS'
 4724  
 4725  
 4726  * Equations for VOFF:
 4727  * ------------------
 4728  
 4729  .PARAM VOFF = '-0.12932 + -0.078441*(TEMPK/(25+273.15) -1)' 
 4730  
 4731  
 4732  
 4733  * Equations for temperature dependance of BGIDL:
 4734  * --------------------------------------------
 4735  .PARAM BGIDL = '7.8647E+09 + -1.9559E+09*(TEMPK/(25+273.15) -1)'
 4736  
 4737  
 4738  * Equations for temperature dependence of series resistances:
 4739  * -----------------------------------------------------------
 4740  .PARAM RDWMIN = 0
 4741  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 4742  .PARAM RSWMIN = 0
 4743  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 4744  .PARAM RDSWMIN = 0
 4745  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 4746  .PARAM RSW = 0
 4747  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 0*(TEMPK/(25+273.15) -1)), (0))'
 4748  .PARAM RDW = 0
 4749  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 0*(TEMPK/(25+273.15) -1)), (0))'
 4750  .PARAM RDSWEFF2 = '(RDSWEFF + 0*(TEMPK/(25+273.15) -1))'
 4751  .PARAM PRT = 0
 4752  
 4753  
 4754  * Equations for thermal noise scaling
 4755  * ------------------------------------
 4756  .PARAM NTNOI = '1*LE/LEC'
 4757  
 4758  
 4759  
 4760  * Equations for Flicker Noise Local Variations
 4761  * --------------------------------------------
 4762  
 4763  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
 4764  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
 4765  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
 4766  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
 4767  .PARAM NOIA    = '((TANH((LE-5E-07)*8E+05))*(4.115E+42)/2+2.0385E+42)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 4768  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 4769  .PARAM NOIC    = '(3E+09)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 4770  
