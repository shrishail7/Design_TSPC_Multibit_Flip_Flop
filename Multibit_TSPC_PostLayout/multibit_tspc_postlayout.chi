 2347  .PARAM WPEMOD    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1),(1))'
 2348  .PARAM KVTH0WE   = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((-0.01231+5.008E-10/LE+8.4E-09/WE+-4.28E-16/(LE*WE))),((-7.404359E-3+1.827268E-10/LE+9.28666E-11/WE)))'
 2349  .PARAM K2WE      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0+0.0/LE+0.0/WE+0.0/(LE*WE))),((2.958218E-3+-1.77185E-11/LE+-1.628225E-10/WE)))'
 2350  .PARAM SCREF     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1E-06),(1E-06))'
 2351  .PARAM KU0WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0.0006944+2.142E-11/LE+-4.813E-10/WE+9.529E-18/(LE*WE))),((5.267004E-3+-1.502153E-10/LE+-2.96138E-09/WE)))'
 2352  .PARAM WEB       = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
 2353  .PARAM WEC2      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
 2354  .PARAM DVTH0_WPE = 'MOSTYPE*WPEMOD*KVTH0WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
 2355  .PARAM DK2_WPE   = 'WPEMOD*K2WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
 2356  .PARAM DU0_WPE   = 'WPEMOD*KU0WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
 2357  
 2358  
 2359  
 2360  * Equations for stress :
 2361  *-----------------------
 2362  
 2363  .PARAM C_1       = 'CONW+COEACT2+CONPO'
 2364  .PARAM C_2       = C_1
 2365  .PARAM B_1       = '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
 2366  .PARAM B_2       = B_1 
 2367  .PARAM CEFF      = '2/(1/C_1+1/C_2)'
 2368  .PARAM BEFF      = '2/(1/B_1+1/B_2)'
 2369  .PARAM PO2ACTEFFM = 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 2370  .PARAM PO2ACTCALM = 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 2371  * Stress effect on threshold voltage :
 2372  *-------------------------------------
 2373  
 2374  
 2375  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1E+12))+(1/LM -(0*NFING/WM+1E+12)))+1.2173E-09*NFING/WM+-0.0010491'
 2376  .PARAM DVTH0_MECHSTRESS = 'MOSTYPE*VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)-MOSTYPE*DVTHFACT*PLVTLP_DVTH0_CMOS065+DVTHTOT'
 2377  * Stress effect on mobility :
 2378  *----------------------------
 2379  
 2380  
 2381  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-9.7441E-09)/2)*(ABS(1/LM-(-0.088*NFING/WM+3.1087E+06))-(1/LM -(-0.088*NFING/WM+3.1087E+06)))+((-2.2734E-16*NFING/WM+1.4902E-10)/2)*(ABS(1/LM-(0.1532*NFING/WM +4.1101E+06))+(1/LM -(0.1532*NFING/WM+4.1101E+06)))+4.41E-10*NFING/WM+0.018161'
 2382  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2383  * Stress effect on body factor K1 :
 2384  *----------------------------------
 2385  .PARAM VARMAXK1         = '0.00273+5.49E-10/LM+-7E-09*NFING/WM'
 2386  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2387  * Stress effect on DVT0 :
 2388  *------------------------
 2389  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 2390  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2391  * Stress effect on access resistance :
 2392  *-------------------------------------
 2393  .PARAM VARMAXRDSW       = '0.103+-8.11E-09*NFING/WM'
 2394  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)' 
 2395  
 2396  
 2397  * Equations for mobility :
 2398  *-------------------------
 2399  .PARAM MOBILITY = '0.0147651*(1+DU0_WPE)*(1+DU0_MECHSTRESS)'
 2400  
 2401  
 2402  
 2403  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PLVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 2404  
 2405  
 2406  * Channel doping nch and body factor k1 worst case :
 2407  *---------------------------------------------------
 2408  .PARAM LE_TYP   = 'LE'
 2409  .PARAM WE_TYP   = 'WE'
 2410  .PARAM SCE_TERM = '1-0.0633248*(1E-6/LE_TYP)--0.00101452*(1E-6/LE_TYP)**2'
 2411  .PARAM NSUBOTYP = '8.82152E+22*MAX((1+-0.0700212*1E-6/WE_TYP*LOG(1+WE_TYP/1.17493E-07)),1E-3)'
 2412  .PARAM NSUBOEFF = '8.82152E+22*MAX((1+-0.0700212*1E-6/WE*LOG(1+WE/1.17493E-07)),1E-3)'
 2413  .PARAM NPCKTYP  = '4.39298E+23*MAX((1+0*1E-6/WE_TYP*LOG(1+WE_TYP/3.50454E-09)),1E-3)'
 2414  .PARAM NPCKEFF  = '4.39298E+23*MAX((1+0*1E-6/WE*LOG(1+WE/3.50454E-09)),1E-3)'
 2415  .PARAM LPCKTYP  = '7.09774E-09*MAX((1+0*1E-6/WE_TYP*LOG(1+WE_TYP/3.50454E-09)),1E-3)'
 2416  .PARAM LPCKEFF  = '7.09774E-09*MAX((1+0*1E-6/WE*LOG(1+WE/3.50454E-09)),1E-3)'
 2417  .PARAM BOVA_TYP = '(SQRT(NSUBOTYP+0.5*NPCKTYP)-SQRT(NSUBOTYP))/7.5E10'
 2418  .PARAM BOVA     = '(SQRT(NSUBOEFF+0.5*NPCKEFF)-SQRT(NSUBOEFF))/7.5E10'
 2419  .PARAM NEFF_TYP = 'SCE_TERM*VALIF( LE_TYP<LPCKTYP, NSUBOTYP+NPCKTYP*(2-LE_TYP/LPCKTYP), (VALIF( LE_TYP<(2*LPCKTYP), NSUBOTYP+NPCKTYP*LPCKTYP/LE_TYP, (SQRT(NSUBOTYP)+7.5E10*LOG(1+2*LPCKTYP/LE_TYP*(EXP(BOVA_TYP)-1)))**2 )) )'
 2420  .PARAM NSUB     = 'VALIF( LE<LPCKEFF, NSUBOEFF+NPCKEFF*(2-LE/LPCKEFF), (VALIF( LE<(2*LPCKEFF), NSUBOEFF+NPCKEFF*LPCKEFF/LE, (SQRT(NSUBOEFF)+7.5E10*LOG(1+2*LPCKEFF/LE*(EXP(BOVA)-1)))**2 )) )'
 2421  .PARAM EGOVQ    = '1.179-9.025E-5*TEMPK-3.05E-7*TEMPK^2'
 2422  .PARAM PHIBFACT = '(1.045+4.5E-4*TEMPK)*(0.523+1.4E-3*TEMPK-1.48E-6*TEMPK^2)*(TEMPK/300)^2'
 2423  .PARAM PHIT_CL  = '1.3806505E-23*TEMPK/1.6021918E-19'
 2424  .PARAM PHIS0_CL = 'EGOVQ + 2*PHIT_CL*LOG(NEFF_TYP/(2.5E25*PHIBFACT^0.75))'
 2425  .PARAM GAMMA0_CL= 'SQRT(2*1.6021918E-19*1.045E-10*NEFF_TYP)/(3.453E-11/2.02728E-09)'
 2426  
 2427  .PARAM DPHIB    = '(0+0*(1E-6/LE_TYP)**1)*(1+0*(1E-6/WE_TYP))*(1+0*(1E-12/LE_TYP/WE_TYP))'
 2428  .PARAM DELTAQ   = '0.4*1*7.448711*(GAMMA0_CL*SQRT(PHIS0_CL+DPHIB)*3.453E-11/2.02728E-09)**(2.0/3.0)'
 2429  .PARAM PHIT     = 'PHIT_CL*(1+(0.75*DELTAQ+DPHIB)/PHIS0_CL)'
 2430  .PARAM PHIS0    = 'EGOVQ + 2*PHIT*LOG(NEFF_TYP/(2.5E25*PHIBFACT^0.75))'
 2431  .PARAM GAMMA0   = 'GAMMA0_CL*(1+DELTAQ/(GAMMA0_CL*SQRT(PHIS0_CL+DPHIB)))'
 2432  .PARAM A        = '2.0*PHIT*GAMMA0/SQRT(PHIS0) - 2.0*PHIT'
 2433  .PARAM C        = 'GAMMA0*SQRT(PHIS0) + 6.0*PHIT'
