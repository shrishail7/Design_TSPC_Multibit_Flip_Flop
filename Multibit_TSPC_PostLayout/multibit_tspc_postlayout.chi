 2273  *----------------------------------------------------------------------
 2274  *----------------------------------------------------------------------
 2275  +       PARAM:W=0.08 L=0.065 NFING=1.0 NCRSD=1.0 MISMATCH=1.0 SRCEFIRST=1.0 TOMETER=1E-06 LPE=0.0 
 2276  + AS=-1 AD=-1 PS=-1 PD=-1 MULT=1.0 NRD=0.0 NRS=0.0 NGCON=1.0 DVT_MDEV=0.0 DMU_MDEV=0.0 
