 1614  *Worst case methodology improvement: Short Channel effect
 1615  *--------------------------------------------------------
 1616  .PARAM LPE0  = '((((0.47182)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4.37035E-09)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1617  .PARAM LPEB  = '(7.90859E-09)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
