  739  * Equations for mobility :
  740  *-------------------------
  741  .PARAM EPSILON2 = 1E-18
  742  .PARAM LLIMIT = '2.849704E-08-XL' 
  743  .PARAM WLIMIT = '-4.22082E-08-XW' 
  744  .PARAM DWU = 'DWU0+(-1.3717)*0.5E6*(ABS(LE-5.9522E-05)-(LE-5.9522E-05))' 
  745  .PARAM MOBILITY = '2.0/(0.01965874929+(LLIMIT+XL
  746  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.002506090626/LE)
  747  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  748  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  749  
  750  
  751  
  752  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PLVTGP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  753  
  754  
  755  * Channel doping nch and body factor k1 worst case :
  756  *---------------------------------------------------
  757  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  758  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  759  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.1643E+17/NI)+0.1878+0.4'
  760  .PARAM  K2        =  '(0.0258+-1.93E-09/LE)*(TOX/1.9184E-09)'
  761  .PARAM  K1        =  '(0.10646)-MOSTYPE*(-0.11334-VTH)/SQRT(PHIS_TYP)'
  762  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  763  .PARAM  NCH       =  '1.1643E+17*(K1*K1)/((0.10646)*(0.10646))'
  764  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.1878+0.4'
  765  * Series resistance worst case :
  766  *-------------------------------
  767  .PARAM RDSW      =  '(278.52+0.0/LE+0.0/WE+4.4532E-17/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PLVTGP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  768  .PARAM PRWB      =  0
  769  
  770  
  771  
  772  
  773  
  774  
  775  .PARAM VSATEFF = '(1.5276E+05+-4.3697E-10/(LE*WE))'
  776  
  777  * Equations for stress :
  778  *-----------------------
  779  
  780  .PARAM C_1	= 'CONW+COEACT2+CONPO'
  781  .PARAM C_2 	= C_1
  782  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
  783  .PARAM B_2	= B_1 
  784  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  785  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  786  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  787  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  788  * Stress effect on threshold voltage :
  789  *-------------------------------------
  790  
  791  
  792  .PARAM VARMAXVTH0       = '((-1.2353E-17*NFING/WM+-1.6765E-10)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))-(1/LM -(0*NFING/WM +1E+07)))+((0*NFING/WM+6E-10)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))+(1/LM -(0*NFING/WM+1E+07)))+8.8235E-11*NFING/WM+0.00041177'
  793  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  794  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PLVTGP_DVTH0_CMOS065+DVTHTOT'
  795  * Stress effect on mobility :
  796  *----------------------------
  797  
  798  
  799  .PARAM VARMAXU0 	= '((0*NFING/WM+1E-09)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))-(1/LM -(0*NFING/WM+1E+07)))+((-8E-16*NFING/WM+2.5882E-09)/2)*(ABS(1/LM-(0*NFING/WM +1E+07))+(1/LM -(0*NFING/WM+1E+07)))+3.0882E-09*NFING/WM+-0.0055882'
  800  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  801  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
  802  * Stress effect on body factor K1 :
  803  *----------------------------------
  804  .PARAM VARMAXK1         = '0.023488+-9.8448E-10/LM+-7.8493E-10*NFING/WM'
  805  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  806  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  807  * Stress effect on DVT0 :
  808  *------------------------
  809  .PARAM DVT0_STRESS        = -5309.5
  810  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  811  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  812  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  813  * Stress effect on access resistance :
  814  *-------------------------------------
  815  .PARAM VARMAXRDSW       = '0+0*NFING/WM'
  816  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  817  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  818  
  819  
  820  .PARAM NFACTOR = '(2.6943E-10+2.0136E-10/LE)*SQRT(PHIS*1.1643E+17/(PHIS_TYP*NCH))*(1.9184E-09/TOX)'
  821  
  822  
  823  
  824  * Equations for VT :
  825  *-------------------
  826  .PARAM W0       = '2.4962E-07+(0-XW)'
  827  .PARAM K3B      = '(0)*(1.9184E-09/TOX)'
  828  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  829  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*1.1643E+17*1E6))'
  830  .PARAM DVTP0    = 0
  831  
  832  
  833  .PARAM N_SUBVT  = '1.0+(2.6943E-10+2.0136E-10/LE)*5.755200556E-09/XDEP0'
  834  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+2.2381E-06))'
  835  .PARAM TMP2     = '1.72656E-09/(WE+W0)'
  836  .PARAM K3       = '(-6.7727+-4.208E-07/(LE*(LMIN+-4E-09-2*LINT)/(LMIN+XL-2*LINT))+-1.1439E-14/((LE*(LMIN+-4E-09-2*LINT)/(LMIN+XL-2*LINT))*WE))*(1.9184E-09/TOX)+VTH_RSCE/TMP2'
  837  
  838  
  839  
  840  * Equation for moin :
  841  *-------------------
  842  .PARAM MOIN = 'VALIF((11.867*((0.10646)/K1EFF)^2 > 5), (11.867*((0.10646)/K1EFF)^2), (5))'
  843  
  844  
  845  * Equations for LKETA :
  846  *---------------------
  847  
  848  
  849  .PARAM LKETA    = -0.00829 
  850  
  851  
  852  *Worst case methodology improvement: Short Channel effect
  853  *--------------------------------------------------------
  854  .PARAM LPE0  = '((((0.10646)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(5.6011E-08+7.6826E-15/LE)/(LMIN+-4E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  855  .PARAM LPEB  = '(0)/(LMIN+-4E-09-2*LINT)*(LMIN+XL-2*LINT)'
  856  .PARAM DVT1  = '3.1663*SQRT(TOX/1.9184E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  857  .PARAM DVT1W = '79.969*SQRT(TOX/1.9184E-09)*SQRT(XDEP0/XDEP0_TYP)'
  858  .PARAM DSUB = '(0.64737)*SQRT(TOX/1.9184E-09)*SQRT(XDEP0/XDEP0_TYP)'
  859  
  860  
  861  
  862  * Equations for Extrinsic Capacitances:
  863  * ------------------------------------
  864  
  865  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
  866  
  867  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
  868  .PARAM C3EXT = '(9.681E-18 + 7.403E-11*(LM + XL))'
  869  
  870  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.237E-17 + 2.400E-18*TANH((LM + XL)/1.258E-07)),(1.474E-17 + 3.229E-18*TANH((LM + XL)/1.497E-07)))'
  871  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.458E-17 + 9.132E-19*TANH((WM/NFING + XW)/1.568E-06) + 1.875E-17*TANH((LM + XL)/5.032E-07)),(1.240E-17 + -2.833E-17*TANH((WM/NFING + XW)/1.635E-06) + 1.043E-17*TANH((LM + XL)/2.752E-07)))' 
  872  
  873  
  874  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-4.315E-19*(1-ALIGNMENT_PRELAYOUT) + 8.264E-11*(WM/NFING + XW) + 4.014E-11*(WM/NFING + XW)*TANH((LM + XL)/3.174E-07)) ,(4.263E-19*(1-ALIGNMENT_PRELAYOUT) + 2.618E-11*(WM/NFING + XW) + 1.895E-11*(WM/NFING + XW)*TANH((LM + XL)/2.508E-07)))'
  875  
  876  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  877  
  878  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
  879  
  880  .PARAM CGSL = '((1.4436E-10) + 4.4235E-18/LM  + -3.1711E-25/LM^2 + -6.0202E-18/WM*NFING + -2.7703E-26/WM^2*NFING^2)*(1.9184E-09/TOX)' 
  881  .PARAM CGDL = '((1.4436E-10) + 4.4235E-18/LM  + -3.1711E-25/LM^2 + -6.0202E-18/WM*NFING + -2.7703E-26/WM^2*NFING^2)*(1.9184E-09/TOX)' 
  882  .PARAM CGSO       =  'VALIF((POCOSM>0),(7.7789E-13*(1.9184E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.8098E-07)*(TANH(POCOSM/9.9978E-08)-1))*1.7299E-10/WEC),7.7789E-13*(1.9184E-09/TOX))'
  883  .PARAM CGDO       =  'VALIF((POCOSM>0),(7.7789E-13*(1.9184E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.8098E-07)*(TANH(POCODM/9.9978E-08)-1))*1.7299E-10/WEC),7.7789E-13*(1.9184E-09/TOX))'
  884  
  885  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  886  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  887  
  888  
  889  
  890  * Equations for extrinsic S/D resistances:
  891  * ---------------------------------------
  892  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
  893   
  894  * Unsilicided poly gate resistance:
  895  * --------------------------------
  896  .PARAM RSHGUMMID = '(620+RSHGUM)/2 + (620-RSHGUM)*TANH(1E18*(2*2.2E-8-LM-XL))/2'
  897  .PARAM RSHGUMEFF = 'RSHGUMMID*620*(LM+XL)/(2*2.2E-8*RSHGUMMID + (LM+XL-2*2.2E-8)*620)'
  898  
  899  
  900  * Salicided poly gate resistance:
  901  * ------------------------------
  902  
  903   .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==0),(1-ALIGNMENT_PRELAYOUT),(0))'
  904  .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__1__YES = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==1),(1-ALIGNMENT_PRELAYOUT),(0))'
  905  .PARAM RGATEMOD = GFLAG__RGATESWITCH__ALL__CMOS065__1__YES 
  906  .PARAM RGATE    = '(((RSHG*(WM/NFING+XW))/(3*NGCON**2*(LM+XL+9E-09)))+((4.13E-12+RSHGUMEFF*1E-07*(1E-07-2.5E-08))/((WM/NFING+XW)*(LM+XL))))/NFING'
  907  .PARAM RSHG0    = 'RGATE*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
