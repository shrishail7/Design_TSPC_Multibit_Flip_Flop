  729  .PARAM PROCESSSTATFLAGS = '1.0'
  730  .PARAM DVTHTOT   = 'PLVTGP_DVTH0_CMOS065/(VALIF((PLVTGP_DVTH0_CMOS065==0),(1),(0))+SQRT((PLVTGP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PLVTGP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PLVTGP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  731  .PARAM VTH     = '-0.11334+PLVTGP_DVTH0_CMOS065'
  732  
