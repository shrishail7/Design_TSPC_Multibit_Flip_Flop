 1426  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
 1427  
 1428  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
