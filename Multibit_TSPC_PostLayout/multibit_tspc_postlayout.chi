 2419  * Model improvement equations :
 2420  *------------------------------
 2421  
 2422  * Equations for mismatch deviations:
 2423  *-----------------------------------
 2424  .PARAM DVTH0_ALPHA = (4.3E-9)
 2425  .PARAM DVTH0_BETA  = (0.0)
 2426  .PARAM DVTH0_FUDGE  = (1.0)
 2427  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
 2428  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMSPHVTLP_DEV*MISMATCH}
 2429  .PARAM DBETA_ALPHA = (1.04E-8)
 2430  .PARAM DBETA_BETA  = (0.0)
 2431  .PARAM DBETA_FUDGE  = (1.0)
 2432  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
 2433  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMSPHVTLP_DEV*MISMATCH}
 2434  
 2435  
 2436  .PARAM PROCESSSTATFLAGS = '1.0'
 2437  .PARAM DVTHTOT   = 'PSRAMSPHVTLP_DVTH0_CMOS065/(VALIF((PSRAMSPHVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((PSRAMSPHVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PSRAMSPHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PSRAMSPHVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 2438  .PARAM VTH     = '-0.75397+PSRAMSPHVTLP_DVTH0_CMOS065'
