  918  
  919  
  920  
  921  *------------------------------------------------------------------------------
  922  * flag used to switch on/off device access modeling (for post layout simulation)
  923  *------------------------------------------------------------------------------
  924  *   lpe     Body      Access_R  Access_C   Extraction_mode
  925  *    0       yes        yes       yes           --
  926  *    1       yes        yes       no             C
  927  *    2       yes        no        yes            R
  928  *    3       yes        no        no             RC
  929  *
  930  .PARAM LPER = 'VALIF(((LPE==2) || (LPE==3)),(1),(0))'
  931  .PARAM LPEC = 'VALIF(((LPE==1) || (LPE==3) || (LPE==97)),(1),(0))'
  932  .PARAM ALIGNMENT_PRELAYOUT  = 'VALIF(((LPE==99) || (LPE==98)),(1),(0))'
  933  .PARAM ALIGNMENT_POSTLAYOUT = 'VALIF((LPE==98),(1),(0))'
  934  .PARAM LPEC2 = 'VALIF(((LPE==1) || (LPE==3)),(1),(0))'
  935  
  936  
  937  *-----------------------------------------------------------------------------------------------------
  938  * flag used to switch on/off Source and Drain diffusion access resistances (for post layout simulation) 
  939  *-----------------------------------------------------------------------------------------------------
  940  .PARAM NRSD_FLAG = 'VALIF(((NRS==0) && (NRD==0)),(0),(1))'
  941  
  942  
  943  
  944  *--------------------------------------------------------
  945  * flag used to switch on/off mismatch into process corners
  946  *--------------------------------------------------------
  947  * sramsphvtlp_dev  no_mm  mc_mm  mm_in_corners  param_mm
  948  *       0       yes    no     no             no
  949  *       1       no     yes    no             no
  950  *       2       no     no     yes            no
  951  *       3       no     no     no             yes
  952  *
  953  .PARAM MFLAG_NO        = 'VALIF((SRAMSPHVTLP_DEV==0),(1),(0))'
  954  .PARAM MFLAG_MC        = 'VALIF((SRAMSPHVTLP_DEV==1),(1),(0))'
  955  .PARAM MFLAG_CORNER    = 'VALIF((SRAMSPHVTLP_DEV==2),(1),(0))'
  956  .PARAM MFLAG_PARAM     = 'VALIF((SRAMSPHVTLP_DEV==3),(1),(0))'
  957  
