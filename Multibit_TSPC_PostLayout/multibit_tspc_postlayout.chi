  714  
  715  * Equations for mismatch deviations:
  716  *-----------------------------------
  717  .PARAM DVTH0_ALPHA = (3.4E-9)
  718  .PARAM DVTH0_BETA  = (0.0)
  719  .PARAM DVTH0_FUDGE  = (1)
  720  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
  721  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*LVTGP_DEV*MISMATCH}
  722  .PARAM DBETA_ALPHA = (0.73E-8)
  723  .PARAM DBETA_BETA  = (0.0)
  724  .PARAM DBETA_FUDGE  = (1)
  725  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
  726  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*LVTGP_DEV*MISMATCH}
