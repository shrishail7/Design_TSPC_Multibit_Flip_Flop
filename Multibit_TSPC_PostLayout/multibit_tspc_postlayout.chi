  182  .PARAM EPSILON2 = 1E-18
  183  .PARAM LLIMIT = '4.768414E-07-XL' 
  184  .PARAM WLIMIT = '7.52256E-07-XW' 
  185  .PARAM DWU = 'DWU0+(-2.6044)*0.5E6*(ABS(LE-5.4443E-08)-(LE-5.4443E-08))' 
  186  .PARAM MOBILITY = '2.0/(0.00449920032+(LLIMIT+XL
  187  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.0005007996801/LE)
  188  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  189  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  190  
  191  
  192  
  193  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSRAMDPHVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  194  
  195  
  196  * Channel doping nch and body factor k1 worst case :
  197  *---------------------------------------------------
  198  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  199  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  200  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.3981E+18/NI)+0.25043+0.4'
  201  .PARAM  K2        =  '(-0.004+-6.2113E-09/LE)*(TOX/2.3926E-09)'
