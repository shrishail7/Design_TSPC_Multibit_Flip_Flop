 5062  * Layout and electrical dimensions:
 5063  *----------------------------------
 5064  .PARAM WM='W*TOMETER'
 5065  .PARAM LM='L*TOMETER'
 5066  .PARAM WFING='WM/NFING+XW'
 5067  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
 5068  .PARAM FS='2-FD'
 5069  .PARAM ADP ='WFING*((NFING-FD)*(NCRSD-1)*(0.09E-6+0.14E-6)/2+NFING*(2E-07-XL)/2+FD*(7.5E-08+XW/2))'
 5070  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(0.09E-6+0.14E-6)/2+NFING*(2E-07-XL)/2+FS*(7.5E-08+XW/2))'
 5071  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(0.09E-6+0.14E-6)+NFING*2*(2E-07-XL)/2+FD*(WFING+2*7.5E-08+XW)'
 5072  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(0.09E-6+0.14E-6)+NFING*2*(2E-07-XL)/2+FS*(WFING+2*7.5E-08+XW)'
 5073  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 5074  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 5075  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 5076  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 5077  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
 5078  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 5079  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 5080  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
 5081  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
 5082  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
 5083  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
 5084  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 5085  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
 5086  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
 5087  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
 5088  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
