  170  .PARAM PROCESSSTATFLAGS = '1.0'
  171  .PARAM DVTHTOT   = 'NHVTLPPDSP_DVTH0_CMOS065/(VALIF((NHVTLPPDSP_DVTH0_CMOS065==0),(1),(0))+SQRT((NHVTLPPDSP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMSPHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NHVTLPPDSP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  172  .PARAM VTH     = '0.67476+NHVTLPPDSP_DVTH0_CMOS065'
  173  
