  718  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  719  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
  720  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
  721  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
  722  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
  723  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  724  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
  725  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
  726  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
  727  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
  728  
  729  * DC Effective length and width:
  730  *---------------------------
  731  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  732  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  733  * AC Effective length and width:
  734  *------------------------------
  735  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  736  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(4.2E-16/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  737  *  Effective Source/Drain Junction width:
  738  *---------------------------------------
  739  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  740  
  741  
  742  * Model improvement equations :
  743  *------------------------------
  744  
  745  * Equations for mismatch deviations:
  746  *-----------------------------------
  747  .PARAM DVTH0_ALPHA = (4.9E-9)
  748  .PARAM DVTH0_BETA  = (0.0)
  749  .PARAM DVTH0_FUDGE  = (1)
  750  .PARAM DVTH0_ALPHA_C2 = (4.9E-9)
  751  .PARAM DVTH0_BETA_C2  = (0.0)
  752  .PARAM DVTH0_FUDGE_C2 = (1)
  753  .PARAM DVTH0_SIG = {(((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DVTH0_ALPHA_C2/SQRT(WM*LM))+DVTH0_BETA_C2)*DVTH0_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
  754  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*HVTLP_DEV*MISMATCH}
  755  .PARAM DBETA_ALPHA = (0.77E-8)
  756  .PARAM DBETA_BETA  = (0.0)
  757  .PARAM DBETA_FUDGE  = (1)
  758  .PARAM DBETA_ALPHA_C2 = (0.77E-8)
  759  .PARAM DBETA_BETA_C2  = (0.0)
  760  .PARAM DBETA_FUDGE_C2 = (1)
  761  .PARAM DBETA_SIG = {(((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DBETA_ALPHA_C2/SQRT(WM*LM))+DBETA_BETA_C2)*DBETA_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
  762  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*HVTLP_DEV*MISMATCH}
  763  
  764  
  765  .PARAM PROCESSSTATFLAGS = '1.0'
  766  .PARAM DVTHTOT   = 'NHVTLP_DVTH0_CMOS065/(VALIF((NHVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((NHVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NHVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  767  .PARAM VTH     = '0.60191+NHVTLP_DVTH0_CMOS065'
  768  
  769  
  770  * Equation for  AGIDL:
  771  * --------------------
  772  .PARAM AGIDL   = '(3.4049E-06)*10^DAGIDL'
  773  
  774  
  775  * Equations for mobility :
  776  *-------------------------
  777  .PARAM EPSILON2 = 1E-18
  778  .PARAM LLIMIT = '6.29744E-08-XL' 
  779  .PARAM WLIMIT = '7.702188E-07-XW' 
  780  .PARAM DWU = 'DWU0+(0.7)*0.5E6*(ABS(LE-8E-08)-(LE-8E-08))' 
  781  .PARAM MOBILITY = '2.0/(0.004990258812+(LLIMIT+XL
  782  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.0002400034857/LE)
  783  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  784  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  785  
  786  
  787  
  788  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NHVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  789  
  790  
  791  * Channel doping nch and body factor k1 worst case :
  792  *---------------------------------------------------
  793  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  794  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  795  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.3118E+18/NI)+0.25043+0.4'
  796  .PARAM  K2        =  '(-0.011192+-6.4929E-09/LE)*(TOX/2.3926E-09)'
  797  .PARAM  K1        =  '(0.45723)-MOSTYPE*(0.60191-VTH)/SQRT(PHIS_TYP)'
  798  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  799  .PARAM  NCH       =  '1.3118E+18*(K1*K1)/((0.45723)*(0.45723))'
  800  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  801  * Series resistance worst case :
  802  *-------------------------------
  803  .PARAM RDSW      =  '(331.79+0.0/LE+0.0/WE+0.0/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NHVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  804  .PARAM PRWB      =  0.013147
  805  
  806  
  807  
  808  
  809  
  810  
  811  * Equations for Poly spacing effect:
  812  *-----------------------------------
  813  .PARAM SPODEFM  = '0.2E-6'
  814  .PARAM SPOAM    = 'VALIF((SPOA > 0),(SPOA*TOMETER),(SPODEFM))'
  815  .PARAM SPOBM    = 'VALIF((SPOB > 0),(SPOB*TOMETER),(SPODEFM))'
  816  .PARAM SPOM     = '2/(1/(MIN(SPOAM,SPOBM)-5E-09)+1/(MIN(SPOAM,SPOBM)-5E-09))'
  817  .PARAM DVT_SPO_LR = '1.000*((5.361E-8/(SPOM))**4.8125-(5.361E-8/(0.2E-6-5E-09))**4.8125)'
  818  .PARAM DVT_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DVT_SPO_LR/0.60191*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DVT_SPO_LR'
  819  .PARAM DU0_SPO_LR = '-1.000*((2.9899E-8/(SPOM))**1.859-(2.9899E-8/(0.2E-6-5E-09))**1.859)'
  820  .PARAM DU0_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DU0_SPO_LR*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DU0_SPO_LR'
  821  .PARAM VSATEFF = '(2.1366E+05+0.0055593/LE+-0.003/WE)*(1+DU0_SPO)'
  822  
  823  
  824  * Equations for stress :
  825  *-----------------------
  826  
  827  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
  828  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
  829  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
  830  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
  831  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
  832  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  833  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  834  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  835  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  836  * Stress effect on threshold voltage :
  837  *-------------------------------------
  838  
  839  
  840  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((-1.6035E-16*NFING/WM+1.0356E-09)/2)*(ABS(1/LM-(0*NFING/WM+4.7637E+06))+(1/LM -(0*NFING/WM+4.7637E+06)))+4.8551E-10*NFING/WM+-0.0048908'
  841  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  842  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NHVTLP_DVTH0_CMOS065+DVTHTOT+DVT_SPO'
  843  * Stress effect on mobility :
  844  *----------------------------
  845  
  846  
  847  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-1.057E-08)/2)*(ABS(1/LM-(-0.08785*NFING/WM+6E+06))-(1/LM -(-0.08785*NFING/WM+6E+06)))+((-4.1565E-16*NFING/WM+5.544E-09)/2)*(ABS(1/LM-(0.1532*NFING/WM +9E+06))+(1/LM -(0.1532*NFING/WM+9E+06)))+-3E-09*NFING/WM+0.07397'
  848  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  849  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)*(1+DU0_SPO)'
  850  * Stress effect on body factor K1 :
  851  *----------------------------------
  852  .PARAM VARMAXK1         = '-0.04+0/LM+1E-08*NFING/WM'
  853  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  854  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  855  * Stress effect on DVT0 :
  856  *------------------------
  857  .PARAM DVT0_STRESS        = -0.0045
  858  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  859  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  860  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  861  * Stress effect on access resistance :
  862  *-------------------------------------
  863  .PARAM VARMAXRDSW       = '0.15+-5.67E-08*NFING/WM'
  864  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  865  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  866  
  867  
  868  .PARAM NFACTOR = '(0.68787)*SQRT(PHIS*1.3118E+18/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
  869  
  870  
  871  
  872  * Equations for VT :
  873  *-------------------
  874  .PARAM W0       = '6.7549E-09+(0-XW)'
  875  .PARAM K3B      = '(3+-1.1E-07/LE)*(2.3926E-09/TOX)'
  876  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  877  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*1.3118E+18*1E6))'
  878  .PARAM DVTP0    = 0
  879  
  880  
  881  .PARAM N_SUBVT  = '1.0+(0.68787)*7.177800693E-09/XDEP0'
  882  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.4628E-06))'
  883  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
  884  .PARAM K3       = '(-5.2029+4.5839E-08/(LE*(LMIN+5E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
  885  
  886  
  887  
  888  * Equation for moin :
  889  *-------------------
  890  .PARAM MOIN = 'VALIF((5.7874*((0.45723)/K1EFF)^2 > 5), (5.7874*((0.45723)/K1EFF)^2), (5))'
  891  
  892  
  893  * Equations for LKETA :
  894  *---------------------
  895  
  896  .PARAM LKETAEXP = 'VALIF(((5.94530321E-06/LE-100.5191088) > 34), (34), (5.94530321E-06/LE-100.5191088))'
  897  
  898  .PARAM LKETA    = '-0.0051935/(1.0+EXP(LKETAEXP))'
  899  
  900  
  901  *Worst case methodology improvement: Short Channel effect
  902  *--------------------------------------------------------
  903  .PARAM LPE0  = '((((0.45723)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.75E-08)/(LMIN+5E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  904  .PARAM LPEB  = '(2.7144E-08)/(LMIN+5E-09-2*LINT)*(LMIN+XL-2*LINT)'
  905  .PARAM DVT1  = '0.022524*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  906  .PARAM DVT1W = '2.3483E+06*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  907  .PARAM DSUB = '(1)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  908  
  909  
  910  
  911  * Equations for Extrinsic Capacitances:
  912  * ------------------------------------
  913  
  914  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  915  
  916  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  917  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  918  
  919  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  920  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  921  
  922  
  923  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  924  
  925  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  926  
  927  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
  928  
  929  .PARAM CGSL = '((9.237E-11) + 1.749E-19/LM  + 0/LM^2 + -6E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
  930  .PARAM CGDL = '((9.237E-11) + 1.749E-19/LM  + 0/LM^2 + -6E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
  931  .PARAM CGSO       =  'VALIF((POCOSM>0),(1E-12*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),1E-12*(2.3926E-09/TOX))'
  932  .PARAM CGDO       =  'VALIF((POCOSM>0),(1E-12*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),1E-12*(2.3926E-09/TOX))'
  933  
  934  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  935  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  936  
  937  
  938  
  939  * Equations for extrinsic S/D resistances:
  940  * ---------------------------------------
  941  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
  942   
  943  * Unsilicided poly gate resistance:
  944  * --------------------------------
  945  .PARAM RSHGUMMID = '(585+RSHGUM)/2 + (585-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
  946  .PARAM RSHGUMEFF = 'RSHGUMMID*585*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*585)'
  947  
  948  
  949  .PARAM RGATEMOD = 1
  950  .PARAM XGWS    = 'CONRPO-COEPO'
  951  .PARAM XGWU    = 'RPOEXTPOFLD'
  952  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
  953  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
  954  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
  955  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
  956  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
  957  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
  958  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
  959  
  960  * Unsilicided Source/Drain diffusion access resistances:
  961  * -----------------------------------------------------
  962  .PARAM NRSEFF    = 'NRS + (RSD_RPO*ESUM/(RSH*WE)/NFING)'
  963  .PARAM NRDEFF    = 'NRD + (RSD_RPO*EDUM/(RSH*WE)/NFING)'
  964  
  965  
  966  
  967  * Equations for VOFF:
  968  * ------------------
  969  
  970  .PARAM VOFF = '-0.17956 + -0.16777*(TEMPK/(25+273.15) -1)' 
  971  
  972  
  973  
  974  * Equations for temperature dependance of BGIDL:
  975  * --------------------------------------------
  976  .PARAM BGIDL = '8.456E+09 + -1.7794E+09*(TEMPK/(25+273.15) -1)'
  977  
  978  
  979  * Equations for temperature dependence of series resistances:
  980  * -----------------------------------------------------------
  981  .PARAM RDWMIN = 0
  982  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  983  .PARAM RSWMIN = 0
  984  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  985  .PARAM RDSWMIN = 0
  986  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  987  .PARAM RSW = 0
  988  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  989  .PARAM RDW = 0
  990  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  991  .PARAM RDSWEFF2 = '(RDSWEFF + 308.72*(TEMPK/(25+273.15) -1))'
  992  .PARAM PRT = 0
  993  
  994  
  995  * Equations for thermal noise scaling
  996  * ------------------------------------
  997  .PARAM NTNOI = '1*LE/LEC'
  998  
  999  
 1000  
 1001  * Equations for Flicker Noise Local Variations
 1002  * --------------------------------------------
 1003  
 1004  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
