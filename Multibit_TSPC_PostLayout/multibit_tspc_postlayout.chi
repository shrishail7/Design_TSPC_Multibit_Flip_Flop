 3528  .SETSOA LABEL="P1 ==> Isolation safe voltage ranges violation" E V(G,D) =(-1.32,1.32) 
 3529  .SETSOA LABEL="P2 ==> Isolation safe voltage ranges violation" E V(G,S) =(-1.32,1.32) 
 3530  .SETSOA LABEL="P3 ==> Isolation safe voltage ranges violation : Gate oxide limitation with and without channel presence" E IF (V(G,B)-VT(M1)>0) THEN V(G,B)=(-1.32,1.32) ELSE V(G,B)=(-2.64,2.64) ENDIF 
 3531  .SETSOA LABEL="P4 ==> Isolation safe voltage ranges violation" E V(D,S) =(-1.32,1.32) 
 3532  .SETSOA LABEL="P5a ==> Isolation safe voltage ranges violation : D/B diode limitation in reverse bias" E V(B,D)=(*,2.64) 
 3533  .SETSOA LABEL="P5b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when D/B diode in forward bias" E V(B,D)=(-0.33,*) 
 3534  .SETSOA LABEL="P6a ==> Isolation safe voltage ranges violation : S/B diode limitation in reverse bias" E V(B,S)=(*,2.64) 
 3535  .SETSOA LABEL="P6b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when S/B diode in forward bias" E V(B,S)=(0.33,*) 
 3536  .SETSOA LABEL="P7 ==> Isolation safe voltage ranges violation : MOS HCI limitation on D side" E IF (V(G,S)-VT(M1)<0) && (V(D,S)<-0.2) THEN V(B,D)=(-0.2,1.4) ENDIF 
 3537  .SETSOA LABEL="P8 ==> Isolation safe voltage ranges violation : MOS HCI limitation on S side" E IF (V(G,D)-VT(M1)<0) && (V(D,S)>0.2) THEN V(B,S)=(-0.2,1.4) ENDIF 
