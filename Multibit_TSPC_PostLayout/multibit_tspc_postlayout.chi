 1037  .PARAM FS='2-FD'
 1038  .PARAM PDP='VALIF(((W*TOMETER)<=1.05E-7),(VALIF(((L*TOMETER)<=8.5E-8),(1.60435E-07),(1.64348E-07))),(VALIF(((L*TOMETER)<=8.5E-8),(1.74324E-07),(1.74324E-07))))'
 1039  .PARAM PSP='VALIF(((W*TOMETER)<=1.05E-7),(VALIF(((L*TOMETER)<=8.5E-8),(1.8E-07),(1.8E-07))),(VALIF(((L*TOMETER)<=8.5E-8),(1.8E-07),(1.8E-07))))'
 1040  .PARAM ADP='VALIF(((W*TOMETER)<=1.05E-7),(VALIF(((L*TOMETER)<=8.5E-8),(8.39348E-15),(8.66739E-15))),(VALIF(((L*TOMETER)<=8.5E-8),(1.35E-14),(1.35E-14))))'
 1041  .PARAM ASP='VALIF(((W*TOMETER)<=1.05E-7),(VALIF(((L*TOMETER)<=8.5E-8),(8.1E-15),(8.1E-15))),(VALIF(((L*TOMETER)<=8.5E-8),(1.35E-14),(1.35E-14))))'
 1042  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
