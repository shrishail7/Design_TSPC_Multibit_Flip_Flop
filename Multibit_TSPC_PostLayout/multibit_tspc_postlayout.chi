 2911  .SETSOA LABEL="N5b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when D/B diode in forward bias" E V(B,D)=(*,0.33) 
 2912  .SETSOA LABEL="N6a ==> Isolation safe voltage ranges violation : S/B diode limitation in reverse bias" E V(B,S)=(-2.64,*) 
 2913  .SETSOA LABEL="N6b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when S/B diode in forward bias" E V(B,S)=(*,0.33) 
 2914  .SETSOA LABEL="N7 ==> Isolation safe voltage ranges violation : MOS HCI limitation on D side" E IF (V(G,S)-VT(M1)>0) && (V(D,S)>0.2) THEN V(B,D)=(-1.4,0.2) ENDIF 
 2915  .SETSOA LABEL="N8 ==> Isolation safe voltage ranges violation : MOS HCI limitation on S side" E IF (V(G,D)-VT(M1)>0) && (V(D,S)<-0.2) THEN V(B,S)=(-1.4,0.2) ENDIF 
