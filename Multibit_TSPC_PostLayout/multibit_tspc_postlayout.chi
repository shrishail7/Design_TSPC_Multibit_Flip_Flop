 2515  *---------------------
 2516  
 2517  .PARAM LKETAEXP = 'VALIF(((9.99000999E+11/LE-1.7737314E+19) > 34), (34), (9.99000999E+11/LE-1.7737314E+19))'
 2518  
 2519  .PARAM LKETA    = '0.0078667/(1.0+EXP(LKETAEXP))'
 2520  
 2521  
 2522  *Worst case methodology improvement: Short Channel effect
 2523  *--------------------------------------------------------
 2524  .PARAM LPE0  = '((((0.48923)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.2426E-08)/(LMIN+0-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 2525  .PARAM LPEB  = '(-1.5427E-09)/(LMIN+0-2*LINT)*(LMIN+XL-2*LINT)'
 2526  .PARAM DVT1  = '0.077454*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
