  135  .PARAM ASP='VALIF(((W*TOMETER)<=1.6E-7),(VALIF(((L*TOMETER)<=7.5E-8),(1.26E-14),(1.26E-14))),(VALIF(((L*TOMETER)<=7.5E-8),(1.98E-14),(1.98E-14))))'
