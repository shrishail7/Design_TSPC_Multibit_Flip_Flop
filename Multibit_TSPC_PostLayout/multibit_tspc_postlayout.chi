   83  
   84  * variant parameters:
   85  *--------------------
   86  .PARAM XL      = '-7E-09 + NSVTGP_DXL_CMOS065'
   87  .PARAM XW      = '0 + NSVTGP_DXW_CMOS065'
   88  .PARAM TOX     = '1.88E-09 + NSVTGP_DTOXE_CMOS065'
   89  .PARAM DMU     = NSVTGP_DMU_CMOS065
   90  
   91  .PARAM NOIA    = '(6E+42)*(1 + NSVTGP_DNOISE_CMOS065)'
   92  .PARAM NOIB    = '(0)*(1 + NSVTGP_DNOISE_CMOS065)'
   93  .PARAM NOIC    = '(0)*(1 + NSVTGP_DNOISE_CMOS065)'
   94  
   95  .PARAM  CJS     = '0.0013154*(1 + NSVTGP_DCJB_CMOS065)'
   96  .PARAM  CJSWS   = '2.629E-11*(1 + NSVTGP_DCJSW_CMOS065)'
   97  .PARAM  CJSWGS  = '2.5718E-10*(1 + NSVTGP_DCJGATE_CMOS065)'
   98  .PARAM  CJD     = '0.0013154*(1 + NSVTGP_DCJB_CMOS065)'
   99  .PARAM  CJSWD   = '2.629E-11*(1 + NSVTGP_DCJSW_CMOS065)'
  100  .PARAM  CJSWGD  = '2.5718E-10*(1 + NSVTGP_DCJGATE_CMOS065)'
  101  .PARAM  JSS     = '3.3261E-07*10^NSVTGP_DIDIODE_CMOS065'
  102  .PARAM  JSWS    = '1.12E-13*10^NSVTGP_DIDIODE_CMOS065'
  103  .PARAM  JSWGS   = '2.7698E-14*10^NSVTGP_DIDIODE_CMOS065'
  104  .PARAM  JTSS    = '1.001E-18*10^NSVTGP_DIDIODE_CMOS065'
  105  .PARAM  JTSSWS  = '3.2373E-11*10^NSVTGP_DIDIODE_CMOS065'
  106  .PARAM  JTSSWGS = '1.3649E-08*10^NSVTGP_DIDIODE_CMOS065'
  107  .PARAM  JSD     = '3.3261E-07*10^NSVTGP_DIDIODE_CMOS065'
  108  .PARAM  JSWD    = '1.12E-13*10^NSVTGP_DIDIODE_CMOS065'
  109  .PARAM  JSWGD   = '2.7698E-14*10^NSVTGP_DIDIODE_CMOS065'
  110  .PARAM  JTSD    = '1.001E-18*10^NSVTGP_DIDIODE_CMOS065'
  111  .PARAM  JTSSWD  = '3.2373E-11*10^NSVTGP_DIDIODE_CMOS065'
  112  .PARAM  JTSSWGD = '1.3649E-08*10^NSVTGP_DIDIODE_CMOS065'
  113  .PARAM DAGIDL  = NSVTGP_DAGIDL_CMOS065
  114  .PARAM DCFRING = NSVTGP_DCFRING_CMOS065
  115  .PARAM DRDSW   = NSVTGP_DRDSW_CMOS065
  116  
