 2539  
 2540  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 2541  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 2542  
 2543  
