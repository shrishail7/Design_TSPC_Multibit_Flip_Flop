 2333  * Continuous Model for mismatch deviations:
 2334  *----------------------------------------
 2335  .PARAM DVTH0_SIG = '(3.3E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT(WM*(LM+XL)))/SQRT(2.0*MULT)'
 2336  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*LVTLP_DEV*MISMATCH}
 2337  .PARAM DBETA_SIG = '(0.45E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT(WM*(LM+XL)))/SQRT(2.0*MULT)'
 2338  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*LVTLP_DEV*MISMATCH}
 2339  .PARAM PROCESSSTATFLAGS = '1.0'
 2340  .PARAM DVTHTOT   = 'MOSTYPE*DVTHFACT*PLVTLP_DVTH0_CMOS065/(VALIF((PLVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((DVTHFACT*PLVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PLVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(DVTHFACT*PLVTLP_DVTH0_CMOS065)^2)+DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS+DVTH0_DEV*MFLAG_MC'
 2341  .PARAM DVTH    = 'MOSTYPE*DVTHFACT*PLVTLP_DVTH0_CMOS065'
 2342  
 2343  
