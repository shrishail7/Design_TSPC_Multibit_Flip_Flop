 2746  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
 2747  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
 2748  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
 2749  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 2750  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 2751  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 2752  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 2753  .PARAM POCOSM	= 'POCOS*TOMETER'
 2754  .PARAM POCODM	= 'POCOD*TOMETER'
 2755  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
 2756  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 2757  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 2758  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
 2759  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
 2760  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
 2761  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
 2762  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 2763  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
 2764  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
 2765  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
 2766  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
 2767  
 2768  * DC Effective length and width:
 2769  *---------------------------
 2770  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 2771  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 2772  * AC Effective length and width:
 2773  *------------------------------
 2774  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 2775  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 2776  *  Effective Source/Drain Junction width:
 2777  *---------------------------------------
 2778  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 2779  
 2780  
 2781  * Model improvement equations :
 2782  *------------------------------
 2783  
 2784   
 2785      * Continuous Model for mismatch deviations 
 2786  *----------------------------------------
 2787  .PARAM X_DEV        = 0.0 DEVX/GAUSS = {1.0}
 2788  .PARAM Y_DEV        = 0.0 DEVX/GAUSS = {1.0}
 2789  .PARAM Z_DEV        = 0.0 DEVX/GAUSS = {1.0}
 2790  .PARAM DVTH_AVT        = '3.3E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 2791  .PARAM DBETA_ABETA     = '0.45E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 2792  
 2793  
 2794  .PARAM PVT          = 5.6E-06      
 2795  .PARAM TPVT         = -0.025E-06     
 2796  .PARAM ZETAVT       = 0.056E+12
 2797  .PARAM DVTH_PVT    = '(PVT+TPVT*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETAVT*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 2798  .PARAM DVTH0_SIG = 'SQRT(DVTH_PVT*DVTH_PVT+DVTH_AVT*DVTH_AVT)'
 2799  .PARAM DVTH0_DEV = '(DVTH_AVT*X_DEV+DVTH_PVT*Y_DEV)*LVTLP_DEV*MISMATCH'
 2800  
 2801  
 2802  .PARAM PBETA        = 1.5E-05    
 2803  .PARAM TPBETA       = -0.0087E-05   
 2804  .PARAM ZETABETA     = 0.021E+12
 2805  .PARAM DBETA_PBETA = '(PBETA+TPBETA*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETABETA*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 2806  .PARAM DBETA_SIG = 'SQRT(DBETA_PBETA*DBETA_PBETA+DBETA_ABETA*DBETA_ABETA)'
 2807  .PARAM DBETA_DEV = '(DBETA_ABETA*Z_DEV+DBETA_PBETA*Y_DEV)*LVTLP_DEV*MISMATCH'
 2808  
 2809  .PARAM PROCESSSTATFLAGS = '1.0'
 2810  .PARAM DVTHTOT   = 'PLVTLP_DVTH0_CMOS065/(VALIF((PLVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((PLVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PLVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PLVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 2811  .PARAM VTH     = '-0.283+PLVTLP_DVTH0_CMOS065'
 2812  
 2813  
 2814  * Equation for  AGIDL:
 2815  * --------------------
 2816  .PARAM AGIDL   = '(1.9994E-06)*10^DAGIDL'
 2817  
 2818  
 2819  * Equations for mobility :
 2820  *-------------------------
 2821  .PARAM EPSILON2 = 1E-18
 2822  .PARAM LLIMIT = '7.3E-08-XL' 
 2823  .PARAM WLIMIT = '8.54612E-07-XW' 
 2824  .PARAM DWU = 'DWU0+(0.04)*0.5E6*(ABS(LE-9E-07)-(LE-9E-07))' 
 2825  .PARAM MOBILITY = '2.0/(0.01990740741+(LLIMIT+XL
 2826  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.005092592593/LE)
 2827  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 2828  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 2829  
 2830  
 2831  
 2832  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PLVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 2833  
 2834  
 2835  * Channel doping nch and body factor k1 worst case :
 2836  *---------------------------------------------------
 2837  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 2838  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 2839  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(2.6962E+17/NI)+0.18679+0.4'
 2840  .PARAM  K2        =  '(0.00084049+-1.1371E-08/LE)*(TOX/2.4239E-09)'
 2841  .PARAM  K1        =  '(0.21)-MOSTYPE*(-0.283-VTH)/SQRT(PHIS_TYP)'
 2842  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 2843  .PARAM  NCH       =  '2.6962E+17*(K1*K1)/((0.21)*(0.21))'
 2844  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18679+0.4'
 2845  * Series resistance worst case :
 2846  *-------------------------------
 2847  .PARAM RDSW      =  '(155+2.097E-05/WE)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PLVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 2848  .PARAM PRWB      =  0.09322
 2849  
 2850  
 2851  
 2852  
 2853  
 2854  
 2855  .PARAM VSATEFF = '(1.578E+05)'
 2856  
 2857  * Equations for stress :
 2858  *-----------------------
 2859  
 2860  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
 2861  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
 2862  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
 2863  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
 2864  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
 2865  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 2866  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 2867  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 2868  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 2869  * Stress effect on threshold voltage :
 2870  *-------------------------------------
 2871  
 2872  
 2873  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1E+12))+(1/LM -(0*NFING/WM+1E+12)))+1.2173E-09*NFING/WM+-0.0010491'
 2874  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2875  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PLVTLP_DVTH0_CMOS065+DVTHTOT'
 2876  * Stress effect on mobility :
 2877  *----------------------------
 2878  
 2879  
 2880  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-9.7441E-09)/2)*(ABS(1/LM-(-0.088*NFING/WM+3.1087E+06))-(1/LM -(-0.088*NFING/WM+3.1087E+06)))+((-2.2734E-16*NFING/WM+1.4902E-10)/2)*(ABS(1/LM-(0.1532*NFING/WM +4.1101E+06))+(1/LM -(0.1532*NFING/WM+4.1101E+06)))+4.41E-10*NFING/WM+0.018161'
 2881  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2882  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 2883  * Stress effect on body factor K1 :
 2884  *----------------------------------
 2885  .PARAM VARMAXK1         = '0.00273+5.49E-10/LM+-7E-09*NFING/WM'
 2886  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2887  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 2888  * Stress effect on DVT0 :
 2889  *------------------------
 2890  .PARAM DVT0_STRESS        = 26.9
 2891  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 2892  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2893  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 2894  * Stress effect on access resistance :
 2895  *-------------------------------------
 2896  .PARAM VARMAXRDSW       = '0.103+-8.11E-09*NFING/WM'
 2897  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 2898  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 2899  
 2900  
 2901  .PARAM NFACTOR = '(0.95946+1.6338E-07/LE+-1.6E-14/(LE*WE))*SQRT(PHIS*2.6962E+17/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 2902  
 2903  
 2904  
 2905  * Equations for VT :
 2906  *-------------------
 2907  .PARAM W0       = '4.6522E-07+(0-XW)'
 2908  .PARAM K3B      = '(3)*(2.4239E-09/TOX)'
 2909  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 2910  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*2.6962E+17*1E6))'
 2911  .PARAM DVTP0    = 0
 2912  
 2913  
 2914  .PARAM N_SUBVT  = '1.0+(0.95946+1.6338E-07/LE+-1.6E-14/(LE*WE))*7.271700702E-09/XDEP0'
 2915  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.9752E-06))'
 2916  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 2917  .PARAM K3       = '(-8+1E-07/(LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT))+2E-13/((LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT))*WE))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 2918  
 2919  
 2920  
 2921  * Equation for moin :
 2922  *-------------------
 2923  .PARAM MOIN = 'VALIF((10*((0.21)/K1EFF)^2 > 5), (10*((0.21)/K1EFF)^2), (5))'
 2924  
 2925  
 2926  * Equations for LKETA :
 2927  *---------------------
 2928  
 2929  
 2930  .PARAM LKETA    = 0.002 
 2931  
 2932  
 2933  *Worst case methodology improvement: Short Channel effect
 2934  *--------------------------------------------------------
 2935  .PARAM LPE0  = '((((0.21)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1E-12+3.1E-15/LE)/(LMIN+8E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 2936  .PARAM LPEB  = '(1.0013E-07+1.8804E-14/LE)/(LMIN+8E-09-2*LINT)*(LMIN+XL-2*LINT)'
 2937  .PARAM DVT1  = '1.3*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 2938  .PARAM DVT1W = '3E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2939  .PARAM DSUB = '(0.019282)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2940  
 2941  
 2942  
 2943  * Equations for Extrinsic Capacitances:
 2944  * ------------------------------------
 2945  
 2946  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 2947  
 2948  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 2949  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 2950  
 2951  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 2952  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 2953  
 2954  
 2955  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 2956  
 2957  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 2958  
 2959  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
 2960  
 2961  .PARAM CGSL = '((1.1515E-10) + 5.4268E-18/LM  + -2.906E-25/LM^2 + -4E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 2962  .PARAM CGDL = '((1.1515E-10) + 5.4268E-18/LM  + -2.906E-25/LM^2 + -4E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 2963  .PARAM CGSO       =  'VALIF((POCOSM>0),(5E-12*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),5E-12*(2.4239E-09/TOX))'
 2964  .PARAM CGDO       =  'VALIF((POCOSM>0),(5E-12*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),5E-12*(2.4239E-09/TOX))'
 2965  
 2966  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2967  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2968  
 2969  
 2970  
 2971  * Equations for extrinsic S/D resistances:
 2972  * ---------------------------------------
 2973  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 2974   
 2975  * Unsilicided poly gate resistance:
 2976  * --------------------------------
 2977  .PARAM RSHGUMMID = '(605+RSHGUM)/2 + (605-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
 2978  .PARAM RSHGUMEFF = 'RSHGUMMID*605*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*605)'
 2979  
 2980  
 2981  .PARAM RGATEMOD = 1
 2982  .PARAM XGWS    = 'CONRPO-COEPO'
 2983  .PARAM XGWU    = 'RPOEXTPOFLD'
 2984  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
 2985  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
 2986  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
 2987  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
 2988  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
 2989  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 2990  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
 2991  
 2992  * Unsilicided Source/Drain diffusion access resistances:
 2993  * -----------------------------------------------------
 2994  .PARAM NRSEFF    = 'NRS + (RSD_RPO*ESUM/(RSH*WE)/NFING)'
 2995  .PARAM NRDEFF    = 'NRD + (RSD_RPO*EDUM/(RSH*WE)/NFING)'
 2996  
 2997  
 2998  
 2999  * Equations for VOFF:
 3000  * ------------------
 3001  
 3002  .PARAM VOFF = '-0.12932 + -0.078441*(TEMPK/(25+273.15) -1)' 
 3003  
 3004  
 3005  
 3006  * Equations for temperature dependance of BGIDL:
 3007  * --------------------------------------------
 3008  .PARAM BGIDL = '7.8647E+09 + -1.9559E+09*(TEMPK/(25+273.15) -1)'
 3009  
 3010  
 3011  * Equations for temperature dependence of series resistances:
 3012  * -----------------------------------------------------------
 3013  .PARAM RDWMIN = 0
 3014  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 3015  .PARAM RSWMIN = 0
 3016  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 3017  .PARAM RDSWMIN = 0
 3018  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 3019  .PARAM RSW = 0
 3020  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 0*(TEMPK/(25+273.15) -1)), (0))'
 3021  .PARAM RDW = 0
 3022  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 0*(TEMPK/(25+273.15) -1)), (0))'
 3023  .PARAM RDSWEFF2 = '(RDSWEFF + 0*(TEMPK/(25+273.15) -1))'
 3024  .PARAM PRT = 0
 3025  
 3026  
