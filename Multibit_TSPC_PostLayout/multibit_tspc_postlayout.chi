 3017  .PARAM  CJSWGS  = '1.6208E-10*(1 + PSVTLP_DCJGATE_CMOS065)'
 3018  .PARAM  CJD     = '0.0012557*(1 + PSVTLP_DCJB_CMOS065)'
 3019  .PARAM  CJSWD   = '3.1862E-11*(1 + PSVTLP_DCJSW_CMOS065)'
 3020  .PARAM  CJSWGD  = '1.6208E-10*(1 + PSVTLP_DCJGATE_CMOS065)'
 3021  .PARAM  JSS     = '9.9977E-15*10^PSVTLP_DIDIODE_CMOS065'
 3022  .PARAM  JSWS    = '1.7696E-14*10^PSVTLP_DIDIODE_CMOS065'
 3023  .PARAM  JSWGS   = '5.6824E-14*10^PSVTLP_DIDIODE_CMOS065'
 3024  .PARAM  JTSS    = '1.0398E-05*10^PSVTLP_DIDIODE_CMOS065'
 3025  .PARAM  JTSSWS  = '2.9147E-10*10^PSVTLP_DIDIODE_CMOS065'
 3026  .PARAM  JTSSWGS = '7.3874E-11*10^PSVTLP_DIDIODE_CMOS065'
 3027  .PARAM  JSD     = '9.9977E-15*10^PSVTLP_DIDIODE_CMOS065'
 3028  .PARAM  JSWD    = '1.7696E-14*10^PSVTLP_DIDIODE_CMOS065'
 3029  .PARAM  JSWGD   = '5.6824E-14*10^PSVTLP_DIDIODE_CMOS065'
 3030  .PARAM  JTSD    = '1.0398E-05*10^PSVTLP_DIDIODE_CMOS065'
 3031  .PARAM  JTSSWD  = '2.9147E-10*10^PSVTLP_DIDIODE_CMOS065'
 3032  .PARAM  JTSSWGD = '7.3874E-11*10^PSVTLP_DIDIODE_CMOS065'
 3033  .PARAM DAGIDL  = PSVTLP_DAGIDL_CMOS065
 3034  .PARAM DCFRING = PSVTLP_DCFRING_CMOS065
 3035  .PARAM DRDSW   = PSVTLP_DRDSW_CMOS065
 3036  
 3037  .PARAM RSH      = '15 + PSVTLP_DRSH_CMOS065'
 3038  .PARAM RCONSD  = '37.5+PSVTLP_DRCONSD_CMOS065'
 3039  .PARAM RSHG     = '16.043 + PSVTLP_DRSHG_CMOS065'
 3040  
 3041  
 3042  
 3043  
 3044  
 3045  .PARAM RCONPO  = '47.3 + PSVTLP_DRCONPO_CMOS065'
 3046  .PARAM RSHGV   = '13.8613 + PSVTLP_DRSHGV_CMOS065'
 3047  .PARAM RSTIR   = '420 + PSVTLP_DRSTIR_CMOS065'
 3048  .PARAM RSTIL   = '0 + PSVTLP_DRSTIL_CMOS065'
 3049  .PARAM XBL     = 4.0E-08
 3050  .PARAM RBSDR   = 8.0E+03
 3051  .PARAM RBGBL   = 50
 3052  .PARAM CDSM0   = 9.0E-11
 3053  .PARAM CDSML   = 5.5E-08
 3054  .PARAM CBXM0   = 8.0E-11
 3055  .PARAM CGXM0   = 1.7E-17 
 3056  .PARAM CGXMW   = 1.59228E-17 
 3057  .PARAM CGXMW2  = 6.81673E-11
 3058  .PARAM CDSM1   = 7.5E-25 
 3059  .PARAM CDSM1W  = 1.29E-17
 3060  .PARAM CFL     = 2.7E-11
 3061  .PARAM LMAXCF  = 1.57E-06
 3062  .PARAM CFW     = 4.63E-18
 3063  
 3064  
 3065  * Layout and electrical dimensions:
 3066  *----------------------------------
 3067  .PARAM WM='W*TOMETER'
 3068  .PARAM LM='L*TOMETER'
 3069  .PARAM WFING='WM/NFING+XW'
 3070  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
 3071  .PARAM FS='2-FD'
 3072  .PARAM ADP ='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FD*(CONW/2.0+COEACT2)+XW/2)'
 3073  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
 3074  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
 3075  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
 3076  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 3077  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 3078  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 3079  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 3080  
 3081  
 3082  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
 3083  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 3084  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 3085  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
 3086  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
 3087  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
 3088  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
 3089  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 3090  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
 3091  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
 3092  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
 3093  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
 3094  
 3095  * DC Effective length and width:
 3096  *---------------------------
 3097  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3098  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3099  * AC Effective length and width:
 3100  *------------------------------
 3101  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3102  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(5E-17/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3103  *  Effective Source/Drain Junction width:
 3104  *---------------------------------------
 3105  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 3106  
 3107  
 3108  * Model improvement equations :
 3109  *------------------------------
 3110  
 3111   
 3112      * Continuous Model for mismatch deviations 
 3113  *----------------------------------------
 3114  .PARAM X_DEV        = 0.0 DEVX/GAUSS = {1.0}
 3115  .PARAM Y_DEV        = 0.0 DEVX/GAUSS = {1.0}
 3116  .PARAM Z_DEV        = 0.0 DEVX/GAUSS = {1.0}
 3117  .PARAM DVTH_AVT        = '3.0E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 3118  .PARAM DBETA_ABETA     = '0.53E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 3119  
 3120  
 3121  .PARAM PVT          = 4.9E-06      
 3122  .PARAM TPVT         = -0.025E-06     
 3123  .PARAM ZETAVT       = 0.94E+12
 3124  .PARAM DVTH_PVT    = '(PVT+TPVT*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETAVT*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 3125  .PARAM DVTH0_SIG = 'SQRT(DVTH_PVT*DVTH_PVT+DVTH_AVT*DVTH_AVT)'
 3126  .PARAM DVTH0_DEV = '(DVTH_AVT*X_DEV+DVTH_PVT*Y_DEV)*SVTLP_DEV*MISMATCH'
 3127  
 3128  
 3129  .PARAM PBETA        = 0.81E-05    
 3130  .PARAM TPBETA       = -0.0078E-05   
 3131  .PARAM ZETABETA     = 0.015E+12
 3132  .PARAM DBETA_PBETA = '(PBETA+TPBETA*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETABETA*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 3133  .PARAM DBETA_SIG = 'SQRT(DBETA_PBETA*DBETA_PBETA+DBETA_ABETA*DBETA_ABETA)'
 3134  .PARAM DBETA_DEV = '(DBETA_ABETA*Z_DEV+DBETA_PBETA*Y_DEV)*SVTLP_DEV*MISMATCH'
 3135  
 3136  .PARAM PROCESSSTATFLAGS = '1.0'
 3137  .PARAM DVTHTOT   = 'PSVTLP_DVTH0_CMOS065/(VALIF((PSVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((PSVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PSVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 3138  .PARAM VTH     = '-0.43+PSVTLP_DVTH0_CMOS065'
 3139  
 3140  
 3141  * Equation for  AGIDL:
 3142  * --------------------
 3143  .PARAM AGIDL   = '(2.3222E-07)*10^DAGIDL'
 3144  
 3145  
 3146  * Equations for mobility :
 3147  *-------------------------
 3148  .PARAM EPSILON2 = 1E-18
 3149  .PARAM LLIMIT = '3.4199E-08-XL' 
 3150  .PARAM WLIMIT = '2.48258E-07-XW' 
 3151  .PARAM DWU = 'DWU0+(-0.3)*0.5E6*(ABS(LE-1E-07)-(LE-1E-07))' 
 3152  .PARAM MOBILITY = '2.0/(0.01486383245+(LLIMIT+XL
 3153  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.001529610171/LE)
 3154  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 3155  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 3156  
 3157  
 3158  
 3159  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 3160  
 3161  
 3162  * Channel doping nch and body factor k1 worst case :
 3163  *---------------------------------------------------
 3164  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 3165  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 3166  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(3.8723E+17/NI)+0.18679+0.4'
 3167  .PARAM  K2        =  '(0.012139+-6.6409E-09/LE)*(TOX/2.4239E-09)'
 3168  .PARAM  K1        =  '(0.25156)-MOSTYPE*(-0.43-VTH)/SQRT(PHIS_TYP)'
 3169  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 3170  .PARAM  NCH       =  '3.8723E+17*(K1*K1)/((0.25156)*(0.25156))'
 3171  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18679+0.4'
 3172  * Series resistance worst case :
 3173  *-------------------------------
 3174  .PARAM RDSW      =  '(312+3E-05/WE)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 3175  .PARAM PRWB      =  -0.26884
 3176  
 3177  
 3178  
 3179  
 3180  
 3181  
 3182  .PARAM VSATEFF = '(1.4573E+05)'
 3183  
 3184  * Equations for stress :
 3185  *-----------------------
 3186  
 3187  .PARAM C_1	= 'CONW+COEACT2+CONPO'
 3188  .PARAM C_2 	= C_1
 3189  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
 3190  .PARAM B_2	= B_1 
 3191  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 3192  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 3193  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 3194  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 3195  * Stress effect on threshold voltage :
 3196  *-------------------------------------
 3197  
 3198  
 3199  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1E+12))+(1/LM -(0*NFING/WM+1E+12)))+1.3708E-09*NFING/WM+-0.0024556'
 3200  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3201  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PSVTLP_DVTH0_CMOS065+DVTHTOT'
 3202  * Stress effect on mobility :
 3203  *----------------------------
 3204  
 3205  
 3206  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-9.7441E-09)/2)*(ABS(1/LM-(-0.088*NFING/WM+3.1087E+06))-(1/LM -(-0.088*NFING/WM+3.1087E+06)))+((-6.439E-16*NFING/WM+2.9816E-09)/2)*(ABS(1/LM-(0.1532*NFING/WM +4.1101E+06))+(1/LM -(0.1532*NFING/WM+4.1101E+06)))+4.41E-10*NFING/WM+0.018161'
 3207  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3208  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 3209  * Stress effect on body factor K1 :
 3210  *----------------------------------
 3211  .PARAM VARMAXK1         = '0.00273+5.49E-10/LM+-7E-09*NFING/WM'
 3212  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3213  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 3214  * Stress effect on DVT0 :
 3215  *------------------------
 3216  .PARAM DVT0_STRESS        = 6
 3217  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 3218  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3219  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 3220  * Stress effect on access resistance :
 3221  *-------------------------------------
 3222  .PARAM VARMAXRDSW       = '0.103+-8.11E-09*NFING/WM'
 3223  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3224  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 3225  
 3226  
 3227  .PARAM NFACTOR = '(1.2065+1.2E-07/LE)*SQRT(PHIS*3.8723E+17/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 3228  
 3229  
 3230  
 3231  * Equations for VT :
 3232  *-------------------
 3233  .PARAM W0       = '4.6522E-07+(0-XW)'
 3234  .PARAM K3B      = '(7.0432)*(2.4239E-09/TOX)'
 3235  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 3236  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*3.8723E+17*1E6))'
 3237  .PARAM DVTP0    = 0
 3238  
 3239  
 3240  .PARAM N_SUBVT  = '1.0+(1.2065+1.2E-07/LE)*7.271700702E-09/XDEP0'
 3241  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+7E-07))'
 3242  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 3243  .PARAM K3       = '(-13.36+3E-07/(LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 3244  
 3245  
 3246  
 3247  * Equation for moin :
 3248  *-------------------
 3249  .PARAM MOIN = 'VALIF((10*((0.25156)/K1EFF)^2 > 5), (10*((0.25156)/K1EFF)^2), (5))'
 3250  
 3251  
 3252  * Equations for LKETA :
 3253  *---------------------
 3254  
 3255  .PARAM LKETAEXP = 'VALIF(((5.204538357E-07/LE-6311.66805) > 34), (34), (5.204538357E-07/LE-6311.66805))'
 3256  
 3257  .PARAM LKETA    = '0.00059794/(1.0+EXP(LKETAEXP))'
 3258  
 3259  
 3260  *Worst case methodology improvement: Short Channel effect
 3261  *--------------------------------------------------------
 3262  .PARAM LPE0  = '((((0.25156)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.72E-08)/(LMIN+8E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 3263  .PARAM LPEB  = '(5.9281E-08)/(LMIN+8E-09-2*LINT)*(LMIN+XL-2*LINT)'
 3264  .PARAM DVT1  = '0.077454*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 3265  .PARAM DVT1W = '1.6265E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 3266  .PARAM DSUB = '(0.050016)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 3267  
 3268  
 3269  
 3270  * Equations for Extrinsic Capacitances:
 3271  * ------------------------------------
 3272  
 3273  .PARAM CF = '(0)*(1 + DCFRING)'
 3274  .PARAM CGBO = '5.00E-10*(1 + DCFRING)'
 3275  
 3276  
 3277  .PARAM CGSL = '((1.40402E-10) + 0/LM  + 0/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 3278  .PARAM CGDL = '((1.40402E-10) + 0/LM  + 0/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 3279  .PARAM CGSO       =  '1.3393E-10*(2.4239E-09/TOX)'
 3280  .PARAM CGDO       =  '1.3393E-10*(2.4239E-09/TOX)'
 3281  
 3282  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 3283  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 3284  
 3285  
 3286  
 3287  * Equations for extrinsic S/D resistances:
 3288  * ---------------------------------------
 3289  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 3290  
 3291  
 3292  
 3293  * Salicided poly gate resistance:
 3294  * ------------------------------
 3295  
 3296  .PARAM RGATEMOD = 0
 3297  .PARAM RSHG0    = 16.043
 3298  
 3299  * Salicided Source/Drain diffusion access resistances:
 3300  * ---------------------------------------------------
 3301  .PARAM NRSEFF    = 'NRS'
 3302  .PARAM NRDEFF    = 'NRD'
 3303  
 3304  
 3305  
 3306  * Equations for poly gate resistance:
 3307  * -----------------------------------
 3308  .PARAM XGW        = 1.0E-07
 3309  .PARAM XGL        = -3.376E-08
 3310  .PARAM TC1G       = 2.3E-03
 3311  .PARAM TC2G       = 0
 3312  .PARAM TC1GV      = 0
 3313  .PARAM TC2GV      = 0
 3314  .PARAM LHEAD      = 'MAX(NFING*CONW+(NFING-1)*CONS+2*COEPO,NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS)))'
 3315  .PARAM NCHEAD     = 'NCRG*(1+TRUNC(((LHEAD-CONW-2*COEPO)/(CONW+CONS))+1E-12))'
 3316  .PARAM RGCON      = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 3317  .PARAM RSHGT      = 'MAX(1E-6,RSHG*(1+(TC1G+TC2G*(EFFTEMP-25))*(EFFTEMP-25)))'
 3318  .PARAM RSHGVT     = 'MAX(1E-6,RSHGV*(1+(TC1GV+TC2GV*(EFFTEMP-25))*(EFFTEMP-25)))'
 3319  .PARAM RGELTD     = 'RSHGT*(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*NFING)+RSHGVT*1E-12/((LM+XL)*(WM/NFING+XW)*NFING)'
 3320  .PARAM RGBSIM4    = '(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*1)'
 3321  .PARAM RSHGEFF    = '(RGELTD+RGCON)/RGBSIM4*NFING'
 3322  
 3323  * Equations for bulk resistance:
 3324  * ------------------------------
 3325  .PARAM RSTI       = '(RSTIR+RSTIL*WM/(12*NFING*(LM+XBL)))/NFING'
 3326  .PARAM RBSD       = '(RBSDR*1E-6)/(WM)'
 3327  .PARAM RBODYMOD   = 1
 3328  .PARAM RBPB       = 'RBGBL*1E-6/LM'
 3329  .PARAM RBPD       = 1E+09
 3330  .PARAM RBPS       = 1E+09
 3331  .PARAM RBDB       = 'RBSD*NFING/2'
 3332  .PARAM RBSB       = 'RBSD*NFING/2'
 3333  
 3334  * Equations for parasitic capacitances:
 3335  * -------------------------------------
 3336  .PARAM CGD_PLS    = '((NFING+FD)/2*CGXM0 + (NFING+FD)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FD*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 3337  .PARAM CGS_PLS    = '((NFING+FS)/2*CGXM0 + (NFING+FS)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FS*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 3338  .PARAM CDS_PLS    = '(CDSM1+CDSM1W*WFING)*NFING/(LM+2*CONPO)'
 3339  .PARAM CGDM	  = '(1-LPEC)*CGD_PLS*WEC*NFING '
 3340  .PARAM CGSM	  = '(1-LPEC)*CGS_PLS*WEC*NFING '
 3341  .PARAM CFLM       = 'CFL*LOG((1+0.5*(MIN(LM+XL,LMAXCF))/(CONPO-XL/2))/(1+0.5*(LMIN+XL)/(CONPO-XL/2)))'
 3342  .PARAM CFWM       = 'CFW*NGCON/WEC'
 3343  .PARAM CDSM       = 'CDSM0*(LMIN+2.0*CDSML)/(LM+2.0*CDSML)*(WM/NFING)*NFING+(1-LPEC)*CDS_PLS'
 3344  .PARAM CBDM       = 'CBXM0*(WM/NFING)*FD'
 3345  .PARAM CBSM       = 'CBXM0*(WM/NFING)*FS'
