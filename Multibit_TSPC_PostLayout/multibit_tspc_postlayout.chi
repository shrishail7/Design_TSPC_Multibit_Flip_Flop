 2165  M1 D G S B PSVTLPPUSP W='WM/NFING' L=LM AS='ASM/NFING' AD='ADM/NFING' PS='PSM/NFING' PD='PDM/NFING'
 2166  +          M='MULT*NFING' NRD='NRDEFF*NFING' NRS='NRSEFF*NFING' NF=1  
