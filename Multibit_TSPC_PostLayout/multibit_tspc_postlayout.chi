 1458  .PARAM NOIA    = '((TANH((LE-1E-07)*1.1E+06))*(1.80E+43)/2+3.00E+42)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 1459  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 1460  .PARAM NOIC    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
