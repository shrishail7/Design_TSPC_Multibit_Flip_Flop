 1255  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 1256  .PARAM POCOSM	= 'POCOS*TOMETER'
 1257  .PARAM POCODM	= 'POCOD*TOMETER'
 1258  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
 1259  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-6*1E-6/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 1260  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
 1261  + 1E-6/10.0*SCM*EXP(-10.0*SCM/1E-6)
 1262  + +1E-6*1E-6/100.0*EXP(-10.0*SCM/1E-6)
 1263  + -1E-6/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-6)
 1264  + -1E-6*1E-6/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-6)),0))'
 1265  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
 1266  + 1E-6/20.0*SCM*EXP(-20.0*SCM/1E-6)
 1267  + +1E-6*1E-6/400.0*EXP(-20.0*SCM/1E-6)
 1268  + -1E-6/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-6)
 1269  + -1E-6*1E-6/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-6)),0))'
 1270  
 1271  * DC Effective length and width:
 1272  *---------------------------
 1273  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1274  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1275  * AC Effective length and width:
 1276  *------------------------------
 1277  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1278  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(-7E-17/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1279  *  Effective Source/Drain Junction width:
 1280  *---------------------------------------
 1281  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 1282  
 1283  
 1284  * Model improvement equations :
 1285  *------------------------------
 1286  
 1287  * Equations for mismatch deviations:
 1288  *-----------------------------------
 1289  .PARAM DVTH0_ALPHA = (2.6E-9)
 1290  .PARAM DVTH0_BETA  = (0.0)
 1291  .PARAM DVTH0_FUDGE  = (1)
 1292  .PARAM DVTH0_ALPHA_C2 = (2.6E-9)
 1293  .PARAM DVTH0_BETA_C2  = (0.0)
 1294  .PARAM DVTH0_FUDGE_C2 = (1)
 1295  .PARAM DVTH0_SIG = {(((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DVTH0_ALPHA_C2/SQRT(WM*LM))+DVTH0_BETA_C2)*DVTH0_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
 1296  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SVTGP_DEV*MISMATCH}
 1297  .PARAM DBETA_ALPHA = (0.56E-8)
 1298  .PARAM DBETA_BETA  = (0.0)
 1299  .PARAM DBETA_FUDGE  = (1)
 1300  .PARAM DBETA_ALPHA_C2 = (0.56E-8)
 1301  .PARAM DBETA_BETA_C2  = (0.0)
 1302  .PARAM DBETA_FUDGE_C2 = (1)
 1303  .PARAM DBETA_SIG = {(((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DBETA_ALPHA_C2/SQRT(WM*LM))+DBETA_BETA_C2)*DBETA_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
 1304  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SVTGP_DEV*MISMATCH}
 1305  
 1306  
 1307  .PARAM PROCESSSTATFLAGS = '1.0'
 1308  .PARAM DVTHTOT   = 'PSVTGP_DVTH0_CMOS065/(VALIF((PSVTGP_DVTH0_CMOS065==0),(1),(0))+SQRT((PSVTGP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PSVTGP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PSVTGP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1309  .PARAM VTH     = '-0.233+PSVTGP_DVTH0_CMOS065'
 1310  
 1311  
 1312  * Equation for  AGIDL:
 1313  * --------------------
 1314  .PARAM AGIDL   = '(0.0057016)*10^DAGIDL'
 1315  
 1316  
 1317  * Equations for mobility :
 1318  *-------------------------
 1319  .PARAM EPSILON2 = 1E-18
 1320  .PARAM LLIMIT = '2.886E-08-XL' 
 1321  .PARAM WLIMIT = '-4.21809E-08-XW' 
 1322  .PARAM DWU = 'DWU0+(0)*0.5E6*(ABS(LE-2E-07)-(LE-2E-07))' 
 1323  .PARAM MOBILITY = '2.0/(0.01459354277+(LLIMIT+XL
 1324  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.001164414995/LE)
 1325  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1326  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1327  
 1328  
 1329  
 1330  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PSVTGP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1331  
 1332  
 1333  * Channel doping nch and body factor k1 worst case :
 1334  *---------------------------------------------------
 1335  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1336  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1337  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(6.9446E+17/NI)+0.18+0.4'
 1338  .PARAM  K2        =  '(-0.01609+-2E-09/LE)*(TOX/1.87E-09)'
 1339  .PARAM  K1        =  '(0.28221)-MOSTYPE*(-0.233-VTH)/SQRT(PHIS_TYP)'
 1340  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1341  .PARAM  NCH       =  '6.9446E+17*(K1*K1)/((0.28221)*(0.28221))'
 1342  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18+0.4'
 1343  * Series resistance worst case :
 1344  *-------------------------------
 1345  .PARAM RDSW      =  '(316.35+9.9E-13/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PSVTGP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1346  .PARAM PRWB      =  0
 1347  
 1348  
 1349  
 1350  
 1351  
 1352  
 1353  .PARAM VSATEFF = '(1.477E+05+-2E-10/(LE*WE))'
 1354  
 1355  * Equations for stress :
 1356  *-----------------------
 1357  
 1358  .PARAM C_1	= 'CONW+COEACT2+CONPO'
 1359  .PARAM C_2 	= C_1
 1360  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
 1361  .PARAM B_2	= B_1 
 1362  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 1363  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 1364  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 1365  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 1366  * Stress effect on threshold voltage :
 1367  *-------------------------------------
 1368  
 1369  
 1370  .PARAM VARMAXVTH0       = '((-1.2353E-17*NFING/WM+-1.6765E-10)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))-(1/LM -(0*NFING/WM +1E+07)))+((0*NFING/WM+6E-10)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))+(1/LM -(0*NFING/WM+1E+07)))+8.8235E-11*NFING/WM+0.00041177'
 1371  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1372  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PSVTGP_DVTH0_CMOS065+DVTHTOT'
 1373  * Stress effect on mobility :
 1374  *----------------------------
 1375  
 1376  
 1377  .PARAM VARMAXU0 	= '((0*NFING/WM+1E-09)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))-(1/LM -(0*NFING/WM+1E+07)))+((-8E-16*NFING/WM+2.5882E-09)/2)*(ABS(1/LM-(0*NFING/WM +1E+07))+(1/LM -(0*NFING/WM+1E+07)))+3.0882E-09*NFING/WM+-0.0055882'
 1378  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1379  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 1380  * Stress effect on body factor K1 :
 1381  *----------------------------------
 1382  .PARAM VARMAXK1         = '0.023488+-9.8448E-10/LM+-7.8493E-10*NFING/WM'
 1383  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1384  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 1385  * Stress effect on DVT0 :
 1386  *------------------------
 1387  .PARAM DVT0_STRESS        = 690
 1388  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 1389  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1390  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 1391  * Stress effect on access resistance :
 1392  *-------------------------------------
 1393  .PARAM VARMAXRDSW       = '0+0*NFING/WM'
 1394  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1395  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 1396  
 1397  
 1398  .PARAM NFACTOR = '(0.74266+1.3842E-07/LE)*SQRT(PHIS*6.9446E+17/(PHIS_TYP*NCH))*(1.87E-09/TOX)'
 1399  
 1400  
 1401  
 1402  * Equations for VT :
 1403  *-------------------
 1404  .PARAM W0       = '2.4962E-07+(0-XW)'
 1405  .PARAM K3B      = '(7)*(1.87E-09/TOX)'
 1406  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1407  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*6.9446E+17*1E6))'
 1408  .PARAM DVTP0    = 0
 1409  
 1410  
 1411  .PARAM N_SUBVT  = '1.0+(0.74266+1.3842E-07/LE)*5.610000542E-09/XDEP0'
 1412  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+4E-07))'
 1413  .PARAM TMP2     = '1.683E-09/(WE+W0)'
 1414  .PARAM K3       = '(-9.5897+-1.2E-07/(LE*(LMIN+-4E-09-2*LINT)/(LMIN+XL-2*LINT))+4E-14/((LE*(LMIN+-4E-09-2*LINT)/(LMIN+XL-2*LINT))*WE))*(1.87E-09/TOX)+VTH_RSCE/TMP2'
 1415  
 1416  
 1417  
 1418  * Equation for moin :
 1419  *-------------------
 1420  .PARAM MOIN = 'VALIF((5.6774*((0.28221)/K1EFF)^2 > 5), (5.6774*((0.28221)/K1EFF)^2), (5))'
 1421  
 1422  
 1423  * Equations for LKETA :
 1424  *---------------------
 1425  
 1426  .PARAM LKETAEXP = 'VALIF(((1.452935074E-07/LE--4.745827451E-06) > 34), (34), (1.452935074E-07/LE--4.745827451E-06))'
 1427  
 1428  .PARAM LKETA    = '-0.10117/(1.0+EXP(LKETAEXP))'
 1429  
 1430  
 1431  *Worst case methodology improvement: Short Channel effect
 1432  *--------------------------------------------------------
 1433  .PARAM LPE0  = '((((0.28221)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(2.42E-08)/(LMIN+-4E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1434  .PARAM LPEB  = '(0)/(LMIN+-4E-09-2*LINT)*(LMIN+XL-2*LINT)'
 1435  .PARAM DVT1  = '2.235*SQRT(TOX/1.87E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1436  .PARAM DVT1W = '2.9873E+05*SQRT(TOX/1.87E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1437  .PARAM DSUB = '(0.27226)*SQRT(TOX/1.87E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1438  
 1439  
 1440  
 1441  * Equations for Extrinsic Capacitances:
 1442  * ------------------------------------
 1443  
 1444  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
 1445  
 1446  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
 1447  .PARAM C3EXT = '(9.681E-18 + 7.403E-11*(LM + XL))'
 1448  
 1449  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.237E-17 + 2.400E-18*TANH((LM + XL)/1.258E-07)),(1.474E-17 + 3.229E-18*TANH((LM + XL)/1.497E-07)))'
 1450  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.458E-17 + 9.132E-19*TANH((WM/NFING + XW)/1.568E-06) + 1.875E-17*TANH((LM + XL)/5.032E-07)),(1.240E-17 + -2.833E-17*TANH((WM/NFING + XW)/1.635E-06) + 1.043E-17*TANH((LM + XL)/2.752E-07)))' 
 1451  
 1452  
 1453  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-4.315E-19*(1-ALIGNMENT_PRELAYOUT) + 8.264E-11*(WM/NFING + XW) + 4.014E-11*(WM/NFING + XW)*TANH((LM + XL)/3.174E-07)) ,(4.263E-19*(1-ALIGNMENT_PRELAYOUT) + 2.618E-11*(WM/NFING + XW) + 1.895E-11*(WM/NFING + XW)*TANH((LM + XL)/2.508E-07)))'
 1454  
 1455  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 1456  
 1457  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
 1458  
 1459  .PARAM CGSL = '((9E-11) + 1E-17/LM  + -4.5E-25/LM^2 + -8E-18/WM*NFING + 8.4988E-25/WM^2*NFING^2)*(1.87E-09/TOX)' 
 1460  .PARAM CGDL = '((9E-11) + 1E-17/LM  + -4.5E-25/LM^2 + -8E-18/WM*NFING + 8.4988E-25/WM^2*NFING^2)*(1.87E-09/TOX)' 
 1461  .PARAM CGSO       =  'VALIF((POCOSM>0),(1E-13*(1.87E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.8098E-07)*(TANH(POCOSM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.87E-09/TOX))'
 1462  .PARAM CGDO       =  'VALIF((POCOSM>0),(1E-13*(1.87E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.8098E-07)*(TANH(POCODM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.87E-09/TOX))'
 1463  
 1464  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1465  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1466  
 1467  
 1468  
 1469  * Equations for extrinsic S/D resistances:
 1470  * ---------------------------------------
 1471  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 1472   
 1473  * Unsilicided poly gate resistance:
 1474  * --------------------------------
 1475  .PARAM RSHGUMMID = '(620+RSHGUM)/2 + (620-RSHGUM)*TANH(1E18*(2*2.2E-8-LM-XL))/2'
 1476  .PARAM RSHGUMEFF = 'RSHGUMMID*620*(LM+XL)/(2*2.2E-8*RSHGUMMID + (LM+XL-2*2.2E-8)*620)'
 1477  
