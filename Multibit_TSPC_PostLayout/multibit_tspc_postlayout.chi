 1144  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
 1145  .PARAM K3       = '(-5.2029+2.5839E-08/(LE*(LMIN+-3E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
