 2504  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+9.7209E-07))'
 2505  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 2506  .PARAM K3       = '(-13.36+3E-07/(LE*(LMIN+0-2*LINT)/(LMIN+XL-2*LINT)))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 2507  
 2508  
 2509  
 2510  * Equation for moin :
 2511  *-------------------
 2512  .PARAM MOIN = 'VALIF((10*((0.25156)/K1EFF)^2 > 5), (10*((0.25156)/K1EFF)^2), (5))'
 2513  
 2514  
 2515  * Equations for LKETA :
 2516  *---------------------
 2517  
 2518  .PARAM LKETAEXP = 'VALIF(((2.646973186E-07/LE-3.020555489) > 34), (34), (2.646973186E-07/LE-3.020555489))'
 2519  
 2520  .PARAM LKETA    = '-0.019729/(1.0+EXP(LKETAEXP))'
 2521  
 2522  
 2523  *Worst case methodology improvement: Short Channel effect
 2524  *--------------------------------------------------------
 2525  .PARAM LPE0  = '((((0.25156)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4.5877E-08)/(LMIN+0-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 2526  .PARAM LPEB  = '(-5.9281E-10)/(LMIN+0-2*LINT)*(LMIN+XL-2*LINT)'
 2527  .PARAM DVT1  = '0.077454*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 2528  .PARAM DVT1W = '2.0191E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2529  .PARAM DSUB = '(0.065407)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2530  
 2531  
 2532  
 2533  * Equations for Extrinsic Capacitances:
 2534  * ------------------------------------
 2535  
 2536  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 2537  
 2538  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 2539  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 2540  
 2541  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 2542  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 2543  
 2544  
 2545  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 2546  
 2547  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 2548  
 2549  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
 2550  
 2551  .PARAM CGSL = '(6.7972E-11)*(2.4239E-09/TOX)'
 2552  .PARAM CGDL = '(6.7972E-11)*(2.4239E-09/TOX)'
 2553  .PARAM CGSO       =  '7.948E-11*(2.4239E-09/TOX)'
 2554  .PARAM CGDO       =  '7.948E-11*(2.4239E-09/TOX)'
 2555  
 2556  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2557  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2558  
 2559  
 2560  
 2561  * Equations for extrinsic S/D resistances:
 2562  * ---------------------------------------
 2563  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*80*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(0*CONPO*NFING/WM)'
 2564  
 2565  
 2566  
 2567  * Salicided poly gate resistance:
 2568  * ------------------------------
 2569  
 2570  .PARAM RGATEMOD = 0
 2571  .PARAM RSHG0    = 0
 2572  
 2573  * Salicided Source/Drain diffusion access resistances:
 2574  * ---------------------------------------------------
 2575  .PARAM NRSEFF    = 'NRS'
 2576  .PARAM NRDEFF    = 'NRD'
 2577  
 2578  
 2579  
 2580  * Equations for VOFF:
 2581  * ------------------
 2582  
 2583  .PARAM VOFF = '-0.1466 + -0.10745*(TEMPK/(25+273.15) -1)' 
 2584  
 2585  
 2586  
 2587  * Equations for temperature dependance of BGIDL:
 2588  * --------------------------------------------
 2589  .PARAM BGIDL = '3.9181E+09 + -1.9559E+09*(TEMPK/(25+273.15) -1)'
 2590  
 2591  
 2592  * Equations for temperature dependence of series resistances:
 2593  * -----------------------------------------------------------
 2594  .PARAM RDWMIN = 0
 2595  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 200*(TEMPK/(25+273.15) -1)), (0))'
 2596  .PARAM RSWMIN = 0
 2597  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 200*(TEMPK/(25+273.15) -1)), (0))'
 2598  .PARAM RDSWMIN = 0
 2599  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 200*(TEMPK/(25+273.15) -1)), (0))'
 2600  .PARAM RSW = 0
 2601  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 200*(TEMPK/(25+273.15) -1)), (0))'
 2602  .PARAM RDW = 0
 2603  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 200*(TEMPK/(25+273.15) -1)), (0))'
 2604  .PARAM RDSWEFF2 = '(RDSWEFF + 200*(TEMPK/(25+273.15) -1))'
 2605  .PARAM PRT = 0
 2606  
