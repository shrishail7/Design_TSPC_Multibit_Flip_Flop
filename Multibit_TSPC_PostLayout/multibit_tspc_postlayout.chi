  144  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  145  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
  146  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
  147  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
  148  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
  149  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  150  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
  151  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
  152  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
  153  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
