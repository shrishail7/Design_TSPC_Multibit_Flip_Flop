 1082  .SETSOA LABEL="P8 ==> Isolation safe voltage ranges violation : MOS HCI limitation on S side" E IF (V(G,D)-VT(M1)<0) && (V(D,S)>0.2) THEN V(B,S)=(-0.2,1.2) ENDIF 
