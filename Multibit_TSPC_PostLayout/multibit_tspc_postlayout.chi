  674  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
  675  .PARAM FS='2-FD'
  676  .PARAM ADP ='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FD*(CONW/2.0+COEACT2)+XW/2)'
  677  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
  678  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
  679  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
  680  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  681  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  682  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
  683  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
