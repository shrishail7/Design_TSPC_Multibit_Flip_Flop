  501  .PARAM MFLAG_MC        = 'VALIF((SRAMSPHVTLP_DEV==1),(1),(0))'
  502  .PARAM MFLAG_CORNER    = 'VALIF((SRAMSPHVTLP_DEV==2),(1),(0))'
  503  .PARAM MFLAG_PARAM     = 'VALIF((SRAMSPHVTLP_DEV==3),(1),(0))'
