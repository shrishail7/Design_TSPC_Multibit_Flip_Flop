 1129  .PARAM NFACTOR = '(1.3251)*SQRT(PHIS*7.863E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
 1130  
 1131  
 1132  
 1133  * Equations for VT :
 1134  *-------------------
 1135  .PARAM W0       = '2.2957E-08+(0-XW)'
 1136  .PARAM K3B      = '(3+-1.7E-07/LE)*(2.3926E-09/TOX)'
 1137  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1138  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*7.863E+17*1E6))'
 1139  .PARAM DVTP0    = 0
 1140  
 1141  
 1142  .PARAM N_SUBVT  = '1.0+(1.3251)*7.177800693E-09/XDEP0'
 1143  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.3E-06))'
 1144  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
 1145  .PARAM K3       = '(-5.8321)*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
 1146  
 1147  
 1148  
 1149  * Equation for moin :
 1150  *-------------------
 1151  .PARAM MOIN = 'VALIF((5.8569*((0.35383)/K1EFF)^2 > 5), (5.8569*((0.35383)/K1EFF)^2), (5))'
 1152  
 1153  
 1154  * Equations for LKETA :
 1155  *---------------------
 1156  
 1157  
 1158  .PARAM LKETA    = '0.0087889 + -0.01*(TEMPK/(25+273.15) -1)'
 1159  
 1160  
 1161  *Worst case methodology improvement: Short Channel effect
 1162  *--------------------------------------------------------
 1163  .PARAM LPE0  = '((((0.35383)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(3E-08+6E-15/LE)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1164  .PARAM LPEB  = '(0)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
 1165  .PARAM DVT1  = '0.032462*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1166  .PARAM DVT1W = '8.598E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1167  .PARAM DSUB = '(0.73367)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1168  
 1169  
 1170  
 1171  * Equations for Extrinsic Capacitances:
 1172  * ------------------------------------
 1173  
 1174  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 1175  
 1176  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 1177  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 1178  
 1179  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 1180  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 1181  
 1182  
 1183  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 1184  
 1185  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 1186  
 1187  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
 1188  
 1189  .PARAM CGSL = '(7.3597E-11)*(2.3926E-09/TOX)'
 1190  .PARAM CGDL = '(7.3597E-11)*(2.3926E-09/TOX)'
 1191  .PARAM CGSO       =  '1E-10*(2.3926E-09/TOX)'
 1192  .PARAM CGDO       =  '1E-10*(2.3926E-09/TOX)'
 1193  
 1194  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1195  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1196  
 1197  
 1198  
 1199  * Equations for extrinsic S/D resistances:
 1200  * ---------------------------------------
 1201  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*70*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(0*CONPO*NFING/WM)'
