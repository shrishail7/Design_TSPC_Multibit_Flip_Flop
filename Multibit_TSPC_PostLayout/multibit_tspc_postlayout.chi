 2138  + CDSC=0.5              WCDSC=-0.17           CDSCB=2.8791E-08      
 2139  + WCDSCB=-0.11998       CDSCD=0.18357         MOBMOD=2              
 2140  + U0=U0EFF              UA=7.5723E-13         LUA=5.1412E-15        
 2141  + WUA=1.2586E-14        UC=-1.25E-13          UD=0                  
 2142  + UP=0                  EU=1.3705             RDSMOD=0              
 2143  + RDSW=RDSWEFF2         PRDSW=0               RDSWMIN=0             
 2144  + PRWG=0                PRWB=PRWB             WR=1                  
 2145  + RSH=RSH               VSAT=VSATEFF          PVSAT=0               
 2146  + A0=3.9999             LA0=-0.035396         A1=0.44999            
