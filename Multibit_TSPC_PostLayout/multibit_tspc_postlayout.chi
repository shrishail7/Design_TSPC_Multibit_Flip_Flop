  455  *----------------------------------------------------------------------
  456  .SUBCKT NSVTLPPDSP620 D G S B
  457  *----------------------------------------------------------------------
  458  * Family nsramspsvtlp Model nsvtlppdsp620 bsim4 typ
  459  * release 1.1.h
  460  *----------------------------------------------------------------------
  461  *----------------------------------------------------------------------
  462  +       PARAM:W=0.14 L=0.065 NFING=1.0 NCRSD=1.0 MISMATCH=1.0 SRCEFIRST=1.0 TOMETER=1E-06 LPE=0.0 
  463  + AS=-1 AD=-1 PS=-1 PD=-1 MULT=1.0 NRD=0.0 NRS=0.0 NGCON=1.0 DVT_MDEV=0.0 DMU_MDEV=0.0 
  464  + 
  465  
  466  
  467  
  468  *------------------------------------------------------------------------------
  469  * flag used to switch on/off device access modeling (for post layout simulation)
  470  *------------------------------------------------------------------------------
  471  *   lpe     Body      Access_R  Access_C   Extraction_mode
  472  *    0       yes        yes       yes           --
  473  *    1       yes        yes       no             C
  474  *    2       yes        no        yes            R
  475  *    3       yes        no        no             RC
  476  *
  477  .PARAM LPER = 'VALIF(((LPE==2) || (LPE==3)),(1),(0))'
  478  .PARAM LPEC = 'VALIF(((LPE==1) || (LPE==3) || (LPE==97)),(1),(0))'
  479  .PARAM ALIGNMENT_PRELAYOUT  = 'VALIF(((LPE==99) || (LPE==98)),(1),(0))'
  480  .PARAM ALIGNMENT_POSTLAYOUT = 'VALIF((LPE==98),(1),(0))'
  481  .PARAM LPEC2 = 'VALIF(((LPE==1) || (LPE==3)),(1),(0))'
  482  
  483  
  484  *-----------------------------------------------------------------------------------------------------
  485  * flag used to switch on/off Source and Drain diffusion access resistances (for post layout simulation) 
  486  *-----------------------------------------------------------------------------------------------------
  487  .PARAM NRSD_FLAG = 'VALIF(((NRS==0) && (NRD==0)),(0),(1))'
  488  
  489  
  490  
  491  *--------------------------------------------------------
  492  * flag used to switch on/off mismatch into process corners
  493  *--------------------------------------------------------
  494  * sramspsvtlp_dev  no_mm  mc_mm  mm_in_corners  param_mm
  495  *       0       yes    no     no             no
  496  *       1       no     yes    no             no
  497  *       2       no     no     yes            no
  498  *       3       no     no     no             yes
  499  *
  500  .PARAM MFLAG_NO        = 'VALIF((SRAMSPSVTLP_DEV==0),(1),(0))'
  501  .PARAM MFLAG_MC        = 'VALIF((SRAMSPSVTLP_DEV==1),(1),(0))'
  502  .PARAM MFLAG_CORNER    = 'VALIF((SRAMSPSVTLP_DEV==2),(1),(0))'
  503  .PARAM MFLAG_PARAM     = 'VALIF((SRAMSPSVTLP_DEV==3),(1),(0))'
  504  
  505  
  506  
  507  
  508  * Device temperature:
  509  *--------------------
  510  .PARAM TEMPK   = 'TEMPER+273.15'
  511  
  512  
  513  * invariant parameters:
  514  *----------------------
  515  .PARAM MOSTYPE = 1  
  516  
  517  .PARAM CONW    = '0.09E-6'
  518  .PARAM CONS    = '0.11E-6'
  519  .PARAM COEACT1  = '0.015E-6'
  520  .PARAM COEACT2  = '0.03E-6'
  521  .PARAM CONPO   = '0.055E-6'
  522  .PARAM PO2DB   = '0.100E-6'
  523  .PARAM LINT    = -2.4175E-09
  524  .PARAM DLC     = 1.35E-08
  525  .PARAM LMIN    = 6E-8
  526  .PARAM DWU0    = -0.13462
  527  .PARAM WINT    = -19.207E-09
  528  .PARAM DWC     = -5E-09
  529  .PARAM DWJ     = 0
  530  .PARAM COEPO   = '0.01E-6'
  531  
  532  .PARAM DIODEMOD = 1
  533  
  534  
  535  
  536  * variant parameters:
  537  *--------------------
  538  .PARAM XL      = '-3E-09 + NSRAMSPSVTLP_DXL_CMOS065'
  539  .PARAM XW      = '0 + NSRAMSPSVTLP_DXW_CMOS065'
  540  .PARAM TOX     = '2.3926E-09 + NSRAMSPSVTLP_DTOXE_CMOS065'
  541  .PARAM DMU     = NSRAMSPSVTLP_DMU_CMOS065
  542  
  543  .PARAM NOIA    = '(6E+42)*(1 + NSRAMSPSVTLP_DNOISE_CMOS065)'
  544  .PARAM NOIB    = '(0)*(1 + NSRAMSPSVTLP_DNOISE_CMOS065)'
  545  .PARAM NOIC    = '(0)*(1 + NSRAMSPSVTLP_DNOISE_CMOS065)'
  546  
  547  .PARAM  CJS     = '0.0012368*(1 + NSRAMSPSVTLP_DCJB_CMOS065)'
  548  .PARAM  CJSWS   = '3.4918E-11*(1 + NSRAMSPSVTLP_DCJSW_CMOS065)'
  549  .PARAM  CJSWGS  = '1.8517E-10*(1 + NSRAMSPSVTLP_DCJGATE_CMOS065)'
  550  .PARAM  CJD     = '0.0012368*(1 + NSRAMSPSVTLP_DCJB_CMOS065)'
  551  .PARAM  CJSWD   = '3.4918E-11*(1 + NSRAMSPSVTLP_DCJSW_CMOS065)'
  552  .PARAM  CJSWGD  = '1.8517E-10*(1 + NSRAMSPSVTLP_DCJGATE_CMOS065)'
  553  .PARAM  JSS     = '0*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  554  .PARAM  JSWS    = '3.1831E-14*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  555  .PARAM  JSWGS   = '0*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  556  .PARAM  JTSS    = '6.9304E-06*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  557  .PARAM  JTSSWS  = '1.1025E-10*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  558  .PARAM  JTSSWGS = '3.0879E-11*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  559  .PARAM  JSD     = '0*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  560  .PARAM  JSWD    = '3.1831E-14*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  561  .PARAM  JSWGD   = '0*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  562  .PARAM  JTSD    = '6.9304E-06*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  563  .PARAM  JTSSWD  = '1.1025E-10*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  564  .PARAM  JTSSWGD = '3.0879E-11*10^NSRAMSPSVTLP_DIDIODE_CMOS065'
  565  .PARAM DAGIDL  = NSRAMSPSVTLP_DAGIDL_CMOS065
  566  .PARAM DCFRING = NSRAMSPSVTLP_DCFRING_CMOS065
  567  .PARAM DRDSW   = NSRAMSPSVTLP_DRDSW_CMOS065
  568  
  569  
  570  .PARAM RSH      = '0'
  571  .PARAM RCONSD  = '70+NSRAMSPSVTLP_DRCONSD_CMOS065'
  572  .PARAM RSHG     = '0 + NSRAMSPSVTLP_DRSHG_CMOS065'
  573  
  574  
  575  
  576  
  577  
  578  * Layout and electrical dimensions:
  579  *----------------------------------
  580  .PARAM WM='W*TOMETER'
  581  .PARAM LM='L*TOMETER'
  582  .PARAM WFING='WM/NFING+XW'
  583  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
  584  .PARAM FS='2-FD'
  585  .PARAM PDP='VALIF(((W*TOMETER)<=1.6E-7),(VALIF(((L*TOMETER)<=7.5E-8),(2.49565E-07),(2.55652E-07))),(VALIF(((L*TOMETER)<=7.5E-8),(2.55676E-07),(2.55676E-07))))'
  586  .PARAM PSP='VALIF(((W*TOMETER)<=1.6E-7),(VALIF(((L*TOMETER)<=7.5E-8),(1.8E-07),(1.8E-07))),(VALIF(((L*TOMETER)<=7.5E-8),(1.8E-07),(1.8E-07))))'
  587  .PARAM ADP='VALIF(((W*TOMETER)<=1.6E-7),(VALIF(((L*TOMETER)<=7.5E-8),(1.30565E-14),(1.34826E-14))),(VALIF(((L*TOMETER)<=7.5E-8),(1.98E-14),(1.98E-14))))'
  588  .PARAM ASP='VALIF(((W*TOMETER)<=1.6E-7),(VALIF(((L*TOMETER)<=7.5E-8),(1.26E-14),(1.26E-14))),(VALIF(((L*TOMETER)<=7.5E-8),(1.98E-14),(1.98E-14))))'
  589  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  590  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  591  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
  592  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
  593  * DC Effective length and width:
  594  *---------------------------
  595  .PARAM WE      = '(WM/NFING+XW-2*WINT)'
  596  .PARAM LE      = 'LM+XL-2.0*LINT'
  597  * AC Effective length and width:
  598  *------------------------------
  599  .PARAM WEC     = '(WM/NFING+XW-2*DWC)'
  600  .PARAM LEC     = 'LM+XL-2.0*DLC'
  601  *  Effective Source/Drain Junction width:
  602  *---------------------------------------
  603  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  604  
  605  
  606  * Model improvement equations :
  607  *------------------------------
  608  
  609  * Equations for mismatch deviations:
  610  *-----------------------------------
  611  .PARAM DVTH0_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(4.5E-9),(5.1E-9))
  612  .PARAM DVTH0_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  613  .PARAM DVTH0_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
  614  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
  615  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMSPSVTLP_DEV*MISMATCH}
  616  .PARAM DBETA_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.69E-8),(0.65E-8))
  617  .PARAM DBETA_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  618  .PARAM DBETA_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
  619  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
  620  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMSPSVTLP_DEV*MISMATCH}
  621  
  622  
  623  .PARAM PROCESSSTATFLAGS = '1.0'
  624  .PARAM DVTHTOT   = 'NSVTLPPDSP_DVTH0_CMOS065/(VALIF((NSVTLPPDSP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTLPPDSP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMSPSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTLPPDSP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  625  .PARAM VTH     = '0.46739+NSVTLPPDSP_DVTH0_CMOS065'
  626  
  627  
  628  * Equation for  AGIDL:
  629  * --------------------
  630  .PARAM AGIDL   = '(0.00014407)*10^DAGIDL'
  631  
  632  
  633  * Equations for mobility :
  634  *-------------------------
  635  .PARAM EPSILON2 = 1E-18
  636  .PARAM LLIMIT = '7.6175E-08-XL' 
  637  .PARAM WLIMIT = '2.41736E-07-XW' 
  638  .PARAM DWU = 'DWU0+(7.7762)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
  639  .PARAM MOBILITY = '2.0/(0.007533670034+(LLIMIT+XL
  640  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.00382996633/LE)
  641  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  642  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  643  
  644  
  645  
  646  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSRAMSPSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  647  
  648  
  649  * Channel doping nch and body factor k1 worst case :
  650  *---------------------------------------------------
  651  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  652  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  653  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(7.863E+17/NI)+0.25043+0.4'
  654  .PARAM  K2        =  '(0.024422+-5.2602E-09/LE)*(TOX/2.3926E-09)'
  655  .PARAM  K1        =  '(0.35383)-MOSTYPE*(0.46739-VTH)/SQRT(PHIS_TYP)'
  656  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  657  .PARAM  NCH       =  '7.863E+17*(K1*K1)/((0.35383)*(0.35383))'
  658  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  659  * Series resistance worst case :
  660  *-------------------------------
  661  .PARAM RDSW      =  '(707.87+-4.2669E-05/LE+-0.00010948/WE+9.5E-12/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSRAMSPSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  662  .PARAM PRWB      =  0.057545
  663  
  664  
  665  
  666  
  667  
  668  .PARAM  VTH0EFF   =  'VTH0-NSVTLPPDSP_DVTH0_CMOS065+DVTHTOT'
  669  .PARAM U0EFF            = U0
  670  .PARAM K1EFF		= K1
  671  .PARAM DVT0EFF		= -0.03
  672  .PARAM RDSWEFF0          = RDSW 
  673  .PARAM VSATEFF = '(1.84E+05+-0.0121/WE)'
  674  
  675  
  676  .PARAM NFACTOR = '(1.3251)*SQRT(PHIS*7.863E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
  677  
  678  
  679  
  680  * Equations for VT :
  681  *-------------------
  682  .PARAM W0       = '2.2957E-08+(0-XW)'
  683  .PARAM K3B      = '(3+-1.7E-07/LE)*(2.3926E-09/TOX)'
  684  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  685  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*7.863E+17*1E6))'
  686  .PARAM DVTP0    = 0
  687  
  688  
  689  .PARAM N_SUBVT  = '1.0+(1.3251)*7.177800693E-09/XDEP0'
  690  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.3E-06))'
  691  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
  692  .PARAM K3       = '(-5.8321)*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
  693  
  694  
  695  
  696  * Equation for moin :
  697  *-------------------
  698  .PARAM MOIN = 'VALIF((5.8569*((0.35383)/K1EFF)^2 > 5), (5.8569*((0.35383)/K1EFF)^2), (5))'
  699  
  700  
  701  * Equations for LKETA :
  702  *---------------------
  703  
  704  
  705  .PARAM LKETA    = '0.0087889 + -0.01*(TEMPK/(25+273.15) -1)'
  706  
  707  
  708  *Worst case methodology improvement: Short Channel effect
  709  *--------------------------------------------------------
  710  .PARAM LPE0  = '((((0.35383)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(3E-08+6E-15/LE)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  711  .PARAM LPEB  = '(0)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
  712  .PARAM DVT1  = '0.032462*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  713  .PARAM DVT1W = '8.598E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  714  .PARAM DSUB = '(0.73367)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  715  
  716  
  717  
  718  * Equations for Extrinsic Capacitances:
  719  * ------------------------------------
  720  
  721  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  722  
  723  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  724  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  725  
  726  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  727  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  728  
  729  
  730  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  731  
  732  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  733  
  734  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
  735  
  736  .PARAM CGSL = '(7.3597E-11)*(2.3926E-09/TOX)'
  737  .PARAM CGDL = '(7.3597E-11)*(2.3926E-09/TOX)'
  738  .PARAM CGSO       =  '1E-10*(2.3926E-09/TOX)'
  739  .PARAM CGDO       =  '1E-10*(2.3926E-09/TOX)'
  740  
  741  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  742  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  743  
  744  
  745  
  746  * Equations for extrinsic S/D resistances:
  747  * ---------------------------------------
  748  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*70*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(0*CONPO*NFING/WM)'
  749  
  750  
  751  
  752  * Salicided poly gate resistance:
  753  * ------------------------------
  754  
  755  .PARAM RGATEMOD = 0
  756  .PARAM RSHG0    = 0
  757  
  758  * Salicided Source/Drain diffusion access resistances:
  759  * ---------------------------------------------------
  760  .PARAM NRSEFF    = 'NRS'
  761  .PARAM NRDEFF    = 'NRD'
  762  
  763  
  764  
  765  * Equations for VOFF:
  766  * ------------------
  767  
  768  .PARAM VOFF = '-0.059216 + -0.14555*(TEMPK/(25+273.15) -1)' 
  769  
  770  
  771  
  772  * Equations for temperature dependance of BGIDL:
  773  * --------------------------------------------
  774  .PARAM BGIDL = '7.8683E+09 + -1.198E+09*(TEMPK/(25+273.15) -1)'
  775  
  776  
  777  * Equations for temperature dependence of series resistances:
  778  * -----------------------------------------------------------
  779  .PARAM RDWMIN = 0
  780  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 450*(TEMPK/(25+273.15) -1)), (0))'
  781  .PARAM RSWMIN = 0
  782  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 450*(TEMPK/(25+273.15) -1)), (0))'
  783  .PARAM RDSWMIN = 0
  784  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 450*(TEMPK/(25+273.15) -1)), (0))'
  785  .PARAM RSW = 0
  786  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 450*(TEMPK/(25+273.15) -1)), (0))'
  787  .PARAM RDW = 0
  788  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 450*(TEMPK/(25+273.15) -1)), (0))'
  789  .PARAM RDSWEFF2 = '(RDSWEFF + 450*(TEMPK/(25+273.15) -1))'
  790  .PARAM PRT = 0
  791  
  792  
  793  * Equations for thermal noise scaling
  794  * ------------------------------------
  795  .PARAM NTNOI = '1*LE/LEC'
  796  
  797  
  798  
  799  
