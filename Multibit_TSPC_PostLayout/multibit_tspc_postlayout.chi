  285  .PARAM CGDL = '(6.7922E-11)*(2.3926E-09/TOX)'
  286  .PARAM CGSO       =  '9.414E-11*(2.3926E-09/TOX)'
  287  .PARAM CGDO       =  '9.414E-11*(2.3926E-09/TOX)'
