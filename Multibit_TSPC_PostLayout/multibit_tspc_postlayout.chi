 2769  .PARAM NOIA    = '((TANH((LE-1)*1))*(0)/2+4.4E+42)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 2770  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 2771  .PARAM NOIC    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*DNOISE_MDEV)'
