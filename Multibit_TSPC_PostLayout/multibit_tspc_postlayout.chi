  170  .PARAM PROCESSSTATFLAGS = '1.0'
  171  .PARAM DVTHTOT   = 'NHVTLPPDDP_DVTH0_CMOS065/(VALIF((NHVTLPPDDP_DVTH0_CMOS065==0),(1),(0))+SQRT((NHVTLPPDDP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMDPHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NHVTLPPDDP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  172  .PARAM VTH     = '0.67355+NHVTLPPDDP_DVTH0_CMOS065'
  173  
