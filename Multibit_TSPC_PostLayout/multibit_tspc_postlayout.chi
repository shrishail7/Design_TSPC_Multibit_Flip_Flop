  124  
  125  * Layout and electrical dimensions:
  126  *----------------------------------
  127  .PARAM WM='W*TOMETER'
  128  .PARAM LM='L*TOMETER'
  129  .PARAM WFING='WM/NFING+XW'
  130  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
  131  .PARAM FS='2-FD'
  132  .PARAM ADP ='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FD*(CONW/2.0+COEACT2)+XW/2)'
  133  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
  134  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
  135  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
  136  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  137  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  138  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
  139  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
  140  .PARAM POCOSM	= 'POCOS*TOMETER'
  141  .PARAM POCODM	= 'POCOD*TOMETER'
  142  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
  143  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-6*1E-6/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
  144  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
  145  + 1E-6/10.0*SCM*EXP(-10.0*SCM/1E-6)
  146  + +1E-6*1E-6/100.0*EXP(-10.0*SCM/1E-6)
  147  + -1E-6/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-6)
  148  + -1E-6*1E-6/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-6)),0))'
  149  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
  150  + 1E-6/20.0*SCM*EXP(-20.0*SCM/1E-6)
  151  + +1E-6*1E-6/400.0*EXP(-20.0*SCM/1E-6)
  152  + -1E-6/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-6)
  153  + -1E-6*1E-6/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-6)),0))'
  154  
  155  * DC Effective length and width:
  156  *---------------------------
  157  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  158  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  159  * AC Effective length and width:
  160  *------------------------------
  161  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  162  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  163  *  Effective Source/Drain Junction width:
  164  *---------------------------------------
  165  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  166  
  167  
  168  * Model improvement equations :
  169  *------------------------------
  170  
  171  * Equations for mismatch deviations:
  172  *-----------------------------------
  173  .PARAM DVTH0_ALPHA = (3E-9)
  174  .PARAM DVTH0_BETA  = (0.0)
  175  .PARAM DVTH0_FUDGE  = (1)
  176  .PARAM DVTH0_ALPHA_C2 = (3E-9)
  177  .PARAM DVTH0_BETA_C2  = (0.0)
  178  .PARAM DVTH0_FUDGE_C2 = (1)
  179  .PARAM DVTH0_SIG = {(((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DVTH0_ALPHA_C2/SQRT(WM*LM))+DVTH0_BETA_C2)*DVTH0_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
  180  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SVTGP_DEV*MISMATCH}
  181  .PARAM DBETA_ALPHA = (0.66E-8)
  182  .PARAM DBETA_BETA  = (0.0)
  183  .PARAM DBETA_FUDGE  = (1)
  184  .PARAM DBETA_ALPHA_C2 = (0.66E-8)
  185  .PARAM DBETA_BETA_C2  = (0.0)
  186  .PARAM DBETA_FUDGE_C2 = (1)
  187  .PARAM DBETA_SIG = {(((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DBETA_ALPHA_C2/SQRT(WM*LM))+DBETA_BETA_C2)*DBETA_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
  188  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SVTGP_DEV*MISMATCH}
  189  
  190  
  191  .PARAM PROCESSSTATFLAGS = '1.0'
  192  .PARAM DVTHTOT   = 'NSVTGP_DVTH0_CMOS065/(VALIF((NSVTGP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTGP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSVTGP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTGP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  193  .PARAM VTH     = '0.2625+NSVTGP_DVTH0_CMOS065'
  194  
  195  
  196  * Equation for  AGIDL:
  197  * --------------------
  198  .PARAM AGIDL   = '(7.4346E-05)*10^DAGIDL'
  199  
  200  
  201  * Equations for mobility :
  202  *-------------------------
  203  .PARAM EPSILON2 = 1E-18
  204  .PARAM LLIMIT = '8.3E-08-XL' 
  205  .PARAM WLIMIT = '6.88E-07-XW' 
  206  .PARAM DWU = 'DWU0+(-0.04)*0.5E6*(ABS(LE-1.7151E-06)-(LE-1.7151E-06))' 
  207  .PARAM MOBILITY = '2.0/(0.003667201527+(LLIMIT+XL
  208  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.001720729508/LE)
  209  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  210  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  211  
  212  
  213  
  214  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSVTGP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  215  
  216  
  217  * Channel doping nch and body factor k1 worst case :
  218  *---------------------------------------------------
  219  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  220  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  221  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(8.9277E+17/NI)+0.17968+0.4'
  222  .PARAM  K2        =  '(-0.036555+-4.5964E-09/LE)*(TOX/1.88E-09)'
  223  .PARAM  K1        =  '(0.34076)-MOSTYPE*(0.2625-VTH)/SQRT(PHIS_TYP)'
  224  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  225  .PARAM  NCH       =  '8.9277E+17*(K1*K1)/((0.34076)*(0.34076))'
  226  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.17968+0.4'
  227  * Series resistance worst case :
  228  *-------------------------------
  229  .PARAM RDSW      =  '(338.91+-2.1E-05/LE+7.4971E-13/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSVTGP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  230  .PARAM PRWB      =  0
  231  
  232  
  233  
  234  
  235  
  236  
  237  .PARAM VSATEFF = '(1.704E+05+0.006633/LE+0.003/WE)'
  238  
  239  * Equations for stress :
  240  *-----------------------
  241  
  242  .PARAM C_1	= 'CONW+COEACT2+CONPO'
  243  .PARAM C_2 	= C_1
  244  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
  245  .PARAM B_2	= B_1 
  246  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  247  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  248  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  249  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  250  * Stress effect on threshold voltage :
  251  *-------------------------------------
  252  
  253  
  254  .PARAM VARMAXVTH0       = '((3.5E-16*NFING/WM+6.5294E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))-(1/LM -(-0.061381*NFING/WM +4.4092E+06)))+((7.9412E-17*NFING/WM+-2.7059E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))+(1/LM -(-0.061381*NFING/WM+4.4092E+06)))+-4.2353E-10*NFING/WM+-0.0049765'
  255  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  256  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NSVTGP_DVTH0_CMOS065+DVTHTOT'
  257  * Stress effect on mobility :
  258  *----------------------------
  259  
  260  
  261  .PARAM VARMAXU0 	= '((0*NFING/WM+-3E-09)/2)*(ABS(1/LM-(0*NFING/WM+4E+06))-(1/LM -(0*NFING/WM+4E+06)))+((-5.2941E-16*NFING/WM+3E-09)/2)*(ABS(1/LM-(0*NFING/WM +4E+06))+(1/LM -(0*NFING/WM+4E+06)))+-1.7647E-09*NFING/WM+0.046765'
  262  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  263  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
  264  * Stress effect on body factor K1 :
  265  *----------------------------------
  266  .PARAM VARMAXK1         = '0.017+0/LM+-5E-09*NFING/WM'
  267  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  268  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  269  * Stress effect on DVT0 :
  270  *------------------------
  271  .PARAM DVT0_STRESS        = 9000
  272  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  273  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  274  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  275  * Stress effect on access resistance :
  276  *-------------------------------------
  277  .PARAM VARMAXRDSW       = '0+0*NFING/WM'
  278  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  279  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  280  
  281  
  282  .PARAM NFACTOR = '(0.78903+1.5017E-07/LE)*SQRT(PHIS*8.9277E+17/(PHIS_TYP*NCH))*(1.88E-09/TOX)'
  283  
  284  
  285  
  286  * Equations for VT :
  287  *-------------------
  288  .PARAM W0       = '1E-09+(0-XW)'
  289  .PARAM K3B      = '(3+-3.7E-07/LE)*(1.88E-09/TOX)'
  290  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  291  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*8.9277E+17*1E6))'
  292  .PARAM DVTP0    = 0
  293  
  294  
  295  .PARAM N_SUBVT  = '1.0+(0.78903+1.5017E-07/LE)*5.640000544E-09/XDEP0'
  296  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+7E-07))'
  297  .PARAM TMP2     = '1.692E-09/(WE+W0)'
  298  .PARAM K3       = '(-6.5+3E-07/(LE*(LMIN+-7E-09-2*LINT)/(LMIN+XL-2*LINT)))*(1.88E-09/TOX)+VTH_RSCE/TMP2'
  299  
  300  
  301  
  302  * Equation for moin :
  303  *-------------------
  304  .PARAM MOIN = 'VALIF((6.1782*((0.34076)/K1EFF)^2 > 5), (6.1782*((0.34076)/K1EFF)^2), (5))'
  305  
  306  
  307  * Equations for LKETA :
  308  *---------------------
  309  
  310  
  311  .PARAM LKETA    = -0.003 
  312  
  313  
  314  *Worst case methodology improvement: Short Channel effect
  315  *--------------------------------------------------------
  316  .PARAM LPE0  = '((((0.34076)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4.4E-08+3E-16/LE)/(LMIN+-7E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  317  .PARAM LPEB  = '(0)/(LMIN+-7E-09-2*LINT)*(LMIN+XL-2*LINT)'
  318  .PARAM DVT1  = '1.05*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  319  .PARAM DVT1W = '3946.1*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  320  .PARAM DSUB = '(0.8)*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  321  
  322  
  323  
  324  * Equations for Extrinsic Capacitances:
  325  * ------------------------------------
  326  
  327  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
  328  
  329  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
  330  .PARAM C3EXT = '(9.681E-18 + 7.403E-11*(LM + XL))'
  331  
  332  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.237E-17 + 2.400E-18*TANH((LM + XL)/1.258E-07)),(1.474E-17 + 3.229E-18*TANH((LM + XL)/1.497E-07)))'
