 1863  .PARAM DBETA_BETA_C2  = (0.0)
 1864  .PARAM DBETA_FUDGE_C2 = (1)
 1865  .PARAM DBETA_SIG = {(((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DBETA_ALPHA_C2/SQRT(WM*LM))+DBETA_BETA_C2)*DBETA_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
 1866  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SVTGP_DEV*MISMATCH}
 1867  
 1868  
 1869  .PARAM PROCESSSTATFLAGS = '1.0'
 1870  .PARAM DVTHTOT   = 'PSVTGP_DVTH0_CMOS065/(VALIF((PSVTGP_DVTH0_CMOS065==0),(1),(0))+SQRT((PSVTGP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PSVTGP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PSVTGP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1871  .PARAM VTH     = '-0.233+PSVTGP_DVTH0_CMOS065'
 1872  
 1873  
 1874  * Equation for  AGIDL:
 1875  * --------------------
 1876  .PARAM AGIDL   = '(0.0057016)*10^DAGIDL'
 1877  
 1878  
 1879  * Equations for mobility :
 1880  *-------------------------
 1881  .PARAM EPSILON2 = 1E-18
 1882  .PARAM LLIMIT = '2.886E-08-XL' 
 1883  .PARAM WLIMIT = '-4.21809E-08-XW' 
 1884  .PARAM DWU = 'DWU0+(0)*0.5E6*(ABS(LE-2E-07)-(LE-2E-07))' 
 1885  .PARAM MOBILITY = '2.0/(0.01459354277+(LLIMIT+XL
 1886  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.001164414995/LE)
 1887  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1888  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1889  
 1890  
 1891  
 1892  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PSVTGP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1893  
 1894  
 1895  * Channel doping nch and body factor k1 worst case :
 1896  *---------------------------------------------------
 1897  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1898  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1899  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(6.9446E+17/NI)+0.18+0.4'
 1900  .PARAM  K2        =  '(-0.01609+-2E-09/LE)*(TOX/1.87E-09)'
 1901  .PARAM  K1        =  '(0.28221)-MOSTYPE*(-0.233-VTH)/SQRT(PHIS_TYP)'
 1902  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1903  .PARAM  NCH       =  '6.9446E+17*(K1*K1)/((0.28221)*(0.28221))'
 1904  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18+0.4'
 1905  * Series resistance worst case :
 1906  *-------------------------------
 1907  .PARAM RDSW      =  '(316.35+9.9E-13/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PSVTGP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1908  .PARAM PRWB      =  0
 1909  
 1910  
 1911  
 1912  
 1913  
 1914  
 1915  .PARAM VSATEFF = '(1.477E+05+-2E-10/(LE*WE))'
 1916  
 1917  * Equations for stress :
 1918  *-----------------------
 1919  
 1920  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
 1921  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
 1922  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
 1923  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
 1924  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
 1925  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 1926  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 1927  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 1928  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 1929  * Stress effect on threshold voltage :
 1930  *-------------------------------------
 1931  
 1932  
 1933  .PARAM VARMAXVTH0       = '((-1.2353E-17*NFING/WM+-1.6765E-10)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))-(1/LM -(0*NFING/WM +1E+07)))+((0*NFING/WM+6E-10)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))+(1/LM -(0*NFING/WM+1E+07)))+8.8235E-11*NFING/WM+0.00041177'
 1934  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1935  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PSVTGP_DVTH0_CMOS065+DVTHTOT'
 1936  * Stress effect on mobility :
 1937  *----------------------------
 1938  
 1939  
 1940  .PARAM VARMAXU0 	= '((0*NFING/WM+1E-09)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))-(1/LM -(0*NFING/WM+1E+07)))+((-8E-16*NFING/WM+2.5882E-09)/2)*(ABS(1/LM-(0*NFING/WM +1E+07))+(1/LM -(0*NFING/WM+1E+07)))+3.0882E-09*NFING/WM+-0.0055882'
 1941  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1942  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 1943  * Stress effect on body factor K1 :
 1944  *----------------------------------
 1945  .PARAM VARMAXK1         = '0.023488+-9.8448E-10/LM+-7.8493E-10*NFING/WM'
 1946  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1947  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 1948  * Stress effect on DVT0 :
 1949  *------------------------
 1950  .PARAM DVT0_STRESS        = 690
 1951  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 1952  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1953  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 1954  * Stress effect on access resistance :
 1955  *-------------------------------------
 1956  .PARAM VARMAXRDSW       = '0+0*NFING/WM'
 1957  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1958  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 1959  
 1960  
 1961  .PARAM NFACTOR = '(0.74266+1.3842E-07/LE)*SQRT(PHIS*6.9446E+17/(PHIS_TYP*NCH))*(1.87E-09/TOX)'
 1962  
 1963  
 1964  
 1965  * Equations for VT :
 1966  *-------------------
 1967  .PARAM W0       = '2.4962E-07+(0-XW)'
 1968  .PARAM K3B      = '(7)*(1.87E-09/TOX)'
 1969  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1970  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*6.9446E+17*1E6))'
 1971  .PARAM DVTP0    = 0
 1972  
 1973  
 1974  .PARAM N_SUBVT  = '1.0+(0.74266+1.3842E-07/LE)*5.610000542E-09/XDEP0'
 1975  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+4E-07))'
 1976  .PARAM TMP2     = '1.683E-09/(WE+W0)'
 1977  .PARAM K3       = '(-9.5897+-1.2E-07/(LE*(LMIN+-4E-09-2*LINT)/(LMIN+XL-2*LINT))+4E-14/((LE*(LMIN+-4E-09-2*LINT)/(LMIN+XL-2*LINT))*WE))*(1.87E-09/TOX)+VTH_RSCE/TMP2'
 1978  
 1979  
 1980  
 1981  * Equation for moin :
 1982  *-------------------
 1983  .PARAM MOIN = 'VALIF((5.6774*((0.28221)/K1EFF)^2 > 5), (5.6774*((0.28221)/K1EFF)^2), (5))'
 1984  
 1985  
 1986  * Equations for LKETA :
 1987  *---------------------
 1988  
 1989  .PARAM LKETAEXP = 'VALIF(((1.452935074E-07/LE--4.745827451E-06) > 34), (34), (1.452935074E-07/LE--4.745827451E-06))'
 1990  
 1991  .PARAM LKETA    = '-0.10117/(1.0+EXP(LKETAEXP))'
 1992  
 1993  
 1994  *Worst case methodology improvement: Short Channel effect
 1995  *--------------------------------------------------------
 1996  .PARAM LPE0  = '((((0.28221)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(2.42E-08)/(LMIN+-4E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1997  .PARAM LPEB  = '(0)/(LMIN+-4E-09-2*LINT)*(LMIN+XL-2*LINT)'
 1998  .PARAM DVT1  = '2.235*SQRT(TOX/1.87E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1999  .PARAM DVT1W = '2.9873E+05*SQRT(TOX/1.87E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2000  .PARAM DSUB = '(0.27226)*SQRT(TOX/1.87E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2001  
 2002  
 2003  
 2004  * Equations for Extrinsic Capacitances:
 2005  * ------------------------------------
 2006  
 2007  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
 2008  
 2009  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
 2010  .PARAM C3EXT = '(9.681E-18 + 7.403E-11*(LM + XL))'
 2011  
 2012  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.237E-17 + 2.400E-18*TANH((LM + XL)/1.258E-07)),(1.474E-17 + 3.229E-18*TANH((LM + XL)/1.497E-07)))'
 2013  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.458E-17 + 9.132E-19*TANH((WM/NFING + XW)/1.568E-06) + 1.875E-17*TANH((LM + XL)/5.032E-07)),(1.240E-17 + -2.833E-17*TANH((WM/NFING + XW)/1.635E-06) + 1.043E-17*TANH((LM + XL)/2.752E-07)))' 
 2014  
 2015  
 2016  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-4.315E-19*(1-ALIGNMENT_PRELAYOUT) + 8.264E-11*(WM/NFING + XW) + 4.014E-11*(WM/NFING + XW)*TANH((LM + XL)/3.174E-07)) ,(4.263E-19*(1-ALIGNMENT_PRELAYOUT) + 2.618E-11*(WM/NFING + XW) + 1.895E-11*(WM/NFING + XW)*TANH((LM + XL)/2.508E-07)))'
 2017  
 2018  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 2019  
 2020  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
 2021  
 2022  .PARAM CGSL = '((9E-11) + 1E-17/LM  + -4.5E-25/LM^2 + -8E-18/WM*NFING + 8.4988E-25/WM^2*NFING^2)*(1.87E-09/TOX)' 
 2023  .PARAM CGDL = '((9E-11) + 1E-17/LM  + -4.5E-25/LM^2 + -8E-18/WM*NFING + 8.4988E-25/WM^2*NFING^2)*(1.87E-09/TOX)' 
 2024  .PARAM CGSO       =  'VALIF((POCOSM>0),(1E-13*(1.87E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.8098E-07)*(TANH(POCOSM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.87E-09/TOX))'
 2025  .PARAM CGDO       =  'VALIF((POCOSM>0),(1E-13*(1.87E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.8098E-07)*(TANH(POCODM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.87E-09/TOX))'
 2026  
 2027  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2028  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2029  
 2030  
 2031  
 2032  * Equations for extrinsic S/D resistances:
 2033  * ---------------------------------------
 2034  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 2035   
 2036  * Unsilicided poly gate resistance:
 2037  * --------------------------------
 2038  .PARAM RSHGUMMID = '(620+RSHGUM)/2 + (620-RSHGUM)*TANH(1E18*(2*2.2E-8-LM-XL))/2'
 2039  .PARAM RSHGUMEFF = 'RSHGUMMID*620*(LM+XL)/(2*2.2E-8*RSHGUMMID + (LM+XL-2*2.2E-8)*620)'
 2040  
 2041  
 2042  .PARAM RGATEMOD = 1
 2043  .PARAM XGWS    = 'CONRPO-COEPO'
 2044  .PARAM XGWU    = 'RPOEXTPOFLD'
 2045  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
 2046  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
 2047  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
 2048  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
 2049  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
 2050  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 2051  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
 2052  
 2053  * Unsilicided Source/Drain diffusion access resistances:
 2054  * -----------------------------------------------------
 2055  .PARAM NRSEFF    = 'NRS + (RSD_RPO*ESUM/(RSH*WE)/NFING)'
 2056  .PARAM NRDEFF    = 'NRD + (RSD_RPO*EDUM/(RSH*WE)/NFING)'
 2057  
 2058  
 2059  
 2060  * Equations for VOFF:
 2061  * ------------------
 2062  
 2063  .PARAM VOFF = '-0.12896 + -0.067255*(TEMPK/(25+273.15) -1)' 
 2064  
 2065  
 2066  
 2067  * Equations for temperature dependance of BGIDL:
 2068  * --------------------------------------------
 2069  .PARAM BGIDL = '2.8015E+10 + -2.7444E+09*(TEMPK/(25+273.15) -1)'
 2070  
 2071  
 2072  * Equations for temperature dependence of series resistances:
 2073  * -----------------------------------------------------------
 2074  .PARAM RDWMIN = 0
 2075  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 0.0002*(TEMPK/(25+273.15) -1)), (0))'
 2076  .PARAM RSWMIN = 0
 2077  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 0.0002*(TEMPK/(25+273.15) -1)), (0))'
 2078  .PARAM RDSWMIN = 0
 2079  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 0.0002*(TEMPK/(25+273.15) -1)), (0))'
 2080  .PARAM RSW = 0
 2081  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 0.0002*(TEMPK/(25+273.15) -1)), (0))'
 2082  .PARAM RDW = 0
 2083  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 0.0002*(TEMPK/(25+273.15) -1)), (0))'
 2084  .PARAM RDSWEFF2 = '(RDSWEFF + 0.0002*(TEMPK/(25+273.15) -1))'
 2085  .PARAM PRT = 0
 2086  
 2087  
 2088  * Equations for thermal noise scaling
 2089  * ------------------------------------
 2090  .PARAM NTNOI = '1*LE/LEC'
 2091  
 2092  
 2093  
 2094  
 2095  
 2096   
 2097  .PARAM WPEMOD   = 1
 2098  .PARAM KVTH0WE  = (-5.486849E-3+9.596948E-11/LE+1E-13/WE)
 2099  .PARAM K2WE     = (3.559716E-3+-5.383133E-11/LE+1.125498E-13/WE)
 2100  .PARAM SCREF    = 1E-6
 2101  .PARAM KU0WE    = (-8.277252E-4+-6.093262E-10/LE+9.372638E-10/WE)
 2102  .PARAM WEB      = -450
 2103  .PARAM WEC2      = -3000
 2104  
 2105  
 2106  M1 D G S B PSVTGP W='WM/NFING' L=LM AS='ASM/NFING' AD='ADM/NFING' PS='PSM/NFING' PD='PDM/NFING'
 2107  +          M='MULT*NFING' NRD='NRDEFF*NFING' NRS='NRSEFF*NFING' NF=1 SCA='SCAM' SCB='SCBM' SCC='SCCM' 
