  124  
  125  * Layout and electrical dimensions:
  126  *----------------------------------
  127  .PARAM WM='W*TOMETER'
  128  .PARAM LM='L*TOMETER'
  129  .PARAM WFING='WM/NFING+XW'
  130  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
  131  .PARAM FS='2-FD'
  132  .PARAM PDP= 4.35E-07
  133  .PARAM PSP= 1.8E-07
  134  .PARAM ADP= 2.87438E-14
  135  .PARAM ASP= 2.835E-14
  136  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  137  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  138  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
  139  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
  140  * DC Effective length and width:
  141  *---------------------------
  142  .PARAM WE      = '(WM/NFING+XW-2*WINT)'
  143  .PARAM LE      = 'LM+XL-2.0*LINT'
  144  * AC Effective length and width:
  145  *------------------------------
  146  .PARAM WEC     = '(WM/NFING+XW-2*DWC)'
  147  .PARAM LEC     = 'LM+XL-2.0*DLC'
  148  *  Effective Source/Drain Junction width:
  149  *---------------------------------------
  150  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  151  
  152  
  153  * Model improvement equations :
  154  *------------------------------
  155  
  156  * Equations for mismatch deviations:
  157  *-----------------------------------
  158  .PARAM DVTH0_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(4.5E-9),(5.8E-9))
  159  .PARAM DVTH0_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  160  .PARAM DVTH0_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
  161  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
  162  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMDPSVTLP_DEV*MISMATCH}
  163  .PARAM DBETA_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.69E-8),(0.52E-8))
  164  .PARAM DBETA_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  165  .PARAM DBETA_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.153))
  166  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
  167  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMDPSVTLP_DEV*MISMATCH}
  168  
  169  
  170  .PARAM PROCESSSTATFLAGS = '1.0'
  171  .PARAM DVTHTOT   = 'NSVTLPPDDP_DVTH0_CMOS065/(VALIF((NSVTLPPDDP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTLPPDDP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMDPSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTLPPDDP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  172  .PARAM VTH     = '0.46885+NSVTLPPDDP_DVTH0_CMOS065'
  173  
  174  
  175  * Equation for  AGIDL:
  176  * --------------------
  177  .PARAM AGIDL   = '(2.0823E-06)*10^DAGIDL'
  178  
  179  
  180  * Equations for mobility :
  181  *-------------------------
  182  .PARAM EPSILON2 = 1E-18
  183  .PARAM LLIMIT = '6.13997E-07-XL' 
  184  .PARAM WLIMIT = '3.78476E-07-XW' 
  185  .PARAM DWU = 'DWU0+(-0.38853)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
  186  .PARAM MOBILITY = '2.0/(0.00414375662+(LLIMIT+XL
  187  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.0009844485083/LE)
  188  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  189  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  190  
  191  
  192  
  193  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSRAMDPSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  194  
  195  
  196  * Channel doping nch and body factor k1 worst case :
  197  *---------------------------------------------------
  198  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  199  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  200  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(7.863E+17/NI)+0.25043+0.4'
  201  .PARAM  K2        =  '(0.024422+-5.4324E-09/LE)*(TOX/2.3926E-09)'
  202  .PARAM  K1        =  '(0.35383)-MOSTYPE*(0.46885-VTH)/SQRT(PHIS_TYP)'
  203  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  204  .PARAM  NCH       =  '7.863E+17*(K1*K1)/((0.35383)*(0.35383))'
  205  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  206  * Series resistance worst case :
  207  *-------------------------------
  208  .PARAM RDSW      =  '(80)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSRAMDPSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  209  .PARAM PRWB      =  -1.2794
  210  
  211  
  212  
  213  
  214  
  215  .PARAM  VTH0EFF   =  'VTH0-NSVTLPPDDP_DVTH0_CMOS065+DVTHTOT'
  216  .PARAM U0EFF            = U0
  217  .PARAM K1EFF		= K1
  218  .PARAM DVT0EFF		= -0.03
  219  .PARAM RDSWEFF0          = RDSW 
  220  .PARAM VSATEFF = '(439020)'
  221  
  222  
  223  .PARAM NFACTOR = '(1.5448)*SQRT(PHIS*7.863E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
  224  
