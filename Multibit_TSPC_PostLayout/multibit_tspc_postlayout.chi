 1077  .PARAM DVTHTOT   = 'NSVTLPPGSP_DVTH0_CMOS065/(VALIF((NSVTLPPGSP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTLPPGSP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMSPSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTLPPGSP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
