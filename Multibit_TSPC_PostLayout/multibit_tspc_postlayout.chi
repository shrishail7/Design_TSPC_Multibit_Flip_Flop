 2141  .PARAM RSWMIN = 0
 2142  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + -43.326*(TEMPK/(25+273.15) -1)), (0))'
 2143  .PARAM RDSWMIN = 0
 2144  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + -43.326*(TEMPK/(25+273.15) -1)), (0))'
 2145  .PARAM RSW = 0
 2146  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + -43.326*(TEMPK/(25+273.15) -1)), (0))'
 2147  .PARAM RDW = 0
 2148  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + -43.326*(TEMPK/(25+273.15) -1)), (0))'
 2149  .PARAM RDSWEFF2 = '(RDSWEFF + -43.326*(TEMPK/(25+273.15) -1))'
 2150  .PARAM PRT = 0
 2151  
 2152  
 2153  * Equations for thermal noise scaling
 2154  * ------------------------------------
 2155  .PARAM NTNOI = '1*LE/LEC'
