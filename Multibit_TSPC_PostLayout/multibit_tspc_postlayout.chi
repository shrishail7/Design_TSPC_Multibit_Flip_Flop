 1030  .PARAM K2WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0.001054073+-8.3058E-12/LE+-1.39175E-10/WE)),((0.0030205+-1.007E-11/LE+-1.3918E-10/WE)))'
 1031  .PARAM SCREF    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1E-6),(1E-06))'
 1032  .PARAM KU0WE    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((-0.001646+-7.02E-11/LE+3.64E-10/WE+0.0/(LE*WE))),((-0.00013709+2.1621E-10/LE+-2.3775E-09/WE)))'
 1033  .PARAM WEB      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
 1034  .PARAM WEC2      =  'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
