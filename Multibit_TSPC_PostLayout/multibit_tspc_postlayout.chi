 1060  *------------------------------
 1061  
 1062  * Equations for mismatch deviations:
 1063  *-----------------------------------
 1064  .PARAM DVTH0_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(5.0E-9),(5.9E-9))
 1065  .PARAM DVTH0_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
 1066  .PARAM DVTH0_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
 1067  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
 1068  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMSPHVTLP_DEV*MISMATCH}
 1069  .PARAM DBETA_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.87E-8),(0.72E-8))
 1070  .PARAM DBETA_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
 1071  .PARAM DBETA_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
 1072  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
 1073  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMSPHVTLP_DEV*MISMATCH}
 1074  
