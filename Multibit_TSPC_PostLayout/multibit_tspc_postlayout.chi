 5408  .SETSOA LABEL="P5b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when D/B diode in forward bias" E V(B,D)=(-0.33,*) 
 5409  .SETSOA LABEL="P6a ==> Isolation safe voltage ranges violation : S/B diode limitation in reverse bias" E V(B,S)=(*,2.64) 
 5410  .SETSOA LABEL="P6b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when S/B diode in forward bias" E V(B,S)=(0.33,*) 
 5411  .SETSOA LABEL="P7 ==> Isolation safe voltage ranges violation : MOS HCI limitation on D side" E IF (V(G,S)-VT(M1)<0) && (V(D,S)<-0.2) THEN V(B,D)=(-0.2,1.4) ENDIF 
 5412  .SETSOA LABEL="P8 ==> Isolation safe voltage ranges violation : MOS HCI limitation on S side" E IF (V(G,D)-VT(M1)<0) && (V(D,S)>0.2) THEN V(B,S)=(-0.2,1.4) ENDIF 
