 2535  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 2536  
 2537  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
