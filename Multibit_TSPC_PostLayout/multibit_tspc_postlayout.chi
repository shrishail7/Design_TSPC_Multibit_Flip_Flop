 3343  
 3344  
 3345  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
 3346  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 3347  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 3348  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
 3349  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
 3350  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
 3351  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
 3352  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 3353  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
 3354  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
 3355  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
 3356  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
 3357  
 3358  * DC Effective length and width:
 3359  *---------------------------
 3360  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3361  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3362  * AC Effective length and width:
 3363  *------------------------------
 3364  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3365  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 3366  *  Effective Source/Drain Junction width:
 3367  *---------------------------------------
 3368  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 3369  
 3370  
 3371  * Model improvement equations :
 3372  *------------------------------
 3373  
 3374   
 3375      * Continuous Model for mismatch deviations 
 3376  *----------------------------------------
 3377  .PARAM X_DEV        = 0.0 DEVX/GAUSS = {1.0}
 3378  .PARAM Y_DEV        = 0.0 DEVX/GAUSS = {1.0}
 3379  .PARAM Z_DEV        = 0.0 DEVX/GAUSS = {1.0}
 3380  .PARAM DVTH_AVT        = '4E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 3381  .PARAM DBETA_ABETA     = '0.46E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 3382  
 3383  
 3384  .PARAM PVT          = 8.2E-06      
 3385  .PARAM TPVT         = -0.025E-06     
 3386  .PARAM ZETAVT       = 0.018E+12
 3387  .PARAM DVTH_PVT    = '(PVT+TPVT*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETAVT*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 3388  .PARAM DVTH0_SIG = 'SQRT(DVTH_PVT*DVTH_PVT+DVTH_AVT*DVTH_AVT)'
 3389  .PARAM DVTH0_DEV = '(DVTH_AVT*X_DEV+DVTH_PVT*Y_DEV)*LVTLP_DEV*MISMATCH'
 3390  
 3391  
 3392  .PARAM PBETA        = 2.2E-05    
 3393  .PARAM TPBETA       = -0.011E-05   
 3394  .PARAM ZETABETA     = 7.9E+09
 3395  .PARAM DBETA_PBETA = '(PBETA+TPBETA*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETABETA*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
 3396  .PARAM DBETA_SIG = 'SQRT(DBETA_PBETA*DBETA_PBETA+DBETA_ABETA*DBETA_ABETA)'
 3397  .PARAM DBETA_DEV = '(DBETA_ABETA*Z_DEV+DBETA_PBETA*Y_DEV)*LVTLP_DEV*MISMATCH'
 3398  
 3399  .PARAM PROCESSSTATFLAGS = '1.0'
 3400  .PARAM DVTHTOT   = 'NLVTLP_DVTH0_CMOS065/(VALIF((NLVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((NLVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NLVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NLVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 3401  .PARAM VTH     = '0.243+NLVTLP_DVTH0_CMOS065'
 3402  
 3403  
 3404  * Equation for  AGIDL:
 3405  * --------------------
 3406  .PARAM AGIDL   = '(4.1681E-05)*10^DAGIDL'
 3407  
 3408  
 3409  * Equations for mobility :
 3410  *-------------------------
 3411  .PARAM EPSILON2 = 1E-18
 3412  .PARAM LLIMIT = '1.14E-07-XL' 
 3413  .PARAM WLIMIT = '4.6E-07-XW' 
 3414  .PARAM DWU = 'DWU0+(-0.45)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
 3415  .PARAM MOBILITY = '2.0/(0.00448019802+(LLIMIT+XL
 3416  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.0005198019802/LE)
 3417  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 3418  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 3419  
 3420  
 3421  
 3422  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NLVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 3423  
 3424  
 3425  * Channel doping nch and body factor k1 worst case :
 3426  *---------------------------------------------------
 3427  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 3428  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 3429  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(5.2772E+17/NI)+0.25043+0.4'
 3430  .PARAM  K2        =  '(-0.027099+9.9092E-09/LE)*(TOX/2.3926E-09)'
 3431  .PARAM  K1        =  '(0.29)-MOSTYPE*(0.243-VTH)/SQRT(PHIS_TYP)'
 3432  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 3433  .PARAM  NCH       =  '5.2772E+17*(K1*K1)/((0.29)*(0.29))'
 3434  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
 3435  * Series resistance worst case :
 3436  *-------------------------------
 3437  .PARAM RDSW      =  '(75)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NLVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 3438  .PARAM PRWB      =  -0.5
 3439  
 3440  
 3441  
 3442  
 3443  
 3444  
 3445  .PARAM VSATEFF = '(7.34E+05+0.00043638/LE)'
 3446  
 3447  * Equations for stress :
 3448  *-----------------------
 3449  
 3450  .PARAM C_1	= 'CONW+COEACT2+CONPO'
 3451  .PARAM C_2 	= C_1
 3452  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
 3453  .PARAM B_2	= B_1 
 3454  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 3455  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 3456  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 3457  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 3458  * Stress effect on threshold voltage :
 3459  *-------------------------------------
 3460  
 3461  
 3462  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((-3.265E-16*NFING/WM+1.3814E-09)/2)*(ABS(1/LM-(0*NFING/WM+5E+06))+(1/LM -(0*NFING/WM+5E+06)))+3.5294E-10*NFING/WM+-0.0040207'
 3463  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3464  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NLVTLP_DVTH0_CMOS065+DVTHTOT'
 3465  * Stress effect on mobility :
 3466  *----------------------------
 3467  
 3468  
 3469  .PARAM VARMAXU0 	= '((4.5544E-16*NFING/WM+-1.1961E-08)/2)*(ABS(1/LM-(-0.08785*NFING/WM+5.8298E+06))-(1/LM -(-0.08785*NFING/WM+5.8298E+06)))+((1.2264E-15*NFING/WM+-1.5993E-09)/2)*(ABS(1/LM-(0.1532*NFING/WM +9.8E+06))+(1/LM -(0.1532*NFING/WM+9.8E+06)))+-3E-09*NFING/WM+0.07397'
 3470  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3471  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 3472  * Stress effect on body factor K1 :
 3473  *----------------------------------
 3474  .PARAM VARMAXK1         = '-0.04+0/LM+1E-08*NFING/WM'
 3475  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3476  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 3477  * Stress effect on DVT0 :
 3478  *------------------------
 3479  .PARAM DVT0_STRESS        = -0.08067
 3480  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 3481  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3482  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 3483  * Stress effect on access resistance :
 3484  *-------------------------------------
 3485  .PARAM VARMAXRDSW       = '0.15+-5.67E-08*NFING/WM'
 3486  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 3487  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 3488  
 3489  
 3490  .PARAM NFACTOR = '(0.90222+1.5331E-07/LE)*SQRT(PHIS*5.2772E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
 3491  
 3492  
 3493  
 3494  * Equations for VT :
 3495  *-------------------
 3496  .PARAM W0       = '2.2957E-08+(0-XW)'
 3497  .PARAM K3B      = '(1.5+-1.6E-07/LE)*(2.3926E-09/TOX)'
 3498  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 3499  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*5.2772E+17*1E6))'
 3500  .PARAM DVTP0    = 0
 3501  
 3502  
 3503  .PARAM N_SUBVT  = '1.0+(0.90222+1.5331E-07/LE)*7.177800693E-09/XDEP0'
 3504  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+3E-06))'
 3505  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
 3506  .PARAM K3       = '(-3.5+2.5E-07/(LE*(LMIN+5E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
 3507  
 3508  
 3509  
 3510  * Equation for moin :
 3511  *-------------------
 3512  .PARAM MOIN = 'VALIF((5.8569*((0.29)/K1EFF)^2 > 5), (5.8569*((0.29)/K1EFF)^2), (5))'
 3513  
 3514  
 3515  * Equations for LKETA :
 3516  *---------------------
 3517  
 3518  
 3519  .PARAM LKETA    = 0 
 3520  
 3521  
 3522  *Worst case methodology improvement: Short Channel effect
 3523  *--------------------------------------------------------
 3524  .PARAM LPE0  = '((((0.29)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4E-12+2.1E-14/LE)/(LMIN+5E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 3525  .PARAM LPEB  = '(-2.038E-07+1.5546E-14/LE)/(LMIN+5E-09-2*LINT)*(LMIN+XL-2*LINT)'
 3526  .PARAM DVT1  = '0.0233*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 3527  .PARAM DVT1W = '7E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 3528  .PARAM DSUB = '(0.62286)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 3529  
 3530  
 3531  
 3532  * Equations for Extrinsic Capacitances:
 3533  * ------------------------------------
 3534  
 3535  .PARAM CF = '(0)*(1 + DCFRING)'
 3536  .PARAM CGBO = '5.00E-10*(1 + DCFRING)'
 3537  
 3538  
 3539  .PARAM CGSL = '((2.5E-11) + 0/LM  + 0/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
 3540  .PARAM CGDL = '((2.5E-11) + 0/LM  + 0/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
 3541  .PARAM CGSO       =  '2.7435E-10*(2.3926E-09/TOX)'
 3542  .PARAM CGDO       =  '2.7435E-10*(2.3926E-09/TOX)'
 3543  
 3544  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 3545  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 3546  
 3547  
 3548  
 3549  * Equations for extrinsic S/D resistances:
 3550  * ---------------------------------------
 3551  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
 3552  
 3553  
 3554  
 3555  * Salicided poly gate resistance:
 3556  * ------------------------------
 3557  
 3558  .PARAM RGATEMOD = 0
 3559  .PARAM RSHG0    = 15.014
 3560  
 3561  * Salicided Source/Drain diffusion access resistances:
 3562  * ---------------------------------------------------
 3563  .PARAM NRSEFF    = 'NRS'
 3564  .PARAM NRDEFF    = 'NRD'
 3565  
 3566  
 3567  
 3568  * Equations for poly gate resistance:
 3569  * -----------------------------------
 3570  .PARAM XGW        = 1.0E-07
 3571  .PARAM XGL        = -2.674E-08
 3572  .PARAM TC1G       = 2.3E-03
 3573  .PARAM TC2G       = 0
 3574  .PARAM TC1GV      = 0
 3575  .PARAM TC2GV      = 0
 3576  .PARAM LHEAD      = 'MAX(NFING*CONW+(NFING-1)*CONS+2*COEPO,NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS)))'
 3577  .PARAM NCHEAD     = 'NCRG*(1+TRUNC(((LHEAD-CONW-2*COEPO)/(CONW+CONS))+1E-12))'
 3578  .PARAM RGCON      = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 3579  .PARAM RSHGT      = 'MAX(1E-6,RSHG*(1+(TC1G+TC2G*(EFFTEMP-25))*(EFFTEMP-25)))'
 3580  .PARAM RSHGVT     = 'MAX(1E-6,RSHGV*(1+(TC1GV+TC2GV*(EFFTEMP-25))*(EFFTEMP-25)))'
 3581  .PARAM RGELTD     = 'RSHGT*(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*NFING)+RSHGVT*1E-12/((LM+XL)*(WM/NFING+XW)*NFING)'
 3582  .PARAM RGBSIM4    = '(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*1)'
 3583  .PARAM RSHGEFF    = '(RGELTD+RGCON)/RGBSIM4*NFING'
 3584  
 3585  * Equations for bulk resistance:
 3586  * ------------------------------
 3587  .PARAM RSTI       = '(RSTIR+RSTIL*WM/(12*NFING*(LM+XBL)))/NFING'
 3588  .PARAM RBSD       = '(RBSDR*1E-6)/(WM)'
 3589  .PARAM RBODYMOD   = 1
 3590  .PARAM RBPB       = 'RBGBL*1E-6/LM'
 3591  .PARAM RBPD       = 1E+09
 3592  .PARAM RBPS       = 1E+09
 3593  .PARAM RBDB       = 'RBSD*NFING/2'
 3594  .PARAM RBSB       = 'RBSD*NFING/2'
 3595  
 3596  * Equations for parasitic capacitances:
 3597  * -------------------------------------
 3598  .PARAM CGD_PLS    = '((NFING+FD)/2*CGXM0 + (NFING+FD)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FD*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 3599  .PARAM CGS_PLS    = '((NFING+FS)/2*CGXM0 + (NFING+FS)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FS*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 3600  .PARAM CDS_PLS    = '(CDSM1+CDSM1W*WFING)*NFING/(LM+2*CONPO)'
 3601  .PARAM CGDM	  = '(1-LPEC)*CGD_PLS*WEC*NFING '
 3602  .PARAM CGSM	  = '(1-LPEC)*CGS_PLS*WEC*NFING '
 3603  .PARAM CFLM       = 'CFL*LOG((1+0.5*(MIN(LM+XL,LMAXCF))/(CONPO-XL/2))/(1+0.5*(LMIN+XL)/(CONPO-XL/2)))'
 3604  .PARAM CFWM       = 'CFW*NGCON/WEC'
 3605  .PARAM CDSM       = 'CDSM0*(LMIN+2.0*CDSML)/(LM+2.0*CDSML)*(WM/NFING)*NFING+(1-LPEC)*CDS_PLS'
 3606  .PARAM CBDM       = 'CBXM0*(WM/NFING)*FD'
 3607  .PARAM CBSM       = 'CBXM0*(WM/NFING)*FS'
 3608  
 3609  
 3610  * Equations for VOFF:
 3611  * ------------------
 3612  
 3613  .PARAM VOFF = '-0.14445 + -0.14555*(TEMPK/(25+273.15) -1)' 
 3614  
 3615  
 3616  
 3617  * Equations for temperature dependance of BGIDL:
 3618  * --------------------------------------------
 3619  .PARAM BGIDL = '4.927E+09 + -1.198E+09*(TEMPK/(25+273.15) -1)'
 3620  
 3621  
 3622  * Equations for temperature dependence of series resistances:
 3623  * -----------------------------------------------------------
 3624  .PARAM RDWMIN = 0
 3625  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 3626  .PARAM RSWMIN = 0
 3627  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 3628  .PARAM RDSWMIN = 0
 3629  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 3630  .PARAM RSW = 0
 3631  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 0*(TEMPK/(25+273.15) -1)), (0))'
 3632  .PARAM RDW = 0
 3633  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 0*(TEMPK/(25+273.15) -1)), (0))'
 3634  .PARAM RDSWEFF2 = '(RDSWEFF + 0*(TEMPK/(25+273.15) -1))'
 3635  .PARAM PRT = 0
 3636  
 3637  
 3638  * Equations for thermal noise scaling
 3639  * ------------------------------------
 3640  .PARAM NTNOI = '1*LE/LEC'
 3641  
 3642  
 3643  
 3644  * Equations for Flicker Noise Local Variations
 3645  * --------------------------------------------
 3646  
 3647  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
 3648  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
 3649  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
 3650  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
 3651  .PARAM NOIA    = '((TANH((LE-1E-07)*1.1E+06))*(1.80E+43)/2+3.00E+42)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 3652  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 3653  .PARAM NOIC    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 3654  
 3655  
 3656  
 3657  
 3658  * Selection of the WPE model parameter values depending on the netlist extraction:
 3659  * -------------------------------------------------------------------------------
