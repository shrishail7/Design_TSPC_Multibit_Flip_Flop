  685  .PARAM POCODM	= 'POCOD*TOMETER'
  686  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
  687  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-6*1E-6/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
  688  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
  689  + 1E-6/10.0*SCM*EXP(-10.0*SCM/1E-6)
  690  + +1E-6*1E-6/100.0*EXP(-10.0*SCM/1E-6)
  691  + -1E-6/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-6)
  692  + -1E-6*1E-6/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-6)),0))'
  693  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
  694  + 1E-6/20.0*SCM*EXP(-20.0*SCM/1E-6)
  695  + +1E-6*1E-6/400.0*EXP(-20.0*SCM/1E-6)
  696  + -1E-6/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-6)
  697  + -1E-6*1E-6/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-6)),0))'
