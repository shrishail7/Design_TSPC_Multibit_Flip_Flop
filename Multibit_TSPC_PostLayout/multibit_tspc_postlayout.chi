    1  
    2  *----------------------------------------------------------------------
    3  .SUBCKT NSVTLP D G S B
    4  *----------------------------------------------------------------------
    5  * Family nsvtlp Model nsvtlp bsim4 typ
    6  * release 1.4.b
    7  *----------------------------------------------------------------------
    8  *----------------------------------------------------------------------
    9  +       PARAM:W=0.135 L=0.06 NFING=1.0 NCRSD=1.0 MISMATCH=1.0 SRCEFIRST=1.0 TOMETER=1E-06 LPE=0.0 
   10  + AS=-1 AD=-1 PS=-1 PD=-1 PO2ACT=-1 SCA=-1 SCB=-1 SCC=-1 SC=-1 MULT=1.0 NRD=0.0 
   11  + NRS=0.0 NGCON=1.0 NUMCOS=-1 NUMCOD=-1 POCOS=-1 POCOD=-1 DVT_MDEV=0.0 DMU_MDEV=0.0 
   12  + DNOISE_MDEV=0.0 SPOA=-1 SPOB=-1 
   13  
   14  
   15  
   16  *------------------------------------------------------------------------------
   17  * flag used to switch on/off device access modeling (for post layout simulation)
   18  *------------------------------------------------------------------------------
   19  *   lpe     Body      Access_R  Access_C   Extraction_mode
   20  *    0       yes        yes       yes           --
   21  *    1       yes        yes       no             C
   22  *    2       yes        no        yes            R
   23  *    3       yes        no        no             RC
   24  *
   25  .PARAM LPER = 'VALIF(((LPE==2) || (LPE==3)),(1),(0))'
   26  .PARAM LPEC = 'VALIF(((LPE==1) || (LPE==3) || (LPE==97)),(1),(0))'
   27  .PARAM ALIGNMENT_PRELAYOUT  = 'VALIF(((LPE==99) || (LPE==98)),(1),(0))'
   28  .PARAM ALIGNMENT_POSTLAYOUT = 'VALIF((LPE==98),(1),(0))'
   29  .PARAM LPEC2 = 'VALIF(((LPE==1) || (LPE==3)),(1),(0))'
   30  
   31  
   32  *-----------------------------------------------------------------------------------------------------
   33  * flag used to switch on/off Source and Drain diffusion access resistances (for post layout simulation) 
   34  *-----------------------------------------------------------------------------------------------------
   35  .PARAM NRSD_FLAG = 'VALIF(((NRS==0) && (NRD==0)),(0),(1))'
   36  
   37  
   38  
   39  *--------------------------------------------------------
   40  * flag used to switch on/off mismatch into process corners
   41  *--------------------------------------------------------
   42  * svtlp_dev  no_mm  mc_mm  mm_in_corners  param_mm
   43  *       0       yes    no     no             no
   44  *       1       no     yes    no             no
   45  *       2       no     no     yes            no
   46  *       3       no     no     no             yes
   47  *
   48  .PARAM MFLAG_NO        = 'VALIF((SVTLP_DEV==0),(1),(0))'
   49  .PARAM MFLAG_MC        = 'VALIF((SVTLP_DEV==1),(1),(0))'
   50  .PARAM MFLAG_CORNER    = 'VALIF((SVTLP_DEV==2),(1),(0))'
   51  .PARAM MFLAG_PARAM     = 'VALIF((SVTLP_DEV==3),(1),(0))'
   52  
   53  
   54  
   55  
   56  * Device temperature:
   57  *--------------------
   58  .PARAM TEMPK   = 'TEMPER+273.15'
   59  
   60  
   61  * invariant parameters:
   62  *----------------------
   63  .PARAM MOSTYPE = 1  
   64  
   65  .PARAM CONW    = '0.09E-6'
   66  .PARAM CONS    = '0.11E-6'
   67  .PARAM COEACT1  = '0.015E-6'
   68  .PARAM COEACT2  = '0.03E-6'
   69  .PARAM CONPO   = '0.055E-6'
   70  .PARAM PO2DB   = '0.100E-6'
   71  .PARAM LINT    = -2E-09
   72  .PARAM DLC     = 7.7532E-09
   73  .PARAM LMIN    = 6E-8
   74  .PARAM DWU0    = -0.12476
   75  .PARAM WINT    = -2.1582E-08
   76  .PARAM DWC     = -5E-09
   77  .PARAM DWJ     = 0
   78  .PARAM COEPO   = '0.01E-6'
   79  
   80  .PARAM DIODEMOD = 1
   81  
   82  
   83  
   84  * variant parameters:
   85  *--------------------
   86  .PARAM XL      = '5E-09 + NSVTLP_DXL_CMOS065'
   87  .PARAM XW      = '0 + NSVTLP_DXW_CMOS065'
   88  .PARAM TOX     = '2.3926E-09 + NSVTLP_DTOXE_CMOS065'
   89  .PARAM DMU     = NSVTLP_DMU_CMOS065
   90   
   91  
   92  .PARAM  CJS     = '0.0012368*(1 + NSVTLP_DCJB_CMOS065)'
   93  .PARAM  CJSWS   = '3.4918E-11*(1 + NSVTLP_DCJSW_CMOS065)'
   94  .PARAM  CJSWGS  = '1.8517E-10*(1 + NSVTLP_DCJGATE_CMOS065)'
   95  .PARAM  CJD     = '0.0012368*(1 + NSVTLP_DCJB_CMOS065)'
   96  .PARAM  CJSWD   = '3.4918E-11*(1 + NSVTLP_DCJSW_CMOS065)'
   97  .PARAM  CJSWGD  = '1.8517E-10*(1 + NSVTLP_DCJGATE_CMOS065)'
   98  .PARAM  JSS     = '0*10^NSVTLP_DIDIODE_CMOS065'
   99  .PARAM  JSWS    = '3.1831E-14*10^NSVTLP_DIDIODE_CMOS065'
  100  .PARAM  JSWGS   = '0*10^NSVTLP_DIDIODE_CMOS065'
  101  .PARAM  JTSS    = '6.9304E-06*10^NSVTLP_DIDIODE_CMOS065'
  102  .PARAM  JTSSWS  = '1.1025E-10*10^NSVTLP_DIDIODE_CMOS065'
  103  .PARAM  JTSSWGS = '3.0879E-11*10^NSVTLP_DIDIODE_CMOS065'
  104  .PARAM  JSD     = '0*10^NSVTLP_DIDIODE_CMOS065'
  105  .PARAM  JSWD    = '3.1831E-14*10^NSVTLP_DIDIODE_CMOS065'
  106  .PARAM  JSWGD   = '0*10^NSVTLP_DIDIODE_CMOS065'
  107  .PARAM  JTSD    = '6.9304E-06*10^NSVTLP_DIDIODE_CMOS065'
  108  .PARAM  JTSSWD  = '1.1025E-10*10^NSVTLP_DIDIODE_CMOS065'
  109  .PARAM  JTSSWGD = '3.0879E-11*10^NSVTLP_DIDIODE_CMOS065'
  110  .PARAM DAGIDL  = NSVTLP_DAGIDL_CMOS065
  111  .PARAM DCFRING = NSVTLP_DCFRING_CMOS065
  112  .PARAM DRDSW   = NSVTLP_DRDSW_CMOS065
  113  
  114  .PARAM RSH      = '12 + NSVTLP_DRSH_CMOS065'
  115  .PARAM RCONSD  = '37.5+NSVTLP_DRCONSD_CMOS065'
  116  .PARAM RSHG     = '15 + NSVTLP_DRSHG_CMOS065'
  117  .PARAM RSHGUM   = '163 + NSVTLP_DRSHGU_CMOS065'
  118  .PARAM RSHGU    = '170 + NSVTLP_DRSHGU_CMOS065'
  119  
  120  
  121  
  122  * Layout and electrical dimensions:
  123  *----------------------------------
  124  .PARAM WM='W*TOMETER'
  125  .PARAM LM='L*TOMETER'
  126  .PARAM WFING='WM/NFING+XW'
  127  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
  128  .PARAM FS='2-FD'
  129  .PARAM ADP ='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FD*(CONW/2.0+COEACT2)+XW/2)'
  130  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
  131  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
  132  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
  133  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  134  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  135  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
  136  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
  137  .PARAM POCOSM	= 'POCOS*TOMETER'
  138  .PARAM POCODM	= 'POCOD*TOMETER'
  139  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
  140  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
  141  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  142  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
  143  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
  144  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
  145  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
  146  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  147  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
  148  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
  149  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
  150  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
  151  
  152  * DC Effective length and width:
  153  *---------------------------
  154  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  155  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  156  * AC Effective length and width:
  157  *------------------------------
  158  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  159  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(2.2556E-16/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  160  *  Effective Source/Drain Junction width:
  161  *---------------------------------------
  162  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  163  
  164  
  165  * Model improvement equations :
  166  *------------------------------
  167  
  168   
  169      * Continuous Model for mismatch deviations 
  170  *----------------------------------------
  171  .PARAM X_DEV        = 0.0 DEVX/GAUSS = {1.0}
  172  .PARAM Y_DEV        = 0.0 DEVX/GAUSS = {1.0}
  173  .PARAM Z_DEV        = 0.0 DEVX/GAUSS = {1.0}
  174  .PARAM DVTH_AVT        = '4.5E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
  175  .PARAM DBETA_ABETA     = '0.81E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
  176  
  177  
  178  .PARAM PVT          = 4.9E-06      
  179  .PARAM TPVT         = -0.014E-06     
  180  .PARAM ZETAVT       = 0.37E+12
  181  .PARAM DVTH_PVT    = '(PVT+TPVT*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETAVT*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
  182  .PARAM DVTH0_SIG = 'SQRT(DVTH_PVT*DVTH_PVT+DVTH_AVT*DVTH_AVT)'
  183  .PARAM DVTH0_DEV = '(DVTH_AVT*X_DEV+DVTH_PVT*Y_DEV)*SVTLP_DEV*MISMATCH'
  184  
  185  
  186  .PARAM PBETA        = 0.77E-05    
  187  .PARAM TPBETA       = -0.0062E-05   
  188  .PARAM ZETABETA     = 9.4E+10
  189  .PARAM DBETA_PBETA = '(PBETA+TPBETA*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETABETA*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
  190  .PARAM DBETA_SIG = 'SQRT(DBETA_PBETA*DBETA_PBETA+DBETA_ABETA*DBETA_ABETA)'
  191  .PARAM DBETA_DEV = '(DBETA_ABETA*Z_DEV+DBETA_PBETA*Y_DEV)*SVTLP_DEV*MISMATCH'
  192  
  193  .PARAM PROCESSSTATFLAGS = '1.0'
  194  .PARAM DVTHTOT   = 'NSVTLP_DVTH0_CMOS065/(VALIF((NSVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  195  .PARAM VTH     = '0.42333+NSVTLP_DVTH0_CMOS065'
  196  
  197  
  198  * Equation for  AGIDL:
  199  * --------------------
  200  .PARAM AGIDL   = '(4.1681E-05)*10^DAGIDL'
  201  
  202  
  203  * Equations for mobility :
  204  *-------------------------
  205  .PARAM EPSILON2 = 1E-18
  206  .PARAM LLIMIT = '7.96E-07-XL' 
  207  .PARAM WLIMIT = '3.75096E-07-XW' 
  208  .PARAM DWU = 'DWU0+(-0.5)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
  209  .PARAM MOBILITY = '2.0/(0.004525008559+(LLIMIT+XL
  210  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.0002557917469/LE)
  211  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  212  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  213  
  214  
  215  
  216  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  217  
  218  
  219  * Channel doping nch and body factor k1 worst case :
  220  *---------------------------------------------------
  221  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  222  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  223  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(7.863E+17/NI)+0.25043+0.4'
  224  .PARAM  K2        =  '(-0.016255+-6.219E-09/LE)*(TOX/2.3926E-09)'
  225  .PARAM  K1        =  '(0.35383)-MOSTYPE*(0.42333-VTH)/SQRT(PHIS_TYP)'
  226  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  227  .PARAM  NCH       =  '7.863E+17*(K1*K1)/((0.35383)*(0.35383))'
  228  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  229  * Series resistance worst case :
  230  *-------------------------------
  231  .PARAM RDSW      =  '(195.87)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  232  .PARAM PRWB      =  0
  233  
  234  
  235  
  236  
  237  
  238  
  239  * Equations for Poly spacing effect:
  240  *-----------------------------------
  241  .PARAM SPODEFM  = '0.2E-6'
  242  .PARAM SPOAM    = 'VALIF((SPOA > 0),(SPOA*TOMETER),(SPODEFM))'
  243  .PARAM SPOBM    = 'VALIF((SPOB > 0),(SPOB*TOMETER),(SPODEFM))'
  244  .PARAM SPOM     = '2/(1/(MIN(SPOAM,SPOBM)-5E-09)+1/(MIN(SPOAM,SPOBM)-5E-09))'
  245  .PARAM DVT_SPO_LR = '1.000*((5.361E-8/(SPOM))**4.8125-(5.361E-8/(0.2E-6-5E-09))**4.8125)'
  246  .PARAM DVT_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DVT_SPO_LR/0.42333*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DVT_SPO_LR'
  247  .PARAM DU0_SPO_LR = '-1.000*((2.9899E-8/(SPOM))**1.859-(2.9899E-8/(0.2E-6-5E-09))**1.859)'
  248  .PARAM DU0_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DU0_SPO_LR*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DU0_SPO_LR'
  249  .PARAM VSATEFF = '(1.7862E+05)*(1+DU0_SPO)'
  250  
  251  
  252  * Equations for stress :
  253  *-----------------------
  254  
  255  .PARAM C_1	= 'CONW+COEACT2+CONPO'
  256  .PARAM C_2 	= C_1
  257  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
  258  .PARAM B_2	= B_1 
  259  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  260  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  261  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  262  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  263  * Stress effect on threshold voltage :
  264  *-------------------------------------
  265  
  266  
  267  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((-5.6224E-16*NFING/WM+2.2724E-09)/2)*(ABS(1/LM-(0*NFING/WM+7E+06))+(1/LM -(0*NFING/WM+7E+06)))+3.5294E-10*NFING/WM+-0.0040207'
  268  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  269  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NSVTLP_DVTH0_CMOS065+DVTHTOT+DVT_SPO'
  270  * Stress effect on mobility :
  271  *----------------------------
  272  
  273  
  274  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-2.1056E-08)/2)*(ABS(1/LM-(-0.08785*NFING/WM+3.8298E+06))-(1/LM -(-0.08785*NFING/WM+3.8298E+06)))+((-5.9944E-15*NFING/WM+2.1544E-08)/2)*(ABS(1/LM-(0.1532*NFING/WM +9E+06))+(1/LM -(0.1532*NFING/WM+9E+06)))+-3E-09*NFING/WM+0.07397'
  275  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  276  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)*(1+DU0_SPO)'
  277  * Stress effect on body factor K1 :
  278  *----------------------------------
  279  .PARAM VARMAXK1         = '-0.04+0/LM+1E-08*NFING/WM'
  280  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  281  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  282  * Stress effect on DVT0 :
  283  *------------------------
  284  .PARAM DVT0_STRESS        = -0.065
  285  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  286  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  287  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  288  * Stress effect on access resistance :
  289  *-------------------------------------
  290  .PARAM VARMAXRDSW       = '0.15+-5.67E-08*NFING/WM'
  291  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  292  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  293  
  294  
  295  .PARAM NFACTOR = '(1.183+1.3488E-07/LE)*SQRT(PHIS*7.863E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
  296  
  297  
  298  
  299  * Equations for VT :
  300  *-------------------
  301  .PARAM W0       = '2.2957E-08+(0-XW)'
  302  .PARAM K3B      = '(3+-1.7E-07/LE)*(2.3926E-09/TOX)'
  303  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  304  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*7.863E+17*1E6))'
  305  .PARAM DVTP0    = 0
  306  
  307  
  308  .PARAM N_SUBVT  = '1.0+(1.183+1.3488E-07/LE)*7.177800693E-09/XDEP0'
  309  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.4293E-06))'
  310  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
  311  .PARAM K3       = '(-5.8321)*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
  312  
  313  
  314  
  315  * Equation for moin :
  316  *-------------------
  317  .PARAM MOIN = 'VALIF((5.8569*((0.35383)/K1EFF)^2 > 5), (5.8569*((0.35383)/K1EFF)^2), (5))'
  318  
  319  
  320  * Equations for LKETA :
  321  *---------------------
  322  
  323  
  324  .PARAM LKETA    = 0.001 
  325  
  326  
  327  *Worst case methodology improvement: Short Channel effect
  328  *--------------------------------------------------------
  329  .PARAM LPE0  = '((((0.35383)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(3E-13+1.16E-14/LE)/(LMIN+5E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  330  .PARAM LPEB  = '(1.2424E-07)/(LMIN+5E-09-2*LINT)*(LMIN+XL-2*LINT)'
  331  .PARAM DVT1  = '0.032*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  332  .PARAM DVT1W = '8.4182E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  333  .PARAM DSUB = '(0.024314)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  334  
  335  
  336  
  337  * Equations for Extrinsic Capacitances:
  338  * ------------------------------------
  339  
  340  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  341  
  342  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  343  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  344  
  345  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  346  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  347  
  348  
  349  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  350  
  351  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  352  
  353  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
  354  
  355  .PARAM CGSL = '((4.2E-11) + 7E-18/LM  + -3.3E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
  356  .PARAM CGDL = '((4.2E-11) + 7E-18/LM  + -3.3E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
  357  .PARAM CGSO       =  'VALIF((POCOSM>0),(3.3E-11*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),3.3E-11*(2.3926E-09/TOX))'
  358  .PARAM CGDO       =  'VALIF((POCOSM>0),(3.3E-11*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),3.3E-11*(2.3926E-09/TOX))'
  359  
  360  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  361  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  362  
  363  
  364  
  365  * Equations for extrinsic S/D resistances:
  366  * ---------------------------------------
  367  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
  368   
  369  * Unsilicided poly gate resistance:
  370  * --------------------------------
  371  .PARAM RSHGUMMID = '(585+RSHGUM)/2 + (585-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
  372  .PARAM RSHGUMEFF = 'RSHGUMMID*585*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*585)'
  373  
  374  
  375  * Salicided poly gate resistance:
  376  * ------------------------------
  377  
  378   .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==0),(1-ALIGNMENT_PRELAYOUT),(0))'
  379  .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__1__YES = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==1),(1-ALIGNMENT_PRELAYOUT),(0))'
  380  .PARAM RGATEMOD = GFLAG__RGATESWITCH__ALL__CMOS065__1__YES 
  381  .PARAM RGATE    = '(((RSHG*(WM/NFING+XW))/(3*NGCON**2*(LM+XL+9E-09)))+((4.13E-12+RSHGUMEFF*1E-07*(1E-07-2.5E-08))/((WM/NFING+XW)*(LM+XL))))/NFING'
  382  .PARAM RSHG0    = 'RGATE*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
  383  
  384  * Salicided Source/Drain diffusion access resistances:
  385  * ---------------------------------------------------
  386  .PARAM NRSEFF    = 'NRS'
  387  .PARAM NRDEFF    = 'NRD'
  388  
  389  
  390  
  391  * Equations for VOFF:
  392  * ------------------
  393  
  394  .PARAM VOFF = '-0.16444 + -0.14555*(TEMPK/(25+273.15) -1)' 
  395  
  396  
  397  
  398  * Equations for temperature dependance of BGIDL:
  399  * --------------------------------------------
  400  .PARAM BGIDL = '4.927E+09 + -1.198E+09*(TEMPK/(25+273.15) -1)'
  401  
  402  
  403  * Equations for temperature dependence of series resistances:
  404  * -----------------------------------------------------------
  405  .PARAM RDWMIN = 0
  406  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 100*(TEMPK/(25+273.15) -1)), (0))'
  407  .PARAM RSWMIN = 0
  408  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 100*(TEMPK/(25+273.15) -1)), (0))'
  409  .PARAM RDSWMIN = 0
  410  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 100*(TEMPK/(25+273.15) -1)), (0))'
  411  .PARAM RSW = 0
  412  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 100*(TEMPK/(25+273.15) -1)), (0))'
  413  .PARAM RDW = 0
  414  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 100*(TEMPK/(25+273.15) -1)), (0))'
  415  .PARAM RDSWEFF2 = '(RDSWEFF + 100*(TEMPK/(25+273.15) -1))'
  416  .PARAM PRT = 0
  417  
  418  
  419  * Equations for thermal noise scaling
  420  * ------------------------------------
  421  .PARAM NTNOI = '1*LE/LEC'
  422  
  423  
  424  
  425  * Equations for Flicker Noise Local Variations
  426  * --------------------------------------------
  427  
  428  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
  429  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
  430  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
  431  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
  432  .PARAM NOIA    = '((TANH((LE-1)*1))*(0)/2+4.4E+42)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*DNOISE_MDEV)'
  433  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*DNOISE_MDEV)'
  434  .PARAM NOIC    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*DNOISE_MDEV)'
  435  
  436  
  437  
  438  
  439  * Selection of the WPE model parameter values depending on the netlist extraction:
  440  * -------------------------------------------------------------------------------
  441  .PARAM WPEMOD   = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1),(1))'
  442  .PARAM KVTH0WE  = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0.0040935+-1.221E-10/LE+-1.74E-10/WE+0.0/(LE*WE))),((7.700107E-3+-2.231503E-10/LE+-2.612565E-10/WE)))'
  443  .PARAM K2WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0.001054073+-8.3058E-12/LE+-1.39175E-10/WE)),((0.0030205+-1.007E-11/LE+-1.3918E-10/WE)))'
  444  .PARAM SCREF    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1E-6),(1E-06))'
  445  .PARAM KU0WE    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((-0.001646+-7.02E-11/LE+3.64E-10/WE+0.0/(LE*WE))),((-0.00013709+2.1621E-10/LE+-2.3775E-09/WE)))'
  446  .PARAM WEB      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
  447  .PARAM WEC2      =  'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
  448  
