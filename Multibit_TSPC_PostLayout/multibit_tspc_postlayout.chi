  140  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
  141  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  142  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
  143  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
  144  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
  145  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
  146  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  147  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
  148  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
  149  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
  150  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
  151  
  152  * DC Effective length and width:
  153  *---------------------------
  154  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  155  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  156  * AC Effective length and width:
  157  *------------------------------
  158  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  159  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(4.2E-16/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  160  *  Effective Source/Drain Junction width:
  161  *---------------------------------------
  162  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  163  
  164  
  165  * Model improvement equations :
  166  *------------------------------
  167  
  168  * Equations for mismatch deviations:
  169  *-----------------------------------
  170  .PARAM DVTH0_ALPHA = (4.9E-9)
  171  .PARAM DVTH0_BETA  = (0.0)
  172  .PARAM DVTH0_FUDGE  = (1)
  173  .PARAM DVTH0_ALPHA_C2 = (4.9E-9)
  174  .PARAM DVTH0_BETA_C2  = (0.0)
  175  .PARAM DVTH0_FUDGE_C2 = (1)
  176  .PARAM DVTH0_SIG = {(((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DVTH0_ALPHA_C2/SQRT(WM*LM))+DVTH0_BETA_C2)*DVTH0_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
  177  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*HVTLP_DEV*MISMATCH}
  178  .PARAM DBETA_ALPHA = (0.77E-8)
  179  .PARAM DBETA_BETA  = (0.0)
  180  .PARAM DBETA_FUDGE  = (1)
  181  .PARAM DBETA_ALPHA_C2 = (0.77E-8)
  182  .PARAM DBETA_BETA_C2  = (0.0)
  183  .PARAM DBETA_FUDGE_C2 = (1)
  184  .PARAM DBETA_SIG = {(((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DBETA_ALPHA_C2/SQRT(WM*LM))+DBETA_BETA_C2)*DBETA_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
  185  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*HVTLP_DEV*MISMATCH}
  186  
  187  
  188  .PARAM PROCESSSTATFLAGS = '1.0'
  189  .PARAM DVTHTOT   = 'NHVTLP_DVTH0_CMOS065/(VALIF((NHVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((NHVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NHVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  190  .PARAM VTH     = '0.60191+NHVTLP_DVTH0_CMOS065'
  191  
  192  
  193  * Equation for  AGIDL:
  194  * --------------------
  195  .PARAM AGIDL   = '(3.4049E-06)*10^DAGIDL'
  196  
  197  
  198  * Equations for mobility :
  199  *-------------------------
  200  .PARAM EPSILON2 = 1E-18
  201  .PARAM LLIMIT = '6.29744E-08-XL' 
  202  .PARAM WLIMIT = '7.702188E-07-XW' 
  203  .PARAM DWU = 'DWU0+(0.7)*0.5E6*(ABS(LE-8E-08)-(LE-8E-08))' 
  204  .PARAM MOBILITY = '2.0/(0.004990258812+(LLIMIT+XL
  205  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.0002400034857/LE)
  206  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  207  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  208  
  209  
  210  
  211  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NHVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  212  
  213  
  214  * Channel doping nch and body factor k1 worst case :
  215  *---------------------------------------------------
  216  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  217  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  218  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.3118E+18/NI)+0.25043+0.4'
  219  .PARAM  K2        =  '(-0.011192+-6.4929E-09/LE)*(TOX/2.3926E-09)'
  220  .PARAM  K1        =  '(0.45723)-MOSTYPE*(0.60191-VTH)/SQRT(PHIS_TYP)'
  221  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  222  .PARAM  NCH       =  '1.3118E+18*(K1*K1)/((0.45723)*(0.45723))'
  223  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  224  * Series resistance worst case :
  225  *-------------------------------
  226  .PARAM RDSW      =  '(331.79+0.0/LE+0.0/WE+0.0/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NHVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  227  .PARAM PRWB      =  0.013147
  228  
  229  
  230  
  231  
  232  
  233  
  234  * Equations for Poly spacing effect:
  235  *-----------------------------------
  236  .PARAM SPODEFM  = '0.2E-6'
  237  .PARAM SPOAM    = 'VALIF((SPOA > 0),(SPOA*TOMETER),(SPODEFM))'
  238  .PARAM SPOBM    = 'VALIF((SPOB > 0),(SPOB*TOMETER),(SPODEFM))'
  239  .PARAM SPOM     = '2/(1/(MIN(SPOAM,SPOBM)-5E-09)+1/(MIN(SPOAM,SPOBM)-5E-09))'
  240  .PARAM DVT_SPO_LR = '1.000*((5.361E-8/(SPOM))**4.8125-(5.361E-8/(0.2E-6-5E-09))**4.8125)'
  241  .PARAM DVT_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DVT_SPO_LR/0.60191*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DVT_SPO_LR'
  242  .PARAM DU0_SPO_LR = '-1.000*((2.9899E-8/(SPOM))**1.859-(2.9899E-8/(0.2E-6-5E-09))**1.859)'
  243  .PARAM DU0_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DU0_SPO_LR*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DU0_SPO_LR'
  244  .PARAM VSATEFF = '(2.1366E+05+0.0055593/LE+-0.003/WE)*(1+DU0_SPO)'
  245  
  246  
  247  * Equations for stress :
  248  *-----------------------
  249  
  250  .PARAM C_1	= 'CONW+COEACT2+CONPO'
  251  .PARAM C_2 	= C_1
  252  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
  253  .PARAM B_2	= B_1 
  254  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  255  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  256  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  257  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  258  * Stress effect on threshold voltage :
  259  *-------------------------------------
  260  
  261  
  262  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((-1.6035E-16*NFING/WM+1.0356E-09)/2)*(ABS(1/LM-(0*NFING/WM+4.7637E+06))+(1/LM -(0*NFING/WM+4.7637E+06)))+4.8551E-10*NFING/WM+-0.0048908'
  263  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  264  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NHVTLP_DVTH0_CMOS065+DVTHTOT+DVT_SPO'
  265  * Stress effect on mobility :
  266  *----------------------------
  267  
  268  
  269  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-1.057E-08)/2)*(ABS(1/LM-(-0.08785*NFING/WM+6E+06))-(1/LM -(-0.08785*NFING/WM+6E+06)))+((-4.1565E-16*NFING/WM+5.544E-09)/2)*(ABS(1/LM-(0.1532*NFING/WM +9E+06))+(1/LM -(0.1532*NFING/WM+9E+06)))+-3E-09*NFING/WM+0.07397'
  270  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  271  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)*(1+DU0_SPO)'
  272  * Stress effect on body factor K1 :
  273  *----------------------------------
  274  .PARAM VARMAXK1         = '-0.04+0/LM+1E-08*NFING/WM'
  275  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  276  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  277  * Stress effect on DVT0 :
  278  *------------------------
  279  .PARAM DVT0_STRESS        = -0.0045
  280  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  281  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  282  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  283  * Stress effect on access resistance :
  284  *-------------------------------------
  285  .PARAM VARMAXRDSW       = '0.15+-5.67E-08*NFING/WM'
  286  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  287  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  288  
  289  
  290  .PARAM NFACTOR = '(0.68787)*SQRT(PHIS*1.3118E+18/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
  291  
  292  
  293  
  294  * Equations for VT :
  295  *-------------------
  296  .PARAM W0       = '6.7549E-09+(0-XW)'
  297  .PARAM K3B      = '(3+-1.1E-07/LE)*(2.3926E-09/TOX)'
  298  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  299  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*1.3118E+18*1E6))'
  300  .PARAM DVTP0    = 0
  301  
  302  
  303  .PARAM N_SUBVT  = '1.0+(0.68787)*7.177800693E-09/XDEP0'
  304  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.4628E-06))'
  305  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
  306  .PARAM K3       = '(-5.2029+4.5839E-08/(LE*(LMIN+5E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
  307  
  308  
  309  
  310  * Equation for moin :
  311  *-------------------
  312  .PARAM MOIN = 'VALIF((5.7874*((0.45723)/K1EFF)^2 > 5), (5.7874*((0.45723)/K1EFF)^2), (5))'
  313  
  314  
  315  * Equations for LKETA :
  316  *---------------------
  317  
  318  .PARAM LKETAEXP = 'VALIF(((5.94530321E-06/LE-100.5191088) > 34), (34), (5.94530321E-06/LE-100.5191088))'
  319  
  320  .PARAM LKETA    = '-0.0051935/(1.0+EXP(LKETAEXP))'
  321  
  322  
  323  *Worst case methodology improvement: Short Channel effect
  324  *--------------------------------------------------------
  325  .PARAM LPE0  = '((((0.45723)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.75E-08)/(LMIN+5E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  326  .PARAM LPEB  = '(2.7144E-08)/(LMIN+5E-09-2*LINT)*(LMIN+XL-2*LINT)'
  327  .PARAM DVT1  = '0.022524*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  328  .PARAM DVT1W = '2.3483E+06*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  329  .PARAM DSUB = '(1)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  330  
  331  
  332  
  333  * Equations for Extrinsic Capacitances:
  334  * ------------------------------------
  335  
  336  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  337  
  338  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  339  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  340  
  341  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  342  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  343  
  344  
  345  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  346  
  347  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  348  
  349  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
  350  
  351  .PARAM CGSL = '((9.237E-11) + 1.749E-19/LM  + 0/LM^2 + -6E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
  352  .PARAM CGDL = '((9.237E-11) + 1.749E-19/LM  + 0/LM^2 + -6E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
  353  .PARAM CGSO       =  'VALIF((POCOSM>0),(1E-12*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),1E-12*(2.3926E-09/TOX))'
  354  .PARAM CGDO       =  'VALIF((POCOSM>0),(1E-12*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),1E-12*(2.3926E-09/TOX))'
  355  
  356  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  357  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  358  
  359  
  360  
  361  * Equations for extrinsic S/D resistances:
  362  * ---------------------------------------
  363  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
  364   
  365  * Unsilicided poly gate resistance:
  366  * --------------------------------
  367  .PARAM RSHGUMMID = '(585+RSHGUM)/2 + (585-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
  368  .PARAM RSHGUMEFF = 'RSHGUMMID*585*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*585)'
  369  
  370  
  371  * Salicided poly gate resistance:
  372  * ------------------------------
  373  
  374   .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==0),(1-ALIGNMENT_PRELAYOUT),(0))'
  375  .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__1__YES = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==1),(1-ALIGNMENT_PRELAYOUT),(0))'
  376  .PARAM RGATEMOD = GFLAG__RGATESWITCH__ALL__CMOS065__1__YES 
  377  .PARAM RGATE    = '(((RSHG*(WM/NFING+XW))/(3*NGCON**2*(LM+XL+9E-09)))+((4.13E-12+RSHGUMEFF*1E-07*(1E-07-2.5E-08))/((WM/NFING+XW)*(LM+XL))))/NFING'
  378  .PARAM RSHG0    = 'RGATE*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
  379  
  380  * Salicided Source/Drain diffusion access resistances:
  381  * ---------------------------------------------------
  382  .PARAM NRSEFF    = 'NRS'
  383  .PARAM NRDEFF    = 'NRD'
  384  
  385  
  386  
  387  * Equations for VOFF:
  388  * ------------------
  389  
  390  .PARAM VOFF = '-0.17956 + -0.16777*(TEMPK/(25+273.15) -1)' 
  391  
  392  
  393  
  394  * Equations for temperature dependance of BGIDL:
  395  * --------------------------------------------
  396  .PARAM BGIDL = '8.456E+09 + -1.7794E+09*(TEMPK/(25+273.15) -1)'
  397  
  398  
  399  * Equations for temperature dependence of series resistances:
  400  * -----------------------------------------------------------
  401  .PARAM RDWMIN = 0
  402  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  403  .PARAM RSWMIN = 0
  404  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  405  .PARAM RDSWMIN = 0
  406  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  407  .PARAM RSW = 0
  408  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  409  .PARAM RDW = 0
  410  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 308.72*(TEMPK/(25+273.15) -1)), (0))'
  411  .PARAM RDSWEFF2 = '(RDSWEFF + 308.72*(TEMPK/(25+273.15) -1))'
  412  .PARAM PRT = 0
  413  
  414  
  415  * Equations for thermal noise scaling
  416  * ------------------------------------
  417  .PARAM NTNOI = '1*LE/LEC'
  418  
  419  
  420  
  421  * Equations for Flicker Noise Local Variations
  422  * --------------------------------------------
  423  
  424  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
