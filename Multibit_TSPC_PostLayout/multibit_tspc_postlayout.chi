  131  .PARAM FS='2-FD'
  132  .PARAM ADP ='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FD*(CONW/2.0+COEACT2)+XW/2)'
  133  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONPO-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
  134  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
  135  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONPO-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
  136  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  137  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  138  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
