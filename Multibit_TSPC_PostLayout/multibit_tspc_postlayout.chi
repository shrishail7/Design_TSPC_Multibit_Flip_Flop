  689  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
  690  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
