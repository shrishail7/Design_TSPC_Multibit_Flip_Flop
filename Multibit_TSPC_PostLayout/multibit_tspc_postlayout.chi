  203  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  204  .PARAM  NCH       =  '1.3981E+18*(K1*K1)/((0.47182)*(0.47182))'
  205  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  206  * Series resistance worst case :
  207  *-------------------------------
  208  .PARAM RDSW      =  '(766.08+-4.8478E-12/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSRAMDPHVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  209  .PARAM PRWB      =  0.013147
