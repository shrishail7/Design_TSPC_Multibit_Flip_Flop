 1610  
 1611  .PARAM LKETA    = '0.0087889 + -0.01*(TEMPK/(25+273.15) -1)'
 1612  
 1613  
 1614  *Worst case methodology improvement: Short Channel effect
 1615  *--------------------------------------------------------
 1616  .PARAM LPE0  = '((((0.35383)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(3E-08+6E-15/LE)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1617  .PARAM LPEB  = '(0)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
 1618  .PARAM DVT1  = '0.032462*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1619  .PARAM DVT1W = '8.598E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1620  .PARAM DSUB = '(0.73367)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1621  
 1622  
