  235  
  236  .PARAM N_SUBVT  = '1.0+(1.5448)*7.177800693E-09/XDEP0'
  237  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.3E-06))'
  238  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
  239  .PARAM K3       = '(-5.8321)*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
