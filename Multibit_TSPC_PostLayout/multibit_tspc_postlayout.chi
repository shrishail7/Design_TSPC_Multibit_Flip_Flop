  688  .PARAM N_SUBVT  = '1.0+(1.2192)*7.177800693E-09/XDEP0'
  689  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.643E-06))'
  690  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
  691  .PARAM K3       = '(-5.2029+2.5839E-08/(LE*(LMIN+-3E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
  692  
  693  
  694  
  695  * Equation for moin :
  696  *-------------------
  697  .PARAM MOIN = 'VALIF((5.7874*((0.47182)/K1EFF)^2 > 5), (5.7874*((0.47182)/K1EFF)^2), (5))'
  698  
  699  
  700  * Equations for LKETA :
  701  *---------------------
  702  
  703  .PARAM LKETAEXP = 'VALIF(((1.198035222E-06/LE-11.54398942) > 34), (34), (1.198035222E-06/LE-11.54398942))'
  704  .PARAM LKETA    = '-0.02425/(1.0+EXP(LKETAEXP)) + -0.01*(TEMPK/(25+273.15) -1)' 
  705  
  706  
  707  *Worst case methodology improvement: Short Channel effect
  708  *--------------------------------------------------------
  709  .PARAM LPE0  = '((((0.47182)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4.37035E-09)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  710  .PARAM LPEB  = '(7.90859E-09)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
  711  .PARAM DVT1  = '0.022524*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  712  .PARAM DVT1W = '4.2642E+07*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  713  .PARAM DSUB = '(1.3)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  714  
  715  
  716  
  717  * Equations for Extrinsic Capacitances:
  718  * ------------------------------------
  719  
  720  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  721  
  722  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  723  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  724  
  725  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  726  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  727  
  728  
  729  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  730  
  731  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  732  
  733  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
  734  
  735  .PARAM CGSL = '(6.7922E-11)*(2.3926E-09/TOX)'
  736  .PARAM CGDL = '(6.7922E-11)*(2.3926E-09/TOX)'
  737  .PARAM CGSO       =  '9.414E-11*(2.3926E-09/TOX)'
  738  .PARAM CGDO       =  '9.414E-11*(2.3926E-09/TOX)'
  739  
  740  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  741  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  742  
