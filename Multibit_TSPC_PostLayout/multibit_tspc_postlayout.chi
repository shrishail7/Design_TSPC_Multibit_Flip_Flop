  789  *-----------------------
  790  
  791  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
  792  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
  793  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
  794  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
  795  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
  796  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  797  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  798  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  799  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  800  * Stress effect on threshold voltage :
  801  *-------------------------------------
  802  
  803  
  804  .PARAM VARMAXVTH0       = '((3.5E-16*NFING/WM+6.5294E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))-(1/LM -(-0.061381*NFING/WM +4.4092E+06)))+((7.9412E-17*NFING/WM+-2.7059E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))+(1/LM -(-0.061381*NFING/WM+4.4092E+06)))+-4.2353E-10*NFING/WM+-0.0049765'
  805  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  806  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NHVTGP_DVTH0_CMOS065+DVTHTOT'
  807  * Stress effect on mobility :
  808  *----------------------------
  809  
  810  
  811  .PARAM VARMAXU0 	= '((0*NFING/WM+-3E-09)/2)*(ABS(1/LM-(0*NFING/WM+4E+06))-(1/LM -(0*NFING/WM+4E+06)))+((-5.2941E-16*NFING/WM+3E-09)/2)*(ABS(1/LM-(0*NFING/WM +4E+06))+(1/LM -(0*NFING/WM+4E+06)))+-1.7647E-09*NFING/WM+0.046765'
  812  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  813  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
  814  * Stress effect on body factor K1 :
  815  *----------------------------------
  816  .PARAM VARMAXK1         = '0.017+0/LM+-5E-09*NFING/WM'
  817  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  818  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  819  * Stress effect on DVT0 :
  820  *------------------------
  821  .PARAM DVT0_STRESS        = 34405
  822  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  823  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  824  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  825  * Stress effect on access resistance :
  826  *-------------------------------------
  827  .PARAM VARMAXRDSW       = '0+0*NFING/WM'
  828  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  829  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  830  
  831  
  832  .PARAM NFACTOR = '(1.0217+2.4286E-07/LE)*SQRT(PHIS*8.9277E+17/(PHIS_TYP*NCH))*(1.88E-09/TOX)'
  833  
  834  
  835  
  836  * Equations for VT :
  837  *-------------------
  838  .PARAM W0       = '1E-09+(0-XW)'
  839  .PARAM K3B      = '(3+-3.7E-07/LE)*(1.88E-09/TOX)'
  840  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  841  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*8.9277E+17*1E6))'
  842  .PARAM DVTP0    = 0
  843  
  844  
  845  .PARAM N_SUBVT  = '1.0+(1.0217+2.4286E-07/LE)*5.640000544E-09/XDEP0'
  846  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.6676E-06))'
  847  .PARAM TMP2     = '1.692E-09/(WE+W0)'
  848  .PARAM K3       = '(-6.5+3E-07/(LE*(LMIN+-7E-09-2*LINT)/(LMIN+XL-2*LINT)))*(1.88E-09/TOX)+VTH_RSCE/TMP2'
  849  
  850  
  851  
  852  * Equation for moin :
  853  *-------------------
  854  .PARAM MOIN = 'VALIF((6.1782*((0.33572)/K1EFF)^2 > 5), (6.1782*((0.33572)/K1EFF)^2), (5))'
  855  
  856  
  857  * Equations for LKETA :
  858  *---------------------
  859  
  860  
  861  .PARAM LKETA    = -0.003 
  862  
  863  
  864  *Worst case methodology improvement: Short Channel effect
  865  *--------------------------------------------------------
  866  .PARAM LPE0  = '((((0.33572)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.5439E-08+-9.28E-16/LE)/(LMIN+-7E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  867  .PARAM LPEB  = '(0)/(LMIN+-7E-09-2*LINT)*(LMIN+XL-2*LINT)'
  868  .PARAM DVT1  = '1.1958*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  869  .PARAM DVT1W = '1885.6*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  870  .PARAM DSUB = '(0.81511)*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  871  
  872  
  873  
  874  * Equations for Extrinsic Capacitances:
  875  * ------------------------------------
  876  
  877  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
  878  
  879  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
  880  .PARAM C3EXT = '(9.681E-18 + 7.403E-11*(LM + XL))'
  881  
  882  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.237E-17 + 2.400E-18*TANH((LM + XL)/1.258E-07)),(1.474E-17 + 3.229E-18*TANH((LM + XL)/1.497E-07)))'
  883  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.458E-17 + 9.132E-19*TANH((WM/NFING + XW)/1.568E-06) + 1.875E-17*TANH((LM + XL)/5.032E-07)),(1.240E-17 + -2.833E-17*TANH((WM/NFING + XW)/1.635E-06) + 1.043E-17*TANH((LM + XL)/2.752E-07)))' 
  884  
  885  
  886  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-4.315E-19*(1-ALIGNMENT_PRELAYOUT) + 8.264E-11*(WM/NFING + XW) + 4.014E-11*(WM/NFING + XW)*TANH((LM + XL)/3.174E-07)) ,(4.263E-19*(1-ALIGNMENT_PRELAYOUT) + 2.618E-11*(WM/NFING + XW) + 1.895E-11*(WM/NFING + XW)*TANH((LM + XL)/2.508E-07)))'
  887  
  888  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  889  
  890  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
  891  
  892  .PARAM CGSL = '((1E-10) + 3E-19/LM  + 0/LM^2 + -1.1796E-17/WM*NFING + 0/WM^2*NFING^2)*(1.88E-09/TOX)' 
  893  .PARAM CGDL = '((1E-10) + 3E-19/LM  + 0/LM^2 + -1.1796E-17/WM*NFING + 0/WM^2*NFING^2)*(1.88E-09/TOX)' 
  894  .PARAM CGSO       =  'VALIF((POCOSM>0),(1E-13*(1.88E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.8098E-07)*(TANH(POCOSM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.88E-09/TOX))'
  895  .PARAM CGDO       =  'VALIF((POCOSM>0),(1E-13*(1.88E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.8098E-07)*(TANH(POCODM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.88E-09/TOX))'
  896  
  897  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  898  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  899  
  900  
  901  
  902  * Equations for extrinsic S/D resistances:
  903  * ---------------------------------------
  904  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
  905   
  906  * Unsilicided poly gate resistance:
  907  * --------------------------------
  908  .PARAM RSHGUMMID = '(620+RSHGUM)/2 + (620-RSHGUM)*TANH(1E18*(2*2.2E-8-LM-XL))/2'
  909  .PARAM RSHGUMEFF = 'RSHGUMMID*620*(LM+XL)/(2*2.2E-8*RSHGUMMID + (LM+XL-2*2.2E-8)*620)'
  910  
  911  
  912  .PARAM RGATEMOD = 1
  913  .PARAM XGWS    = 'CONRPO-COEPO'
  914  .PARAM XGWU    = 'RPOEXTPOFLD'
  915  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
  916  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
  917  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
  918  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
  919  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
  920  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
  921  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
  922  
  923  * Unsilicided Source/Drain diffusion access resistances:
  924  * -----------------------------------------------------
  925  .PARAM NRSEFF    = 'NRS + (RSD_RPO*ESUM/(RSH*WE)/NFING)'
  926  .PARAM NRDEFF    = 'NRD + (RSD_RPO*EDUM/(RSH*WE)/NFING)'
  927  
  928  
  929  
  930  * Equations for VOFF:
  931  * ------------------
  932  
  933  .PARAM VOFF = '-0.15313 + -0.075489*(TEMPK/(25+273.15) -1)' 
  934  
  935  
  936  
  937  * Equations for temperature dependance of BGIDL:
  938  * --------------------------------------------
  939  .PARAM BGIDL = '2.4657E+10 + -2.2027E+09*(TEMPK/(25+273.15) -1)'
  940  
  941  
  942  * Equations for temperature dependence of series resistances:
  943  * -----------------------------------------------------------
  944  .PARAM RDWMIN = 0
  945  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  946  .PARAM RSWMIN = 0
  947  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  948  .PARAM RDSWMIN = 0
  949  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  950  .PARAM RSW = 0
  951  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  952  .PARAM RDW = 0
  953  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  954  .PARAM RDSWEFF2 = '(RDSWEFF + -61.497*(TEMPK/(25+273.15) -1))'
  955  .PARAM PRT = 0
  956  
  957  
  958  * Equations for thermal noise scaling
  959  * ------------------------------------
  960  .PARAM NTNOI = '1*LE/LEC'
  961  
  962  
  963  
  964  
  965  
