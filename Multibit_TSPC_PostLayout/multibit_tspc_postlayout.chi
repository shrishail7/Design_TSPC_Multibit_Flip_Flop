  254  
  255  *Worst case methodology improvement: Short Channel effect
  256  *--------------------------------------------------------
  257  .PARAM LPE0  = '((((0.47182)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4.37035E-09)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  258  .PARAM LPEB  = '(7.90859E-09)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
  259  .PARAM DVT1  = '0.022524*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  260  .PARAM DVT1W = '4.2642E+07*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  261  .PARAM DSUB = '(1.6)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  262  
