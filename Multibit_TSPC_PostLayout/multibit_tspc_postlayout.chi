 1093  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.003621958121/LE)
 1094  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1095  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1096  
