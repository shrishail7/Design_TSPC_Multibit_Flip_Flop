 2484  .PARAM DVT0EFF		= -2.1337
 2485  .PARAM RDSWEFF0          = RDSW 
 2486  .PARAM VSATEFF = '(3.1161E+06+-0.1/LE)'
 2487  
 2488  
 2489  .PARAM NFACTOR = '(1.0985)*SQRT(PHIS*1.4646E+18/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 2490  
 2491  
 2492  
 2493  * Equations for VT :
 2494  *-------------------
 2495  .PARAM W0       = '3.0052E-07+(0-XW)'
