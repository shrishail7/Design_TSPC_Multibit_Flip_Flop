 1736  +       PARAM:W=0.135 L=0.06 NFING=1.0 NCRSD=1.0 MISMATCH=1.0 SRCEFIRST=1.0 TOMETER=1E-06 LPE=0.0 
 1737  + AS=-1 AD=-1 PS=-1 PD=-1 PO2ACT=-1 SCA=-1 SCB=-1 SCC=-1 SC=-1 MULT=1.0 NRD=0.0 
 1738  + NRS=0.0 NGCON=1.0 NUMCOS=-1 NUMCOD=-1 POCOS=-1 POCOD=-1 DVT_MDEV=0.0 DMU_MDEV=0.0 
 1739  + DNOISE_MDEV=0.0 EDU=0.3 ESU=0.3 
 1740  
