  907  .SUBCKT PSVTLPPUDP D G S B
  908  *----------------------------------------------------------------------
  909  * Family psramdpsvtlp Model psvtlppudp bsim4 typ
  910  * release 1.1.h
  911  *----------------------------------------------------------------------
  912  *----------------------------------------------------------------------
  913  +       PARAM:W=0.09 L=0.07 NFING=1.0 NCRSD=1.0 MISMATCH=1.0 SRCEFIRST=1.0 TOMETER=1E-06 LPE=0.0 
  914  + AS=-1 AD=-1 PS=-1 PD=-1 MULT=1.0 NRD=0.0 NRS=0.0 NGCON=1.0 DVT_MDEV=0.0 DMU_MDEV=0.0 
  915  + 
  916  
  917  
  918  
  919  *------------------------------------------------------------------------------
  920  * flag used to switch on/off device access modeling (for post layout simulation)
  921  *------------------------------------------------------------------------------
  922  *   lpe     Body      Access_R  Access_C   Extraction_mode
  923  *    0       yes        yes       yes           --
  924  *    1       yes        yes       no             C
  925  *    2       yes        no        yes            R
  926  *    3       yes        no        no             RC
  927  *
  928  .PARAM LPER = 'VALIF(((LPE==2) || (LPE==3)),(1),(0))'
  929  .PARAM LPEC = 'VALIF(((LPE==1) || (LPE==3) || (LPE==97)),(1),(0))'
  930  .PARAM ALIGNMENT_PRELAYOUT  = 'VALIF(((LPE==99) || (LPE==98)),(1),(0))'
  931  .PARAM ALIGNMENT_POSTLAYOUT = 'VALIF((LPE==98),(1),(0))'
  932  .PARAM LPEC2 = 'VALIF(((LPE==1) || (LPE==3)),(1),(0))'
  933  
  934  
  935  *-----------------------------------------------------------------------------------------------------
  936  * flag used to switch on/off Source and Drain diffusion access resistances (for post layout simulation) 
  937  *-----------------------------------------------------------------------------------------------------
