 1471  .PARAM KU0WE    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((5.126E-05+1.668E-11/LE+-5.689E-10/WE+5.348E-17/(LE*WE))),((-3.259336E-3+3.23339E-10/LE+-4.397753E-10/WE)))'
 1472  .PARAM WEB      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
 1473  .PARAM WEC2      =  'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
