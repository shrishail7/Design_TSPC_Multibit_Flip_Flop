 1732  .PARAM NCRG    = 1
 1733  .PARAM CONRPO  = '0.22E-6'
 1734  .PARAM RPOEXTPOFLD = '0.22E-6' 
 1735  .PARAM DIODEMOD = 1
 1736  
 1737  
 1738  
 1739  * variant parameters:
 1740  *--------------------
 1741  .PARAM XL      = '-4E-09 + PHVTGP_DXL_CMOS065'
 1742  .PARAM XW      = '0 + PHVTGP_DXW_CMOS065'
 1743  .PARAM TOX     = '1.92E-09 + PHVTGP_DTOXE_CMOS065'
 1744  .PARAM DMU     = PHVTGP_DMU_CMOS065
 1745  
 1746  .PARAM NOIA    = '(5E+42)*(1 + PHVTGP_DNOISE_CMOS065)'
 1747  .PARAM NOIB    = '(0)*(1 + PHVTGP_DNOISE_CMOS065)'
 1748  .PARAM NOIC    = '(5E+09)*(1 + PHVTGP_DNOISE_CMOS065)'
 1749  
 1750  .PARAM  CJS     = '0.0012727*(1 + PHVTGP_DCJB_CMOS065)'
 1751  .PARAM  CJSWS   = '3.2543E-11*(1 + PHVTGP_DCJSW_CMOS065)'
 1752  .PARAM  CJSWGS  = '2.5948E-10*(1 + PHVTGP_DCJGATE_CMOS065)'
 1753  .PARAM  CJD     = '0.0012727*(1 + PHVTGP_DCJB_CMOS065)'
 1754  .PARAM  CJSWD   = '3.2543E-11*(1 + PHVTGP_DCJSW_CMOS065)'
 1755  .PARAM  CJSWGD  = '2.5948E-10*(1 + PHVTGP_DCJGATE_CMOS065)'
 1756  .PARAM  JSS     = '4.7297E-08*10^PHVTGP_DIDIODE_CMOS065'
 1757  .PARAM  JSWS    = '9.5256E-15*10^PHVTGP_DIDIODE_CMOS065'
 1758  .PARAM  JSWGS   = '0*10^PHVTGP_DIDIODE_CMOS065'
 1759  .PARAM  JTSS    = '0*10^PHVTGP_DIDIODE_CMOS065'
 1760  .PARAM  JTSSWS  = '2.5001E-12*10^PHVTGP_DIDIODE_CMOS065'
 1761  .PARAM  JTSSWGS = '3.8006E-09*10^PHVTGP_DIDIODE_CMOS065'
 1762  .PARAM  JSD     = '4.7297E-08*10^PHVTGP_DIDIODE_CMOS065'
 1763  .PARAM  JSWD    = '9.5256E-15*10^PHVTGP_DIDIODE_CMOS065'
 1764  .PARAM  JSWGD   = '0*10^PHVTGP_DIDIODE_CMOS065'
 1765  .PARAM  JTSD    = '0*10^PHVTGP_DIDIODE_CMOS065'
 1766  .PARAM  JTSSWD  = '2.5001E-12*10^PHVTGP_DIDIODE_CMOS065'
 1767  .PARAM  JTSSWGD = '3.8006E-09*10^PHVTGP_DIDIODE_CMOS065'
 1768  .PARAM DAGIDL  = PHVTGP_DAGIDL_CMOS065
 1769  .PARAM DCFRING = PHVTGP_DCFRING_CMOS065
 1770  .PARAM DRDSW   = PHVTGP_DRDSW_CMOS065
 1771  
 1772  .PARAM RSH      = '15 + PHVTGP_DRSH_CMOS065'
 1773  .PARAM RCONSD  = '37.5+PHVTGP_DRCONSD_CMOS065'
 1774  .PARAM RSHG     = '15 + PHVTGP_DRSHG_CMOS065'
 1775  .PARAM RSHGUM   = '442 + PHVTGP_DRSHGU_CMOS065'
 1776  .PARAM RSHGU    = '710 + PHVTGP_DRSHGU_CMOS065'
 1777  
 1778  .PARAM RCONPO	= '37.5 + PHVTGP_DRCONPO_CMOS065'
 1779  .PARAM RHIG	= '0 + PHVTGP_DRHIG_CMOS065'
 1780  .PARAM RSD_RPO  = '265 + PHVTGP_DRSD_RPO_CMOS065'
 1781  
 1782  
 1783  * Layout and electrical dimensions:
 1784  *----------------------------------
 1785  .PARAM WM='W*TOMETER'
 1786  .PARAM LM='L*TOMETER'
 1787  .PARAM WFING='WM/NFING+XW'
 1788  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
 1789  .PARAM FS='2-FD'
 1790  .PARAM EDUM='EDU*TOMETER'
 1791  .PARAM ESUM='ESU*TOMETER'
 1792  .PARAM ADP='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(CONW/2.0+COEACT2+XW/2))'
 1793  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
 1794  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
 1795  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
 1796  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 1797  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 1798  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 1799  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 1800  .PARAM POCOSM	= 'POCOS*TOMETER'
 1801  .PARAM POCODM	= 'POCOD*TOMETER'
 1802  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
 1803  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 1804  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 1805  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
 1806  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
 1807  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
 1808  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
 1809  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 1810  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
 1811  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
 1812  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
 1813  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
 1814  
 1815  * DC Effective length and width:
 1816  *---------------------------
 1817  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1818  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1819  * AC Effective length and width:
 1820  *------------------------------
 1821  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1822  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(1.8E-16/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1823  *  Effective Source/Drain Junction width:
 1824  *---------------------------------------
 1825  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 1826  
 1827  
 1828  * Model improvement equations :
 1829  *------------------------------
 1830  
 1831  * Equations for mismatch deviations:
 1832  *-----------------------------------
 1833  .PARAM DVTH0_ALPHA = (2.5E-9)
 1834  .PARAM DVTH0_BETA  = (0.0)
 1835  .PARAM DVTH0_FUDGE  = (1.0)
 1836  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
 1837  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*HVTGP_DEV*MISMATCH}
 1838  .PARAM DBETA_ALPHA = (0.61E-8)
 1839  .PARAM DBETA_BETA  = (0.0)
 1840  .PARAM DBETA_FUDGE  = (1.0)
 1841  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
 1842  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*HVTGP_DEV*MISMATCH}
 1843  
 1844  
 1845  .PARAM PROCESSSTATFLAGS = '1.0'
 1846  .PARAM DVTHTOT   = 'PHVTGP_DVTH0_CMOS065/(VALIF((PHVTGP_DVTH0_CMOS065==0),(1),(0))+SQRT((PHVTGP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PHVTGP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PHVTGP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1847  .PARAM VTH     = '-0.3803+PHVTGP_DVTH0_CMOS065'
 1848  
 1849  
 1850  * Equation for  AGIDL:
 1851  * --------------------
 1852  .PARAM AGIDL   = '(0.0057016)*10^DAGIDL'
 1853  
 1854  
 1855  * Equations for mobility :
 1856  *-------------------------
 1857  .PARAM EPSILON2 = 1E-18
 1858  .PARAM LLIMIT = '3.1301E-08-XL' 
 1859  .PARAM WLIMIT = '2.870386E-06-XW' 
 1860  .PARAM DWU = DWU0
 1861  .PARAM MOBILITY = '2.0/(0.009091661343+(LLIMIT+XL
 1862  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.00392917199/LE)
 1863  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1864  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1865  
 1866  
 1867  
 1868  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PHVTGP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1869  
 1870  
 1871  * Channel doping nch and body factor k1 worst case :
 1872  *---------------------------------------------------
 1873  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1874  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1875  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.0525E+18/NI)+0.2211+0.4'
 1876  .PARAM  K2        =  '(-0.010266+-1E-09/LE)*(TOX/1.92E-09)'
 1877  .PARAM  K1        =  '(0.44634)-MOSTYPE*(-0.3803-VTH)/SQRT(PHIS_TYP)'
 1878  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1879  .PARAM  NCH       =  '1.0525E+18*(K1*K1)/((0.44634)*(0.44634))'
 1880  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.2211+0.4'
 1881  * Series resistance worst case :
 1882  *-------------------------------
 1883  .PARAM RDSW      =  '(200+8E-06/LE+2.6603E-06/WE+1E-12/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PHVTGP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1884  .PARAM PRWB      =  0.5258
 1885  
 1886  
 1887  
 1888  
 1889  
 1890  
 1891  .PARAM VSATEFF = '(9.6425E+05+0.0079/LE)'
 1892  
 1893  * Equations for stress :
 1894  *-----------------------
 1895  
 1896  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
 1897  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
 1898  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
 1899  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
 1900  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
 1901  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 1902  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 1903  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 1904  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 1905  * Stress effect on threshold voltage :
 1906  *-------------------------------------
 1907  
 1908  
 1909  .PARAM VARMAXVTH0       = '((-1.2353E-17*NFING/WM+-1.6765E-10)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))-(1/LM -(0*NFING/WM +1E+07)))+((0*NFING/WM+6E-10)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))+(1/LM -(0*NFING/WM+1E+07)))+8.8235E-11*NFING/WM+0.00041177'
 1910  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1911  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PHVTGP_DVTH0_CMOS065+DVTHTOT'
 1912  * Stress effect on mobility :
 1913  *----------------------------
 1914  
 1915  
 1916  .PARAM VARMAXU0 	= '((0*NFING/WM+1E-09)/2)*(ABS(1/LM-(0*NFING/WM+1E+07))-(1/LM -(0*NFING/WM+1E+07)))+((-8E-16*NFING/WM+2.5882E-09)/2)*(ABS(1/LM-(0*NFING/WM +1E+07))+(1/LM -(0*NFING/WM+1E+07)))+3.0882E-09*NFING/WM+-0.0055882'
 1917  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1918  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 1919  * Stress effect on body factor K1 :
 1920  *----------------------------------
 1921  .PARAM VARMAXK1         = '0.023488+-9.8448E-10/LM+-7.8493E-10*NFING/WM'
 1922  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1923  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 1924  * Stress effect on DVT0 :
 1925  *------------------------
 1926  .PARAM DVT0_STRESS        = -106.24
 1927  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 1928  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1929  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 1930  * Stress effect on access resistance :
 1931  *-------------------------------------
 1932  .PARAM VARMAXRDSW       = '0+0*NFING/WM'
 1933  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1934  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 1935  
 1936  
 1937  .PARAM NFACTOR = '(1.2765+-8.1847E-15/LE)*SQRT(PHIS*1.0525E+18/(PHIS_TYP*NCH))*(1.92E-09/TOX)'
 1938  
 1939  
 1940  
 1941  * Equations for VT :
 1942  *-------------------
 1943  .PARAM W0       = '1.2168E-07+(0-XW)'
 1944  .PARAM K3B      = '(8.973+9.0317E-08/LE)*(1.92E-09/TOX)'
 1945  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1946  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*1.0525E+18*1E6))'
 1947  .PARAM DVTP0    = 0
 1948  
 1949  
 1950  .PARAM N_SUBVT  = '1.0+(1.2765+-8.1847E-15/LE)*5.760000556E-09/XDEP0'
 1951  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.3327E-07))'
 1952  .PARAM TMP2     = '1.728E-09/(WE+W0)'
 1953  .PARAM K3       = '(-8.6+-9E-08/(LE*(LMIN+-4E-09-2*LINT)/(LMIN+XL-2*LINT)))*(1.92E-09/TOX)+VTH_RSCE/TMP2'
 1954  
 1955  
 1956  
 1957  * Equation for moin :
 1958  *-------------------
 1959  .PARAM MOIN = 'VALIF((10*((0.44634)/K1EFF)^2 > 5), (10*((0.44634)/K1EFF)^2), (5))'
 1960  
 1961  
 1962  * Equations for LKETA :
 1963  *---------------------
 1964  
 1965  .PARAM LKETAEXP = 'VALIF(((28384.09355/LE-4.730682259E+13) > 34), (34), (28384.09355/LE-4.730682259E+13))'
 1966  
 1967  .PARAM LKETA    = '-0.0046213/(1.0+EXP(LKETAEXP))'
 1968  
 1969  
 1970  *Worst case methodology improvement: Short Channel effect
 1971  *--------------------------------------------------------
 1972  .PARAM LPE0  = '((((0.44634)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(2.6165E-08)/(LMIN+-4E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1973  .PARAM LPEB  = '(0)/(LMIN+-4E-09-2*LINT)*(LMIN+XL-2*LINT)'
 1974  .PARAM DVT1  = '1.4316*SQRT(TOX/1.92E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1975  .PARAM DVT1W = '7.0779E+05*SQRT(TOX/1.92E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1976  .PARAM DSUB = '(0.33123)*SQRT(TOX/1.92E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1977  
 1978  
 1979  
 1980  * Equations for Extrinsic Capacitances:
 1981  * ------------------------------------
 1982  
 1983  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
 1984  
 1985  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
 1986  .PARAM C3EXT = '(9.681E-18 + 7.403E-11*(LM + XL))'
 1987  
 1988  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.237E-17 + 2.400E-18*TANH((LM + XL)/1.258E-07)),(1.474E-17 + 3.229E-18*TANH((LM + XL)/1.497E-07)))'
 1989  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.458E-17 + 9.132E-19*TANH((WM/NFING + XW)/1.568E-06) + 1.875E-17*TANH((LM + XL)/5.032E-07)),(1.240E-17 + -2.833E-17*TANH((WM/NFING + XW)/1.635E-06) + 1.043E-17*TANH((LM + XL)/2.752E-07)))' 
 1990  
 1991  
 1992  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-4.315E-19*(1-ALIGNMENT_PRELAYOUT) + 8.264E-11*(WM/NFING + XW) + 4.014E-11*(WM/NFING + XW)*TANH((LM + XL)/3.174E-07)) ,(4.263E-19*(1-ALIGNMENT_PRELAYOUT) + 2.618E-11*(WM/NFING + XW) + 1.895E-11*(WM/NFING + XW)*TANH((LM + XL)/2.508E-07)))'
 1993  
 1994  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 1995  
 1996  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
 1997  
 1998  .PARAM CGSL = '((9.2E-11) + 1E-18/LM  + 0/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(1.92E-09/TOX)' 
 1999  .PARAM CGDL = '((9.2E-11) + 1E-18/LM  + 0/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(1.92E-09/TOX)' 
 2000  .PARAM CGSO       =  'VALIF((POCOSM>0),(0*(1.92E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.8098E-07)*(TANH(POCOSM/9.9978E-08)-1))*1.7299E-10/WEC),0*(1.92E-09/TOX))'
 2001  .PARAM CGDO       =  'VALIF((POCOSM>0),(0*(1.92E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.8098E-07)*(TANH(POCODM/9.9978E-08)-1))*1.7299E-10/WEC),0*(1.92E-09/TOX))'
 2002  
 2003  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2004  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2005  
 2006  
 2007  
 2008  * Equations for extrinsic S/D resistances:
 2009  * ---------------------------------------
 2010  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 2011   
 2012  * Unsilicided poly gate resistance:
 2013  * --------------------------------
 2014  .PARAM RSHGUMMID = '(620+RSHGUM)/2 + (620-RSHGUM)*TANH(1E18*(2*2.2E-8-LM-XL))/2'
 2015  .PARAM RSHGUMEFF = 'RSHGUMMID*620*(LM+XL)/(2*2.2E-8*RSHGUMMID + (LM+XL-2*2.2E-8)*620)'
 2016  
 2017  
 2018  .PARAM RGATEMOD = 1
 2019  .PARAM XGWS    = 'CONRPO-COEPO'
 2020  .PARAM XGWU    = 'RPOEXTPOFLD'
 2021  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
 2022  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
 2023  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
 2024  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
 2025  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
 2026  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 2027  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
 2028  
 2029  * Unsilicided Source/Drain diffusion access resistances:
 2030  * -----------------------------------------------------
 2031  .PARAM NRSEFF    = 'NRS + (RSD_RPO*ESUM/(RSH*WE)/NFING)'
 2032  .PARAM NRDEFF    = 'NRD + (RSD_RPO*EDUM/(RSH*WE)/NFING)'
