 1965  * Model improvement equations :
 1966  *------------------------------
 1967  
 1968  * Equations for mismatch deviations:
 1969  *-----------------------------------
 1970  .PARAM DVTH0_ALPHA = (4.1E-9)
 1971  .PARAM DVTH0_BETA  = (0.0)
 1972  .PARAM DVTH0_FUDGE  = (1.0)
 1973  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
 1974  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMSPSVTLP_DEV*MISMATCH}
 1975  .PARAM DBETA_ALPHA = (0.98E-8)
 1976  .PARAM DBETA_BETA  = (0.0)
 1977  .PARAM DBETA_FUDGE  = (1.0)
 1978  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
 1979  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMSPSVTLP_DEV*MISMATCH}
 1980  
 1981  
 1982  .PARAM PROCESSSTATFLAGS = '1.0'
 1983  .PARAM DVTHTOT   = 'PSRAMSPSVTLP_DVTH0_CMOS065/(VALIF((PSRAMSPSVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((PSRAMSPSVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PSRAMSPSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PSRAMSPSVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1984  .PARAM VTH     = '-0.48961+PSRAMSPSVTLP_DVTH0_CMOS065'
 1985  
