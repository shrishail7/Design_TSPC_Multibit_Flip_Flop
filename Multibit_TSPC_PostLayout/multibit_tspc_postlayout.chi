 1545  .MODEL PSVTGP PMOS
 1546  + LEVEL=60
 1547  + VERSION=4.5           BINUNIT=1             TNOM=25               
 1548  + TOXE=TOX              TOXP=TOX              TOXM=TOX              
 1549  + DTOX=0                EPSROX=3.9            XW=XW                 
 1550  + XL=XL                 WINT=-2.1607E-08      LINT=6E-09            
