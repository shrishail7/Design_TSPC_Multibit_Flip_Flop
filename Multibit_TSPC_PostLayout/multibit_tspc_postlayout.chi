 1099  .SETSOA LABEL="N1 ==> Isolation safe voltage ranges violation" E V(G,D)=(-1.1,1.1) 
 1100  .SETSOA LABEL="N2 ==> Isolation safe voltage ranges violation" E V(G,S)=(-1.1,1.1) 
 1101  .SETSOA LABEL="N3 ==> Isolation safe voltage ranges violation : Gate oxide limitation with and without channel presence" E IF (V(G,B)-VT(M1)<0) THEN V(G,B)=(-1.1,1.1) ELSE V(G,B)=(-2.2,2.2) ENDIF 
 1102  .SETSOA LABEL="N4 ==> Isolation safe voltage ranges violation" E V(D,S)=(-1.1,1.1) 
 1103  .SETSOA LABEL="N5a ==> Isolation safe voltage ranges violation : D/B diode limitation in reverse bias" E V(B,D)=(-2.2,*) 
 1104  .SETSOA LABEL="N5b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when D/B diode in forward bias" E V(B,D)=(*,0.33) 
 1105  .SETSOA LABEL="N6a ==> Isolation safe voltage ranges violation : S/B diode limitation in reverse bias" E V(B,S)=(-2.2,*) 
 1106  .SETSOA LABEL="N6b ==> Isolation safe voltage ranges violation : lateral parasitic bipolar not modelled when S/B diode in forward bias" E V(B,S)=(*,0.33) 
 1107  .SETSOA LABEL="N7 ==> Isolation safe voltage ranges violation : MOS HCI limitation on D side" E IF (V(G,S)-VT(M1)>0) && (V(D,S)>0.2) THEN V(B,D)=(-1.2,0.2) ENDIF 
 1108  .SETSOA LABEL="N8 ==> Isolation safe voltage ranges violation : MOS HCI limitation on S side" E IF (V(G,D)-VT(M1)>0) && (V(D,S)<-0.2) THEN V(B,S)=(-1.2,0.2) ENDIF 
