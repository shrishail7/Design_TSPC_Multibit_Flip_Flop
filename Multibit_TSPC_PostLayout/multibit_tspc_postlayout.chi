  699  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  700  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
  701  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
  702  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
  703  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
  704  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  705  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
  706  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
  707  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
  708  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
