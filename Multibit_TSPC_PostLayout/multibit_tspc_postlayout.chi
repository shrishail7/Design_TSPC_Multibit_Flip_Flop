  557  .PARAM  JTSSWS  = '2.0358E-10*10^NSRAMSPHVTLP_DIDIODE_CMOS065'
  558  .PARAM  JTSSWGS = '2E-10*10^NSRAMSPHVTLP_DIDIODE_CMOS065'
