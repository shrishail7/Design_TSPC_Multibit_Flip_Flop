 1864  
 1865  
 1866  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-9.7441E-09)/2)*(ABS(1/LM-(-0.088*NFING/WM+3.1087E+06))-(1/LM -(-0.088*NFING/WM+3.1087E+06)))+((-2.2734E-16*NFING/WM+1.4902E-10)/2)*(ABS(1/LM-(0.1532*NFING/WM +4.1101E+06))+(1/LM -(0.1532*NFING/WM+4.1101E+06)))+4.41E-10*NFING/WM+0.018161'
 1867  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1868  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 1869  * Stress effect on body factor K1 :
 1870  *----------------------------------
 1871  .PARAM VARMAXK1         = '0.00273+5.49E-10/LM+-7E-09*NFING/WM'
 1872  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1873  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 1874  * Stress effect on DVT0 :
 1875  *------------------------
 1876  .PARAM DVT0_STRESS        = 26.9
 1877  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 1878  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1879  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 1880  * Stress effect on access resistance :
 1881  *-------------------------------------
 1882  .PARAM VARMAXRDSW       = '0.103+-8.11E-09*NFING/WM'
 1883  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1884  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 1885  
 1886  
 1887  .PARAM NFACTOR = '(0.95946+1.6338E-07/LE+-1.6E-14/(LE*WE))*SQRT(PHIS*2.6962E+17/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 1888  
 1889  
 1890  
 1891  * Equations for VT :
 1892  *-------------------
 1893  .PARAM W0       = '4.6522E-07+(0-XW)'
 1894  .PARAM K3B      = '(3)*(2.4239E-09/TOX)'
 1895  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1896  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*2.6962E+17*1E6))'
 1897  .PARAM DVTP0    = 0
 1898  
 1899  
 1900  .PARAM N_SUBVT  = '1.0+(0.95946+1.6338E-07/LE+-1.6E-14/(LE*WE))*7.271700702E-09/XDEP0'
 1901  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.9752E-06))'
 1902  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 1903  .PARAM K3       = '(-8+1E-07/(LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT))+2E-13/((LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT))*WE))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 1904  
 1905  
 1906  
 1907  * Equation for moin :
 1908  *-------------------
 1909  .PARAM MOIN = 'VALIF((10*((0.21)/K1EFF)^2 > 5), (10*((0.21)/K1EFF)^2), (5))'
 1910  
 1911  
 1912  * Equations for LKETA :
 1913  *---------------------
 1914  
 1915  
 1916  .PARAM LKETA    = 0.002 
 1917  
 1918  
 1919  *Worst case methodology improvement: Short Channel effect
 1920  *--------------------------------------------------------
 1921  .PARAM LPE0  = '((((0.21)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1E-12+3.1E-15/LE)/(LMIN+8E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1922  .PARAM LPEB  = '(1.0013E-07+1.8804E-14/LE)/(LMIN+8E-09-2*LINT)*(LMIN+XL-2*LINT)'
 1923  .PARAM DVT1  = '1.3*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1924  .PARAM DVT1W = '3E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1925  .PARAM DSUB = '(0.019282)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1926  
 1927  
 1928  
 1929  * Equations for Extrinsic Capacitances:
 1930  * ------------------------------------
 1931  
 1932  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 1933  
 1934  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 1935  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 1936  
 1937  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 1938  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 1939  
 1940  
 1941  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 1942  
 1943  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 1944  
 1945  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
 1946  
 1947  .PARAM CGSL = '((1.1515E-10) + 5.4268E-18/LM  + -2.906E-25/LM^2 + -4E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 1948  .PARAM CGDL = '((1.1515E-10) + 5.4268E-18/LM  + -2.906E-25/LM^2 + -4E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 1949  .PARAM CGSO       =  'VALIF((POCOSM>0),(5E-12*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),5E-12*(2.4239E-09/TOX))'
 1950  .PARAM CGDO       =  'VALIF((POCOSM>0),(5E-12*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),5E-12*(2.4239E-09/TOX))'
 1951  
 1952  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1953  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1954  
 1955  
 1956  
 1957  * Equations for extrinsic S/D resistances:
 1958  * ---------------------------------------
 1959  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 1960   
 1961  * Unsilicided poly gate resistance:
 1962  * --------------------------------
 1963  .PARAM RSHGUMMID = '(605+RSHGUM)/2 + (605-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
 1964  .PARAM RSHGUMEFF = 'RSHGUMMID*605*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*605)'
 1965  
 1966  
 1967  * Salicided poly gate resistance:
 1968  * ------------------------------
 1969  
 1970   .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==0),(1-ALIGNMENT_PRELAYOUT),(0))'
 1971  .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__1__YES = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==1),(1-ALIGNMENT_PRELAYOUT),(0))'
 1972  .PARAM RGATEMOD = GFLAG__RGATESWITCH__ALL__CMOS065__1__YES 
 1973  .PARAM RGATE    = '(((RSHG*(WM/NFING+XW))/(3*NGCON**2*(LM+XL+9E-09)))+((17.5E-12+RSHGUMEFF*1E-07*(1E-07-2.5E-08))/((WM/NFING+XW)*(LM+XL))))/NFING'
 1974  .PARAM RSHG0    = 'RGATE*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
 1975  
 1976  * Salicided Source/Drain diffusion access resistances:
 1977  * ---------------------------------------------------
 1978  .PARAM NRSEFF    = 'NRS'
 1979  .PARAM NRDEFF    = 'NRD'
 1980  
 1981  
 1982  
 1983  * Equations for VOFF:
 1984  * ------------------
 1985  
 1986  .PARAM VOFF = '-0.12932 + -0.078441*(TEMPK/(25+273.15) -1)' 
 1987  
 1988  
 1989  
 1990  * Equations for temperature dependance of BGIDL:
 1991  * --------------------------------------------
 1992  .PARAM BGIDL = '7.8647E+09 + -1.9559E+09*(TEMPK/(25+273.15) -1)'
 1993  
 1994  
 1995  * Equations for temperature dependence of series resistances:
 1996  * -----------------------------------------------------------
 1997  .PARAM RDWMIN = 0
 1998  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 1999  .PARAM RSWMIN = 0
 2000  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 2001  .PARAM RDSWMIN = 0
 2002  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 0*(TEMPK/(25+273.15) -1)), (0))'
 2003  .PARAM RSW = 0
 2004  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 0*(TEMPK/(25+273.15) -1)), (0))'
 2005  .PARAM RDW = 0
 2006  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 0*(TEMPK/(25+273.15) -1)), (0))'
 2007  .PARAM RDSWEFF2 = '(RDSWEFF + 0*(TEMPK/(25+273.15) -1))'
 2008  .PARAM PRT = 0
 2009  
 2010  
 2011  * Equations for thermal noise scaling
 2012  * ------------------------------------
 2013  .PARAM NTNOI = '1*LE/LEC'
 2014  
 2015  
 2016  
 2017  * Equations for Flicker Noise Local Variations
 2018  * --------------------------------------------
 2019  
 2020  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
 2021  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
 2022  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
 2023  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
 2024  .PARAM NOIA    = '((TANH((LE-5E-07)*8E+05))*(4.115E+42)/2+2.0385E+42)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 2025  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 2026  .PARAM NOIC    = '(3E+09)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 2027  
