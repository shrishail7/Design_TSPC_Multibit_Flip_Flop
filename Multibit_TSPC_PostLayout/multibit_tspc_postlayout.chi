 1555  * Channel doping nch and body factor k1 worst case :
 1556  *---------------------------------------------------
 1557  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1558  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1559  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.3981E+18/NI)+0.25043+0.4'
 1560  .PARAM  K2        =  '(-0.004+-5.7755E-09/LE)*(TOX/2.3926E-09)'
 1561  .PARAM  K1        =  '(0.47182)-MOSTYPE*(0.67476-VTH)/SQRT(PHIS_TYP)'
 1562  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1563  .PARAM  NCH       =  '1.3981E+18*(K1*K1)/((0.47182)*(0.47182))'
 1564  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
 1565  * Series resistance worst case :
 1566  *-------------------------------
