 1777  .PARAM DVTH_AVT        = '3.3E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
 1778  .PARAM DBETA_ABETA     = '0.45E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
