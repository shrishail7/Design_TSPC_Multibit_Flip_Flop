 1161  *Worst case methodology improvement: Short Channel effect
 1162  *--------------------------------------------------------
 1163  .PARAM LPE0  = '((((0.47182)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4.37035E-09)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1164  .PARAM LPEB  = '(7.90859E-09)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
 1165  .PARAM DVT1  = '0.022524*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1166  .PARAM DVT1W = '4.2642E+07*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
