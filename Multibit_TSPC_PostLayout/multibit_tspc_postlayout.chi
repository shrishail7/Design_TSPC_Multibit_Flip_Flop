 1512  * Model improvement equations :
 1513  *------------------------------
 1514  
 1515  * Equations for mismatch deviations:
 1516  *-----------------------------------
 1517  .PARAM DVTH0_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(5.0E-9),(5.9E-9))
 1518  .PARAM DVTH0_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
 1519  .PARAM DVTH0_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
 1520  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
 1521  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMSPHVTLP_DEV*MISMATCH}
 1522  .PARAM DBETA_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.87E-8),(0.72E-8))
 1523  .PARAM DBETA_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
 1524  .PARAM DBETA_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
 1525  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
 1526  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMSPHVTLP_DEV*MISMATCH}
