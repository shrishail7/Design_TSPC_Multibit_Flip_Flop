 4776  .PARAM WPEMOD   = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1),(1))'
 4777  .PARAM KVTH0WE  = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((-0.01231+5.008E-10/LE+8.4E-09/WE+-4.28E-16/(LE*WE))),((-7.404359E-3+1.827268E-10/LE+9.28666E-11/WE)))'
 4778  .PARAM K2WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0+0.0/LE+0.0/WE+0.0/(LE*WE))),((2.958218E-3+-1.77185E-11/LE+-1.628225E-10/WE)))'
 4779  .PARAM SCREF    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1E-06),(1E-06))'
 4780  .PARAM KU0WE    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0.0006944+2.142E-11/LE+-4.813E-10/WE+9.529E-18/(LE*WE))),((5.267004E-3+-1.502153E-10/LE+-2.96138E-09/WE)))'
 4781  .PARAM WEB      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
 4782  .PARAM WEC2      =  'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
