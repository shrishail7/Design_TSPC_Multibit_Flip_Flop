 2504  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 2505  .PARAM K3       = '(-14.268+1E-07/(LE*(LMIN+0-2*LINT)/(LMIN+XL-2*LINT)))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 2506  
 2507  
