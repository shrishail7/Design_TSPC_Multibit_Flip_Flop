  242  
  243  * Equation for moin :
  244  *-------------------
  245  .PARAM MOIN = 'VALIF((5.8569*((0.35383)/K1EFF)^2 > 5), (5.8569*((0.35383)/K1EFF)^2), (5))'
  246  
  247  
  248  * Equations for LKETA :
  249  *---------------------
  250  
  251  
  252  .PARAM LKETA    = '0.0087889 + 0.06*(TEMPK/(25+273.15) -1)'
  253  
  254  
  255  *Worst case methodology improvement: Short Channel effect
  256  *--------------------------------------------------------
  257  .PARAM LPE0  = '((((0.35383)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(2.27309E-08+4.54618E-15/LE)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  258  .PARAM LPEB  = '(0)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
  259  .PARAM DVT1  = '0.032462*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  260  .PARAM DVT1W = '1.1929E+06*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  261  .PARAM DSUB = '(0.8682)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  262  
  263  
  264  
  265  * Equations for Extrinsic Capacitances:
  266  * ------------------------------------
  267  
  268  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  269  
  270  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  271  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  272  
  273  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  274  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  275  
  276  
  277  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  278  
  279  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  280  
  281  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
  282  
  283  .PARAM CGSL = '(7.3597E-11)*(2.3926E-09/TOX)'
  284  .PARAM CGDL = '(7.3597E-11)*(2.3926E-09/TOX)'
  285  .PARAM CGSO       =  '1E-10*(2.3926E-09/TOX)'
  286  .PARAM CGDO       =  '1E-10*(2.3926E-09/TOX)'
  287  
  288  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  289  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  290  
  291  
  292  
  293  * Equations for extrinsic S/D resistances:
  294  * ---------------------------------------
  295  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*70*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(0*CONPO*NFING/WM)'
  296  
  297  
