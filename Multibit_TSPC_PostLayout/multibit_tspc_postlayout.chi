 2445  
 2446  * Equations for mobility :
 2447  *-------------------------
 2448  .PARAM EPSILON2 = 1E-18
 2449  .PARAM LLIMIT = '2.6322E-08-XL' 
 2450  .PARAM WLIMIT = '9.3521E-07-XW' 
 2451  .PARAM DWU = DWU0
 2452  .PARAM MOBILITY = '2.0/(0.008367963498+(LLIMIT+XL
 2453  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.005449916839/LE)
 2454  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 2455  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 2456  
 2457  
 2458  
 2459  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PSRAMSPHVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 2460  
 2461  
 2462  * Channel doping nch and body factor k1 worst case :
 2463  *---------------------------------------------------
 2464  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 2465  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 2466  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.4646E+18/NI)+0.18679+0.4'
 2467  .PARAM  K2        =  '(0+9.665E-11/LE)*(TOX/2.4239E-09)'
 2468  .PARAM  K1        =  '(0.48923)-MOSTYPE*(-0.75397-VTH)/SQRT(PHIS_TYP)'
 2469  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 2470  .PARAM  NCH       =  '1.4646E+18*(K1*K1)/((0.48923)*(0.48923))'
 2471  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18679+0.4'
 2472  * Series resistance worst case :
 2473  *-------------------------------
 2474  .PARAM RDSW      =  '(804.55)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PSRAMSPHVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 2475  .PARAM PRWB      =  0.33755
