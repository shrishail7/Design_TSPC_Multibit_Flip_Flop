  258  .PARAM LPE0  = '((((0.47182)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(2.359E-09)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  259  .PARAM LPEB  = '(4.26886E-09)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
  260  .PARAM DVT1  = '0.022524*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
