  136  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  137  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  138  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
  139  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
  140  .PARAM POCOSM	= 'POCOS*TOMETER'
  141  .PARAM POCODM	= 'POCOD*TOMETER'
  142  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
  143  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-6*1E-6/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
  144  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
  145  + 1E-6/10.0*SCM*EXP(-10.0*SCM/1E-6)
  146  + +1E-6*1E-6/100.0*EXP(-10.0*SCM/1E-6)
  147  + -1E-6/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-6)
  148  + -1E-6*1E-6/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-6)),0))'
  149  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
  150  + 1E-6/20.0*SCM*EXP(-20.0*SCM/1E-6)
  151  + +1E-6*1E-6/400.0*EXP(-20.0*SCM/1E-6)
  152  + -1E-6/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-6)
  153  + -1E-6*1E-6/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-6)),0))'
  154  
  155  * DC Effective length and width:
  156  *---------------------------
  157  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  158  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  159  * AC Effective length and width:
  160  *------------------------------
  161  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  162  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  163  *  Effective Source/Drain Junction width:
  164  *---------------------------------------
  165  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  166  
  167  
  168  * Model improvement equations :
  169  *------------------------------
  170  
  171  * Equations for mismatch deviations:
  172  *-----------------------------------
  173  .PARAM DVTH0_ALPHA = (3.8E-9)
  174  .PARAM DVTH0_BETA  = (0.0)
  175  .PARAM DVTH0_FUDGE  = (1)
  176  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
  177  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*LVTGP_DEV*MISMATCH}
  178  .PARAM DBETA_ALPHA = (1.01E-8)
  179  .PARAM DBETA_BETA  = (0.0)
  180  .PARAM DBETA_FUDGE  = (1)
  181  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
  182  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*LVTGP_DEV*MISMATCH}
  183  
  184  
  185  .PARAM PROCESSSTATFLAGS = '1.0'
  186  .PARAM DVTHTOT   = 'NLVTGP_DVTH0_CMOS065/(VALIF((NLVTGP_DVTH0_CMOS065==0),(1),(0))+SQRT((NLVTGP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NLVTGP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NLVTGP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  187  .PARAM VTH     = '0.12809+NLVTGP_DVTH0_CMOS065'
  188  
  189  
  190  * Equation for  AGIDL:
  191  * --------------------
  192  .PARAM AGIDL   = '(0.00024538)*10^DAGIDL'
  193  
  194  
  195  * Equations for mobility :
  196  *-------------------------
  197  .PARAM EPSILON2 = 1E-18
  198  .PARAM LLIMIT = '6.77562E-09-XL' 
  199  .PARAM WLIMIT = '-8.12E-10-XW' 
  200  .PARAM DWU = 'DWU0+(-0.4985)*0.5E6*(ABS(LE-4.4E-07)-(LE-4.4E-07))' 
  201  .PARAM MOBILITY = '2.0/(0.004526148166+(LLIMIT+XL
  202  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.0008329086405/LE)
  203  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  204  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  205  
  206  
  207  
  208  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NLVTGP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  209  
  210  
  211  * Channel doping nch and body factor k1 worst case :
  212  *---------------------------------------------------
  213  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  214  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  215  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.7519E+17/NI)+0.20148+0.4'
  216  .PARAM  K2        =  '(0.012689)*(TOX/1.88E-09)'
  217  .PARAM  K1        =  '(0.13129)-MOSTYPE*(0.12809-VTH)/SQRT(PHIS_TYP)'
  218  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  219  .PARAM  NCH       =  '1.7519E+17*(K1*K1)/((0.13129)*(0.13129))'
  220  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.20148+0.4'
  221  * Series resistance worst case :
  222  *-------------------------------
  223  .PARAM RDSW      =  '(120.27+0.0/LE+-7.3292E-06/WE+7.4971E-13/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NLVTGP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  224  .PARAM PRWB      =  0
  225  
  226  
  227  
  228  
  229  
  230  
  231  .PARAM VSATEFF = '(4.3645E+05+0.01999/LE)'
  232  
  233  * Equations for stress :
  234  *-----------------------
  235  
  236  .PARAM C_1	= 'CONW+COEACT2+CONPO'
  237  .PARAM C_2 	= C_1
  238  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
  239  .PARAM B_2	= B_1 
  240  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  241  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  242  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  243  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  244  * Stress effect on threshold voltage :
  245  *-------------------------------------
  246  
  247  
  248  .PARAM VARMAXVTH0       = '((3.5E-16*NFING/WM+6.5294E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))-(1/LM -(-0.061381*NFING/WM +4.4092E+06)))+((7.9412E-17*NFING/WM+-2.7059E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))+(1/LM -(-0.061381*NFING/WM+4.4092E+06)))+-4.2353E-10*NFING/WM+-0.0049765'
  249  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  250  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NLVTGP_DVTH0_CMOS065+DVTHTOT'
  251  * Stress effect on mobility :
  252  *----------------------------
  253  
  254  
  255  .PARAM VARMAXU0 	= '((0*NFING/WM+-3E-09)/2)*(ABS(1/LM-(0*NFING/WM+4E+06))-(1/LM -(0*NFING/WM+4E+06)))+((-5.2941E-16*NFING/WM+3E-09)/2)*(ABS(1/LM-(0*NFING/WM +4E+06))+(1/LM -(0*NFING/WM+4E+06)))+-1.7647E-09*NFING/WM+0.046765'
  256  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  257  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
  258  * Stress effect on body factor K1 :
  259  *----------------------------------
  260  .PARAM VARMAXK1         = '0.017+0/LM+-5E-09*NFING/WM'
  261  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  262  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  263  * Stress effect on DVT0 :
  264  *------------------------
  265  .PARAM DVT0_STRESS        = -74.599
  266  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  267  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  268  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  269  * Stress effect on access resistance :
  270  *-------------------------------------
  271  .PARAM VARMAXRDSW       = '0+0*NFING/WM'
  272  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  273  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  274  
  275  
  276  .PARAM NFACTOR = '(0.0001+4.2574E-07/LE)*SQRT(PHIS*1.7519E+17/(PHIS_TYP*NCH))*(1.88E-09/TOX)'
  277  
  278  
  279  
  280  * Equations for VT :
  281  *-------------------
  282  .PARAM W0       = '1.2745E-07+(0-XW)'
  283  .PARAM K3B      = '(1.58)*(1.88E-09/TOX)'
  284  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  285  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*1.7519E+17*1E6))'
  286  .PARAM DVTP0    = 0
  287  
  288  
  289  .PARAM N_SUBVT  = '1.0+(0.0001+4.2574E-07/LE)*5.640000544E-09/XDEP0'
  290  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+9.2053E-06))'
  291  .PARAM TMP2     = '1.692E-09/(WE+W0)'
  292  .PARAM K3       = '(-10.665+2.3295E-07/(LE*(LMIN+-7E-09-2*LINT)/(LMIN+XL-2*LINT)))*(1.88E-09/TOX)+VTH_RSCE/TMP2'
  293  
  294  
  295  
  296  * Equation for moin :
  297  *-------------------
  298  .PARAM MOIN = 'VALIF((15.569*((0.13129)/K1EFF)^2 > 5), (15.569*((0.13129)/K1EFF)^2), (5))'
  299  
  300  
  301  * Equations for LKETA :
  302  *---------------------
  303  
  304  
  305  .PARAM LKETA    = 0 
  306  
  307  
  308  *Worst case methodology improvement: Short Channel effect
  309  *--------------------------------------------------------
  310  .PARAM LPE0  = '((((0.13129)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.048E-09+1.1573E-15/LE)/(LMIN+-7E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  311  .PARAM LPEB  = '(0)/(LMIN+-7E-09-2*LINT)*(LMIN+XL-2*LINT)'
  312  .PARAM DVT1  = '1.6049*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  313  .PARAM DVT1W = '8.5483E-05*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  314  .PARAM DSUB = '(0.10772)*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  315  
  316  
  317  
  318  * Equations for Extrinsic Capacitances:
  319  * ------------------------------------
  320  
  321  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
  322  
  323  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
  324  .PARAM C3EXT = '(9.681E-18 + 7.403E-11*(LM + XL))'
  325  
  326  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.237E-17 + 2.400E-18*TANH((LM + XL)/1.258E-07)),(1.474E-17 + 3.229E-18*TANH((LM + XL)/1.497E-07)))'
  327  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.458E-17 + 9.132E-19*TANH((WM/NFING + XW)/1.568E-06) + 1.875E-17*TANH((LM + XL)/5.032E-07)),(1.240E-17 + -2.833E-17*TANH((WM/NFING + XW)/1.635E-06) + 1.043E-17*TANH((LM + XL)/2.752E-07)))' 
  328  
  329  
  330  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-4.315E-19*(1-ALIGNMENT_PRELAYOUT) + 8.264E-11*(WM/NFING + XW) + 4.014E-11*(WM/NFING + XW)*TANH((LM + XL)/3.174E-07)) ,(4.263E-19*(1-ALIGNMENT_PRELAYOUT) + 2.618E-11*(WM/NFING + XW) + 1.895E-11*(WM/NFING + XW)*TANH((LM + XL)/2.508E-07)))'
  331  
  332  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  333  
  334  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
  335  
  336  .PARAM CGSL = '((3.4996E-11) + 6.7565E-18/LM  + -3.0488E-25/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(1.88E-09/TOX)' 
  337  .PARAM CGDL = '((3.4996E-11) + 6.7565E-18/LM  + -3.0488E-25/LM^2 + 0/WM*NFING + 0/WM^2*NFING^2)*(1.88E-09/TOX)' 
  338  .PARAM CGSO       =  'VALIF((POCOSM>0),(4.1151E-11*(1.88E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.8098E-07)*(TANH(POCOSM/9.9978E-08)-1))*1.7299E-10/WEC),4.1151E-11*(1.88E-09/TOX))'
  339  .PARAM CGDO       =  'VALIF((POCOSM>0),(4.1151E-11*(1.88E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.8098E-07)*(TANH(POCODM/9.9978E-08)-1))*1.7299E-10/WEC),4.1151E-11*(1.88E-09/TOX))'
  340  
  341  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  342  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  343  
  344  
  345  
  346  * Equations for extrinsic S/D resistances:
  347  * ---------------------------------------
  348  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
  349   
  350  * Unsilicided poly gate resistance:
  351  * --------------------------------
  352  .PARAM RSHGUMMID = '(620+RSHGUM)/2 + (620-RSHGUM)*TANH(1E18*(2*2.2E-8-LM-XL))/2'
  353  .PARAM RSHGUMEFF = 'RSHGUMMID*620*(LM+XL)/(2*2.2E-8*RSHGUMMID + (LM+XL-2*2.2E-8)*620)'
  354  
  355  
  356  * Salicided poly gate resistance:
  357  * ------------------------------
  358  
  359   .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==0),(1-ALIGNMENT_PRELAYOUT),(0))'
  360  .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__1__YES = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==1),(1-ALIGNMENT_PRELAYOUT),(0))'
  361  .PARAM RGATEMOD = GFLAG__RGATESWITCH__ALL__CMOS065__1__YES 
  362  .PARAM RGATE    = '(((RSHG*(WM/NFING+XW))/(3*NGCON**2*(LM+XL+9E-09)))+((4.13E-12+RSHGUMEFF*1E-07*(1E-07-2.5E-08))/((WM/NFING+XW)*(LM+XL))))/NFING'
  363  .PARAM RSHG0    = 'RGATE*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
  364  
  365  * Salicided Source/Drain diffusion access resistances:
  366  * ---------------------------------------------------
  367  .PARAM NRSEFF    = 'NRS'
  368  .PARAM NRDEFF    = 'NRD'
  369  
  370  
  371  
  372  * Equations for VOFF:
  373  * ------------------
  374  
  375  .PARAM VOFF = '-0.14523 + -0.08657*(TEMPK/(25+273.15) -1)' 
  376  
  377  
  378  
  379  * Equations for temperature dependance of BGIDL:
  380  * --------------------------------------------
  381  .PARAM BGIDL = '6.9956E+10 + -1.8531E+09*(TEMPK/(25+273.15) -1)'
  382  
  383  
  384  * Equations for temperature dependence of series resistances:
  385  * -----------------------------------------------------------
  386  .PARAM RDWMIN = 0
  387  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 11.849*(TEMPK/(25+273.15) -1)), (0))'
  388  .PARAM RSWMIN = 0
  389  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 11.849*(TEMPK/(25+273.15) -1)), (0))'
  390  .PARAM RDSWMIN = 0
  391  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 11.849*(TEMPK/(25+273.15) -1)), (0))'
  392  .PARAM RSW = 0
  393  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 11.849*(TEMPK/(25+273.15) -1)), (0))'
  394  .PARAM RDW = 0
  395  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 11.849*(TEMPK/(25+273.15) -1)), (0))'
  396  .PARAM RDSWEFF2 = '(RDSWEFF + 11.849*(TEMPK/(25+273.15) -1))'
  397  .PARAM PRT = 0
  398  
  399  
  400  * Equations for thermal noise scaling
  401  * ------------------------------------
  402  .PARAM NTNOI = '1*LE/LEC'
  403  
  404  
  405  
  406  
  407  
  408   
  409  .PARAM WPEMOD   = 1
  410  .PARAM KVTH0WE  = (5.61788E-3+-2.104897E-10/LE+-4.895972E-10/WE)
  411  .PARAM K2WE     = (1.249436E-3+1.369675E-11/LE+4.517234E-10/WE)
  412  .PARAM SCREF    = 1E-6
  413  .PARAM KU0WE    = (-2.097275E-3+-2.043484E-10/LE+-1.005728E-12/WE)
  414  .PARAM WEB      = -350
  415  .PARAM WEC2      = -3E3
  416  
  417  
  418  M1 D G S B NLVTGP W='WM/NFING' L=LM AS='ASM/NFING' AD='ADM/NFING' PS='PSM/NFING' PD='PDM/NFING'
  419  +          M='MULT*NFING' NRD='NRDEFF*NFING' NRS='NRSEFF*NFING' NF=1 SCA='SCAM' SCB='SCBM' SCC='SCCM' 
  420  
  421  
  422  .MODEL NLVTGP NMOS
  423  + LEVEL=60
  424  + VERSION=4.5           BINUNIT=1             PARAMCHK=0            
  425  + TNOM=25               TOXE=TOX              TOXP=TOX              
  426  + TOXM=TOX              DTOX=0                EPSROX=3.9            
  427  + XW=XW                 XL=XL                 WINT=-1.2874E-08      
  428  + LINT=3.0191E-10       DLC=1.1853E-08        DWC=-1.2987E-08       
  429  + DWJ=-1.2837E-08       DWG=2.4258E-09        DWB=3.5632E-09        
  430  + DMCG=0                DMCI=0                DMDG=0                
  431  + DMCGT=0               WL=0                  WLN=1                 
  432  + WW=0                  WWN=1                 WWL=0                 
  433  + LL=0                  LLN=1                 LW=0                  
  434  + LWN=1                 LWL=0                 LLC=0                 
  435  + LWC=0                 LWLC=0                WLC=0                 
  436  + WWC=0                 WWLC=0                LMIN='6E-8'           
  437  + LMAX=1.8E-07          WMIN='1.2E-7'         WMAX=0.001            
