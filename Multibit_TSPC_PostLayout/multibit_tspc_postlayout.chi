 1903  
 1904  .PARAM PROCESSSTATFLAGS = '1.0'
 1905  .PARAM DVTHTOT   = 'PHVTLP_DVTH0_CMOS065/(VALIF((PHVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((PHVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PHVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1906  .PARAM VTH     = '-0.60574+PHVTLP_DVTH0_CMOS065'
 1907  
 1908  
 1909  * Equation for  AGIDL:
 1910  * --------------------
 1911  .PARAM AGIDL   = '(1.0856E-05)*10^DAGIDL'
 1912  
 1913  
 1914  * Equations for mobility :
 1915  *-------------------------
 1916  .PARAM EPSILON2 = 1E-18
 1917  .PARAM LLIMIT = '1.405E-08-XL' 
 1918  .PARAM WLIMIT = '9.4521E-07-XW' 
 1919  .PARAM DWU = DWU0
 1920  .PARAM MOBILITY = '2.0/(0.01213666762+(LLIMIT+XL
 1921  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.0002503012854/LE)
 1922  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1923  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1924  
 1925  
 1926  
 1927  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PHVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1928  
 1929  
 1930  * Channel doping nch and body factor k1 worst case :
 1931  *---------------------------------------------------
 1932  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1933  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1934  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.4646E+18/NI)+0.18679+0.4'
 1935  .PARAM  K2        =  '(0+-2E-09/LE)*(TOX/2.4239E-09)'
 1936  .PARAM  K1        =  '(0.48923)-MOSTYPE*(-0.60574-VTH)/SQRT(PHIS_TYP)'
 1937  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1938  .PARAM  NCH       =  '1.4646E+18*(K1*K1)/((0.48923)*(0.48923))'
 1939  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18679+0.4'
 1940  * Series resistance worst case :
 1941  *-------------------------------
 1942  .PARAM RDSW      =  '(302.21+0.0/LE+0.0/WE+0.0/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PHVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1943  .PARAM PRWB      =  -0.33755
 1944  
 1945  
 1946  
 1947  
 1948  
 1949  
 1950  .PARAM VSATEFF = '(84178+0.0066521/LE+-0.0102/WE)'
 1951  
 1952  * Equations for stress :
 1953  *-----------------------
 1954  
 1955  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
 1956  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
 1957  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
 1958  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
 1959  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
 1960  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 1961  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 1962  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 1963  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 1964  * Stress effect on threshold voltage :
 1965  *-------------------------------------
 1966  
 1967  
 1968  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1E+12))+(1/LM -(0*NFING/WM+1E+12)))+9.0095E-10*NFING/WM+-3.5838E-05'
 1969  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1970  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PHVTLP_DVTH0_CMOS065+DVTHTOT'
 1971  * Stress effect on mobility :
 1972  *----------------------------
 1973  
 1974  
 1975  .PARAM VARMAXU0 	= '((-1.4E-15*NFING/WM+-9.1441E-09)/2)*(ABS(1/LM-(-0.088*NFING/WM+3.1087E+06))-(1/LM -(-0.088*NFING/WM+3.1087E+06)))+((-4.5926E-16*NFING/WM+9.1028E-10)/2)*(ABS(1/LM-(0.1532*NFING/WM +4.1101E+06))+(1/LM -(0.1532*NFING/WM+4.1101E+06)))+4.41E-10*NFING/WM+0.018161'
 1976  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1977  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 1978  * Stress effect on body factor K1 :
 1979  *----------------------------------
 1980  .PARAM VARMAXK1         = '0.00273+5.49E-10/LM+-7E-09*NFING/WM'
 1981  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1982  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 1983  * Stress effect on DVT0 :
 1984  *------------------------
 1985  .PARAM DVT0_STRESS        = -0.69318
 1986  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 1987  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1988  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 1989  * Stress effect on access resistance :
 1990  *-------------------------------------
 1991  .PARAM VARMAXRDSW       = '0.103+-8.11E-09*NFING/WM'
 1992  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1993  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 1994  
 1995  
 1996  .PARAM NFACTOR = '(1.0985)*SQRT(PHIS*1.4646E+18/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 1997  
 1998  
 1999  
 2000  * Equations for VT :
 2001  *-------------------
 2002  .PARAM W0       = '3.0052E-07+(0-XW)'
 2003  .PARAM K3B      = '(12.574)*(2.4239E-09/TOX)'
 2004  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 2005  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*1.4646E+18*1E6))'
 2006  .PARAM DVTP0    = 0
 2007  
 2008  
 2009  .PARAM N_SUBVT  = '1.0+(1.0985)*7.271700702E-09/XDEP0'
 2010  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.4687E-07))'
 2011  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 2012  .PARAM K3       = '(-14.268+1E-07/(LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 2013  
 2014  
 2015  
 2016  * Equation for moin :
 2017  *-------------------
 2018  .PARAM MOIN = 'VALIF((9.0239*((0.48923)/K1EFF)^2 > 5), (9.0239*((0.48923)/K1EFF)^2), (5))'
 2019  
 2020  
 2021  * Equations for LKETA :
 2022  *---------------------
 2023  
 2024  .PARAM LKETAEXP = 'VALIF(((9.99000999E+11/LE-1.7737314E+19) > 34), (34), (9.99000999E+11/LE-1.7737314E+19))'
 2025  
 2026  .PARAM LKETA    = '-0.01/(1.0+EXP(LKETAEXP))'
 2027  
 2028  
 2029  *Worst case methodology improvement: Short Channel effect
 2030  *--------------------------------------------------------
 2031  .PARAM LPE0  = '((((0.48923)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.6518E-08)/(LMIN+8E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 2032  .PARAM LPEB  = '(-1.5427E-09)/(LMIN+8E-09-2*LINT)*(LMIN+XL-2*LINT)'
 2033  .PARAM DVT1  = '0.077454*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 2034  .PARAM DVT1W = '1.6265E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2035  .PARAM DSUB = '(0.56293)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 2036  
 2037  
 2038  
 2039  * Equations for Extrinsic Capacitances:
 2040  * ------------------------------------
 2041  
 2042  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 2043  
 2044  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 2045  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 2046  
 2047  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 2048  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 2049  
 2050  
 2051  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 2052  
 2053  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 2054  
 2055  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
 2056  
 2057  .PARAM CGSL = '((1.264E-10) + -4.642E-18/LM  + 1.563E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 2058  .PARAM CGDL = '((1.264E-10) + -4.642E-18/LM  + 1.563E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 2059  .PARAM CGSO       =  'VALIF((POCOSM>0),(5E-12*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),5E-12*(2.4239E-09/TOX))'
 2060  .PARAM CGDO       =  'VALIF((POCOSM>0),(5E-12*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),5E-12*(2.4239E-09/TOX))'
 2061  
 2062  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2063  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 2064  
 2065  
 2066  
 2067  * Equations for extrinsic S/D resistances:
 2068  * ---------------------------------------
 2069  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 2070   
 2071  * Unsilicided poly gate resistance:
 2072  * --------------------------------
 2073  .PARAM RSHGUMMID = '(605+RSHGUM)/2 + (605-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
 2074  .PARAM RSHGUMEFF = 'RSHGUMMID*605*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*605)'
 2075  
 2076  
 2077  .PARAM RGATEMOD = 1
 2078  .PARAM XGWS    = 'CONRPO-COEPO'
 2079  .PARAM XGWU    = 'RPOEXTPOFLD'
 2080  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
 2081  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
 2082  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
 2083  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
 2084  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
 2085  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 2086  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
 2087  
 2088  * Unsilicided Source/Drain diffusion access resistances:
 2089  * -----------------------------------------------------
 2090  .PARAM NRSEFF    = 'NRS + (RSD_RPO*ESUM/(RSH*WE)/NFING)'
 2091  .PARAM NRDEFF    = 'NRD + (RSD_RPO*EDUM/(RSH*WE)/NFING)'
 2092  
 2093  
 2094  
 2095  * Equations for VOFF:
 2096  * ------------------
 2097  
 2098  .PARAM VOFF = '-0.13249 + -0.10229*(TEMPK/(25+273.15) -1)' 
 2099  
 2100  
 2101  
 2102  * Equations for temperature dependance of BGIDL:
 2103  * --------------------------------------------
 2104  .PARAM BGIDL = '7.1549E+09 + -1.2525E+09*(TEMPK/(25+273.15) -1)'
 2105  
 2106  
 2107  * Equations for temperature dependence of series resistances:
 2108  * -----------------------------------------------------------
 2109  .PARAM RDWMIN = 0
 2110  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 2111  .PARAM RSWMIN = 0
 2112  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 2113  .PARAM RDSWMIN = 0
 2114  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 2115  .PARAM RSW = 0
 2116  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 2117  .PARAM RDW = 0
 2118  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 2119  .PARAM RDSWEFF2 = '(RDSWEFF + 163.72*(TEMPK/(25+273.15) -1))'
 2120  .PARAM PRT = 0
 2121  
 2122  
 2123  * Equations for thermal noise scaling
 2124  * ------------------------------------
 2125  .PARAM NTNOI = '1*LE/LEC'
 2126  
 2127  
 2128  
 2129  * Equations for Flicker Noise Local Variations
 2130  * --------------------------------------------
 2131  
 2132  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
 2133  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
 2134  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
 2135  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(1.200E-01*1.200E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
 2136  .PARAM NOIA    = '((TANH((LE-3E-07)*2E+06))*(1.70E+42)/2+1.45E+42)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.200E-01*1.200E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 2137  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.200E-01*1.200E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 2138  .PARAM NOIC    = '(5E+09)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.200E-01*1.200E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 2139  
 2140  
 2141  
 2142  
 2143  * Selection of the WPE model parameter values depending on the netlist extraction:
 2144  * -------------------------------------------------------------------------------
 2145  .PARAM WPEMOD   = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1),(1))'
 2146  .PARAM KVTH0WE  = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((-0.002802+2.076E-11/LE+6.307E-10/WE+-1.52E-17/(LE*WE))),((-3.30111E-3+3.093636E-11/LE+1.009387E-09/WE)))'
 2147  .PARAM K2WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0+0.0/LE+0.0/WE+0.0/(LE*WE))),((1.925584E-3+-1.483648E-10/LE+-1.62823E-10/WE)))'
 2148  .PARAM SCREF    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1E-06),(1E-06))'
 2149  .PARAM KU0WE    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((-0.0005534+-1.13E-10/LE+-1.159E-09/WE+8.669E-17/(LE*WE))),((-2.0E-3+-4E-09/WE)))'
 2150  .PARAM WEB      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
 2151  .PARAM WEC2      =  'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
 2152  
 2153  
 2154  M1 D G S B PHVTLP W='WM/NFING' L=LM AS='ASM/NFING' AD='ADM/NFING' PS='PSM/NFING' PD='PDM/NFING'
 2155  +          M='MULT*NFING' NRD='NRDEFF*NFING' NRS='NRSEFF*NFING' NF=1 SCA='SCAM' SCB='SCBM' SCC='SCCM' 
 2156  
 2157  
 2158  .MODEL PHVTLP PMOS
 2159  + LEVEL=60
 2160  + VERSION=4.5           BINUNIT=1             PARAMCHK=0            
 2161  + TNOM=25               TOXE=TOX              TOXP=TOX              
 2162  + TOXM=TOX              DTOX=0                EPSROX=3.9            
 2163  + XW=XW                 XL=XL                 WINT=-2.7395E-08      
 2164  + LINT=1.5E-09          DLC=8.16E-09          DWC=-1E-08            
 2165  + DWJ=-1.1E-08          DWG=-1.1572E-08       DWB=-1.8177E-08       
 2166  + DMCG=0                DMCI=0                DMDG=0                
 2167  + DMCGT=0               WL=0                  WLN=1                 
 2168  + WW=0                  WWN=1                 WWL=0                 
 2169  + LL=0                  LLN=1                 LW=0                  
 2170  + LWN=1                 LWL=0                 LLC=2.451E-16         
 2171  + LWC=0                 LWLC=0                WLC=0                 
 2172  + WWC=0                 WWLC=0                LMIN='6E-8'           
 2173  + LMAX=1E-05            WMIN='1.2E-7'         WMAX=0.001            
 2174  + XJ=2E-08              NGATE=2.5806E+20      LNGATE=-7.7145E+18    
 2175  + NSD=1E+20             NDEP=NCH              VTH0=VTH0EFF          
 2176  + K1=K1EFF              K2=K2                 LK2=0                 
 2177  + PHIN=0.18679          K3=K3                 LK3=0                 
 2178  + K3B=K3B               W0=W0                 LPE0=LPE0             
 2179  + LPEB=LPEB             DVT0=DVT0EFF          DVT1=DVT1             
 2180  + DVT2=-0.16694         DVTP0=DVTP0           DVTP1=0               
 2181  + DVT0W=0               DVT1W=DVT1W           DVT2W=0.25            
 2182  + ETA0=6.242E-05        LETA0=0.015369        WETA0=-0.019          
 2183  + ETAB=-0.07            DSUB=DSUB             VOFF=VOFF             
 2184  + VOFFL=-2.7497E-09     MINV=-0.44967         LMINV=0.0064641       
 2185  + NFACTOR=NFACTOR       CIT=0                 CDSC=0.00033666       
 2186  + CDSCB=0.00013009      CDSCD=8.9077E-06      MOBMOD=2              
