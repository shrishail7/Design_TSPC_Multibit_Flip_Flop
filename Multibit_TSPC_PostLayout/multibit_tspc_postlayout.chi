 2278  
 2279  
 2280  
 2281  *------------------------------------------------------------------------------
 2282  * flag used to switch on/off device access modeling (for post layout simulation)
 2283  *------------------------------------------------------------------------------
 2284  *   lpe     Body      Access_R  Access_C   Extraction_mode
 2285  *    0       yes        yes       yes           --
 2286  *    1       yes        yes       no             C
 2287  *    2       yes        no        yes            R
 2288  *    3       yes        no        no             RC
 2289  *
 2290  .PARAM LPER = 'VALIF(((LPE==2) || (LPE==3)),(1),(0))'
 2291  .PARAM LPEC = 'VALIF(((LPE==1) || (LPE==3) || (LPE==97)),(1),(0))'
 2292  .PARAM ALIGNMENT_PRELAYOUT  = 'VALIF(((LPE==99) || (LPE==98)),(1),(0))'
 2293  .PARAM ALIGNMENT_POSTLAYOUT = 'VALIF((LPE==98),(1),(0))'
 2294  .PARAM LPEC2 = 'VALIF(((LPE==1) || (LPE==3)),(1),(0))'
 2295  
