 1306  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1307  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(2.451E-16/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
 1308  *  Effective Source/Drain Junction width:
 1309  *---------------------------------------
 1310  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 1311  
 1312  
 1313  * Model improvement equations :
 1314  *------------------------------
 1315  
 1316  * Equations for mismatch deviations:
 1317  *-----------------------------------
 1318  .PARAM DVTH0_ALPHA = (3.5E-9)
 1319  .PARAM DVTH0_BETA  = (0.0)
 1320  .PARAM DVTH0_FUDGE  = (1)
 1321  .PARAM DVTH0_ALPHA_C2 = (3.5E-9)
 1322  .PARAM DVTH0_BETA_C2  = (0.0)
 1323  .PARAM DVTH0_FUDGE_C2 = (1)
 1324  .PARAM DVTH0_SIG = {(((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DVTH0_ALPHA_C2/SQRT(WM*LM))+DVTH0_BETA_C2)*DVTH0_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
 1325  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*HVTLP_DEV*MISMATCH}
 1326  .PARAM DBETA_ALPHA = (0.70E-8)
 1327  .PARAM DBETA_BETA  = (0.0)
 1328  .PARAM DBETA_FUDGE  = (1)
 1329  .PARAM DBETA_ALPHA_C2 = (0.70E-8)
 1330  .PARAM DBETA_BETA_C2  = (0.0)
 1331  .PARAM DBETA_FUDGE_C2 = (1)
 1332  .PARAM DBETA_SIG = {(((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DBETA_ALPHA_C2/SQRT(WM*LM))+DBETA_BETA_C2)*DBETA_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
 1333  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*HVTLP_DEV*MISMATCH}
 1334  
 1335  
 1336  .PARAM PROCESSSTATFLAGS = '1.0'
 1337  .PARAM DVTHTOT   = 'PHVTLP_DVTH0_CMOS065/(VALIF((PHVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((PHVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PHVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1338  .PARAM VTH     = '-0.60574+PHVTLP_DVTH0_CMOS065'
 1339  
 1340  
 1341  * Equation for  AGIDL:
 1342  * --------------------
 1343  .PARAM AGIDL   = '(1.0856E-05)*10^DAGIDL'
 1344  
 1345  
 1346  * Equations for mobility :
 1347  *-------------------------
 1348  .PARAM EPSILON2 = 1E-18
 1349  .PARAM LLIMIT = '1.405E-08-XL' 
 1350  .PARAM WLIMIT = '9.4521E-07-XW' 
 1351  .PARAM DWU = DWU0
 1352  .PARAM MOBILITY = '2.0/(0.01213666762+(LLIMIT+XL
 1353  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.0002503012854/LE)
 1354  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1355  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1356  
 1357  
 1358  
 1359  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PHVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1360  
 1361  
 1362  * Channel doping nch and body factor k1 worst case :
 1363  *---------------------------------------------------
 1364  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1365  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1366  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.4646E+18/NI)+0.18679+0.4'
 1367  .PARAM  K2        =  '(0+-2E-09/LE)*(TOX/2.4239E-09)'
 1368  .PARAM  K1        =  '(0.48923)-MOSTYPE*(-0.60574-VTH)/SQRT(PHIS_TYP)'
 1369  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1370  .PARAM  NCH       =  '1.4646E+18*(K1*K1)/((0.48923)*(0.48923))'
 1371  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18679+0.4'
 1372  * Series resistance worst case :
 1373  *-------------------------------
 1374  .PARAM RDSW      =  '(302.21+0.0/LE+0.0/WE+0.0/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PHVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1375  .PARAM PRWB      =  -0.33755
 1376  
 1377  
 1378  
 1379  
 1380  
 1381  
 1382  .PARAM VSATEFF = '(84178+0.0066521/LE+-0.0102/WE)'
 1383  
 1384  * Equations for stress :
 1385  *-----------------------
 1386  
 1387  .PARAM C_1	= 'CONW+COEACT2+CONPO'
 1388  .PARAM C_2 	= C_1
 1389  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
 1390  .PARAM B_2	= B_1 
 1391  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
 1392  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
 1393  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 1394  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 1395  * Stress effect on threshold voltage :
 1396  *-------------------------------------
 1397  
 1398  
 1399  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1E+12))+(1/LM -(0*NFING/WM+1E+12)))+9.0095E-10*NFING/WM+-3.5838E-05'
 1400  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1401  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-PHVTLP_DVTH0_CMOS065+DVTHTOT'
 1402  * Stress effect on mobility :
 1403  *----------------------------
 1404  
 1405  
 1406  .PARAM VARMAXU0 	= '((-1.4E-15*NFING/WM+-9.1441E-09)/2)*(ABS(1/LM-(-0.088*NFING/WM+3.1087E+06))-(1/LM -(-0.088*NFING/WM+3.1087E+06)))+((-4.5926E-16*NFING/WM+9.1028E-10)/2)*(ABS(1/LM-(0.1532*NFING/WM +4.1101E+06))+(1/LM -(0.1532*NFING/WM+4.1101E+06)))+4.41E-10*NFING/WM+0.018161'
 1407  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1408  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
 1409  * Stress effect on body factor K1 :
 1410  *----------------------------------
 1411  .PARAM VARMAXK1         = '0.00273+5.49E-10/LM+-7E-09*NFING/WM'
 1412  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1413  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
 1414  * Stress effect on DVT0 :
 1415  *------------------------
 1416  .PARAM DVT0_STRESS        = -0.69318
 1417  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 1418  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1419  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
 1420  * Stress effect on access resistance :
 1421  *-------------------------------------
 1422  .PARAM VARMAXRDSW       = '0.103+-8.11E-09*NFING/WM'
 1423  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 1424  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
 1425  
 1426  
 1427  .PARAM NFACTOR = '(1.0985)*SQRT(PHIS*1.4646E+18/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 1428  
 1429  
 1430  
 1431  * Equations for VT :
 1432  *-------------------
 1433  .PARAM W0       = '3.0052E-07+(0-XW)'
 1434  .PARAM K3B      = '(12.574)*(2.4239E-09/TOX)'
 1435  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1436  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*1.4646E+18*1E6))'
 1437  .PARAM DVTP0    = 0
 1438  
 1439  
 1440  .PARAM N_SUBVT  = '1.0+(1.0985)*7.271700702E-09/XDEP0'
 1441  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.4687E-07))'
 1442  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 1443  .PARAM K3       = '(-14.268+1E-07/(LE*(LMIN+8E-09-2*LINT)/(LMIN+XL-2*LINT)))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 1444  
 1445  
 1446  
 1447  * Equation for moin :
 1448  *-------------------
 1449  .PARAM MOIN = 'VALIF((9.0239*((0.48923)/K1EFF)^2 > 5), (9.0239*((0.48923)/K1EFF)^2), (5))'
 1450  
 1451  
 1452  * Equations for LKETA :
 1453  *---------------------
 1454  
 1455  .PARAM LKETAEXP = 'VALIF(((9.99000999E+11/LE-1.7737314E+19) > 34), (34), (9.99000999E+11/LE-1.7737314E+19))'
 1456  
 1457  .PARAM LKETA    = '-0.01/(1.0+EXP(LKETAEXP))'
 1458  
 1459  
 1460  *Worst case methodology improvement: Short Channel effect
 1461  *--------------------------------------------------------
 1462  .PARAM LPE0  = '((((0.48923)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.6518E-08)/(LMIN+8E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1463  .PARAM LPEB  = '(-1.5427E-09)/(LMIN+8E-09-2*LINT)*(LMIN+XL-2*LINT)'
 1464  .PARAM DVT1  = '0.077454*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1465  .PARAM DVT1W = '1.6265E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1466  .PARAM DSUB = '(0.56293)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1467  
 1468  
 1469  
 1470  * Equations for Extrinsic Capacitances:
 1471  * ------------------------------------
 1472  
 1473  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 1474  
 1475  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 1476  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 1477  
 1478  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 1479  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 1480  
 1481  
 1482  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 1483  
 1484  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 1485  
 1486  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
 1487  
 1488  .PARAM CGSL = '((1.264E-10) + -4.642E-18/LM  + 1.563E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 1489  .PARAM CGDL = '((1.264E-10) + -4.642E-18/LM  + 1.563E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.4239E-09/TOX)' 
 1490  .PARAM CGSO       =  'VALIF((POCOSM>0),(5E-12*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),5E-12*(2.4239E-09/TOX))'
 1491  .PARAM CGDO       =  'VALIF((POCOSM>0),(5E-12*(2.4239E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),5E-12*(2.4239E-09/TOX))'
 1492  
 1493  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1494  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
 1495  
 1496  
 1497  
 1498  * Equations for extrinsic S/D resistances:
 1499  * ---------------------------------------
 1500  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(15*CONPO*NFING/WM)'
 1501   
 1502  * Unsilicided poly gate resistance:
 1503  * --------------------------------
 1504  .PARAM RSHGUMMID = '(605+RSHGUM)/2 + (605-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
 1505  .PARAM RSHGUMEFF = 'RSHGUMMID*605*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*605)'
 1506  
 1507  
 1508  * Salicided poly gate resistance:
 1509  * ------------------------------
 1510  
 1511   .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==0),(1-ALIGNMENT_PRELAYOUT),(0))'
 1512  .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__1__YES = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==1),(1-ALIGNMENT_PRELAYOUT),(0))'
 1513  .PARAM RGATEMOD = GFLAG__RGATESWITCH__ALL__CMOS065__1__YES 
 1514  .PARAM RGATE    = '(((RSHG*(WM/NFING+XW))/(3*NGCON**2*(LM+XL+9E-09)))+((17.5E-12+RSHGUMEFF*1E-07*(1E-07-2.5E-08))/((WM/NFING+XW)*(LM+XL))))/NFING'
 1515  .PARAM RSHG0    = 'RGATE*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
 1516  
 1517  * Salicided Source/Drain diffusion access resistances:
 1518  * ---------------------------------------------------
 1519  .PARAM NRSEFF    = 'NRS'
 1520  .PARAM NRDEFF    = 'NRD'
 1521  
 1522  
 1523  
 1524  * Equations for VOFF:
 1525  * ------------------
 1526  
 1527  .PARAM VOFF = '-0.13249 + -0.10229*(TEMPK/(25+273.15) -1)' 
 1528  
 1529  
 1530  
 1531  * Equations for temperature dependance of BGIDL:
 1532  * --------------------------------------------
 1533  .PARAM BGIDL = '7.1549E+09 + -1.2525E+09*(TEMPK/(25+273.15) -1)'
 1534  
 1535  
 1536  * Equations for temperature dependence of series resistances:
 1537  * -----------------------------------------------------------
 1538  .PARAM RDWMIN = 0
 1539  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 1540  .PARAM RSWMIN = 0
 1541  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 1542  .PARAM RDSWMIN = 0
 1543  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 1544  .PARAM RSW = 0
 1545  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 1546  .PARAM RDW = 0
 1547  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 163.72*(TEMPK/(25+273.15) -1)), (0))'
 1548  .PARAM RDSWEFF2 = '(RDSWEFF + 163.72*(TEMPK/(25+273.15) -1))'
 1549  .PARAM PRT = 0
 1550  
 1551  
 1552  * Equations for thermal noise scaling
 1553  * ------------------------------------
 1554  .PARAM NTNOI = '1*LE/LEC'
 1555  
 1556  
 1557  
 1558  * Equations for Flicker Noise Local Variations
 1559  * --------------------------------------------
 1560  
 1561  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
 1562  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
 1563  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
 1564  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(1.200E-01*1.200E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
 1565  .PARAM NOIA    = '((TANH((LE-3E-07)*2E+06))*(1.70E+42)/2+1.45E+42)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.200E-01*1.200E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 1566  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.200E-01*1.200E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 1567  .PARAM NOIC    = '(5E+09)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.200E-01*1.200E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 1568  
 1569  
 1570  
 1571  
 1572  * Selection of the WPE model parameter values depending on the netlist extraction:
 1573  * -------------------------------------------------------------------------------
 1574  .PARAM WPEMOD   = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1),(1))'
 1575  .PARAM KVTH0WE  = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((-0.002802+2.076E-11/LE+6.307E-10/WE+-1.52E-17/(LE*WE))),((-3.30111E-3+3.093636E-11/LE+1.009387E-09/WE)))'
 1576  .PARAM K2WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0+0.0/LE+0.0/WE+0.0/(LE*WE))),((1.925584E-3+-1.483648E-10/LE+-1.62823E-10/WE)))'
 1577  .PARAM SCREF    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1E-06),(1E-06))'
 1578  .PARAM KU0WE    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((-0.0005534+-1.13E-10/LE+-1.159E-09/WE+8.669E-17/(LE*WE))),((-2.0E-3+-4E-09/WE)))'
 1579  .PARAM WEB      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
 1580  .PARAM WEC2      =  'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
 1581  
 1582  
 1583  M1 D G S B PHVTLP W='WM/NFING' L=LM AS='ASM/NFING' AD='ADM/NFING' PS='PSM/NFING' PD='PDM/NFING'
 1584  +          M='MULT*NFING' NRD='NRDEFF*NFING' NRS='NRSEFF*NFING' NF=1 SCA='SCAM' SCB='SCBM' SCC='SCCM' 
 1585  
 1586  
 1587  .MODEL PHVTLP PMOS
 1588  + LEVEL=60
