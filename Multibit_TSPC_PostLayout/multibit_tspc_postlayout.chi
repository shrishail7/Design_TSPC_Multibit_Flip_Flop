 1452  * --------------------------------------------
 1453  
 1454  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
 1455  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
 1456  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
