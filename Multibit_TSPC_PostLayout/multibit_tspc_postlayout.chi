 1161  .PARAM POCODM	= 'POCOD*TOMETER'
 1162  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
 1163  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 1164  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 1165  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
 1166  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
 1167  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
 1168  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
 1169  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
 1170  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
 1171  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
 1172  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
 1173  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
 1174  
