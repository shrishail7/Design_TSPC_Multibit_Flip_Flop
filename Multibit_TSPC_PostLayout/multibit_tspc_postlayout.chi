 1042  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 1043  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 1044  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 1045  * DC Effective length and width:
 1046  *---------------------------
 1047  .PARAM WE      = '(WM/NFING+XW-2*WINT)'
 1048  .PARAM LE      = 'LM+XL-2.0*LINT'
 1049  * AC Effective length and width:
 1050  *------------------------------
 1051  .PARAM WEC     = '(WM/NFING+XW-2*DWC)'
 1052  .PARAM LEC     = 'LM+XL-2.0*DLC'
 1053  *  Effective Source/Drain Junction width:
 1054  *---------------------------------------
 1055  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 1056  
 1057  
 1058  * Model improvement equations :
 1059  *------------------------------
 1060  
 1061  * Equations for mismatch deviations:
 1062  *-----------------------------------
 1063  .PARAM DVTH0_ALPHA = (4.3E-9)
 1064  .PARAM DVTH0_BETA  = (0.0)
 1065  .PARAM DVTH0_FUDGE  = (1.0)
 1066  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
 1067  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMDPHVTLP_DEV*MISMATCH}
 1068  .PARAM DBETA_ALPHA = (1.04E-8)
 1069  .PARAM DBETA_BETA  = (0.0)
 1070  .PARAM DBETA_FUDGE  = (1.0)
 1071  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
 1072  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMDPHVTLP_DEV*MISMATCH}
 1073  
 1074  
 1075  .PARAM PROCESSSTATFLAGS = '1.0'
 1076  .PARAM DVTHTOT   = 'PSRAMDPHVTLP_DVTH0_CMOS065/(VALIF((PSRAMDPHVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((PSRAMDPHVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PSRAMDPHVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PSRAMDPHVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1077  .PARAM VTH     = '-0.75397+PSRAMDPHVTLP_DVTH0_CMOS065'
 1078  
 1079  
 1080  * Equation for  AGIDL:
 1081  * --------------------
 1082  .PARAM AGIDL   = '(1.1192E-09)*10^DAGIDL'
 1083  
 1084  
 1085  * Equations for mobility :
 1086  *-------------------------
 1087  .PARAM EPSILON2 = 1E-18
 1088  .PARAM LLIMIT = '2.6322E-08-XL' 
 1089  .PARAM WLIMIT = '9.3521E-07-XW' 
 1090  .PARAM DWU = DWU0
 1091  .PARAM MOBILITY = '2.0/(0.008367963498+(LLIMIT+XL
 1092  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.005449916839/LE)
 1093  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1094  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1095  
 1096  
 1097  
 1098  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PSRAMDPHVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1099  
 1100  
 1101  * Channel doping nch and body factor k1 worst case :
 1102  *---------------------------------------------------
 1103  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1104  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1105  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.4646E+18/NI)+0.18679+0.4'
 1106  .PARAM  K2        =  '(0+9.665E-11/LE)*(TOX/2.4239E-09)'
 1107  .PARAM  K1        =  '(0.48923)-MOSTYPE*(-0.75397-VTH)/SQRT(PHIS_TYP)'
 1108  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1109  .PARAM  NCH       =  '1.4646E+18*(K1*K1)/((0.48923)*(0.48923))'
 1110  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18679+0.4'
 1111  * Series resistance worst case :
 1112  *-------------------------------
 1113  .PARAM RDSW      =  '(804.55)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PSRAMDPHVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1114  .PARAM PRWB      =  0.33755
 1115  
 1116  
 1117  
 1118  
 1119  
 1120  .PARAM  VTH0EFF   =  'VTH0-PSRAMDPHVTLP_DVTH0_CMOS065+DVTHTOT'
 1121  .PARAM U0EFF            = U0
 1122  .PARAM K1EFF		= K1
 1123  .PARAM DVT0EFF		= -2.1337
 1124  .PARAM RDSWEFF0          = RDSW 
 1125  .PARAM VSATEFF = '(3.1161E+06+-0.1/LE)'
 1126  
 1127  
 1128  .PARAM NFACTOR = '(1.0985)*SQRT(PHIS*1.4646E+18/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 1129  
 1130  
 1131  
 1132  * Equations for VT :
 1133  *-------------------
 1134  .PARAM W0       = '3.0052E-07+(0-XW)'
 1135  .PARAM K3B      = '(12.574)*(2.4239E-09/TOX)'
 1136  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1137  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*1.4646E+18*1E6))'
 1138  .PARAM DVTP0    = 0
 1139  
 1140  
 1141  .PARAM N_SUBVT  = '1.0+(1.0985)*7.271700702E-09/XDEP0'
 1142  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.1468E-07))'
 1143  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 1144  .PARAM K3       = '(-14.268+1E-07/(LE*(LMIN+0-2*LINT)/(LMIN+XL-2*LINT)))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 1145  
 1146  
 1147  
 1148  * Equation for moin :
 1149  *-------------------
 1150  .PARAM MOIN = 'VALIF((9.0239*((0.48923)/K1EFF)^2 > 5), (9.0239*((0.48923)/K1EFF)^2), (5))'
 1151  
 1152  
 1153  * Equations for LKETA :
 1154  *---------------------
 1155  
 1156  .PARAM LKETAEXP = 'VALIF(((9.99000999E+11/LE-1.7737314E+19) > 34), (34), (9.99000999E+11/LE-1.7737314E+19))'
 1157  
 1158  .PARAM LKETA    = '0.0078667/(1.0+EXP(LKETAEXP))'
 1159  
 1160  
 1161  *Worst case methodology improvement: Short Channel effect
 1162  *--------------------------------------------------------
 1163  .PARAM LPE0  = '((((0.48923)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.2426E-08)/(LMIN+0-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1164  .PARAM LPEB  = '(-1.5427E-09)/(LMIN+0-2*LINT)*(LMIN+XL-2*LINT)'
 1165  .PARAM DVT1  = '0.077454*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1166  .PARAM DVT1W = '131010*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1167  .PARAM DSUB = '(0.40719)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1168  
 1169  
 1170  
 1171  * Equations for Extrinsic Capacitances:
 1172  * ------------------------------------
 1173  
 1174  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 1175  
 1176  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 1177  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 1178  
 1179  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 1180  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 1181  
 1182  
 1183  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 1184  
 1185  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 1186  
