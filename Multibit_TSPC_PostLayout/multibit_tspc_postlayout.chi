 2397  .PARAM  CJSWS   = '3.4918E-11*(1 + NSVTLP_DCJSW_CMOS065)'
 2398  .PARAM  CJSWGS  = '1.8517E-10*(1 + NSVTLP_DCJGATE_CMOS065)'
 2399  .PARAM  CJD     = '0.0012368*(1 + NSVTLP_DCJB_CMOS065)'
 2400  .PARAM  CJSWD   = '3.4918E-11*(1 + NSVTLP_DCJSW_CMOS065)'
 2401  .PARAM  CJSWGD  = '1.8517E-10*(1 + NSVTLP_DCJGATE_CMOS065)'
 2402  .PARAM  JSS     = '0*10^NSVTLP_DIDIODE_CMOS065'
 2403  .PARAM  JSWS    = '3.1831E-14*10^NSVTLP_DIDIODE_CMOS065'
 2404  .PARAM  JSWGS   = '0*10^NSVTLP_DIDIODE_CMOS065'
 2405  .PARAM  JTSS    = '6.9304E-06*10^NSVTLP_DIDIODE_CMOS065'
 2406  .PARAM  JTSSWS  = '1.1025E-10*10^NSVTLP_DIDIODE_CMOS065'
 2407  .PARAM  JTSSWGS = '3.0879E-11*10^NSVTLP_DIDIODE_CMOS065'
 2408  .PARAM  JSD     = '0*10^NSVTLP_DIDIODE_CMOS065'
 2409  .PARAM  JSWD    = '3.1831E-14*10^NSVTLP_DIDIODE_CMOS065'
 2410  .PARAM  JSWGD   = '0*10^NSVTLP_DIDIODE_CMOS065'
 2411  .PARAM  JTSD    = '6.9304E-06*10^NSVTLP_DIDIODE_CMOS065'
 2412  .PARAM  JTSSWD  = '1.1025E-10*10^NSVTLP_DIDIODE_CMOS065'
 2413  .PARAM  JTSSWGD = '3.0879E-11*10^NSVTLP_DIDIODE_CMOS065'
 2414  .PARAM DAGIDL  = NSVTLP_DAGIDL_CMOS065
 2415  .PARAM DCFRING = NSVTLP_DCFRING_CMOS065
