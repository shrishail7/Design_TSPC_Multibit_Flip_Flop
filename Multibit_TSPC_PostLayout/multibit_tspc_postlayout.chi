 1492  .PARAM PSP='VALIF(((W*TOMETER)<=1.05E-7),(VALIF(((L*TOMETER)<=8.5E-8),(1.8E-07),(1.8E-07))),(VALIF(((L*TOMETER)<=8.5E-8),(1.8E-07),(1.8E-07))))'
 1493  .PARAM ADP='VALIF(((W*TOMETER)<=1.05E-7),(VALIF(((L*TOMETER)<=8.5E-8),(8.39348E-15),(8.66739E-15))),(VALIF(((L*TOMETER)<=8.5E-8),(1.35E-14),(1.35E-14))))'
 1494  .PARAM ASP='VALIF(((W*TOMETER)<=1.05E-7),(VALIF(((L*TOMETER)<=8.5E-8),(8.1E-15),(8.1E-15))),(VALIF(((L*TOMETER)<=8.5E-8),(1.35E-14),(1.35E-14))))'
 1495  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 1496  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 1497  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 1498  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 1499  * DC Effective length and width:
 1500  *---------------------------
 1501  .PARAM WE      = '(WM/NFING+XW-2*WINT)'
 1502  .PARAM LE      = 'LM+XL-2.0*LINT'
 1503  * AC Effective length and width:
 1504  *------------------------------
 1505  .PARAM WEC     = '(WM/NFING+XW-2*DWC)'
 1506  .PARAM LEC     = 'LM+XL-2.0*DLC'
 1507  *  Effective Source/Drain Junction width:
 1508  *---------------------------------------
 1509  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 1510  
 1511  
 1512  * Model improvement equations :
 1513  *------------------------------
 1514  
 1515  * Equations for mismatch deviations:
 1516  *-----------------------------------
 1517  .PARAM DVTH0_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(4.5E-9),(5.1E-9))
 1518  .PARAM DVTH0_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
 1519  .PARAM DVTH0_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
 1520  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
 1521  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMSPSVTLP_DEV*MISMATCH}
 1522  .PARAM DBETA_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.69E-8),(0.65E-8))
 1523  .PARAM DBETA_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
 1524  .PARAM DBETA_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
 1525  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
 1526  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMSPSVTLP_DEV*MISMATCH}
 1527  
 1528  
 1529  .PARAM PROCESSSTATFLAGS = '1.0'
 1530  .PARAM DVTHTOT   = 'NSVTLPPGSP_DVTH0_CMOS065/(VALIF((NSVTLPPGSP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTLPPGSP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMSPSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTLPPGSP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1531  .PARAM VTH     = '0.46739+NSVTLPPGSP_DVTH0_CMOS065'
 1532  
 1533  
 1534  * Equation for  AGIDL:
 1535  * --------------------
 1536  .PARAM AGIDL   = '(0.00014407)*10^DAGIDL'
 1537  
 1538  
 1539  * Equations for mobility :
 1540  *-------------------------
 1541  .PARAM EPSILON2 = 1E-18
 1542  .PARAM LLIMIT = '7.6175E-08-XL' 
 1543  .PARAM WLIMIT = '2.38336E-07-XW' 
 1544  .PARAM DWU = 'DWU0+(7.7762)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
 1545  .PARAM MOBILITY = '2.0/(0.007130730051+(LLIMIT+XL
 1546  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.003621958121/LE)
 1547  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1548  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1549  
 1550  
 1551  
 1552  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSRAMSPSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1553  
 1554  
 1555  * Channel doping nch and body factor k1 worst case :
 1556  *---------------------------------------------------
 1557  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1558  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1559  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(7.863E+17/NI)+0.25043+0.4'
 1560  .PARAM  K2        =  '(0.024422+-5.2602E-09/LE)*(TOX/2.3926E-09)'
 1561  .PARAM  K1        =  '(0.35383)-MOSTYPE*(0.46739-VTH)/SQRT(PHIS_TYP)'
 1562  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1563  .PARAM  NCH       =  '7.863E+17*(K1*K1)/((0.35383)*(0.35383))'
 1564  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
 1565  * Series resistance worst case :
 1566  *-------------------------------
 1567  .PARAM RDSW      =  '(707.87+-4.2669E-05/LE+-0.00010948/WE+9.5E-12/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSRAMSPSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1568  .PARAM PRWB      =  0.057545
 1569  
 1570  
 1571  
 1572  
 1573  
 1574  .PARAM  VTH0EFF   =  'VTH0-NSVTLPPGSP_DVTH0_CMOS065+DVTHTOT'
 1575  .PARAM U0EFF            = U0
 1576  .PARAM K1EFF		= K1
 1577  .PARAM DVT0EFF		= -0.03
 1578  .PARAM RDSWEFF0          = RDSW 
 1579  .PARAM VSATEFF = '(1.21E+05)'
 1580  
 1581  
 1582  .PARAM NFACTOR = '(1.3251)*SQRT(PHIS*7.863E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
 1583  
 1584  
 1585  
 1586  * Equations for VT :
 1587  *-------------------
 1588  .PARAM W0       = '2.2957E-08+(0-XW)'
 1589  .PARAM K3B      = '(3+-1.7E-07/LE)*(2.3926E-09/TOX)'
 1590  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1591  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*7.863E+17*1E6))'
 1592  .PARAM DVTP0    = 0
 1593  
 1594  
 1595  .PARAM N_SUBVT  = '1.0+(1.3251)*7.177800693E-09/XDEP0'
 1596  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.3E-06))'
 1597  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
 1598  .PARAM K3       = '(-5.8321)*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
 1599  
 1600  
 1601  
 1602  * Equation for moin :
 1603  *-------------------
 1604  .PARAM MOIN = 'VALIF((5.8569*((0.35383)/K1EFF)^2 > 5), (5.8569*((0.35383)/K1EFF)^2), (5))'
