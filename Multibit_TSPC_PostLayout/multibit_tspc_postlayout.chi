  627  * Equation for  AGIDL:
  628  * --------------------
  629  .PARAM AGIDL   = '(-0.0059656+6.4973E-10/LE)*10^DAGIDL'
  630  
  631  
  632  * Equations for mobility :
  633  *-------------------------
  634  .PARAM EPSILON2 = 1E-18
  635  .PARAM LLIMIT = '7.084E-07-XL' 
  636  .PARAM WLIMIT = '7.780828E-07-XW' 
  637  .PARAM DWU = 'DWU0+(-1.3612)*0.5E6*(ABS(LE-5.272E-08)-(LE-5.272E-08))' 
  638  .PARAM MOBILITY = '2.0/(0.004251271843+(LLIMIT+XL
  639  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.0006149082061/LE)
  640  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  641  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  642  
  643  
  644  
  645  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSRAMDPHVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  646  
  647  
  648  * Channel doping nch and body factor k1 worst case :
  649  *---------------------------------------------------
  650  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  651  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  652  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.3981E+18/NI)+0.25043+0.4'
  653  .PARAM  K2        =  '(-0.004+-5.7755E-09/LE)*(TOX/2.3926E-09)'
  654  .PARAM  K1        =  '(0.47182)-MOSTYPE*(0.67476-VTH)/SQRT(PHIS_TYP)'
  655  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  656  .PARAM  NCH       =  '1.3981E+18*(K1*K1)/((0.47182)*(0.47182))'
  657  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  658  * Series resistance worst case :
  659  *-------------------------------
  660  .PARAM RDSW      =  '(1182.8+-3.3059E-08/LE+2.3665E-09/WE+-2.3821E-12/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSRAMDPHVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  661  .PARAM PRWB      =  0.013147
