  654  .PARAM  CJD     = '0.0013154*(1 + NSVTGP_DCJB_CMOS065)'
  655  .PARAM  CJSWD   = '2.629E-11*(1 + NSVTGP_DCJSW_CMOS065)'
  656  .PARAM  CJSWGD  = '2.5718E-10*(1 + NSVTGP_DCJGATE_CMOS065)'
  657  .PARAM  JSS     = '3.3261E-07*10^NSVTGP_DIDIODE_CMOS065'
  658  .PARAM  JSWS    = '1.12E-13*10^NSVTGP_DIDIODE_CMOS065'
  659  .PARAM  JSWGS   = '2.7698E-14*10^NSVTGP_DIDIODE_CMOS065'
  660  .PARAM  JTSS    = '1.001E-18*10^NSVTGP_DIDIODE_CMOS065'
  661  .PARAM  JTSSWS  = '3.2373E-11*10^NSVTGP_DIDIODE_CMOS065'
  662  .PARAM  JTSSWGS = '1.3649E-08*10^NSVTGP_DIDIODE_CMOS065'
  663  .PARAM  JSD     = '3.3261E-07*10^NSVTGP_DIDIODE_CMOS065'
  664  .PARAM  JSWD    = '1.12E-13*10^NSVTGP_DIDIODE_CMOS065'
  665  .PARAM  JSWGD   = '2.7698E-14*10^NSVTGP_DIDIODE_CMOS065'
  666  .PARAM  JTSD    = '1.001E-18*10^NSVTGP_DIDIODE_CMOS065'
  667  .PARAM  JTSSWD  = '3.2373E-11*10^NSVTGP_DIDIODE_CMOS065'
  668  .PARAM  JTSSWGD = '1.3649E-08*10^NSVTGP_DIDIODE_CMOS065'
  669  .PARAM DAGIDL  = NSVTGP_DAGIDL_CMOS065
  670  .PARAM DCFRING = NSVTGP_DCFRING_CMOS065
  671  .PARAM DRDSW   = NSVTGP_DRDSW_CMOS065
  672  
  673  .PARAM RSH      = '12 + NSVTGP_DRSH_CMOS065'
  674  .PARAM RCONSD  = '37.5+NSVTGP_DRCONSD_CMOS065'
  675  .PARAM RSHG     = '15 + NSVTGP_DRSHG_CMOS065'
  676  .PARAM RSHGUM   = '150 + NSVTGP_DRSHGU_CMOS065'
  677  .PARAM RSHGU    = '170 + NSVTGP_DRSHGU_CMOS065'
  678  
  679  .PARAM RCONPO	= '37.5 + NSVTGP_DRCONPO_CMOS065'
  680  .PARAM RHIG	= '0 + NSVTGP_DRHIG_CMOS065'
  681  .PARAM RSD_RPO  = '130 + NSVTGP_DRSD_RPO_CMOS065'
  682  
  683  
  684  * Layout and electrical dimensions:
  685  *----------------------------------
  686  .PARAM WM='W*TOMETER'
  687  .PARAM LM='L*TOMETER'
  688  .PARAM WFING='WM/NFING+XW'
  689  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
  690  .PARAM FS='2-FD'
  691  .PARAM EDUM='EDU*TOMETER'
  692  .PARAM ESUM='ESU*TOMETER'
  693  .PARAM ADP='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(CONW/2.0+COEACT2+XW/2))'
  694  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
  695  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
  696  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
  697  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  698  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  699  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
  700  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
  701  .PARAM POCOSM	= 'POCOS*TOMETER'
  702  .PARAM POCODM	= 'POCOD*TOMETER'
  703  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
  704  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-6*1E-6/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
  705  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
  706  + 1E-6/10.0*SCM*EXP(-10.0*SCM/1E-6)
  707  + +1E-6*1E-6/100.0*EXP(-10.0*SCM/1E-6)
  708  + -1E-6/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-6)
  709  + -1E-6*1E-6/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-6)),0))'
  710  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
  711  + 1E-6/20.0*SCM*EXP(-20.0*SCM/1E-6)
  712  + +1E-6*1E-6/400.0*EXP(-20.0*SCM/1E-6)
  713  + -1E-6/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-6)
  714  + -1E-6*1E-6/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-6)),0))'
  715  
  716  * DC Effective length and width:
  717  *---------------------------
  718  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  719  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  720  * AC Effective length and width:
  721  *------------------------------
  722  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  723  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  724  *  Effective Source/Drain Junction width:
  725  *---------------------------------------
  726  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  727  
  728  
  729  * Model improvement equations :
  730  *------------------------------
  731  
  732  * Equations for mismatch deviations:
  733  *-----------------------------------
  734  .PARAM DVTH0_ALPHA = (3E-9)
  735  .PARAM DVTH0_BETA  = (0.0)
  736  .PARAM DVTH0_FUDGE  = (1)
  737  .PARAM DVTH0_ALPHA_C2 = (3E-9)
  738  .PARAM DVTH0_BETA_C2  = (0.0)
  739  .PARAM DVTH0_FUDGE_C2 = (1)
  740  .PARAM DVTH0_SIG = {(((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DVTH0_ALPHA_C2/SQRT(WM*LM))+DVTH0_BETA_C2)*DVTH0_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
  741  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SVTGP_DEV*MISMATCH}
  742  .PARAM DBETA_ALPHA = (0.66E-8)
  743  .PARAM DBETA_BETA  = (0.0)
  744  .PARAM DBETA_FUDGE  = (1)
  745  .PARAM DBETA_ALPHA_C2 = (0.66E-8)
  746  .PARAM DBETA_BETA_C2  = (0.0)
  747  .PARAM DBETA_FUDGE_C2 = (1)
  748  .PARAM DBETA_SIG = {(((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT))*MFLAG_ALIGNMENT+(((DBETA_ALPHA_C2/SQRT(WM*LM))+DBETA_BETA_C2)*DBETA_FUDGE_C2/SQRT(2.0*MULT))*(1-MFLAG_ALIGNMENT)}
  749  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SVTGP_DEV*MISMATCH}
  750  
  751  
  752  .PARAM PROCESSSTATFLAGS = '1.0'
  753  .PARAM DVTHTOT   = 'NSVTGP_DVTH0_CMOS065/(VALIF((NSVTGP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTGP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSVTGP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTGP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  754  .PARAM VTH     = '0.2625+NSVTGP_DVTH0_CMOS065'
  755  
  756  
  757  * Equation for  AGIDL:
  758  * --------------------
  759  .PARAM AGIDL   = '(7.4346E-05)*10^DAGIDL'
  760  
  761  
  762  * Equations for mobility :
  763  *-------------------------
  764  .PARAM EPSILON2 = 1E-18
  765  .PARAM LLIMIT = '8.3E-08-XL' 
  766  .PARAM WLIMIT = '6.88E-07-XW' 
  767  .PARAM DWU = 'DWU0+(-0.04)*0.5E6*(ABS(LE-1.7151E-06)-(LE-1.7151E-06))' 
  768  .PARAM MOBILITY = '2.0/(0.003667201527+(LLIMIT+XL
  769  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.001720729508/LE)
  770  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  771  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  772  
  773  
  774  
  775  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSVTGP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  776  
  777  
  778  * Channel doping nch and body factor k1 worst case :
  779  *---------------------------------------------------
  780  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  781  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  782  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(8.9277E+17/NI)+0.17968+0.4'
  783  .PARAM  K2        =  '(-0.036555+-4.5964E-09/LE)*(TOX/1.88E-09)'
  784  .PARAM  K1        =  '(0.34076)-MOSTYPE*(0.2625-VTH)/SQRT(PHIS_TYP)'
  785  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  786  .PARAM  NCH       =  '8.9277E+17*(K1*K1)/((0.34076)*(0.34076))'
  787  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.17968+0.4'
  788  * Series resistance worst case :
  789  *-------------------------------
  790  .PARAM RDSW      =  '(338.91+-2.1E-05/LE+7.4971E-13/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSVTGP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  791  .PARAM PRWB      =  0
  792  
  793  
  794  
  795  
  796  
  797  
  798  .PARAM VSATEFF = '(1.704E+05+0.006633/LE+0.003/WE)'
  799  
  800  * Equations for stress :
  801  *-----------------------
  802  
  803  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
  804  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
  805  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
  806  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
  807  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
  808  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  809  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  810  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  811  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  812  * Stress effect on threshold voltage :
  813  *-------------------------------------
  814  
  815  
  816  .PARAM VARMAXVTH0       = '((3.5E-16*NFING/WM+6.5294E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))-(1/LM -(-0.061381*NFING/WM +4.4092E+06)))+((7.9412E-17*NFING/WM+-2.7059E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))+(1/LM -(-0.061381*NFING/WM+4.4092E+06)))+-4.2353E-10*NFING/WM+-0.0049765'
  817  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  818  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NSVTGP_DVTH0_CMOS065+DVTHTOT'
  819  * Stress effect on mobility :
  820  *----------------------------
  821  
  822  
  823  .PARAM VARMAXU0 	= '((0*NFING/WM+-3E-09)/2)*(ABS(1/LM-(0*NFING/WM+4E+06))-(1/LM -(0*NFING/WM+4E+06)))+((-5.2941E-16*NFING/WM+3E-09)/2)*(ABS(1/LM-(0*NFING/WM +4E+06))+(1/LM -(0*NFING/WM+4E+06)))+-1.7647E-09*NFING/WM+0.046765'
  824  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  825  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
  826  * Stress effect on body factor K1 :
  827  *----------------------------------
  828  .PARAM VARMAXK1         = '0.017+0/LM+-5E-09*NFING/WM'
  829  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  830  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  831  * Stress effect on DVT0 :
  832  *------------------------
  833  .PARAM DVT0_STRESS        = 9000
  834  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  835  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  836  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  837  * Stress effect on access resistance :
  838  *-------------------------------------
  839  .PARAM VARMAXRDSW       = '0+0*NFING/WM'
  840  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  841  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  842  
  843  
  844  .PARAM NFACTOR = '(0.78903+1.5017E-07/LE)*SQRT(PHIS*8.9277E+17/(PHIS_TYP*NCH))*(1.88E-09/TOX)'
  845  
  846  
  847  
  848  * Equations for VT :
  849  *-------------------
  850  .PARAM W0       = '1E-09+(0-XW)'
  851  .PARAM K3B      = '(3+-3.7E-07/LE)*(1.88E-09/TOX)'
  852  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  853  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*8.9277E+17*1E6))'
  854  .PARAM DVTP0    = 0
  855  
  856  
  857  .PARAM N_SUBVT  = '1.0+(0.78903+1.5017E-07/LE)*5.640000544E-09/XDEP0'
  858  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+7E-07))'
  859  .PARAM TMP2     = '1.692E-09/(WE+W0)'
  860  .PARAM K3       = '(-6.5+3E-07/(LE*(LMIN+-7E-09-2*LINT)/(LMIN+XL-2*LINT)))*(1.88E-09/TOX)+VTH_RSCE/TMP2'
  861  
  862  
  863  
  864  * Equation for moin :
  865  *-------------------
  866  .PARAM MOIN = 'VALIF((6.1782*((0.34076)/K1EFF)^2 > 5), (6.1782*((0.34076)/K1EFF)^2), (5))'
  867  
  868  
  869  * Equations for LKETA :
  870  *---------------------
  871  
  872  
  873  .PARAM LKETA    = -0.003 
  874  
  875  
  876  *Worst case methodology improvement: Short Channel effect
  877  *--------------------------------------------------------
  878  .PARAM LPE0  = '((((0.34076)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4.4E-08+3E-16/LE)/(LMIN+-7E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  879  .PARAM LPEB  = '(0)/(LMIN+-7E-09-2*LINT)*(LMIN+XL-2*LINT)'
  880  .PARAM DVT1  = '1.05*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  881  .PARAM DVT1W = '3946.1*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  882  .PARAM DSUB = '(0.8)*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  883  
  884  
  885  
  886  * Equations for Extrinsic Capacitances:
  887  * ------------------------------------
  888  
  889  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
  890  
  891  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
  892  .PARAM C3EXT = '(9.681E-18 + 7.403E-11*(LM + XL))'
  893  
  894  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.237E-17 + 2.400E-18*TANH((LM + XL)/1.258E-07)),(1.474E-17 + 3.229E-18*TANH((LM + XL)/1.497E-07)))'
  895  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.458E-17 + 9.132E-19*TANH((WM/NFING + XW)/1.568E-06) + 1.875E-17*TANH((LM + XL)/5.032E-07)),(1.240E-17 + -2.833E-17*TANH((WM/NFING + XW)/1.635E-06) + 1.043E-17*TANH((LM + XL)/2.752E-07)))' 
  896  
  897  
  898  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-4.315E-19*(1-ALIGNMENT_PRELAYOUT) + 8.264E-11*(WM/NFING + XW) + 4.014E-11*(WM/NFING + XW)*TANH((LM + XL)/3.174E-07)) ,(4.263E-19*(1-ALIGNMENT_PRELAYOUT) + 2.618E-11*(WM/NFING + XW) + 1.895E-11*(WM/NFING + XW)*TANH((LM + XL)/2.508E-07)))'
  899  
  900  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  901  
  902  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
  903  
  904  .PARAM CGSL = '((3E-11) + 1.7E-17/LM  + -7.8E-25/LM^2 + -3E-18/WM*NFING + 0/WM^2*NFING^2)*(1.88E-09/TOX)' 
  905  .PARAM CGDL = '((3E-11) + 1.7E-17/LM  + -7.8E-25/LM^2 + -3E-18/WM*NFING + 0/WM^2*NFING^2)*(1.88E-09/TOX)' 
  906  .PARAM CGSO       =  'VALIF((POCOSM>0),(1E-13*(1.88E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.8098E-07)*(TANH(POCOSM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.88E-09/TOX))'
  907  .PARAM CGDO       =  'VALIF((POCOSM>0),(1E-13*(1.88E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.8098E-07)*(TANH(POCODM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.88E-09/TOX))'
  908  
  909  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  910  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  911  
  912  
  913  
  914  * Equations for extrinsic S/D resistances:
  915  * ---------------------------------------
  916  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
  917   
  918  * Unsilicided poly gate resistance:
  919  * --------------------------------
  920  .PARAM RSHGUMMID = '(620+RSHGUM)/2 + (620-RSHGUM)*TANH(1E18*(2*2.2E-8-LM-XL))/2'
  921  .PARAM RSHGUMEFF = 'RSHGUMMID*620*(LM+XL)/(2*2.2E-8*RSHGUMMID + (LM+XL-2*2.2E-8)*620)'
  922  
  923  
  924  .PARAM RGATEMOD = 1
  925  .PARAM XGWS    = 'CONRPO-COEPO'
  926  .PARAM XGWU    = 'RPOEXTPOFLD'
  927  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
  928  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
  929  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
  930  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
  931  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
  932  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
  933  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
  934  
  935  * Unsilicided Source/Drain diffusion access resistances:
