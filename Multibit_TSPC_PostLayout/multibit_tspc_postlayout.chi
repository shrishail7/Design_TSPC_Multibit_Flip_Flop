 2114  + DTOX=0                EPSROX=3.9            XW=XW                 
 2115  + XL=XL                 WINT=-2.1607E-08      LINT=6E-09            
 2116  + DLC=1.45E-08          DWC=-2E-08            DWJ=-7.1359E-09       
 2117  + DWG=-2.0244E-09       DWB=-5E-09            DMCG=0                
 2118  + DMCI=0                DMDG=0                DMCGT=0               
 2119  + WL=0                  WLN=1                 WW=0                  
 2120  + WWN=1                 WWL=0                 LL=0                  
 2121  + LLN=1                 LW=0                  LWN=1                 
 2122  + LWL=0                 LLC=-7E-17            LWC=0                 
 2123  + LWLC=0                WLC=0                 WWC=0                 
 2124  + WWLC=0                LMIN='6E-8'           LMAX=1.8E-07          
 2125  + WMIN='1.2E-7'         WMAX=0.001            XJ=5E-08              
 2126  + NGATE=5.2228E+20      NSD=1E+20             NDEP=NCH              
 2127  + VTH0=VTH0EFF          K1=K1EFF              K2=K2                 
 2128  + LK2=0                 PHIN=0.18             K3=K3                 
 2129  + LK3=0                 PK3=0                 K3B=K3B               
 2130  + W0=W0                 LPE0=LPE0             LPEB=LPEB             
 2131  + DVT0=DVT0EFF          DVT1=DVT1             DVT2=0.14             
 2132  + DVTP0=DVTP0           DVTP1=0               DVT0W=0.15            
 2133  + DVT1W=DVT1W           DVT2W=0.25            ETA0=0.035            
 2134  + WETA0=-0.0022613      ETAB=-0.02            WETAB=0.01            
 2135  + DSUB=DSUB             VOFF=VOFF             PVOFF=0.00019688      
