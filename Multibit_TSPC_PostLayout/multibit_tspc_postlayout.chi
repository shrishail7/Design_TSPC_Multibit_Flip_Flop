  118  .PARAM RCONSD  = '37.5+NSVTGP_DRCONSD_CMOS065'
  119  .PARAM RSHG     = '15 + NSVTGP_DRSHG_CMOS065'
  120  .PARAM RSHGUM   = '150 + NSVTGP_DRSHGU_CMOS065'
  121  .PARAM RSHGU    = '170 + NSVTGP_DRSHGU_CMOS065'
