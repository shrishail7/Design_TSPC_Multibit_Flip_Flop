 1469  .PARAM K2WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0+0.0/LE+0.0/WE+0.0/(LE*WE))),((5.10249E-3+-4.810027E-11/LE+5.294195E-11/WE)))'
