 1145  .PARAM WM='W*TOMETER'
 1146  .PARAM LM='L*TOMETER'
 1147  .PARAM WFING='WM/NFING+XW'
 1148  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
 1149  .PARAM FS='2-FD'
 1150  .PARAM EDUM='EDU*TOMETER'
 1151  .PARAM ESUM='ESU*TOMETER'
 1152  .PARAM ADP='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(CONW/2.0+COEACT2+XW/2))'
 1153  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
 1154  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
 1155  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
 1156  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 1157  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 1158  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 1159  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
