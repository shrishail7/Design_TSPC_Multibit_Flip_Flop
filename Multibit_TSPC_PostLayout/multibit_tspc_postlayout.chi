 1944  .PARAM PDP='VALIF(((W*TOMETER)<=8.5E-8),(VALIF(((L*TOMETER)<=7.5E-8),(1.80571E-07),(1.85143E-07))),(VALIF(((L*TOMETER)<=7.5E-8),(1.77568E-07),(1.72703E-07))))'
 1945  .PARAM PSP='VALIF(((W*TOMETER)<=8.5E-8),(VALIF(((L*TOMETER)<=7.5E-8),(1.85E-07),(1.85E-07))),(VALIF(((L*TOMETER)<=7.5E-8),(1.8E-07),(1.8E-07))))'
 1946  .PARAM ADP='VALIF(((W*TOMETER)<=8.5E-8),(VALIF(((L*TOMETER)<=7.5E-8),(7.13143E-15),(7.31429E-15))),(VALIF(((L*TOMETER)<=7.5E-8),(8.14865E-15),(7.91757E-15))))'
 1947  .PARAM ASP='VALIF(((W*TOMETER)<=8.5E-8),(VALIF(((L*TOMETER)<=7.5E-8),(7.475E-15),(7.475E-15))),(VALIF(((L*TOMETER)<=7.5E-8),(8.1E-15),(8.1E-15))))'
