 1821  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-6*1E-6/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
 1822  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
 1823  + 1E-6/10.0*SCM*EXP(-10.0*SCM/1E-6)
 1824  + +1E-6*1E-6/100.0*EXP(-10.0*SCM/1E-6)
 1825  + -1E-6/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-6)
 1826  + -1E-6*1E-6/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-6)),0))'
 1827  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-6)*(
 1828  + 1E-6/20.0*SCM*EXP(-20.0*SCM/1E-6)
 1829  + +1E-6*1E-6/400.0*EXP(-20.0*SCM/1E-6)
 1830  + -1E-6/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-6)
 1831  + -1E-6*1E-6/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-6)),0))'
