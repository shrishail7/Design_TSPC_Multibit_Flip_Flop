  710  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  711  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
  712  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
  713  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
  714  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
  715  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  716  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
  717  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
  718  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
  719  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
  720  
  721  * DC Effective length and width:
  722  *---------------------------
  723  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  724  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  725  * AC Effective length and width:
  726  *------------------------------
  727  .PARAM WGCV    = 'WM/NFING+XW+-1.6E-08-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  728  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  729  .PARAM LGCV    = 'LM+XL+-3.4E-08-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  730  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  731  *  Effective Source/Drain Junction width:
  732  *---------------------------------------
  733  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  734  
  735  
  736  * Model improvement equations :
  737  *------------------------------
  738  
  739   
  740  * Continuous Model for mismatch deviations:
  741  *----------------------------------------
  742  .PARAM DVTH0_SIG = '(4E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT(WM*(LM+XL)))/SQRT(2.0*MULT)'
  743  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*LVTLP_DEV*MISMATCH}
  744  .PARAM DBETA_SIG = '(0.46E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT(WM*(LM+XL)))/SQRT(2.0*MULT)'
  745  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*LVTLP_DEV*MISMATCH}
  746  .PARAM PROCESSSTATFLAGS = '1.0'
  747  .PARAM DVTHTOT   = 'MOSTYPE*DVTHFACT*NLVTLP_DVTH0_CMOS065/(VALIF((NLVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((DVTHFACT*NLVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NLVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(DVTHFACT*NLVTLP_DVTH0_CMOS065)^2)+DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS+DVTH0_DEV*MFLAG_MC'
  748  .PARAM DVTH    = 'MOSTYPE*DVTHFACT*NLVTLP_DVTH0_CMOS065'
  749  
  750  
  751  
  752  * Selection of the WPE model parameter values depending on the netlist extraction:
  753  * -------------------------------------------------------------------------------
  754  .PARAM WPEMOD    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1),(1))'
  755  .PARAM KVTH0WE   = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0.008439+-3.265E-10/LE+-4.246E-09/WE+2.287E-16/(LE*WE))),((7.943001E-3+-2.437907E-10/LE+5.294195E-11/WE)))'
  756  .PARAM K2WE      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0+0.0/LE+0.0/WE+0.0/(LE*WE))),((5.10249E-3+-4.810027E-11/LE+5.294195E-11/WE)))'
  757  .PARAM SCREF     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1E-06),(1E-06))'
  758  .PARAM KU0WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((5.126E-05+1.668E-11/LE+-5.689E-10/WE+5.348E-17/(LE*WE))),((-3.259336E-3+3.23339E-10/LE+-4.397753E-10/WE)))'
  759  .PARAM WEB       = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
  760  .PARAM WEC2      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
  761  .PARAM DVTH0_WPE = 'MOSTYPE*WPEMOD*KVTH0WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
  762  .PARAM DK2_WPE   = 'WPEMOD*K2WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
  763  .PARAM DU0_WPE   = 'WPEMOD*KU0WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
  764  
  765  
  766  
  767  * Equations for stress :
  768  *-----------------------
  769  
  770  .PARAM C_1       = 'CONW+COEACT2+CONPO'
  771  .PARAM C_2       = C_1
  772  .PARAM B_1       = '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
  773  .PARAM B_2       = B_1 
  774  .PARAM CEFF      = '2/(1/C_1+1/C_2)'
  775  .PARAM BEFF      = '2/(1/B_1+1/B_2)'
  776  .PARAM PO2ACTEFFM = 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  777  .PARAM PO2ACTCALM = 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  778  * Stress effect on threshold voltage :
  779  *-------------------------------------
  780  
  781  
  782  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((-3.265E-16*NFING/WM+1.3814E-09)/2)*(ABS(1/LM-(0*NFING/WM+5E+06))+(1/LM -(0*NFING/WM+5E+06)))+3.5294E-10*NFING/WM+-0.0040207'
  783  .PARAM DVTH0_MECHSTRESS = 'MOSTYPE*VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)-MOSTYPE*DVTHFACT*NLVTLP_DVTH0_CMOS065+DVTHTOT'
  784  * Stress effect on mobility :
  785  *----------------------------
  786  
  787  
  788  .PARAM VARMAXU0 	= '((4.5544E-16*NFING/WM+-1.1961E-08)/2)*(ABS(1/LM-(-0.08785*NFING/WM+5.8298E+06))-(1/LM -(-0.08785*NFING/WM+5.8298E+06)))+((1.2264E-15*NFING/WM+-1.5993E-09)/2)*(ABS(1/LM-(0.1532*NFING/WM +9.8E+06))+(1/LM -(0.1532*NFING/WM+9.8E+06)))+-3E-09*NFING/WM+0.07397'
  789  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  790  * Stress effect on body factor K1 :
  791  *----------------------------------
  792  .PARAM VARMAXK1         = '-0.04+0/LM+1E-08*NFING/WM'
  793  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  794  * Stress effect on DVT0 :
  795  *------------------------
  796  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  797  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  798  * Stress effect on access resistance :
  799  *-------------------------------------
  800  .PARAM VARMAXRDSW       = '0.15+-5.67E-08*NFING/WM'
  801  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)' 
  802  
  803  
  804  * Equations for mobility :
  805  *-------------------------
  806  .PARAM MOBILITY = '0.0448269*(1+DU0_WPE)*(1+DU0_MECHSTRESS)'
  807  
  808  
  809  
  810  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NLVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  811  
  812  
  813  * Channel doping nch and body factor k1 worst case :
  814  *---------------------------------------------------
  815  .PARAM LE_TYP   = 'LE'
  816  .PARAM WE_TYP   = 'WE'
  817  .PARAM SCE_TERM = '1-0.10395*(1E-6/LE_TYP)--0.00270864*(1E-6/LE_TYP)**2'
  818  .PARAM NSUBOTYP = '1.03781E+23*MAX((1+-0.0139217*1E-6/WE_TYP*LOG(1+WE_TYP/8.98534E-10)),1E-3)'
  819  .PARAM NSUBOEFF = '1.03781E+23*MAX((1+-0.0139217*1E-6/WE*LOG(1+WE/8.98534E-10)),1E-3)'
  820  .PARAM NPCKTYP  = '6.34706E+23*MAX((1+0*1E-6/WE_TYP*LOG(1+WE_TYP/9.97308E-07)),1E-3)'
  821  .PARAM NPCKEFF  = '6.34706E+23*MAX((1+0*1E-6/WE*LOG(1+WE/9.97308E-07)),1E-3)'
  822  .PARAM LPCKTYP  = '5.18669E-09*MAX((1+0*1E-6/WE_TYP*LOG(1+WE_TYP/9.97308E-07)),1E-3)'
  823  .PARAM LPCKEFF  = '5.18669E-09*MAX((1+0*1E-6/WE*LOG(1+WE/9.97308E-07)),1E-3)'
  824  .PARAM BOVA_TYP = '(SQRT(NSUBOTYP+0.5*NPCKTYP)-SQRT(NSUBOTYP))/7.5E10'
  825  .PARAM BOVA     = '(SQRT(NSUBOEFF+0.5*NPCKEFF)-SQRT(NSUBOEFF))/7.5E10'
  826  .PARAM NEFF_TYP = 'SCE_TERM*VALIF( LE_TYP<LPCKTYP, NSUBOTYP+NPCKTYP*(2-LE_TYP/LPCKTYP), (VALIF( LE_TYP<(2*LPCKTYP), NSUBOTYP+NPCKTYP*LPCKTYP/LE_TYP, (SQRT(NSUBOTYP)+7.5E10*LOG(1+2*LPCKTYP/LE_TYP*(EXP(BOVA_TYP)-1)))**2 )) )'
  827  .PARAM NSUB     = 'VALIF( LE<LPCKEFF, NSUBOEFF+NPCKEFF*(2-LE/LPCKEFF), (VALIF( LE<(2*LPCKEFF), NSUBOEFF+NPCKEFF*LPCKEFF/LE, (SQRT(NSUBOEFF)+7.5E10*LOG(1+2*LPCKEFF/LE*(EXP(BOVA)-1)))**2 )) )'
  828  .PARAM EGOVQ    = '1.179-9.025E-5*TEMPK-3.05E-7*TEMPK^2'
  829  .PARAM PHIBFACT = '(1.045+4.5E-4*TEMPK)*(0.523+1.4E-3*TEMPK-1.48E-6*TEMPK^2)*(TEMPK/300)^2'
  830  .PARAM PHIT_CL  = '1.3806505E-23*TEMPK/1.6021918E-19'
  831  .PARAM PHIS0_CL = 'EGOVQ + 2*PHIT_CL*LOG(NEFF_TYP/(2.5E25*PHIBFACT^0.75))'
  832  .PARAM GAMMA0_CL= 'SQRT(2*1.6021918E-19*1.045E-10*NEFF_TYP)/(3.453E-11/2.19039E-09)'
  833  
  834  .PARAM DPHIB    = '(0+0*(1E-6/LE_TYP)**1)*(1+0*(1E-6/WE_TYP))*(1+0*(1E-12/LE_TYP/WE_TYP))'
  835  .PARAM DELTAQ   = '0.4*1*5.951993*(GAMMA0_CL*SQRT(PHIS0_CL+DPHIB)*3.453E-11/2.19039E-09)**(2.0/3.0)'
  836  .PARAM PHIT     = 'PHIT_CL*(1+(0.75*DELTAQ+DPHIB)/PHIS0_CL)'
  837  .PARAM PHIS0    = 'EGOVQ + 2*PHIT*LOG(NEFF_TYP/(2.5E25*PHIBFACT^0.75))'
  838  .PARAM GAMMA0   = 'GAMMA0_CL*(1+DELTAQ/(GAMMA0_CL*SQRT(PHIS0_CL+DPHIB)))'
  839  .PARAM A        = '2.0*PHIT*GAMMA0/SQRT(PHIS0) - 2.0*PHIT'
  840  .PARAM C        = 'GAMMA0*SQRT(PHIS0) + 6.0*PHIT'
  841  .PARAM NSUBO    = 'NSUB*( ((A-C)+SQRT((A+C)^2+4.0*A*(DVTH+0.29*DK1_MECHSTRESS*(SQRT(1+(4E-12+2.1E-14/LE)/LE)-1)*SQRT(PHIS0))))/2.0/A )^2'
  842  .PARAM NPCK     = '0'
  843  .PARAM LPCK     = '5.18669E-09'
  844  
  845  .PARAM DVFB     = '(1+-0.0243527*1E-6/LE)*(1+0*1E-6/WE)*(1+0.001*1E-12/(WE*LE))'
  846  .PARAM VFBO     = '-0.921516+(DVTH0_WPE+DVTH0_MECHSTRESS)/DVFB'
  847  .PARAM FTOX     = 'TOX/2.19039E-09'
  848  * Series resistance worst case :
  849  *-------------------------------
  850  .PARAM RSW1      =  '39.3088*(1+DRDSW_MECHSTRESS)'
  851  .PARAM RSW1EFF0  =  'RSW1*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NLVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  852  
  853  
  854  * Equations for Extrinsic Capacitances:
  855  * ------------------------------------
  856  
  857  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  858  
  859  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  860  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  861  
  862  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  863  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  864  
  865  
  866  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  867  
  868  .PARAM CFRW = '2.7435E-16/FTOX+1E-6*(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC'
  869  
  870  .PARAM LOV = '1.87E-09'
  871  
  872  
  873  
  874  * Equations for extrinsic S/D resistances:
  875  * ---------------------------------------
  876  .PARAM RSW1EFF    = 'RSW1EFF0 - LPER*RCONSD*WE*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12))'
  877  
  878  
  879  
  880  * Salicided poly gate resistance:
  881  * ------------------------------
  882  
  883   .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==0),(1-ALIGNMENT_PRELAYOUT),(0))'
  884  .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__1__YES = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==1),(1-ALIGNMENT_PRELAYOUT),(0))'
  885  .PARAM RGATEMOD = GFLAG__RGATESWITCH__ALL__CMOS065__1__YES 
  886  .PARAM RGATE    = 'RSHG*((1.0E-07+WEJ/(3*NGCON)))/(NGCON*(LM+XL--2.674E-08)*NFING)'
  887  .PARAM RSHG0    = 'RGATE*(NGCON*(LM+XL--2.674E-08)*NFING)/((1.0E-07+WEJ/(3*NGCON)))'
  888  
  889  * Salicided Source/Drain diffusion access resistances:
  890  * ---------------------------------------------------
  891  .PARAM NRSEFF    = 'NRS'
  892  .PARAM NRDEFF    = 'NRD'
  893  
  894  
  895  
  896  
  897  * Equations for Flicker Noise Local Variations
  898  * --------------------------------------------
  899  
  900  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
  901  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
  902  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
  903  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
  904  .PARAM NOIA    = '((TANH((LE-1E-07)*1.1E+06))*(2.8836E+26)/2+4.806E+25)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
  905  .PARAM NOIB    = '0*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
  906  .PARAM NOIC    = '0*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(2.100E-01*2.100E-01+2.500E-07*2.500E-07/(WM*LM*MULT))*DNOISE_MDEV)'
  907  
  908  
  909  
  910  
  911  
  912  M1 D G S B NLVTLP W='WM/NFING' L=LM ABSOURCE='ASM/NFING' ABDRAIN='ADM/NFING' LSSOURCE='PSM/NFING' LSDRAIN='PDM/NFING'
  913  +          LGSOURCE='WE' LGDRAIN='WE' M='MULT*NFING'
  914  
  915  
  916  
  917  .MODEL NLVTLP NMOS LEVEL=70 SCALELEV=1020 VERSION=102.1
  918  + WMIN=1.2E-07          WMAX=1E-05            LMIN=6E-08            
  919  + LMAX=1E-05
  920  + TR=25                 SWIGATE=1             SWIMPACT=1            
  921  + SWGIDL=1              SWJUNCAP=1            QMC=1                 
  922  + LVARO=XL              LVARL=0               LVARW=0               
  923  + LAP=-3E-09            WVARO=XW              WVARL=0               
  924  + WVARW=0               WOT=-2E-08            DLQ=-3.4E-08          
  925  + DWQ=-1.6E-08          VFBO=VFBO             VFBL=-0.0243527       
  926  + VFBW=0                VFBLW=0.001           STVFBO=0.000538249    
  927  + STVFBL=0.0051834      STVFBW=-0.00857997    STVFBLW=-0.00381712   
  928  + TOXO=TOX              NSUBO=NSUBO           NSUBW=0               
  929  + WSEG=8.98534E-10      NPCK=NPCK             NPCKW=0               
  930  + WSEGP=9.97308E-07     LPCK=LPCK             LPCKW=0               
  931  + FOL1=0.10395          FOL2=-0.00270864      VNSUBO=0              
  932  + NSLPO=0.05            DNSUBO=0              DPHIBO=0              
  933  + DPHIBL=0              DPHIBLEXP=1           DPHIBW=0              
  934  + DPHIBLW=0             NPO=4.04063E+26       NPL=0                 
  935  + CTO='0.0234441'       CTL='0.0252877'       CTLEXP=0.841348       
  936  + CTW='0.146856'        CTLW='-0.00391158'    TOXOVO=TOX            
  937  + LOV=LOV               NOVO=1.508E+24        CFL=5.19654E-05       
  938  + CFLEXP=2.83225        CFW=-0.0623829        CFBO=0                
  939  + UO=U0                 FBET1=0.528925        FBET1W=-0.192782      
  940  + LP1=4.71614E-08       LP1W=0.129499         FBET2=1.21764         
  941  + LP2=1.24064E-08       BETW1=-0.00509013     BETW2=-0.103962       
  942  + WBET=4.9599E-07       STBETO=1.35303        STBETL=-0.0116032     
  943  + STBETW=0.00224968     STBETLW=0.00232922    MUEO=0.869816         
  944  + MUEW=0.00312469       STMUEO=-4.4409E-10    THEMUO=1.81854        
  945  + STTHEMUO=0.224244     CSO=0.717381          CSL=0.00433959        
  946  + CSLEXP=2.47946        CSW=0.107359          CSLW=0.0112374        
  947  + STCSO=-3.89037        XCORO=0.0697307       XCORL=1E-06           
  948  + XCORW=-0.539971       XCORLW=1E-15          STXCORO=1.6278        
  949  + FETAO=1               RSW1=RSW1EFF          RSW2=0.213571         
  950  + STRSO=0.693125        RSBO=0                RSGO=0                
