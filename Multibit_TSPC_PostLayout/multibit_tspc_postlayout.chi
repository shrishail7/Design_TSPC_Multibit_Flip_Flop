 1087  *-------------------------
 1088  .PARAM EPSILON2 = 1E-18
 1089  .PARAM LLIMIT = '7.084E-07-XL' 
 1090  .PARAM WLIMIT = '7.780828E-07-XW' 
 1091  .PARAM DWU = 'DWU0+(-1.3612)*0.5E6*(ABS(LE-5.272E-08)-(LE-5.272E-08))' 
 1092  .PARAM MOBILITY = '2.0/(0.004251271843+(LLIMIT+XL
 1093  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.0006149082061/LE)
 1094  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1095  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1096  
 1097  
 1098  
 1099  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSRAMSPHVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1100  
 1101  
 1102  * Channel doping nch and body factor k1 worst case :
 1103  *---------------------------------------------------
 1104  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1105  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1106  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.3981E+18/NI)+0.25043+0.4'
 1107  .PARAM  K2        =  '(-0.004+-5.7755E-09/LE)*(TOX/2.3926E-09)'
 1108  .PARAM  K1        =  '(0.47182)-MOSTYPE*(0.67476-VTH)/SQRT(PHIS_TYP)'
 1109  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1110  .PARAM  NCH       =  '1.3981E+18*(K1*K1)/((0.47182)*(0.47182))'
 1111  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
 1112  * Series resistance worst case :
 1113  *-------------------------------
 1114  .PARAM RDSW      =  '(1182.8+-3.3059E-08/LE+2.3665E-09/WE+-2.3821E-12/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSRAMSPHVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1115  .PARAM PRWB      =  0.013147
