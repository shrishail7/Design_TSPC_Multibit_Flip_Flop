  747  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*70*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(0*CONPO*NFING/WM)'
