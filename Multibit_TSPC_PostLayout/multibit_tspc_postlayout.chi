  560  .PARAM  JSWD    = '2.0978E-14*10^NSRAMSPHVTLP_DIDIODE_CMOS065'
  561  .PARAM  JSWGD   = '1.8731E-15*10^NSRAMSPHVTLP_DIDIODE_CMOS065'
  562  .PARAM  JTSD    = '0.00099903*10^NSRAMSPHVTLP_DIDIODE_CMOS065'
  563  .PARAM  JTSSWD  = '2.0358E-10*10^NSRAMSPHVTLP_DIDIODE_CMOS065'
  564  .PARAM  JTSSWGD = '2E-10*10^NSRAMSPHVTLP_DIDIODE_CMOS065'
