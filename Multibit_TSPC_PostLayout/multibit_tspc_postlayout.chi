  135  .PARAM ASP='VALIF(((W*TOMETER)<=1.6E-7),(VALIF(((L*TOMETER)<=7.5E-8),(1.26E-14),(1.26E-14))),(VALIF(((L*TOMETER)<=7.5E-8),(1.98E-14),(1.98E-14))))'
  136  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  137  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  138  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
  139  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
  140  * DC Effective length and width:
  141  *---------------------------
  142  .PARAM WE      = '(WM/NFING+XW-2*WINT)'
  143  .PARAM LE      = 'LM+XL-2.0*LINT'
  144  * AC Effective length and width:
  145  *------------------------------
  146  .PARAM WEC     = '(WM/NFING+XW-2*DWC)'
  147  .PARAM LEC     = 'LM+XL-2.0*DLC'
  148  *  Effective Source/Drain Junction width:
  149  *---------------------------------------
  150  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  151  
  152  
  153  * Model improvement equations :
  154  *------------------------------
  155  
  156  * Equations for mismatch deviations:
  157  *-----------------------------------
  158  .PARAM DVTH0_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(4.5E-9),(5.1E-9))
  159  .PARAM DVTH0_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  160  .PARAM DVTH0_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
  161  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
  162  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMSPSVTLP_DEV*MISMATCH}
  163  .PARAM DBETA_ALPHA = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.69E-8),(0.65E-8))
  164  .PARAM DBETA_BETA  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(0.0),(0.0))
  165  .PARAM DBETA_FUDGE  = VALIF(((WM>0.0)&&(WM<=0.110E-6)&&(LM>0.0)),(1.0),(1.0))
  166  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
  167  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMSPSVTLP_DEV*MISMATCH}
  168  
  169  
  170  .PARAM PROCESSSTATFLAGS = '1.0'
  171  .PARAM DVTHTOT   = 'NSVTLPPDSP_DVTH0_CMOS065/(VALIF((NSVTLPPDSP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTLPPDSP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSRAMSPSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTLPPDSP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  172  .PARAM VTH     = '0.46739+NSVTLPPDSP_DVTH0_CMOS065'
  173  
  174  
  175  * Equation for  AGIDL:
  176  * --------------------
  177  .PARAM AGIDL   = '(0.00014407)*10^DAGIDL'
  178  
  179  
  180  * Equations for mobility :
  181  *-------------------------
  182  .PARAM EPSILON2 = 1E-18
  183  .PARAM LLIMIT = '7.6175E-08-XL' 
  184  .PARAM WLIMIT = '2.41736E-07-XW' 
  185  .PARAM DWU = 'DWU0+(7.7762)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
  186  .PARAM MOBILITY = '2.0/(0.007533670034+(LLIMIT+XL
  187  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.00382996633/LE)
  188  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  189  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  190  
  191  
  192  
  193  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSRAMSPSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  194  
  195  
  196  * Channel doping nch and body factor k1 worst case :
  197  *---------------------------------------------------
  198  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  199  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  200  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(7.863E+17/NI)+0.25043+0.4'
  201  .PARAM  K2        =  '(0.024422+-5.2602E-09/LE)*(TOX/2.3926E-09)'
  202  .PARAM  K1        =  '(0.35383)-MOSTYPE*(0.46739-VTH)/SQRT(PHIS_TYP)'
  203  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  204  .PARAM  NCH       =  '7.863E+17*(K1*K1)/((0.35383)*(0.35383))'
  205  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  206  * Series resistance worst case :
  207  *-------------------------------
  208  .PARAM RDSW      =  '(707.87+-4.2669E-05/LE+-0.00010948/WE+9.5E-12/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSRAMSPSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  209  .PARAM PRWB      =  0.057545
  210  
  211  
  212  
  213  
  214  
  215  .PARAM  VTH0EFF   =  'VTH0-NSVTLPPDSP_DVTH0_CMOS065+DVTHTOT'
  216  .PARAM U0EFF            = U0
  217  .PARAM K1EFF		= K1
  218  .PARAM DVT0EFF		= -0.03
  219  .PARAM RDSWEFF0          = RDSW 
  220  .PARAM VSATEFF = '(1.84E+05+-0.0121/WE)'
  221  
  222  
  223  .PARAM NFACTOR = '(1.3251)*SQRT(PHIS*7.863E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
  224  
  225  
  226  
  227  * Equations for VT :
  228  *-------------------
  229  .PARAM W0       = '2.2957E-08+(0-XW)'
  230  .PARAM K3B      = '(3+-1.7E-07/LE)*(2.3926E-09/TOX)'
  231  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  232  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*7.863E+17*1E6))'
  233  .PARAM DVTP0    = 0
  234  
  235  
  236  .PARAM N_SUBVT  = '1.0+(1.3251)*7.177800693E-09/XDEP0'
  237  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.3E-06))'
  238  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
  239  .PARAM K3       = '(-5.8321)*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
  240  
  241  
  242  
  243  * Equation for moin :
  244  *-------------------
  245  .PARAM MOIN = 'VALIF((5.8569*((0.35383)/K1EFF)^2 > 5), (5.8569*((0.35383)/K1EFF)^2), (5))'
  246  
  247  
  248  * Equations for LKETA :
  249  *---------------------
  250  
  251  
  252  .PARAM LKETA    = '0.0087889 + -0.01*(TEMPK/(25+273.15) -1)'
  253  
  254  
  255  *Worst case methodology improvement: Short Channel effect
  256  *--------------------------------------------------------
  257  .PARAM LPE0  = '((((0.35383)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(3E-08+6E-15/LE)/(LMIN+-3E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  258  .PARAM LPEB  = '(0)/(LMIN+-3E-09-2*LINT)*(LMIN+XL-2*LINT)'
  259  .PARAM DVT1  = '0.032462*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  260  .PARAM DVT1W = '8.598E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  261  .PARAM DSUB = '(0.73367)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  262  
  263  
  264  
  265  * Equations for Extrinsic Capacitances:
  266  * ------------------------------------
  267  
  268  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  269  
  270  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  271  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  272  
  273  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  274  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  275  
  276  
  277  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  278  
  279  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  280  
  281  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
  282  
  283  .PARAM CGSL = '(7.3597E-11)*(2.3926E-09/TOX)'
  284  .PARAM CGDL = '(7.3597E-11)*(2.3926E-09/TOX)'
  285  .PARAM CGSO       =  '1E-10*(2.3926E-09/TOX)'
  286  .PARAM CGDO       =  '1E-10*(2.3926E-09/TOX)'
  287  
  288  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  289  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  290  
  291  
  292  
  293  * Equations for extrinsic S/D resistances:
  294  * ---------------------------------------
  295  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*70*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(0*CONPO*NFING/WM)'
  296  
  297  
