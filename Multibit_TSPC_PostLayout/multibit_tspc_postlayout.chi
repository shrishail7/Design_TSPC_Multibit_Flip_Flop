  162  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  163  *  Effective Source/Drain Junction width:
  164  *---------------------------------------
  165  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  166  
  167  
  168  * Model improvement equations :
  169  *------------------------------
  170  
  171  * Equations for mismatch deviations:
  172  *-----------------------------------
  173  .PARAM DVTH0_ALPHA = (3.3E-9)
  174  .PARAM DVTH0_BETA  = (0.0)
  175  .PARAM DVTH0_FUDGE  = (1.0)
  176  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
  177  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*HVTGP_DEV*MISMATCH}
  178  .PARAM DBETA_ALPHA = (0.76E-8)
  179  .PARAM DBETA_BETA  = (0.0)
  180  .PARAM DBETA_FUDGE  = (1.0)
  181  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
  182  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*HVTGP_DEV*MISMATCH}
  183  
  184  
  185  .PARAM PROCESSSTATFLAGS = '1.0'
  186  .PARAM DVTHTOT   = 'NHVTGP_DVTH0_CMOS065/(VALIF((NHVTGP_DVTH0_CMOS065==0),(1),(0))+SQRT((NHVTGP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NHVTGP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NHVTGP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  187  .PARAM VTH     = '0.39586+NHVTGP_DVTH0_CMOS065'
  188  
  189  
  190  * Equation for  AGIDL:
  191  * --------------------
  192  .PARAM AGIDL   = '(0.030701)*10^DAGIDL'
  193  
  194  
  195  * Equations for mobility :
  196  *-------------------------
  197  .PARAM EPSILON2 = 1E-18
  198  .PARAM LLIMIT = '8.522E-08-XL' 
  199  .PARAM WLIMIT = '6.88E-07-XW' 
  200  .PARAM DWU = 'DWU0+(-0.04)*0.5E6*(ABS(LE-1.7151E-06)-(LE-1.7151E-06))' 
  201  .PARAM MOBILITY = '2.0/(0.004851458661+(LLIMIT+XL
  202  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*-0.002414663047/LE)
  203  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  204  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  205  
  206  
  207  
  208  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NHVTGP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  209  
  210  
  211  * Channel doping nch and body factor k1 worst case :
  212  *---------------------------------------------------
  213  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  214  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  215  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(8.9277E+17/NI)+0.17968+0.4'
  216  .PARAM  K2        =  '(0.0062662+-4.5964E-09/LE)*(TOX/1.88E-09)'
  217  .PARAM  K1        =  '(0.33572)-MOSTYPE*(0.39586-VTH)/SQRT(PHIS_TYP)'
  218  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  219  .PARAM  NCH       =  '8.9277E+17*(K1*K1)/((0.33572)*(0.33572))'
  220  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.17968+0.4'
  221  * Series resistance worst case :
  222  *-------------------------------
  223  .PARAM RDSW      =  '(340+-2.1E-05/LE+7.4971E-13/(LE*WE))*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NHVTGP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  224  .PARAM PRWB      =  0
  225  
  226  
  227  
  228  
  229  
  230  
  231  .PARAM VSATEFF = '(1.938E+06+0.005/LE+0.003/WE)'
  232  
  233  * Equations for stress :
  234  *-----------------------
  235  
  236  .PARAM C_1	= 'CONW+COEACT2+CONPO'
  237  .PARAM C_2 	= C_1
  238  .PARAM B_1	= '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
  239  .PARAM B_2	= B_1 
  240  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  241  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  242  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  243  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  244  * Stress effect on threshold voltage :
  245  *-------------------------------------
  246  
  247  
  248  .PARAM VARMAXVTH0       = '((3.5E-16*NFING/WM+6.5294E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))-(1/LM -(-0.061381*NFING/WM +4.4092E+06)))+((7.9412E-17*NFING/WM+-2.7059E-10)/2)*(ABS(1/LM-(-0.061381*NFING/WM+4.4092E+06))+(1/LM -(-0.061381*NFING/WM+4.4092E+06)))+-4.2353E-10*NFING/WM+-0.0049765'
  249  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  250  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NHVTGP_DVTH0_CMOS065+DVTHTOT'
  251  * Stress effect on mobility :
  252  *----------------------------
  253  
  254  
  255  .PARAM VARMAXU0 	= '((0*NFING/WM+-3E-09)/2)*(ABS(1/LM-(0*NFING/WM+4E+06))-(1/LM -(0*NFING/WM+4E+06)))+((-5.2941E-16*NFING/WM+3E-09)/2)*(ABS(1/LM-(0*NFING/WM +4E+06))+(1/LM -(0*NFING/WM+4E+06)))+-1.7647E-09*NFING/WM+0.046765'
  256  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  257  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)'
  258  * Stress effect on body factor K1 :
  259  *----------------------------------
  260  .PARAM VARMAXK1         = '0.017+0/LM+-5E-09*NFING/WM'
  261  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  262  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  263  * Stress effect on DVT0 :
  264  *------------------------
  265  .PARAM DVT0_STRESS        = 34405
  266  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  267  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  268  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  269  * Stress effect on access resistance :
  270  *-------------------------------------
  271  .PARAM VARMAXRDSW       = '0+0*NFING/WM'
  272  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  273  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  274  
  275  
  276  .PARAM NFACTOR = '(1.0217+2.4286E-07/LE)*SQRT(PHIS*8.9277E+17/(PHIS_TYP*NCH))*(1.88E-09/TOX)'
  277  
  278  
  279  
  280  * Equations for VT :
  281  *-------------------
  282  .PARAM W0       = '1E-09+(0-XW)'
  283  .PARAM K3B      = '(3+-3.7E-07/LE)*(1.88E-09/TOX)'
  284  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  285  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*8.9277E+17*1E6))'
  286  .PARAM DVTP0    = 0
  287  
  288  
  289  .PARAM N_SUBVT  = '1.0+(1.0217+2.4286E-07/LE)*5.640000544E-09/XDEP0'
  290  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.6676E-06))'
  291  .PARAM TMP2     = '1.692E-09/(WE+W0)'
  292  .PARAM K3       = '(-6.5+3E-07/(LE*(LMIN+-7E-09-2*LINT)/(LMIN+XL-2*LINT)))*(1.88E-09/TOX)+VTH_RSCE/TMP2'
  293  
  294  
  295  
  296  * Equation for moin :
  297  *-------------------
  298  .PARAM MOIN = 'VALIF((6.1782*((0.33572)/K1EFF)^2 > 5), (6.1782*((0.33572)/K1EFF)^2), (5))'
  299  
  300  
  301  * Equations for LKETA :
  302  *---------------------
  303  
  304  
  305  .PARAM LKETA    = -0.003 
  306  
  307  
  308  *Worst case methodology improvement: Short Channel effect
  309  *--------------------------------------------------------
  310  .PARAM LPE0  = '((((0.33572)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(1.5439E-08+-9.28E-16/LE)/(LMIN+-7E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  311  .PARAM LPEB  = '(0)/(LMIN+-7E-09-2*LINT)*(LMIN+XL-2*LINT)'
  312  .PARAM DVT1  = '1.1958*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  313  .PARAM DVT1W = '1885.6*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  314  .PARAM DSUB = '(0.81511)*SQRT(TOX/1.88E-09)*SQRT(XDEP0/XDEP0_TYP)'
  315  
  316  
  317  
  318  * Equations for Extrinsic Capacitances:
  319  * ------------------------------------
  320  
  321  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-7.453E-19 + 1.2490E-10*(WM/NFING + XW))),(0.75*(-7.408E-19 + 1.476E-10*(WM/NFING + XW))))'
  322  
  323  .PARAM C3INT = '0.3*(-2.418E-18 + 2.653E-10*(LM + XL))'
  324  .PARAM C3EXT = '(9.681E-18 + 7.403E-11*(LM + XL))'
  325  
  326  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.237E-17 + 2.400E-18*TANH((LM + XL)/1.258E-07)),(1.474E-17 + 3.229E-18*TANH((LM + XL)/1.497E-07)))'
  327  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.458E-17 + 9.132E-19*TANH((WM/NFING + XW)/1.568E-06) + 1.875E-17*TANH((LM + XL)/5.032E-07)),(1.240E-17 + -2.833E-17*TANH((WM/NFING + XW)/1.635E-06) + 1.043E-17*TANH((LM + XL)/2.752E-07)))' 
  328  
  329  
  330  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-4.315E-19*(1-ALIGNMENT_PRELAYOUT) + 8.264E-11*(WM/NFING + XW) + 4.014E-11*(WM/NFING + XW)*TANH((LM + XL)/3.174E-07)) ,(4.263E-19*(1-ALIGNMENT_PRELAYOUT) + 2.618E-11*(WM/NFING + XW) + 1.895E-11*(WM/NFING + XW)*TANH((LM + XL)/2.508E-07)))'
  331  
  332  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  333  
  334  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
  335  
  336  .PARAM CGSL = '((1E-10) + 3E-19/LM  + 0/LM^2 + -1.1796E-17/WM*NFING + 0/WM^2*NFING^2)*(1.88E-09/TOX)' 
  337  .PARAM CGDL = '((1E-10) + 3E-19/LM  + 0/LM^2 + -1.1796E-17/WM*NFING + 0/WM^2*NFING^2)*(1.88E-09/TOX)' 
  338  .PARAM CGSO       =  'VALIF((POCOSM>0),(1E-13*(1.88E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.8098E-07)*(TANH(POCOSM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.88E-09/TOX))'
  339  .PARAM CGDO       =  'VALIF((POCOSM>0),(1E-13*(1.88E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.8098E-07)*(TANH(POCODM/9.9978E-08)-1))*1.7299E-10/WEC),1E-13*(1.88E-09/TOX))'
  340  
  341  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  342  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  343  
  344  
  345  
  346  * Equations for extrinsic S/D resistances:
  347  * ---------------------------------------
  348  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
  349   
  350  * Unsilicided poly gate resistance:
  351  * --------------------------------
  352  .PARAM RSHGUMMID = '(620+RSHGUM)/2 + (620-RSHGUM)*TANH(1E18*(2*2.2E-8-LM-XL))/2'
  353  .PARAM RSHGUMEFF = 'RSHGUMMID*620*(LM+XL)/(2*2.2E-8*RSHGUMMID + (LM+XL-2*2.2E-8)*620)'
  354  
  355  
  356  * Salicided poly gate resistance:
  357  * ------------------------------
  358  
  359   .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==0),(1-ALIGNMENT_PRELAYOUT),(0))'
  360  .PARAM GFLAG__RGATESWITCH__ALL__CMOS065__1__YES = 'VALIF((GFLAG__RGATESWITCH__ALL__CMOS065==1),(1-ALIGNMENT_PRELAYOUT),(0))'
  361  .PARAM RGATEMOD = GFLAG__RGATESWITCH__ALL__CMOS065__1__YES 
  362  .PARAM RGATE    = '(((RSHG*(WM/NFING+XW))/(3*NGCON**2*(LM+XL+9E-09)))+((4.13E-12+RSHGUMEFF*1E-07*(1E-07-2.5E-08))/((WM/NFING+XW)*(LM+XL))))/NFING'
  363  .PARAM RSHG0    = 'RGATE*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
  364  
  365  * Salicided Source/Drain diffusion access resistances:
  366  * ---------------------------------------------------
  367  .PARAM NRSEFF    = 'NRS'
  368  .PARAM NRDEFF    = 'NRD'
  369  
  370  
  371  
  372  * Equations for VOFF:
  373  * ------------------
  374  
  375  .PARAM VOFF = '-0.15313 + -0.075489*(TEMPK/(25+273.15) -1)' 
  376  
  377  
  378  
  379  * Equations for temperature dependance of BGIDL:
  380  * --------------------------------------------
  381  .PARAM BGIDL = '2.4657E+10 + -2.2027E+09*(TEMPK/(25+273.15) -1)'
  382  
  383  
  384  * Equations for temperature dependence of series resistances:
  385  * -----------------------------------------------------------
  386  .PARAM RDWMIN = 0
  387  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  388  .PARAM RSWMIN = 0
  389  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  390  .PARAM RDSWMIN = 0
  391  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  392  .PARAM RSW = 0
  393  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  394  .PARAM RDW = 0
  395  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + -61.497*(TEMPK/(25+273.15) -1)), (0))'
  396  .PARAM RDSWEFF2 = '(RDSWEFF + -61.497*(TEMPK/(25+273.15) -1))'
  397  .PARAM PRT = 0
  398  
  399  
  400  * Equations for thermal noise scaling
  401  * ------------------------------------
  402  .PARAM NTNOI = '1*LE/LEC'
  403  
  404  
  405  
  406  
  407  
  408   
  409  .PARAM WPEMOD   = 1
  410  .PARAM KVTH0WE  = (4.309778E-03+-5.43624E-11/LE+-4.406305E-10/WE)
  411  .PARAM K2WE     = (1.015452E-03+-6.486544E-13/LE+5.178106E-11/WE)
  412  .PARAM SCREF    = 1E-06
  413  .PARAM KU0WE    = (-4.847566E-03+-2.616231E-10/LE+5.968712E-11/WE)
  414  .PARAM WEB      = -350
  415  .PARAM WEC2      = -3000
  416  
  417  
  418  M1 D G S B NHVTGP W='WM/NFING' L=LM AS='ASM/NFING' AD='ADM/NFING' PS='PSM/NFING' PD='PDM/NFING'
  419  +          M='MULT*NFING' NRD='NRDEFF*NFING' NRS='NRSEFF*NFING' NF=1 SCA='SCAM' SCB='SCBM' SCC='SCCM' 
  420  
  421  
  422  .MODEL NHVTGP NMOS
  423  + LEVEL=60
  424  + VERSION=4.5           BINUNIT=1             PARAMCHK=0            
  425  + TNOM=25               TOXE=TOX              TOXP=TOX              
  426  + TOXM=TOX              DTOX=0                EPSROX=3.9            
  427  + XW=XW                 XL=XL                 WINT=-6E-09           
  428  + LINT=-3.1E-08         DLC=1E-08             DWC=-1.8E-08          
  429  + DWJ=-1.2837E-08       DWG=2.4258E-09        DWB=3.5632E-09        
  430  + WL=0                  WLN=1                 WW=0                  
  431  + WWN=1                 WWL=0                 LL=0                  
  432  + LLN=1                 LW=0                  LWN=1                 
  433  + LWL=0                 LLC=0                 LWC=0                 
  434  + LWLC=0                WLC=0                 WWC=0                 
  435  + WWLC=0                LMIN='6E-8'           LMAX=1.8E-07          
  436  + WMIN='1.2E-7'         WMAX=0.001            XJ=5E-08              
  437  + NGATE=5.4944E+20      NSD=1E+20             NDEP=NCH              
  438  + VTH0=VTH0EFF          K1=K1EFF              K2=K2                 
  439  + LK2=0                 PHIN=0.17968          K3=K3                 
  440  + LK3=0                 K3B=K3B               LK3B=0                
  441  + W0=W0                 LPE0=LPE0             LLPE0=0               
  442  + LPEB=LPEB             DVT0=DVT0EFF          DVT1=DVT1             
  443  + DVT2=0.14203          DVTP0=DVTP0           DVTP1=0               
  444  + DVT0W=1.8465E-05      DVT1W=DVT1W           DVT2W=-0.2            
  445  + ETA0=1E-05            LETA0=4.7             WETA0=-3              
  446  + ETAB=-11              WETAB=0.4             DSUB=DSUB             
  447  + VOFF=VOFF             PVOFF=0.0003          VOFFL=-8.1847E-09     
  448  + MINV=-0.36375         LMINV=-0.048348       NFACTOR=NFACTOR       
  449  + LNFACTOR=0            CIT=0                 CDSC=2                
  450  + WCDSC=-1              CDSCB=1               WCDSCB=-0.4           
  451  + CDSCD=0.15            MOBMOD=2              U0=U0EFF              
  452  + UA=4.6517E-17         LUA=-6.6148E-18       PUA=8.3147E-20        
  453  + UC=-2.0853E-17        UD=0                  UP=0                  
  454  + EU=1.8025             RDSMOD=0              RDSW=RDSWEFF2         
  455  + LRDSW=0               PRDSW=0               RDSWMIN=0             
  456  + PRWG=0                PRWB=PRWB             WR=1                  
  457  + RSH=RSH               VSAT=VSATEFF          LVSAT=0               
  458  + WVSAT=0               A0=4.67               A1=-0.052355          
  459  + A2=0.075533           AGS=1.1105            LAGS=-0.13            
  460  + B0=-2.8346E-08        B1=0                  KETA=0.02             
  461  + LKETA=LKETA           PCLM=0.5909           PDIBLC1=1.0809E-18    
  462  + PDIBLC2=1.001E-18     PDIBLCB=0             DROUT=349.22          
  463  + PSCBE1=8E+18          PSCBE2=1E-15          PVAG=17.553           
  464  + DELTA=0.033           FPROUT=0              PDITS=4.9768          
  465  + PDITSL=2.3094E+08     PDITSD=0.020319       ALPHA0=4.788E-13      
  466  + ALPHA1=-1.3274E-06    BETA0=4.6585          LBETA0=-0.44007       
  467  + AGIDL='DIODEMOD*AGIDL' BGIDL=BGIDL           CGIDL=0.5             
