   16  *------------------------------------------------------------------------------
   17  * flag used to switch on/off device access modeling (for post layout simulation)
   18  *------------------------------------------------------------------------------
   19  *   lpe     Body      Access_R  Access_C   Extraction_mode
   20  *    0       yes        yes       yes           --
   21  *    1       yes        yes       no             C
   22  *    2       yes        no        yes            R
   23  *    3       yes        no        no             RC
   24  *
   25  .PARAM LPER = 'VALIF(((LPE==2) || (LPE==3)),(1),(0))'
   26  .PARAM LPEC = 'VALIF(((LPE==1) || (LPE==3) || (LPE==97)),(1),(0))'
   27  .PARAM ALIGNMENT_PRELAYOUT  = 'VALIF(((LPE==99) || (LPE==98)),(1),(0))'
   28  .PARAM ALIGNMENT_POSTLAYOUT = 'VALIF((LPE==98),(1),(0))'
   29  .PARAM LPEC2 = 'VALIF(((LPE==1) || (LPE==3)),(1),(0))'
   30  
   31  
   32  *-----------------------------------------------------------------------------------------------------
   33  * flag used to switch on/off Source and Drain diffusion access resistances (for post layout simulation) 
   34  *-----------------------------------------------------------------------------------------------------
   35  .PARAM NRSD_FLAG = 'VALIF(((NRS==0) && (NRD==0)),(0),(1))'
   36  
   37  
   38  
   39  *--------------------------------------------------------
   40  * flag used to switch on/off mismatch into process corners
   41  *--------------------------------------------------------
   42  * svtgp_dev  no_mm  mc_mm  mm_in_corners  param_mm
   43  *       0       yes    no     no             no
   44  *       1       no     yes    no             no
   45  *       2       no     no     yes            no
   46  *       3       no     no     no             yes
   47  *
   48  .PARAM MFLAG_NO        = 'VALIF((SVTGP_DEV==0),(1),(0))'
   49  .PARAM MFLAG_MC        = 'VALIF((SVTGP_DEV==1),(1),(0))'
   50  .PARAM MFLAG_CORNER    = 'VALIF((SVTGP_DEV==2),(1),(0))'
   51  .PARAM MFLAG_PARAM     = 'VALIF((SVTGP_DEV==3),(1),(0))'
   52  .PARAM MFLAG_ALIGNMENT = 'VALIF((MISMATCH_CROLLES==0),(1),(0))'
   53  
   54  
   55  
   56  * Device temperature:
   57  *--------------------
   58  .PARAM TEMPK   = 'TEMPER+273.15'
   59  
   60  
   61  * invariant parameters:
   62  *----------------------
   63  .PARAM MOSTYPE = 1  
   64  
   65  .PARAM CONW    = '0.09E-6'
   66  .PARAM CONS    = '0.11E-6'
   67  .PARAM COEACT1  = '0.015E-6'
   68  .PARAM COEACT2  = '0.03E-6'
   69  .PARAM CONPO   = '0.055E-6'
   70  .PARAM PO2DB   = '0.100E-6'
   71  .PARAM LINT    = -3.1E-08
   72  .PARAM DLC     = 9.5E-09
   73  .PARAM LMIN    = 6E-8
   74  .PARAM DWU0    = 0.015
   75  .PARAM WINT    = -6E-09
   76  .PARAM DWC     = -1.3E-08
   77  .PARAM DWJ     = -1.2837E-08
   78  .PARAM COEPO   = '0.01E-6'
   79  
   80  .PARAM DIODEMOD = 1
