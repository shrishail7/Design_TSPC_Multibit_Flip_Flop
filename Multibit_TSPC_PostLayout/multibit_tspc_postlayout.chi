 1806  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
 1807  .PARAM FS='2-FD'
 1808  .PARAM EDUM='EDU*TOMETER'
 1809  .PARAM ESUM='ESU*TOMETER'
 1810  .PARAM ADP='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(CONW/2.0+COEACT2+XW/2))'
 1811  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
 1812  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
 1813  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
 1814  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 1815  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
