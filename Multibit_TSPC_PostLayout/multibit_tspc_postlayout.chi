 5103  
 5104  
 5105  * Model improvement equations :
 5106  *------------------------------
 5107  
 5108   
 5109  * Continuous Model for mismatch deviations:
 5110  *----------------------------------------
 5111  .PARAM DVTH0_SIG = '(3.3E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT(WM*(LM+XL)))/SQRT(2.0*MULT)'
 5112  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*LVTLP_DEV*MISMATCH}
 5113  .PARAM DBETA_SIG = '(0.45E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT(WM*(LM+XL)))/SQRT(2.0*MULT)'
 5114  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*LVTLP_DEV*MISMATCH}
 5115  .PARAM PROCESSSTATFLAGS = '1.0'
 5116  .PARAM DVTHTOT   = 'MOSTYPE*DVTHFACT*PLVTLP_DVTH0_CMOS065/(VALIF((PLVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((DVTHFACT*PLVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PLVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(DVTHFACT*PLVTLP_DVTH0_CMOS065)^2)+DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS+DVTH0_DEV*MFLAG_MC'
 5117  .PARAM DVTH    = 'MOSTYPE*DVTHFACT*PLVTLP_DVTH0_CMOS065'
 5118  
 5119  
 5120  
 5121  * Selection of the WPE model parameter values depending on the netlist extraction:
 5122  * -------------------------------------------------------------------------------
 5123  .PARAM WPEMOD    = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1),(1))'
 5124  .PARAM KVTH0WE   = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((-0.01231+5.008E-10/LE+8.4E-09/WE+-4.28E-16/(LE*WE))),((-7.404359E-3+1.827268E-10/LE+9.28666E-11/WE)))'
 5125  .PARAM K2WE      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0+0.0/LE+0.0/WE+0.0/(LE*WE))),((2.958218E-3+-1.77185E-11/LE+-1.628225E-10/WE)))'
 5126  .PARAM SCREF     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(1E-06),(1E-06))'
 5127  .PARAM KU0WE     = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),((0.0006944+2.142E-11/LE+-4.813E-10/WE+9.529E-18/(LE*WE))),((5.267004E-3+-1.502153E-10/LE+-2.96138E-09/WE)))'
 5128  .PARAM WEB       = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-400.0))'
 5129  .PARAM WEC2      = 'VALIF(((SCB==-1 || SCC==-1) && (SC==-1) && (SCA>-1)),(0),(-3000.0))'
 5130  .PARAM DVTH0_WPE = 'MOSTYPE*WPEMOD*KVTH0WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
 5131  .PARAM DK2_WPE   = 'WPEMOD*K2WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
 5132  .PARAM DU0_WPE   = 'WPEMOD*KU0WE*(SCAM+WEB*SCBM+WEC2*SCCM)'
 5133  
 5134  
 5135  
 5136  * Equations for stress :
 5137  *-----------------------
 5138  
 5139  .PARAM C_1       = 'CONW+COEACT2+CONPO'
 5140  .PARAM C_2       = C_1
 5141  .PARAM B_1       = '2*CONPO+(NCRSD-1)*(CONW+CONS)+CONW'
 5142  .PARAM B_2       = B_1 
 5143  .PARAM CEFF      = '2/(1/C_1+1/C_2)'
 5144  .PARAM BEFF      = '2/(1/B_1+1/B_2)'
 5145  .PARAM PO2ACTEFFM = 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
 5146  .PARAM PO2ACTCALM = 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
 5147  * Stress effect on threshold voltage :
 5148  *-------------------------------------
 5149  
 5150  
 5151  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1E+12))+(1/LM -(0*NFING/WM+1E+12)))+1.2173E-09*NFING/WM+-0.0010491'
 5152  .PARAM DVTH0_MECHSTRESS = 'MOSTYPE*VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)-MOSTYPE*DVTHFACT*PLVTLP_DVTH0_CMOS065+DVTHTOT'
 5153  * Stress effect on mobility :
 5154  *----------------------------
 5155  
 5156  
 5157  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-9.7441E-09)/2)*(ABS(1/LM-(-0.088*NFING/WM+3.1087E+06))-(1/LM -(-0.088*NFING/WM+3.1087E+06)))+((-2.2734E-16*NFING/WM+1.4902E-10)/2)*(ABS(1/LM-(0.1532*NFING/WM +4.1101E+06))+(1/LM -(0.1532*NFING/WM+4.1101E+06)))+4.41E-10*NFING/WM+0.018161'
 5158  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 5159  * Stress effect on body factor K1 :
 5160  *----------------------------------
 5161  .PARAM VARMAXK1         = '0.00273+5.49E-10/LM+-7E-09*NFING/WM'
 5162  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 5163  * Stress effect on DVT0 :
 5164  *------------------------
 5165  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
 5166  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
 5167  * Stress effect on access resistance :
 5168  *-------------------------------------
 5169  .PARAM VARMAXRDSW       = '0.103+-8.11E-09*NFING/WM'
 5170  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)' 
 5171  
 5172  
 5173  * Equations for mobility :
 5174  *-------------------------
 5175  .PARAM MOBILITY = '0.0147651*(1+DU0_WPE)*(1+DU0_MECHSTRESS)'
 5176  
 5177  
 5178  
 5179  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PLVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 5180  
 5181  
 5182  * Channel doping nch and body factor k1 worst case :
 5183  *---------------------------------------------------
 5184  .PARAM LE_TYP   = 'LE'
 5185  .PARAM WE_TYP   = 'WE'
 5186  .PARAM SCE_TERM = '1-0.0633248*(1E-6/LE_TYP)--0.00101452*(1E-6/LE_TYP)**2'
 5187  .PARAM NSUBOTYP = '8.82152E+22*MAX((1+-0.0700212*1E-6/WE_TYP*LOG(1+WE_TYP/1.17493E-07)),1E-3)'
 5188  .PARAM NSUBOEFF = '8.82152E+22*MAX((1+-0.0700212*1E-6/WE*LOG(1+WE/1.17493E-07)),1E-3)'
 5189  .PARAM NPCKTYP  = '4.39298E+23*MAX((1+0*1E-6/WE_TYP*LOG(1+WE_TYP/3.50454E-09)),1E-3)'
 5190  .PARAM NPCKEFF  = '4.39298E+23*MAX((1+0*1E-6/WE*LOG(1+WE/3.50454E-09)),1E-3)'
 5191  .PARAM LPCKTYP  = '7.09774E-09*MAX((1+0*1E-6/WE_TYP*LOG(1+WE_TYP/3.50454E-09)),1E-3)'
 5192  .PARAM LPCKEFF  = '7.09774E-09*MAX((1+0*1E-6/WE*LOG(1+WE/3.50454E-09)),1E-3)'
 5193  .PARAM BOVA_TYP = '(SQRT(NSUBOTYP+0.5*NPCKTYP)-SQRT(NSUBOTYP))/7.5E10'
 5194  .PARAM BOVA     = '(SQRT(NSUBOEFF+0.5*NPCKEFF)-SQRT(NSUBOEFF))/7.5E10'
 5195  .PARAM NEFF_TYP = 'SCE_TERM*VALIF( LE_TYP<LPCKTYP, NSUBOTYP+NPCKTYP*(2-LE_TYP/LPCKTYP), (VALIF( LE_TYP<(2*LPCKTYP), NSUBOTYP+NPCKTYP*LPCKTYP/LE_TYP, (SQRT(NSUBOTYP)+7.5E10*LOG(1+2*LPCKTYP/LE_TYP*(EXP(BOVA_TYP)-1)))**2 )) )'
 5196  .PARAM NSUB     = 'VALIF( LE<LPCKEFF, NSUBOEFF+NPCKEFF*(2-LE/LPCKEFF), (VALIF( LE<(2*LPCKEFF), NSUBOEFF+NPCKEFF*LPCKEFF/LE, (SQRT(NSUBOEFF)+7.5E10*LOG(1+2*LPCKEFF/LE*(EXP(BOVA)-1)))**2 )) )'
 5197  .PARAM EGOVQ    = '1.179-9.025E-5*TEMPK-3.05E-7*TEMPK^2'
 5198  .PARAM PHIBFACT = '(1.045+4.5E-4*TEMPK)*(0.523+1.4E-3*TEMPK-1.48E-6*TEMPK^2)*(TEMPK/300)^2'
 5199  .PARAM PHIT_CL  = '1.3806505E-23*TEMPK/1.6021918E-19'
 5200  .PARAM PHIS0_CL = 'EGOVQ + 2*PHIT_CL*LOG(NEFF_TYP/(2.5E25*PHIBFACT^0.75))'
 5201  .PARAM GAMMA0_CL= 'SQRT(2*1.6021918E-19*1.045E-10*NEFF_TYP)/(3.453E-11/2.02728E-09)'
 5202  
 5203  .PARAM DPHIB    = '(0+0*(1E-6/LE_TYP)**1)*(1+0*(1E-6/WE_TYP))*(1+0*(1E-12/LE_TYP/WE_TYP))'
 5204  .PARAM DELTAQ   = '0.4*1*7.448711*(GAMMA0_CL*SQRT(PHIS0_CL+DPHIB)*3.453E-11/2.02728E-09)**(2.0/3.0)'
 5205  .PARAM PHIT     = 'PHIT_CL*(1+(0.75*DELTAQ+DPHIB)/PHIS0_CL)'
 5206  .PARAM PHIS0    = 'EGOVQ + 2*PHIT*LOG(NEFF_TYP/(2.5E25*PHIBFACT^0.75))'
 5207  .PARAM GAMMA0   = 'GAMMA0_CL*(1+DELTAQ/(GAMMA0_CL*SQRT(PHIS0_CL+DPHIB)))'
 5208  .PARAM A        = '2.0*PHIT*GAMMA0/SQRT(PHIS0) - 2.0*PHIT'
 5209  .PARAM C        = 'GAMMA0*SQRT(PHIS0) + 6.0*PHIT'
 5210  .PARAM NSUBO    = 'NSUB*( ((A-C)+SQRT((A+C)^2+4.0*A*(DVTH+0.21*DK1_MECHSTRESS*(SQRT(1+(1E-12+3.1E-15/LE)/LE)-1)*SQRT(PHIS0))))/2.0/A )^2'
 5211  .PARAM NPCK     = '0'
 5212  .PARAM LPCK     = '7.09774E-09'
 5213  
 5214  .PARAM DVFB     = '(1+-0.0159727*1E-6/LE)*(1+-0.00114105*1E-6/WE)*(1+0.00045*1E-12/(WE*LE))'
 5215  .PARAM VFBO     = '-0.832114+(DVTH0_WPE+DVTH0_MECHSTRESS)/DVFB'
 5216  .PARAM FTOX     = 'TOX/2.02728E-09'
 5217  * Series resistance worst case :
 5218  *-------------------------------
 5219  .PARAM RSW1      =  '82.9521*(1+DRDSW_MECHSTRESS)'
 5220  .PARAM RSW1EFF0  =  'RSW1*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PLVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 5221  
 5222  
 5223  * Equations for Extrinsic Capacitances:
 5224  * ------------------------------------
 5225  
 5226  .PARAM CFRW = '1.5623E-16/FTOX'
 5227  
 5228  
 5229  .PARAM LOV = '9.124E-09'
 5230  
 5231  
 5232  
 5233  * Equations for extrinsic S/D resistances:
 5234  * ---------------------------------------
 5235  .PARAM RSW1EFF    = 'RSW1EFF0 - LPER*RCONSD*WE*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12))'
 5236  
 5237  
 5238  
 5239  * Salicided poly gate resistance:
 5240  * ------------------------------
 5241  
 5242  .PARAM RGATEMOD = 0
 5243  .PARAM RSHG0    = 16.043
 5244  
 5245  * Salicided Source/Drain diffusion access resistances:
 5246  * ---------------------------------------------------
 5247  .PARAM NRSEFF    = 'NRS'
 5248  .PARAM NRDEFF    = 'NRD'
 5249  
 5250  
 5251  
 5252  * Equations for poly gate resistance:
 5253  * -----------------------------------
 5254  .PARAM XGW        = 1.0E-07
 5255  .PARAM XGL        = -3.376E-08
 5256  .PARAM TC1G       = 2.3E-03
 5257  .PARAM TC2G       = 0
 5258  .PARAM TC1GV      = 0
 5259  .PARAM TC2GV      = 0
 5260  .PARAM LHEAD      = 'MAX(NFING*CONW+(NFING-1)*CONS+2*COEPO,NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS)))'
 5261  .PARAM NCHEAD     = 'NCRG*(1+TRUNC(((LHEAD-CONW-2*COEPO)/(CONW+CONS))+1E-12))'
 5262  .PARAM RGCON      = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
 5263  .PARAM RSHGT      = 'MAX(1E-6,RSHG*(1+(TC1G+TC2G*(EFFTEMP-25))*(EFFTEMP-25)))'
 5264  .PARAM RSHGVT     = 'MAX(1E-6,RSHGV*(1+(TC1GV+TC2GV*(EFFTEMP-25))*(EFFTEMP-25)))'
 5265  .PARAM RGELTD     = 'RSHGT*(XGW+(WM/NFING+XW)/(3*NGCON))/(NGCON*(LM+XL-XGL)*NFING)+RSHGVT*1E-12/((LM+XL)*(WM/NFING+XW)*NFING)'
 5266  .PARAM RG         = '(RGELTD+RGCON)'
 5267  
 5268  * Equations for bulk resistance:
 5269  * ------------------------------
 5270  .PARAM RSTI       = '(RSTIR+RSTIL*WM/(12*NFING*(LM+XBL)))/NFING'
 5271  .PARAM RBSD       = '(RBSDR*1E-6)/(WM)'
 5272  .PARAM RBULKO     = 'RBGBL*1E-6/LM'
 5273  .PARAM RWELLO     = 'RSTI*NFING'
 5274  .PARAM RJUNSO     = 'RBSD*NFING/2'
 5275  .PARAM RJUNDO     = 'RBSD*NFING/2'
 5276  
 5277  * Equations for parasitic capacitances:
 5278  * -------------------------------------
 5279  .PARAM CGD_PLS    = '((NFING+FD)/2*CGXM0 + (NFING+FD)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FD*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 5280  .PARAM CGS_PLS    = '((NFING+FS)/2*CGXM0 + (NFING+FS)/2*NGCON*(CGXMW*LOG10(1+WFING/(XGW+COEPO))) + FS*NGCON*CGXMW2*WFING/2)/NFING/WEC'
 5281  .PARAM CDS_PLS    = '(CDSM1+CDSM1W*WFING)*NFING/(LM+2*CONPO)'
 5282  .PARAM CGDM	  = '(1-LPEC)*CGD_PLS*WEC*NFING '
 5283  .PARAM CGSM	  = '(1-LPEC)*CGS_PLS*WEC*NFING '
 5284  .PARAM CFLM       = 'CFLM0*LOG((1+0.5*(MIN(LM+XL,LMAXCF))/(CONPO-XL/2))/(1+0.5*(LMIN+XL)/(CONPO-XL/2)))'
 5285  .PARAM CFWM       = 'CFWM0*NGCON/WEC'
 5286  .PARAM CDSM       = 'CDSM0*(LMIN+2.0*CDSML)/(LM+2.0*CDSML)*(WM/NFING)*NFING+(1-LPEC)*CDS_PLS'
 5287  .PARAM CBDM       = 'CBXM0*(WM/NFING)*FD'
 5288  .PARAM CBSM       = 'CBXM0*(WM/NFING)*FS'
 5289  
 5290  
 5291  
 5292  * Equations for Flicker Noise Local Variations
 5293  * --------------------------------------------
 5294  
 5295  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
 5296  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
 5297  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
 5298  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
 5299  .PARAM NOIA    = '((TANH((LE-5E-07)*8E+05))*(6.59223E+25)/2+3.26568E+25)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 5300  .PARAM NOIB    = '0*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 5301  .PARAM NOIC    = '4.806E-08*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.000E-01*1.000E-01+1.300E-07*1.300E-07/(WM*LM*MULT))*DNOISE_MDEV)'
