  704  * Layout and electrical dimensions:
  705  *----------------------------------
  706  .PARAM WM='W*TOMETER'
  707  .PARAM LM='L*TOMETER'
  708  .PARAM WFING='WM/NFING+XW'
  709  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
  710  .PARAM FS='2-FD'
  711  .PARAM EDUM='EDU*TOMETER'
  712  .PARAM ESUM='ESU*TOMETER'
  713  .PARAM ADP='WFING*((NFING-FD)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(CONW/2.0+COEACT2+XW/2))'
  714  .PARAM ASP='WFING*((NFING-FS)*(NCRSD-1)*(CONW+CONS)/2+NFING*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(CONW/2.0+COEACT2+XW/2))'
  715  .PARAM PDP='(NFING-FD)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*EDUM-XL)/2+FD*(WFING+CONW+2*COEACT2+XW)'
  716  .PARAM PSP='(NFING-FS)/2*(NCRSD-1)*(CONW+CONS)+NFING*2*(CONW+2.0*CONRPO+2.0*ESUM-XL)/2+FS*(WFING+CONW+2*COEACT2+XW)'
  717  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
  718  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
  719  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
  720  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
  721  .PARAM POCOSM	= 'POCOS*TOMETER'
  722  .PARAM POCODM	= 'POCOD*TOMETER'
  723  .PARAM SCM ='VALIF(SC >=0, SC*TOMETER,0)'
  724  .PARAM SCAM='VALIF(SCA>=0, SCA,VALIF(SCM>0,((1E-06*1E-06/(WM/NFING))*(1.0/(SCM+1E-12)-1.0/(SCM+(WM/NFING)))),0))'
  725  .PARAM SCBM='VALIF(SCB>=0, SCB,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  726  + 1E-06/10.0*SCM*EXP(-10.0*SCM/1E-06)
  727  + +1E-06*1E-06/100.0*EXP(-10.0*SCM/1E-06)
  728  + -1E-06/10.0*(SCM+(WM/NFING))*EXP(-10*(SCM+(WM/NFING))/1E-06)
  729  + -1E-06*1E-06/100.0*EXP(-10.0*(SCM+(WM/NFING))/1E-06)),0))'
  730  .PARAM SCCM='VALIF(SCC>=0, SCC,VALIF(SCM>0,1.0/((WM/NFING)*1E-06)*(
  731  + 1E-06/20.0*SCM*EXP(-20.0*SCM/1E-06)
  732  + +1E-06*1E-06/400.0*EXP(-20.0*SCM/1E-06)
  733  + -1E-06/20.0*(SCM+(WM/NFING))*EXP(-20*(SCM+(WM/NFING))/1E-06)
  734  + -1E-06*1E-06/400.0*EXP(-20.0*(SCM+(WM/NFING))/1E-06)),0))'
  735  
  736  * DC Effective length and width:
  737  *---------------------------
  738  .PARAM WE      = 'WM/NFING+XW-2*WINT-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  739  .PARAM LE      = 'LM+XL-2.0*LINT-2.0*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  740  * AC Effective length and width:
  741  *------------------------------
  742  .PARAM WEC     = 'WM/NFING+XW-2*DWC-2*(0/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  743  .PARAM LEC     = 'LM+XL-2.0*DLC-2.0*(2.2556E-16/(LM^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/(LM^1))'
  744  *  Effective Source/Drain Junction width:
  745  *---------------------------------------
  746  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
  747  
  748  
  749  * Model improvement equations :
  750  *------------------------------
  751  
  752   
  753      * Continuous Model for mismatch deviations 
  754  *----------------------------------------
  755  .PARAM X_DEV        = 0.0 DEVX/GAUSS = {1.0}
  756  .PARAM Y_DEV        = 0.0 DEVX/GAUSS = {1.0}
  757  .PARAM Z_DEV        = 0.0 DEVX/GAUSS = {1.0}
  758  .PARAM DVTH_AVT        = '4.5E-09*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
  759  .PARAM DBETA_ABETA     = '0.81E-08*(1+0/((LM+XL)*(LM+XL)))/SQRT((WM+NFING*XW)*(LM+XL))/SQRT(2.0*MULT)'
  760  
  761  
  762  .PARAM PVT          = 4.9E-06      
  763  .PARAM TPVT         = -0.014E-06     
  764  .PARAM ZETAVT       = 0.37E+12
  765  .PARAM DVTH_PVT    = '(PVT+TPVT*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETAVT*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
  766  .PARAM DVTH0_SIG = 'SQRT(DVTH_PVT*DVTH_PVT+DVTH_AVT*DVTH_AVT)'
  767  .PARAM DVTH0_DEV = '(DVTH_AVT*X_DEV+DVTH_PVT*Y_DEV)*SVTLP_DEV*MISMATCH'
  768  
  769  
  770  .PARAM PBETA        = 0.77E-05    
  771  .PARAM TPBETA       = -0.0062E-05   
  772  .PARAM ZETABETA     = 9.4E+10
  773  .PARAM DBETA_PBETA = '(PBETA+TPBETA*(TEMPER-25))/SQRT((WM+NFING*XW)*(1+ZETABETA*(LM+XL)*(LM+XL)))/SQRT(2.0*MULT)'
  774  .PARAM DBETA_SIG = 'SQRT(DBETA_PBETA*DBETA_PBETA+DBETA_ABETA*DBETA_ABETA)'
  775  .PARAM DBETA_DEV = '(DBETA_ABETA*Z_DEV+DBETA_PBETA*Y_DEV)*SVTLP_DEV*MISMATCH'
  776  
  777  .PARAM PROCESSSTATFLAGS = '1.0'
  778  .PARAM DVTHTOT   = 'NSVTLP_DVTH0_CMOS065/(VALIF((NSVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((NSVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*NSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(NSVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
  779  .PARAM VTH     = '0.42333+NSVTLP_DVTH0_CMOS065'
  780  
  781  
  782  * Equation for  AGIDL:
  783  * --------------------
  784  .PARAM AGIDL   = '(4.1681E-05)*10^DAGIDL'
  785  
  786  
  787  * Equations for mobility :
  788  *-------------------------
  789  .PARAM EPSILON2 = 1E-18
  790  .PARAM LLIMIT = '7.96E-07-XL' 
  791  .PARAM WLIMIT = '3.75096E-07-XW' 
  792  .PARAM DWU = 'DWU0+(-0.5)*0.5E6*(ABS(LE-1.3E-07)-(LE-1.3E-07))' 
  793  .PARAM MOBILITY = '2.0/(0.004525008559+(LLIMIT+XL
  794  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.0002557917469/LE)
  795  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
  796  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
  797  
  798  
  799  
  800  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*NSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
  801  
  802  
  803  * Channel doping nch and body factor k1 worst case :
  804  *---------------------------------------------------
  805  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  806  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  807  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(7.863E+17/NI)+0.25043+0.4'
  808  .PARAM  K2        =  '(-0.016255+-6.219E-09/LE)*(TOX/2.3926E-09)'
  809  .PARAM  K1        =  '(0.35383)-MOSTYPE*(0.42333-VTH)/SQRT(PHIS_TYP)'
  810  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
  811  .PARAM  NCH       =  '7.863E+17*(K1*K1)/((0.35383)*(0.35383))'
  812  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.25043+0.4'
  813  * Series resistance worst case :
  814  *-------------------------------
  815  .PARAM RDSW      =  '(195.87)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*NSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
  816  .PARAM PRWB      =  0
  817  
  818  
  819  
  820  
  821  
  822  
  823  * Equations for Poly spacing effect:
  824  *-----------------------------------
  825  .PARAM SPODEFM  = '0.2E-6'
  826  .PARAM SPOAM    = 'VALIF((SPOA > 0),(SPOA*TOMETER),(SPODEFM))'
  827  .PARAM SPOBM    = 'VALIF((SPOB > 0),(SPOB*TOMETER),(SPODEFM))'
  828  .PARAM SPOM     = '2/(1/(MIN(SPOAM,SPOBM)-5E-09)+1/(MIN(SPOAM,SPOBM)-5E-09))'
  829  .PARAM DVT_SPO_LR = '1.000*((5.361E-8/(SPOM))**4.8125-(5.361E-8/(0.2E-6-5E-09))**4.8125)'
  830  .PARAM DVT_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DVT_SPO_LR/0.42333*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DVT_SPO_LR'
  831  .PARAM DU0_SPO_LR = '-1.000*((2.9899E-8/(SPOM))**1.859-(2.9899E-8/(0.2E-6-5E-09))**1.859)'
  832  .PARAM DU0_SPO = '(0.06E-6+5E-09)/(LM+5E-09)/(1+DU0_SPO_LR*(1-(0.06E-6+5E-09)/(LM+5E-09)))*DU0_SPO_LR'
  833  .PARAM VSATEFF = '(1.7862E+05)*(1+DU0_SPO)'
  834  
  835  
  836  * Equations for stress :
  837  *-----------------------
  838  
  839  .PARAM FLAGNFING	= 'TRUNC(NFING/2)-TRUNC((NFING-1)/2)'
  840  .PARAM C_1	= 'CONW+COEACT2+CONRPO+(1-SRCEFIRST)*EDUM+SRCEFIRST*ESUM'
  841  .PARAM C_2	= 'VALIF((FLAGNFING > 0),(C_1),(CONW+COEACT2+CONRPO+(1-SRCEFIRST)*ESUM+SRCEFIRST*EDUM))'
  842  .PARAM B_1	= '2*(CONRPO+EDUM)+(NCRSD-1)*(CONW+CONS)+CONW'
  843  .PARAM B_2	= '2*(CONRPO+ESUM)+(NCRSD-1)*(CONW+CONS)+CONW' 
  844  .PARAM CEFF	= '2/(1/C_1+1/C_2)'
  845  .PARAM BEFF	= '2/(1/B_1+1/B_2)'
  846  .PARAM PO2ACTEFFM	= 'CEFF*(1+(NFING-1)/(1+2.5*CEFF/(BEFF+LM)))'
  847  .PARAM PO2ACTCALM	= 'VALIF((PO2ACT > 0),(PO2ACT*TOMETER),(PO2ACTEFFM))'
  848  * Stress effect on threshold voltage :
  849  *-------------------------------------
  850  
  851  
  852  .PARAM VARMAXVTH0       = '((0*NFING/WM+0)/2)*(ABS(1/LM-(0*NFING/WM+1))-(1/LM -(0*NFING/WM +1)))+((-5.6224E-16*NFING/WM+2.2724E-09)/2)*(ABS(1/LM-(0*NFING/WM+7E+06))+(1/LM -(0*NFING/WM+7E+06)))+3.5294E-10*NFING/WM+-0.0040207'
  853  .PARAM DVTH0_MECHSTRESS = 'VARMAXVTH0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  854  .PARAM  VTH0EFF   =  'VTH0+DVTH0_MECHSTRESS-NSVTLP_DVTH0_CMOS065+DVTHTOT+DVT_SPO'
  855  * Stress effect on mobility :
  856  *----------------------------
  857  
  858  
  859  .PARAM VARMAXU0 	= '((4.153E-16*NFING/WM+-2.1056E-08)/2)*(ABS(1/LM-(-0.08785*NFING/WM+3.8298E+06))-(1/LM -(-0.08785*NFING/WM+3.8298E+06)))+((-5.9944E-15*NFING/WM+2.1544E-08)/2)*(ABS(1/LM-(0.1532*NFING/WM +9E+06))+(1/LM -(0.1532*NFING/WM+9E+06)))+-3E-09*NFING/WM+0.07397'
  860  .PARAM DU0_MECHSTRESS   = 'VARMAXU0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  861  .PARAM U0EFF            = 'U0*(1+DU0_MECHSTRESS)*(1+DU0_SPO)'
  862  * Stress effect on body factor K1 :
  863  *----------------------------------
  864  .PARAM VARMAXK1         = '-0.04+0/LM+1E-08*NFING/WM'
  865  .PARAM DK1_MECHSTRESS   = 'VARMAXK1*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  866  .PARAM K1EFF            = 'K1*(1+DK1_MECHSTRESS)'
  867  * Stress effect on DVT0 :
  868  *------------------------
  869  .PARAM DVT0_STRESS        = -0.065
  870  .PARAM VARMAXDVT0         = '0+0*NFING/WM'
  871  .PARAM DDVT0_MECHSTRESS   = 'VARMAXDVT0*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  872  .PARAM DVT0EFF            = 'DVT0_STRESS*(1+DDVT0_MECHSTRESS)'
  873  * Stress effect on access resistance :
  874  *-------------------------------------
  875  .PARAM VARMAXRDSW       = '0.15+-5.67E-08*NFING/WM'
  876  .PARAM DRDSW_MECHSTRESS = 'VARMAXRDSW*(PO2ACTCALM-(4.05E-07))/(PO2ACTCALM)'
  877  .PARAM RDSWEFF0          = 'RDSW*(1+DRDSW_MECHSTRESS)' 
  878  
  879  
  880  .PARAM NFACTOR = '(1.183+1.3488E-07/LE)*SQRT(PHIS*7.863E+17/(PHIS_TYP*NCH))*(2.3926E-09/TOX)'
  881  
  882  
  883  
  884  * Equations for VT :
  885  *-------------------
  886  .PARAM W0       = '2.2957E-08+(0-XW)'
  887  .PARAM K3B      = '(3+-1.7E-07/LE)*(2.3926E-09/TOX)'
  888  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
  889  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*7.863E+17*1E6))'
  890  .PARAM DVTP0    = 0
  891  
  892  
  893  .PARAM N_SUBVT  = '1.0+(1.183+1.3488E-07/LE)*7.177800693E-09/XDEP0'
  894  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+1.4293E-06))'
  895  .PARAM TMP2     = '2.15334E-09/(WE+W0)'
  896  .PARAM K3       = '(-5.8321)*(2.3926E-09/TOX)+VTH_RSCE/TMP2'
  897  
  898  
  899  
  900  * Equation for moin :
  901  *-------------------
  902  .PARAM MOIN = 'VALIF((5.8569*((0.35383)/K1EFF)^2 > 5), (5.8569*((0.35383)/K1EFF)^2), (5))'
  903  
  904  
  905  * Equations for LKETA :
  906  *---------------------
  907  
  908  
  909  .PARAM LKETA    = 0.001 
  910  
  911  
  912  *Worst case methodology improvement: Short Channel effect
  913  *--------------------------------------------------------
  914  .PARAM LPE0  = '((((0.35383)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(3E-13+1.16E-14/LE)/(LMIN+5E-09-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
  915  .PARAM LPEB  = '(1.2424E-07)/(LMIN+5E-09-2*LINT)*(LMIN+XL-2*LINT)'
  916  .PARAM DVT1  = '0.032*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)' 
  917  .PARAM DVT1W = '8.4182E+05*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  918  .PARAM DSUB = '(0.024314)*SQRT(TOX/2.3926E-09)*SQRT(XDEP0/XDEP0_TYP)'
  919  
  920  
  921  
  922  * Equations for Extrinsic Capacitances:
  923  * ------------------------------------
  924  
  925  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
  926  
  927  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
  928  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
  929  
  930  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
  931  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
  932  
  933  
  934  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
  935  
  936  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
  937  
  938  .PARAM CF = 'VALIF((POCOSM>0),((LPEC2*C4/WEC) + (1-LPEC2)*((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC)), ((C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1+DCFRING)/WEC))'  
  939  
  940  .PARAM CGSL = '((4.2E-11) + 7E-18/LM  + -3.3E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
  941  .PARAM CGDL = '((4.2E-11) + 7E-18/LM  + -3.3E-25/LM^2 + -5E-18/WM*NFING + 0/WM^2*NFING^2)*(2.3926E-09/TOX)' 
  942  .PARAM CGSO       =  'VALIF((POCOSM>0),(3.3E-11*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOS*1.5841E-07)*(TANH(POCOSM/9.7820E-08)-1))*1.2646E-10/WEC),3.3E-11*(2.3926E-09/TOX))'
  943  .PARAM CGDO       =  'VALIF((POCOSM>0),(3.3E-11*(2.3926E-09/TOX) + LPEC2*((WM/NFING)+(NUMCOD*1.5841E-07)*(TANH(POCODM/9.7820E-08)-1))*1.2646E-10/WEC),3.3E-11*(2.3926E-09/TOX))'
  944  
  945  .PARAM CJSWGS2    =  'CJSWGS*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  946  .PARAM CJSWGD2    =  'CJSWGD*(WM/NFING+XW-2*WINT)/(WM/NFING+XW-2*DWC)'
  947  
  948  
  949  
  950  * Equations for extrinsic S/D resistances:
  951  * ---------------------------------------
  952  .PARAM RDSWEFF    = 'RDSWEFF0 - 2*LPER*37.5*WEJ*1E6/(1+TRUNC((MAX(0,(WM/NFING-CONW-2*COEACT1))/(CONW+CONS))+1E-12)) - 2*NRSD_FLAG*WEJ*1E6*(12*CONPO*NFING/WM)'
  953   
  954  * Unsilicided poly gate resistance:
  955  * --------------------------------
  956  .PARAM RSHGUMMID = '(585+RSHGUM)/2 + (585-RSHGUM)*TANH(1E18*(2*2.75E-8-LM-XL))/2'
  957  .PARAM RSHGUMEFF = 'RSHGUMMID*585*(LM+XL)/(2*2.75E-8*RSHGUMMID + (LM+XL-2*2.75E-8)*585)'
  958  
  959  
  960  .PARAM RGATEMOD = 1
  961  .PARAM XGWS    = 'CONRPO-COEPO'
  962  .PARAM XGWU    = 'RPOEXTPOFLD'
  963  .PARAM LHEAD   = 'NFING*LM+(NFING-1)*(CONW+2*CONPO+(NCRSD-1)*(CONW+CONS))'
  964  .PARAM NCHEAD  = 'NCRG*(1+TRUNC((MAX(0,(LHEAD-CONW-2*COEPO))/(CONW+CONS))+1E-12))'
  965  .PARAM RGELTDU = '(RSHGUMEFF*((WM/NFING+XW)/(3*NGCON)+XGWU-XW/2))/(NGCON*(LM+XL)*NFING)'
  966  .PARAM RGELTDS = '(1-LPER)*(RSHG*XGWS)/(NGCON*(LM+XL)*NFING)'
  967  .PARAM RGELTDI = 'RHIG/(NGCON*(LM+XL)*NFING)'
  968  .PARAM RGCON   = '(1-LPER)*RCONPO/(NCHEAD*NGCON)'
  969  .PARAM RSHG0   = '(RGELTDU+RGELTDS+RGELTDI+RGCON)*(NGCON*(LM+XL-0)*NFING)/((0+WEJ/(3*NGCON)))'
  970  
  971  * Unsilicided Source/Drain diffusion access resistances:
  972  * -----------------------------------------------------
  973  .PARAM NRSEFF    = 'NRS + (RSD_RPO*ESUM/(RSH*WE)/NFING)'
  974  .PARAM NRDEFF    = 'NRD + (RSD_RPO*EDUM/(RSH*WE)/NFING)'
  975  
  976  
  977  
  978  * Equations for VOFF:
  979  * ------------------
  980  
  981  .PARAM VOFF = '-0.16444 + -0.14555*(TEMPK/(25+273.15) -1)' 
  982  
  983  
  984  
  985  * Equations for temperature dependance of BGIDL:
  986  * --------------------------------------------
  987  .PARAM BGIDL = '4.927E+09 + -1.198E+09*(TEMPK/(25+273.15) -1)'
  988  
  989  
  990  * Equations for temperature dependence of series resistances:
  991  * -----------------------------------------------------------
  992  .PARAM RDWMIN = 0
  993  .PARAM RDWMINEFF = 'VALIF( (RDWMIN-1E-18 > 0), (RDWMIN + 100*(TEMPK/(25+273.15) -1)), (0))'
  994  .PARAM RSWMIN = 0
  995  .PARAM RSWMINEFF = 'VALIF( (RSWMIN-1E-18 > 0), (RSWMIN + 100*(TEMPK/(25+273.15) -1)), (0))'
  996  .PARAM RDSWMIN = 0
  997  .PARAM RDSWMINEFF = 'VALIF( (RDSWMIN-1E-18 > 0), (RDSWMIN + 100*(TEMPK/(25+273.15) -1)), (0))'
  998  .PARAM RSW = 0
  999  .PARAM RSWEFF = 'VALIF( (RSW-1E-18 > 0), (RSW + 100*(TEMPK/(25+273.15) -1)), (0))'
 1000  .PARAM RDW = 0
 1001  .PARAM RDWEFF = 'VALIF( (RDW-1E-18 > 0), (RDW + 100*(TEMPK/(25+273.15) -1)), (0))'
 1002  .PARAM RDSWEFF2 = '(RDSWEFF + 100*(TEMPK/(25+273.15) -1))'
 1003  .PARAM PRT = 0
 1004  
 1005  
 1006  * Equations for thermal noise scaling
 1007  * ------------------------------------
 1008  .PARAM NTNOI = '1*LE/LEC'
 1009  
 1010  
 1011  
 1012  * Equations for Flicker Noise Local Variations
 1013  * --------------------------------------------
 1014  
 1015  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__0__NO  = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==0),(1),(0))'
 1016  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__1__MC = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==1),(1),(0))'
 1017  .PARAM GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM = 'VALIF((GFLAG__NOISEDEV__ALL__CMOS065==2),(1),(0))'
 1018  .PARAM DNOISE_DEV = 0.0 DEVX/GAUSS = {SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*GFLAG__NOISEDEV__ALL__CMOS065__1__MC}
 1019  .PARAM NOIA    = '((TANH((LE-1)*1))*(0)/2+4.4E+42)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 1020  .PARAM NOIB    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*DNOISE_MDEV)'
 1021  .PARAM NOIC    = '(0)*10^(DNOISE_DEV)*10^(GFLAG__NOISEDEV__ALL__CMOS065__2__PARAM*SQRT(1.8E-01*1.8E-01+2.5E-07*2.5E-07/(WM*LM*MULT))*DNOISE_MDEV)'
