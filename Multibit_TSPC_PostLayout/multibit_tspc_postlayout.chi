  196  * Channel doping nch and body factor k1 worst case :
  197  *---------------------------------------------------
  198  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
  199  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
  200  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(1.3981E+18/NI)+0.25043+0.4'
