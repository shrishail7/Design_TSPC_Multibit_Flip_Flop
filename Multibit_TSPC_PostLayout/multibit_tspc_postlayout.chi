 1029  * Layout and electrical dimensions:
 1030  *----------------------------------
 1031  .PARAM WM='W*TOMETER'
 1032  .PARAM LM='L*TOMETER'
 1033  .PARAM WFING='WM/NFING+XW'
 1034  .PARAM FD='SRCEFIRST*(NFING-2*TRUNC(NFING/2))+(1-SRCEFIRST)*(2*TRUNC(1+NFING/2)-NFING)'
 1035  .PARAM FS='2-FD'
 1036  .PARAM PDP= 1.82432E-07
 1037  .PARAM PSP= 1.8E-07
 1038  .PARAM ADP= 8.42838E-15
 1039  .PARAM ASP= 8.1E-15
 1040  .PARAM PDM='VALIF((PD>=0),(PD*TOMETER),(PDP))'
 1041  .PARAM PSM='VALIF((PS>=0),(PS*TOMETER),(PSP))'
 1042  .PARAM ADM='VALIF((AD>=0),(AD*TOMETER*TOMETER),(ADP))'
 1043  .PARAM ASM='VALIF((AS>=0),(AS*TOMETER*TOMETER),(ASP))'
 1044  * DC Effective length and width:
 1045  *---------------------------
 1046  .PARAM WE      = '(WM/NFING+XW-2*WINT)'
 1047  .PARAM LE      = 'LM+XL-2.0*LINT'
 1048  * AC Effective length and width:
 1049  *------------------------------
 1050  .PARAM WEC     = '(WM/NFING+XW-2*DWC)'
 1051  .PARAM LEC     = 'LM+XL-2.0*DLC'
 1052  *  Effective Source/Drain Junction width:
 1053  *---------------------------------------
 1054  .PARAM WEJ     = 'WM/NFING+XW-2*DWJ-2*(0/((LM)^1)+0/((WM/NFING)^1)+0/((WM/NFING)^1)/((LM)^1))'
 1055  
 1056  
 1057  * Model improvement equations :
 1058  *------------------------------
 1059  
 1060  * Equations for mismatch deviations:
 1061  *-----------------------------------
 1062  .PARAM DVTH0_ALPHA = (4.1E-9)
 1063  .PARAM DVTH0_BETA  = (0.0)
 1064  .PARAM DVTH0_FUDGE  = (1.0)
 1065  .PARAM DVTH0_SIG = {((DVTH0_ALPHA/SQRT(WM*LM))+DVTH0_BETA)*DVTH0_FUDGE/SQRT(2.0*MULT)}
 1066  .PARAM DVTH0_DEV = 0.0 DEVX/GAUSS = {DVTH0_SIG*SRAMDPSVTLP_DEV*MISMATCH}
 1067  .PARAM DBETA_ALPHA = (0.98E-8)
 1068  .PARAM DBETA_BETA  = (0.0)
 1069  .PARAM DBETA_FUDGE  = (1.0)
 1070  .PARAM DBETA_SIG = {((DBETA_ALPHA/SQRT(WM*LM))+DBETA_BETA)*DBETA_FUDGE/SQRT(2.0*MULT)}
 1071  .PARAM DBETA_DEV = 0.0 DEVX/GAUSS = {DBETA_SIG*SRAMDPSVTLP_DEV*MISMATCH}
 1072  
 1073  
 1074  .PARAM PROCESSSTATFLAGS = '1.0'
 1075  .PARAM DVTHTOT   = 'PSRAMDPSVTLP_DVTH0_CMOS065/(VALIF((PSRAMDPSVTLP_DVTH0_CMOS065==0),(1),(0))+SQRT((PSRAMDPSVTLP_DVTH0_CMOS065)^2))*SQRT(((DVTH0_SIG*PSRAMDPSVTLP_MCOR_VT_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+(PSRAMDPSVTLP_DVTH0_CMOS065)^2)+MOSTYPE*DVTH0_SIG*DVT_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS'
 1076  .PARAM VTH     = '-0.41061+PSRAMDPSVTLP_DVTH0_CMOS065'
 1077  
 1078  
 1079  * Equation for  AGIDL:
 1080  * --------------------
 1081  .PARAM AGIDL   = '(1.1537E-07)*10^DAGIDL'
 1082  
 1083  
 1084  * Equations for mobility :
 1085  *-------------------------
 1086  .PARAM EPSILON2 = 1E-18
 1087  .PARAM LLIMIT = '3.660474E-08-XL' 
 1088  .PARAM WLIMIT = '2.62296E-07-XW' 
 1089  .PARAM DWU = 'DWU0+(3.2242)*0.5E6*(ABS(LE-1E-07)-(LE-1E-07))' 
 1090  .PARAM MOBILITY = '2.0/(0.0252865415+(LLIMIT+XL
 1091  + -2.0*LINT-SQRT((LLIMIT-LM)*(LLIMIT-LM)+EPSILON2))*0.00803623962/LE)
 1092  + *(WM/NFING-2.0*((WINT-XW/2.0)*(1.0+2.0*(DWU))-(DWU)*WLIMIT
 1093  + +(DWU)*0.5*(WLIMIT-WM/NFING)+0.5*(DWU)*SQRT((WLIMIT-WM/NFING)*(WLIMIT-WM/NFING)+EPSILON2)))/WE'
 1094  
 1095  
 1096  
 1097  .PARAM U0 = 'MOBILITY*(1.0+DBETA_DEV*MFLAG_MC)*(1+DMU/(VALIF((DMU==0),(1),(0))+SQRT(DMU^2))*SQRT(((DBETA_SIG*PSRAMDPSVTLP_MCOR_BETA_CMOS065)^2)*MFLAG_CORNER*PROCESSSTATFLAGS+DMU^2))*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS)'
 1098  
 1099  
 1100  * Channel doping nch and body factor k1 worst case :
 1101  *---------------------------------------------------
 1102  .PARAM  EG0       =  '1.16-(7.02E-4*((273.15+25)^2)/(25+1381))'
 1103  .PARAM  NI        =  '1.45E10*(((273.15+25)/300.15)^1.5)*EXP(21.5565981-EG0/(1.725E-4*(273.15+25)))'
 1104  .PARAM  PHIS_TYP  =  '8.617087E-5*(273.15+25)*LOG(3.8723E+17/NI)+0.18679+0.4'
 1105  .PARAM  K2        =  '(0+7.4711E-11/LE)*(TOX/2.4239E-09)'
 1106  .PARAM  K1        =  '(0.25156)-MOSTYPE*(-0.41061-VTH)/SQRT(PHIS_TYP)'
 1107  .PARAM  VTH0   =  'VTH+MOSTYPE*DVTH0_DEV*MFLAG_MC' 
 1108  .PARAM  NCH       =  '3.8723E+17*(K1*K1)/((0.25156)*(0.25156))'
 1109  .PARAM  PHIS      =  '8.617087E-5*(273.15+25)*LOG(NCH/NI)+0.18679+0.4'
 1110  * Series resistance worst case :
 1111  *-------------------------------
 1112  .PARAM RDSW      =  '(406.95+2.097E-05/WE)*(1+DRDSW)/((1.0+DBETA_DEV*MFLAG_MC)*(1+DBETA_SIG*PSRAMDPSVTLP_MCOR_BETA_CMOS065*MFLAG_CORNER*PROCESSSTATFLAGS)*(1+DBETA_SIG*DMU_MDEV*MFLAG_PARAM*MISMATCH*PROCESSSTATFLAGS))'
 1113  .PARAM PRWB      =  0.26884
 1114  
 1115  
 1116  
 1117  
 1118  
 1119  .PARAM  VTH0EFF   =  'VTH0-PSRAMDPSVTLP_DVTH0_CMOS065+DVTHTOT'
 1120  .PARAM U0EFF            = U0
 1121  .PARAM K1EFF		= K1
 1122  .PARAM DVT0EFF		= 1.4588
 1123  .PARAM RDSWEFF0          = RDSW 
 1124  .PARAM VSATEFF = '(3.1774E+05)'
 1125  
 1126  
 1127  .PARAM NFACTOR = '(1.2065)*SQRT(PHIS*3.8723E+17/(PHIS_TYP*NCH))*(2.4239E-09/TOX)'
 1128  
 1129  
 1130  
 1131  * Equations for VT :
 1132  *-------------------
 1133  .PARAM W0       = '4.6522E-07+(0-XW)'
 1134  .PARAM K3B      = '(7.0432)*(2.4239E-09/TOX)'
 1135  .PARAM XDEP0    = 'SQRT(2*1.03594E-10*PHIS/(1.60219E-19*NCH*1E6))'
 1136  .PARAM XDEP0_TYP= 'SQRT(2*1.03594E-10*PHIS_TYP/(1.60219E-19*3.8723E+17*1E6))'
 1137  .PARAM DVTP0    = 0
 1138  
 1139  
 1140  .PARAM N_SUBVT  = '1.0+(1.2065)*7.271700702E-09/XDEP0'
 1141  .PARAM VTH_RSCE = '-N_SUBVT*0.02586*LOG(LE/(LE+9.7209E-07))'
 1142  .PARAM TMP2     = '2.18151E-09/(WE+W0)'
 1143  .PARAM K3       = '(-13.36+3E-07/(LE*(LMIN+0-2*LINT)/(LMIN+XL-2*LINT)))*(2.4239E-09/TOX)+VTH_RSCE/TMP2'
 1144  
 1145  
 1146  
 1147  * Equation for moin :
 1148  *-------------------
 1149  .PARAM MOIN = 'VALIF((10*((0.25156)/K1EFF)^2 > 5), (10*((0.25156)/K1EFF)^2), (5))'
 1150  
 1151  
 1152  * Equations for LKETA :
 1153  *---------------------
 1154  
 1155  .PARAM LKETAEXP = 'VALIF(((2.646973186E-07/LE-3.020555489) > 34), (34), (2.646973186E-07/LE-3.020555489))'
 1156  
 1157  .PARAM LKETA    = '-0.019729/(1.0+EXP(LKETAEXP))'
 1158  
 1159  
 1160  *Worst case methodology improvement: Short Channel effect
 1161  *--------------------------------------------------------
 1162  .PARAM LPE0  = '((((0.25156)/K1)*SQRT(PHIS_TYP/PHIS)*(SQRT(1+(4.5877E-08)/(LMIN+0-(2*LINT)))-1)+1)**2-1)*(LMIN+XL-(2*LINT))'
 1163  .PARAM LPEB  = '(-5.9281E-10)/(LMIN+0-2*LINT)*(LMIN+XL-2*LINT)'
 1164  .PARAM DVT1  = '0.077454*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)' 
 1165  .PARAM DVT1W = '2.0191E+05*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1166  .PARAM DSUB = '(0.065407)*SQRT(TOX/2.4239E-09)*SQRT(XDEP0/XDEP0_TYP)'
 1167  
 1168  
 1169  
 1170  * Equations for Extrinsic Capacitances:
 1171  * ------------------------------------
 1172  
 1173  .PARAM C2 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(0.75*(-8.304E-19 + 1.031E-10*(WM/NFING + XW))),(0.75*(-7.961E-19 + 1.344E-10*(WM/NFING + XW))))'
 1174  
 1175  .PARAM C3INT = '0.3*(-2.401E-18 + 2.435E-10*(LM + XL))'
 1176  .PARAM C3EXT = '(9.751E-18 + 7.319E-11*(LM + XL))'
 1177  
 1178  .PARAM C4 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.216E-17 + 2.141E-18*TANH((LM + XL)/1.388E-07)),(1.479E-17 + 3.024E-18*TANH((LM + XL)/1.649E-07)))'
 1179  .PARAM C7 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(1.549E-17 + 1.068E-16*TANH((WM/NFING + XW)/0.0001376) + 1.69E-17*TANH((LM + XL)/4.648E-07)),(1.117E-17 + 5.853E-17*TANH((WM/NFING + XW)/0.0002762) + 1.452E-17*TANH((LM + XL)/6.377E-07)))' 
 1180  
 1181  
 1182  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 1183  
 1184  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 1185  
 1186  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
 1187  
 1188  .PARAM CGSL = '(6.7972E-11)*(2.4239E-09/TOX)'
 1189  .PARAM CGDL = '(6.7972E-11)*(2.4239E-09/TOX)'
