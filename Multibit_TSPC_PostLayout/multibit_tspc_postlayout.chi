 1635  
 1636  .PARAM C56 = 'VALIF(((WM/NFING)>=(CONW+2*COEACT1-1E-18)),(-8.16E-19*(1-ALIGNMENT_PRELAYOUT) + 9.707E-11*(WM/NFING + XW) + 4.244E-11*(WM/NFING + XW)*TANH((LM + XL)/3.678E-07)) ,(3.994E-19*(1-ALIGNMENT_PRELAYOUT) + 3.116E-11*(WM/NFING + XW) + 2.5E-11*(WM/NFING + XW)*TANH((LM + XL)/6.106E-07)))'
 1637  
 1638  .PARAM CGBO = '(1-ALIGNMENT_PRELAYOUT)*(C3INT + C3EXT*(1-LPEC))*(1 + DCFRING)/LEC'
 1639  
 1640  .PARAM CF = '(C2 + (1-ALIGNMENT_PRELAYOUT)*C4 + (1-ALIGNMENT_POSTLAYOUT)*C56*(1-LPEC2) + (1-ALIGNMENT_PRELAYOUT)*C7*(1-LPEC2))*(1 + DCFRING)/WEC' 
 1641  
 1642  .PARAM CGSL = '(6.7922E-11)*(2.3926E-09/TOX)'
 1643  .PARAM CGDL = '(6.7922E-11)*(2.3926E-09/TOX)'
